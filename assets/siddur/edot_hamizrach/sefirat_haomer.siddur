ֹם לָעֹֽמֶר, שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים:"}]],"en":"Today is Fourty-Seven Days of the Omer, which are Six Weeks & Five Days.","when":{"omerDay":47}},{"key":"rkom0d_WBH","he":[[{"t":"יודע","s":"b"},{"t":" הוד שבמלכות "},{"t":"כל","s":"b"},{"t":" ס"}]],"when":{"omerDay":47}},{"key":"RyxfqGCDpk","he":[[{"t":"ד סיון","s":"n"}]],"when":{"omerDay":48}},{"key":"yBk0CXNonY","he":[[{"t":"הַיּוֹם שְׁמוֹנָה וְאַרְבָּעִים יוֹם לָעֹֽמֶר, שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים:"}]],"en":"Today is Fourty-Eight Days of the Omer, which are Six Weeks & Six Days.","when":{"omerDay":48}},{"key":"-eYVhY9mf-","he":[[{"t":"תעלומות","s":"b"},{"t":" יסוד שבמלכות "},{"t":"אפסי","s":"b"},{"t":" ל"}]],"when":{"omerDay":48}},{"key":"hzBY2aZczx","he":[[{"t":"ה סיון","s":"n"}]],"when":{"omerDay":49}},{"key":"vji30UuW6H","he":[[{"t":"הַיּוֹם תִּשְׁעָה וְאַרְבָּעִים יוֹם לָעֹֽמֶר, שֶׁהֵם שִׁבְעָה שָׁבוּעוֹת:"}]],"en":"Today is Fourty-Nine Days of the Omer, which are Seven Weeks.","when":{"omerDay":49}},{"key":"sKgwb_UCPl","he":[[{"t":"שק\"ו צי\"ת","s":"b"},{"t":" מַלְכוּת שבמלכות "},{"t":"ארץ","s":"b"},{"t":" ה"}]],"when":{"omerDay":49}},{"key":"ztP8HYUx4g","he":[[{"t":"הָרַחֲמָן","s":"b"},{"t":" הוּא יַחֲזִיר עֲבוֹדַת בֵּית הַמִּקְדָּשׁ לִמְקוֹמָהּ בִּמְהֵרָה בְיָמֵֽינוּ אָמֵן:"}]],"en":"The Merciful One, May You Return the Service of the Holy Temple to its place, speedily in our days. Amen."},{"key":"J2sGAopsXP","he":[[{"t":"לַמְנַצֵּ֥חַ ","s":"b"},{"t":"(תהילים ס״ז:א׳-ג׳)","s":"n"},{"t":" בִּנְגִינֹ֗ת מִזְמ֥וֹר שִֽׁיר׃ אֱֽלֹהִ֗ים יְחׇנֵּ֥נוּ וִיבָרְכֵ֑נוּ יָ֤אֵֽר פָּנָ֖יו אִתָּ֣נוּ סֶֽלָה׃ לָדַ֣עַת בָּאָ֣רֶץ דַּרְכֶּ֑ךָ בְּכׇל־גּ֝וֹיִ֗ם יְשׁוּעָתֶֽךָ׃ יוֹד֖וּךָ עַמִּ֥ים ׀ אֱלֹהִ֑ים י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃ יִ֥שְׂמְח֥וּ וִירַנְּנ֗וּ לְאֻ֫מִּ֥ים כִּֽי־תִשְׁפֹּ֣ט עַמִּ֣ים מִישֹׁ֑ר וּלְאֻמִּ֓ים ׀ בָּאָ֖רֶץ תַּנְחֵ֣ם סֶֽלָה׃ יוֹד֖וּךָ עַמִּ֥ים ׀ אֱלֹהִ֑ים י֝וֹד֗וּךָ עַמִּ֥ים כֻּלָּֽם׃ אֶ֭רֶץ נָתְנָ֣ה יְבוּלָ֑הּ יְ֝בָרְכֵ֗נוּ אֱלֹהִ֥ים אֱלֹהֵֽינוּ׃ יְבָרְכֵ֥נוּ אֱלֹהִ֑ים וְיִֽירְא֥וּ א֝וֹת֗וֹ כׇּל־אַפְסֵי־אָֽרֶץ׃"}]],"en":"To the Chief Musician a psalm with instrumental music, a Song. May G-d, give us grace & bless us, May He shine His countenance among us – forever. For the world to know Your way, & among all the nations, Your salvation. Peoples [of the world] will thank You, G-d. All the peoples will thank You. The Nations will rejoice & sing [praises] the people [of earth] for you judge the people with righteousness & that You lead the nations of the earth, forever. Peoples [of the world] will thank You, G-d. All the peoples will thank You. The land will have yielded its produce – May You bless us L·rd, our G-d. L·rd bless us & they will fear Him. - from the ends of the earth. (Tehillim / Psalm 67)"},{"key":"HIZ4piL1GL","he":[[{"t":"אָֽנָּֽא בְּכֹֽחַ. גְּדוּלַת יְמִינֶֽךָ. תַּתִּיר צְרוּרָה: "},{"t":"(אב\"ג ית\"ץ)","s":"n"}]],"en":"Please [God] with the power of the greatness of Your right hand, free the captive [Israel from its Exile]."},{"key":"bfbeSnc5ES","he":[[{"t":"קַבֵּל רִנַּת. עַמֶּֽךָ שַׂגְּבֵֽנוּ. טַהֲרֵֽנוּ נוֹרָא: "},{"t":"(קר\"ע שט\"ן)","s":"n"}]],"en":"Accept the singing [prayer] of Your people. Strengthen us & purify us, Awesome One."},{"key":"GcFC2Lvtim","he":[[{"t":"נָא גִבּוֹר. דּֽוֹרְשֵֽׁי יִחוּדֶֽךָ. כְּבָבַת שָׁמְרֵם: "},{"t":"(נג\"ד יכ\"ש)","s":"n"}]],"en":"Please, Mighty One, those that seek Your unity - like the pupil of the eyes - guard them."},{"key":"1zKtv69Kna","he":[[{"t":"בָּֽרְכֵֽם טַהֲרֵם. רַחֲמֵי צִדְקָתֶֽךָ. תָּמִיד גָּמְלֵם: "},{"t":"(בט\"ר צת\"ג)","s":"n"}]],"en":"Bless them & purify them. The mercy of Your righteousness always bestow upon them."},{"key":"BybpfrakSO","he":[[{"t":"חֲסִין קָדוֹשׁ. בְּרֹב טֽוּבְךָֽ. נַהֵל עֲדָתֶֽךָ: "},{"t":"(חק\"ב טנ\"ע)","s":"n"}]],"en":"Mighty & Holy One with the abundance of your good, lead Your congregation."},{"key":"3OvLbvHS7b","he":[[{"t":"יָחִיד גֵּאֶה. לְעַמְּךָ פְנֵה. זֽוֹכְרֵֽי קְדֻשָּׁתֶֽךָ: "},{"t":"(יג\"ל פז\"ק)","s":"n"}]],"en":"Single Exalted One, turn to Your people - those that remind of Your Holiness ."},{"key":"Em32DVZtC2","he":[[{"t":"שַׁוְעָתֵֽנוּ קַבֵּל. וּשְׁמַע צַעֲקָתֵֽנוּ. יוֹדֵֽעַ תַּעֲלוּמוֹת: "},{"t":"(שק\"ו צי\"ת)","s":"n"}]],"en":"Accept our pleading & hear our wailing - [You] Who knows the hidden."},{"key":"1oMtpNL4FR","he":[[{"t":"ואומר בלחש:","s":"n"},{"t":" בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:"}]],"en":"(Silently) Blessed be the Name of His glorious kingdom forever more."}]}],"credits":[{"title":"Siddur Edot HaMizrach — Shaliehsaboo Edition","license":"CC0","url":"https://www.sefaria.org/Siddur_Edot_HaMizrach"},{"title":"Siddur Edot HaMizrach — Sefaria Community Translation","license":"CC0","url":"https://www.sefaria.org/Siddur_Edot_HaMizrach"}]}