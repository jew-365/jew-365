{"nusach":"edot_hamizrach","id":"al_hamichya","sections":[{"title":{"he":"ברכה מעין שלוש","en":"Me'ein Shalosh"},"segments":[{"key":"1MvzTU3U_R","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם"}]]},{"key":"leqaTuDkzV","he":[[{"t":"אם אכל מזונות יאמר","s":"n"},{"t":" עַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה"}]]},{"key":"nOPFraLyAQ","he":[[{"t":"אם שתה יין יאמר","s":"n"},{"t":" (וְ)עַל הַגֶּֽפֶן וְעַל פְּרִי הַגֶּֽפֶן"}]]},{"key":"wlpMUVQa1Y","he":[[{"t":"אם אכל פרות משבעת המינים יאמר","s":"n"},{"t":" (וְ)עַל הָעֵץ וְעַל פְּרִי הָעֵץ"}]]},{"key":"VI5TJdq6BF","he":[[{"t":"וְעַל תְּנוּבַת הַשָּׂדֶה, וְעַל אֶֽרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה, שֶׁרָצִֽיתָ וְהִנְחַֽלְתָּ לַאֲבוֹתֵֽינוּ, לֶאֱכֹל מִפִּרְיָהּ וְלִשְׂבֹּֽעַ מִטּוּבָהּ. רַחֵם יְהֹוָה אֱלֹהֵֽינוּ עָלֵֽינוּ וְעַל יִשְׂרָאֵל עַמָּךְ, וְעַל יְרוּשָׁלַֽיִם עִירָךְ, וְעַל הַר צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ, וְעַל מִזְבָּחָךְ וְעַל הֵיכָלָךְ. וּבְנֵה יְרוּשָׁלַֽיִם עִיר הַקֹּֽדֶשׁ בִּמְהֵרָה בְיָמֵֽינוּ, וְהַעֲלֵֽנוּ לְתוֹכָהּ, וְשַׂמְּחֵֽנוּ בְּבִנְיָנָהּ, וּנְבָֽרְכָֽךְ עָלֶֽיהָ בִּקְדֻשָּׁה וּבְטָהֳרָה:"}]]},{"key":"61_-CP9MPZ","he":[[{"t":"בראש־חודש","s":"n"},{"t":" וְזָכְרֵֽנוּ לְטוֹבָה בְּיוֹם רֹאשׁ חֹֽדֶשׁ הַזֶּה."}]],"when":{"any":["roshChodesh","roshChodeshYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"key":"4F6MLgaHTU","he":[[{"t":"בפסח","s":"n"},{"t":" וְשַׂמְּחֵֽנוּ בְּיוֹם חַג הַמַּצּוֹת הַזֶּה, בְּיוֹם מִקְרָא קֹדֶשׁ הַזֶּה."}]],"when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"key":"uHB0AnPoMh","he":[[{"t":"בסוכות","s":"n"},{"t":" וְשַׂמְּחֵֽנוּ בְּיוֹם הַסֻּכּוֹת הַזֶּה, בְּיוֹם מִקְרָא קֹֽדֶשׁ הַזֶּה."}]],"when":{"any":["cholHamoedSukkot","cholHamoedSukkotYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"key":"h9N6HFwKoE","he":[[{"t":"כִּי אַתָּה טוֹב וּמֵטִיב לַכֹּל, וְנוֹדֶה לְךָ עַל הָאָֽרֶץ"}]]},{"key":"vDBBWwfZdi","he":[[{"t":"מזונות","s":"n"},{"t":" וְעַל הַמִּחְיָה וְעַל הַכַּלְכָּלָה"}]]},{"key":"Y87DbEESc6","he":[[{"t":"יין","s":"n"},{"t":" וְעַל פְּרִי הַגֶּֽפֶן"}]]},{"key":"aI6Vy9MNvp","he":[[{"t":"פירות","s":"n"},{"t":" וְעַל הַפֵּרוֹת"}]]},{"key":"ZVpRz_dxsq","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה, עַל הָאָֽרֶץ וְעַל"}]]},{"key":"L8hGuJb2aU","he":[[{"t":"מזונות","s":"n"},{"t":" הַמִּחְיָה וְעַל הַכַּלְכָּלָה:"}]]},{"key":"QbpHL1QbZe","he":[[{"t":"יין","s":"n"},{"t":" פְּרִי הַגֶּֽפֶן:"}]]},{"key":"rVYoBqyrXt","he":[[{"t":"פירות","s":"n"},{"t":" הַפֵּרוֹת:"}]]}]},{"title":{"he":"לפירות ארץ ישראל","en":"For Produce of the Land of Israel"},"optional":{"he":"לפירות ארץ ישראל","en":"For produce of the Land of Israel"},"segments":[{"key":"ivhq6RhToZ","he":[[{"t":"על פירות ארץ ישראל מסיימים:","s":"n"}]],"en":"For produce of the Land of Israel, the blessing ends:"},{"key":"vDBBWwfZdi.1","he":[[{"t":"מזונות","s":"n"},{"t":" וְעַל מִחְיָתָהּ וְעַל כַּלְכָּלָתָהּ"}]]},{"key":"Y87DbEESc6.1","he":[[{"t":"יין","s":"n"},{"t":" וְעַל פְּרִי גַפְנָהּ"}]]},{"key":"aI6Vy9MNvp.1","he":[[{"t":"פירות","s":"n"},{"t":" וְעַל פֵּרוֹתֶֽיהָ"}]]},{"key":"ZVpRz_dxsq.1","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה, עַל הָאָֽרֶץ וְעַל"}]]},{"key":"L8hGuJb2aU.1","he":[[{"t":"מזונות","s":"n"},{"t":" מִחְיָתָהּ וְעַל כַּלְכָּלָתָהּ:"}]]},{"key":"QbpHL1QbZe.1","he":[[{"t":"יין","s":"n"},{"t":" פְּרִי גַפְנָהּ:"}]]},{"key":"rVYoBqyrXt.1","he":[[{"t":"פירות","s":"n"},{"t":" פֵּרוֹתֶֽיהָ:"}]]}]}],"credits":[{"title":"Siddur Edot HaMizrach — Shaliehsaboo Edition","license":"CC0","url":"https://www.sefaria.org/Siddur_Edot_HaMizrach"}]}