{"nusach":"teiman","id":"havdalah","sections":[{"title":{"he":"החל עלינו","en":"Hachel Aleinu"},"optional":{"he":"במקצת מקומות אומרים לפני ההבדלה","en":"In some places this is said before Havdalah"},"segments":[{"key":"6iX4MOrD89","he":[[{"t":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ הָחֵל עָלֵינוּ אֶת שֵׁשֶׁת יְמֵי הַמַּעֲשֶׂה הַבָּאִים לִקְרָאתֵנוּ לְשָׁלוֹם חֲשׂוּכִים מִכָּל חֵטְא וָפֶשַׁע. מְנוּקִּים מִכָּל עָוֹן וְאַשְׁמָה וָרֶשַׁע. מְדוּבָּקִים בְּיִרְאָתֶךָ: אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ לֹא תַעֲלֶה קִנְאָתֵנוּ עַל לֵב אָדָם וְלֹא קִנְאַת אָדָם תַּעֲלֶה עַל לִבֵּנוּ וְכָל הַיּוֹעֵץ עָלֵינוּ וְעַל עַמְּךָ בֵּית יִשְׂרָאֵל עֵצָה טוֹבָה וּמַחְשָׁבָה טוֹבָה לְמַעַן שְׁמָךְ תַּקְּנוֹ קַיְּימוֹ קַיֵּים עֲצָתוֹ וְתַקֵּן מַחֲשַׁבְתּוֹ וְקַיֵּים עָלָיו קְרָא דְּכַתִיב וַיֹּאמֶר אֲנִי אַעֲבִיר כָּל טוּבִי עַל פָּנֶיךָ וְקָרָאתִי בְשֵׁם יְיָ לְפָנֶיךָ וְחַנּוֹתִי אֶת אֲשֶׁר אָחוֹן וְרִחַמְתִּי אֶת אֲשֶׁר אֲרַחֵם: וְכָתוּב כִּי יְיָ דִּבֶּר טוֹב עַל יִשְׂרָאֵל: וְכָל הַיּוֹעֵץ עָלֵינוּ וְעַל עַמְּךָ בֵּית יִשְׂרָאֵל עֵצָה שְׁאֵינָהּ טוֹבָה וּמַחְשָׁבָה שְׁאֵינָהּ טוֹבָה בֵּין שְׁהוּא בֶּן בְּרִית וּבֵין שְׁאֵינוֹ בֶּן בְּרִית לְמַעַן שְׁמָךְ גַּדְּעוֹ נַתְּצוֹ בַּלְבְּלוֹ טַלְטְלוֹ הַכְרִיתוֹ הַחְרִימוֹ הַשְׁמִידוֹ הָפֵר עֲצָתוֹ וְקַלְקֵל מַחֲשַׁבְתּוֹ. וְקַיֵּים עָלָיו קְרָא דְּכַתִיב הַאֲשִׁימֵם אֱלֹהִים יִפְּלוּ מִמּוֹעֲצוֹתֵיהֶם בְּרוֹב פִּשְׁעֵיהֶם הַדִּיחֵמוֹ כִּי מָרוּ בָךְ וְכַתִיב עוּצוּ עֵצָה וְתוּפָר דַּבְּרוּ דָבָר וְלֹא יָקוּם כִּי עִמָּנוּ אֵל: רַבּוֹת מַחֲשָׁבוֹת בְּלֶב אִישׁ וַעֲצַת יְיָ הִיא תָקוּם: בָּרוּךְ מֵפֵר עֵצוֹת הָרָעוֹת וּמַחְשָׁבוֹת הָרָעוֹת וְיִסּוּרִין הָרָעִים מֵעָלֵינוּ וּמֵעַל כָּל עַמּוֹ בֵּית יִשְׂרָאֵל:"}]],"when":{"none":["tishaBav"]}}]},{"title":{"he":"סדר הבדלה","en":"Havdalah"},"segments":[{"key":"BqmxYTby_m","he":[[{"t":"ומבדילין על הכוס סימן ינ\"ה יין נר הבדלה ואין מברכין על הבשמים אפילו חל בשבת . ואין מברכין על הנר אלא על אור ששבת ולא שהוציאוהו עתה מעצים ואבנים :","s":"n"}]],"when":{"all":["dayAfterYomKippur"]}},{"key":"VoKsRNWm1W","he":[[{"t":"במוצאי ר\"ה מבדילין בתפלה ועל הכוס אלא שאינו מברך על הבשמים והאש :","s":"n"}]],"when":{"all":["aseretYemeiTeshuva","motzaei"],"none":["yomTov","motzaeiShabbat"]}},{"key":"91lq2F7Kme","he":[[{"t":"למעריב שהוא חוה\"מ כמו בחול והבדלה בחונן הדעת ויעלה ויבא בעבודה אֶת יוֹם מִקְרָא קֹדֶשׁ הַזֶּה אֶת יוֹם מוֹעֵד חַג הַמַּצּוֹת הַזֶּה ואם לא אמרו מחזירין אותו. וברכת העומר. ומבדיל על הכוס יין הבדלה :","s":"n"}]],"when":{"all":["cholHamoedPesach","motzaei"],"none":["motzaeiShabbat"]}},{"key":"C4M-obuH6O","he":[[{"t":"כשחל ט\"ב במ\"ש אין פושטין בגדי שבת מבע\"י. ואין אומרים מעלות ומתפללים כבשאר ימים ואומרים הבדלה בחונן הדעת ואומרים קדיש ואומרים ויהי נועם וכו' ואתה קדוש וישלים סדרא דיומא וקדיש תתקבל ואומרים עלינו לשבח ויושב ומברך על הנר בורא מאורי האש קודם איכה ואינו מברך על הבשמים . ומוצאי ט\"ב מבדיל על הכוס ואינו מברך לא על הנר ולא על הבשמים .","s":"n"}]],"when":{"all":["tishaBav","motzaeiShabbat"]}},{"key":"_l9MZkTj8l","he":[[{"t":"ומבדיל על הכוס","s":"n"},{"t":", ומדליק נר של שעווה או של שמן","s":"n","when":{"any":["motzaeiShabbat","dayAfterYomKippur"]}},{"t":", ומתחיל. אם הוא כוס של יין, מברך:","s":"n"}]],"when":{"none":["tishaBav"]}},{"key":"gUieAXO6aj","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא פְּרִי הַגָּפֶן:"}]],"when":{"none":["tishaBav"]},"en":"Blessed are You, Adonoy our God, King of the Universe, Creator of the fruit of the vine."},{"key":"-w6qaWxAM6","he":[[{"t":"ואם אינו יין, מברך שהכל.","s":"n"},{"t":" ומעביר את הכוס ליד שמאל, ואוחז את הבשמים בימין, ומברך:","s":"n","when":{"any":["motzaeiShabbat"],"none":["tishaBav","dayAfterYomKippur"]}}]],"when":{"none":["tishaBav"]}},{"key":"Y34bL6rHoR","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא עֲצֵי בְשָׂמִים"}]],"when":{"any":["motzaeiShabbat"],"none":["tishaBav","dayAfterYomKippur"]}},{"key":"vA1koYhlUC","he":[[{"t":"ומברך על הנר:","s":"n"}]],"when":{"any":["dayAfterYomKippur","motzaeiShabbat"]}},{"key":"yid2QriJuf","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא מְאוֹרֵי הָאֵשׁ"}]],"when":{"any":["dayAfterYomKippur","motzaeiShabbat"]}},{"key":"rV9w0lb8nV","he":[[{"t":"ומחזיר את הכוס ליד ימין, ","s":"n","when":{"any":["motzaeiShabbat"],"none":["tishaBav","dayAfterYomKippur"]}},{"t":"ומבדיל:","s":"n"}]],"when":{"none":["tishaBav"]}},{"key":"T3mlHUbKTA","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם הַמַּבְדִּיל בֵּין קֹדֶשׁ לְחוֹל וּבֵין אוֹר לַחֹשֶׁךְ וּבֵין יִשְׂרָאֵל לָעַמִּים וּבֵין יוֹם הַשְּׁבִיעִי לְשֵׁשֶׁת יְמֵי הַמַּעֲשֶׂה. בָּרוּךְ אַתָּה יְיָ הַמַּבְדִּיל בֵין קֹדֶשׁ לַחוֹל:"}]],"when":{"none":["tishaBav"]}},{"key":"AQ_X9kzGQH","he":[[{"t":"ואחר הבדלה אומרים ויתן לך האלהים מטל השמים ופסוקים אחרים כמו שנהגו","s":"n"}]],"when":{"all":["motzaeiShabbat"],"none":["tishaBav"]}}]}],"credits":[{"title":"Havdalah — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Maariv after Shabbat: Vihi No'am and V'Atah Kadosh — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}