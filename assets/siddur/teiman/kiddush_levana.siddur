{"nusach":"teiman","id":"kiddush_levana","sections":[{"title":{"he":"פתיחה","en":"Opening"},"segments":[{"key":"MHKQ9W5ZwS","he":[[{"t":"הרואה את הלבנה בחידושה בתחילת כל חודש מברך, ואומר קודם הברכה:","s":"n"}]]},{"key":"idxtaNYTVU","he":[[{"t":"תַּנָא דְּבֵי רִבִּי יִשְׁמָעֵאל אִלְמַלֵא לֹא זָכוּ יִשְׂרָאֵל אֵלָא לְהַקְבִּיל פְּנֵי אֲבִיהֶם שֶׁבַּשָּׁמַיִם פַּעַם אַחַת בַּחֹדֶשׁ דַּיָּם אֲמַר אַבַּיֵי הִילְכָּךְ מֵעוֹמֵד:"}]]}]},{"title":{"he":"ברכת הלבנה","en":"Blessing of the Moon"},"segments":[{"key":"ODxun3KDcZ","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר בְּמַאֲמָרוֹ בָּרָא שְׁחָקִים וּבְרוּחַ פִּיו כָּל צְבָאָם חוֹק וּזְמָן נָתַן לָהֶם שֶׁלֹּא יְשַׁנּוּ אֶת תַּפְקִידָתָם שָׂשִׂים וּשְׂמֵחִים לַעֲשׂוֹת רְצוֹן קוֹנֵיהֶם פּוֹעֲלֵי אֱמֶת שֶׁפְּעוּלָּתָם אֱמֶת וְלַלְּבָנָה אָמַר שֶׁתִּתְחַדֵּשׁ לִהְיוֹת עֲטֶרֶת תִּפְאֶרֶת לַעֲמוּסֵי בֶטֶן. שְׁהֶם עֲתִידִים לְהִתְחַדֵּשׁ כְּמוֹתָהּ וּלְפָאֵר לְיוֹצְרָם עַל כְּבוֹד מַלְכוּתוֹ בָּרוּךְ אַתָּה יְיָ מְחַדֵּשׁ חֳדָשִׁים:"}]]},{"key":"Eo6JGXsf67","he":[[{"t":"סִימָן טוֹב תְּהֶא לָנוּ וּלְכָל יִשְׂרָאֵל: "},{"t":"ג\"פ","s":"n"}]]},{"key":"kOPfyt2_uh","he":[[{"t":"בָּרוּךְ יוֹצְרִיךְ בָּרוּךְ עוֹשִיךְ בָּרוּךְ קוֹנִיךְ בָּרוּךְ בּוֹרְאִיךְ. "},{"t":"ורוקד כנגד הלבנה ואומר","s":"n"}]]},{"key":"sxhAJ8b7-s","he":[[{"t":"כְּשֵׁם שֶׁאָֽנוּ מְרַקְּדִים כְּנֶגְדִּיךְ וְאֵין אָנוּ יְכוּלִים לִיגַּע בִּיךְ כָּךְ אִם יְרַקְּדוּ אֲחֵרִים כְּנֶגְדֵּנוּ לְהַזִּיקֵנוּ לֹא יוּכְלוּ לִיגַּע בָּנוּ."}]]},{"key":"ip4_qWaPIx","he":[[{"t":"תִּפֹּל עֲלֵיהֶם אֵימָתָה וָפַחַד בִּגְדֹל זְרוֹעֲךָ יִדְּמוּ כָּאָבֶן. כָּאָבֶן יִדְּמוּ זְרוֹעֲךָ בִּגְדֹל וָפַחַד אֵימָתָה עֲלֵיהֶם תִּפֹּל:"}]]},{"key":"NOjlXN9k_M","he":[[{"t":"וחוזר ואומר סימן טוב וכו' ג\"פ","s":"n"}]]},{"key":"1RLRaA3AEu","he":[[{"t":"דָּוִד מֶלֶךְ יִשְׂרָאֵל חַי וְקַיָּם: "},{"t":"ג\"פ","s":"n"}]]},{"key":"kDyf11gF6O","he":[[{"t":"אָמֵן אָמֵן אָמֵן סֶלָּה סֶלָה סֶלָּה:"}]]},{"key":"jVgMZ8dEBO","he":[[{"t":"לֵב טָהוֹר בְּרָא לִי אֱלֹהִים וְרוּחַ נָכוֹן חַדֵּשׁ בְּקִרְבִּי:"}]]}]},{"title":{"he":"פסוקים ומזמורים","en":"Verses and Psalms"},"segments":[{"key":"F0BSyiihkW","he":[[{"t":"שיר למעלות אשא עיני אל ההרים וכו' עד סופו .","s":"n"}]]},{"key":"PQhQUpQgno","he":[[{"t":"שִׁיר לַמַּעֲלוֹת אֶשָּׂא עֵינַי אֶל־הֶהָרִים מֵאַיִן יָבֹא עֶזְרִי׃"}]]},{"key":"YLhJEUncmp","he":[[{"t":"עֶזְרִי מֵעִם יְיָ עֹשֵׂה שָׁמַיִם וָאָרֶץ׃"}]]},{"key":"gRkbhvzuYg","he":[[{"t":"אַל־יִתֵּן לַמּוֹט רַגְלֶךָ אַל־יָנוּם שֹׁמְרֶךָ׃"}]]},{"key":"v9l4JjFfdP","he":[[{"t":"הִנֵּה לֹא־יָנוּם וְלֹא יִישָׁן שׁוֹמֵר יִשְׂרָאֵל׃"}]],"en":"Behold, He neither slumbers nor sleeps! the Guardian of Israel."},{"key":"tNtCR_vsEF","he":[[{"t":"יְיָ שֹׁמְרֶךָ יְיָ צִלְּךָ עַל־יַד יְמִינֶךָ׃"}]]},{"key":"CD9Y5L8Z0Z","he":[[{"t":"יוֹמָם הַשֶּׁמֶשׁ לֹא־יַכֶּכָּה וְיָרֵחַ בַּלָּיְלָה׃"}]]},{"key":"NWe8N_KcN7","he":[[{"t":"יְיָ יִשְׁמָרְךָ מִכָּל־רָע יִשְׁמֹר אֶת־נַפְשֶׁךָ׃"}]]},{"key":"no598ViGSd","he":[[{"t":"יְיָ יִשְׁמָר־צֵאתְךָ וּבוֹאֶךָ מֵעַתָּה וְעַד־עוֹלָם׃"}]]},{"key":"F0BSyiihkW.1","he":[[{"t":"הללויה הללו אל בקדשו וכו' עד סופו .","s":"n"}]]},{"key":"HTf_D7evks","he":[[{"t":"הַלְלוּ יָהּ הַלְלוּ־אֵל בְּקָדְשׁוֹ הַלְלוּהוּ בִּרְקִיעַ עֻזּוֹ׃"}]]},{"key":"5oMxA3_pxM","he":[[{"t":"הַלְלוּהוּ בִגְבוּרֹתָיו הַלְלוּהוּ כְּרֹב גֻּדְלוֹ׃"}]]},{"key":"1lpo2wdSY5","he":[[{"t":"הַלְלוּהוּ בְּתֵקַע שׁוֹפָר הַלְלוּהוּ בְּנֵבֶל וְכִנּוֹר׃"}]]},{"key":"2MDlvbQ7dH","he":[[{"t":"הַלְלוּהוּ בְתֹף וּמָחוֹל הַלְלוּהוּ בְּמִנִּים וְעוּגָב׃"}]]},{"key":"I-O44yFEx4","he":[[{"t":"הַלְלוּהוּ בְצִלְצְלֵי־שָׁמַע הַלְלוּהוּ בְּצִלְצְלֵי תְרוּעָה׃"}]]},{"key":"LBd3qfF61s","he":[[{"t":"כֹּל הַנְּשָׁמָה תְּהַלֵּל יָהּ הַלְלוּ־יָהּ׃"}]]}]},{"title":{"he":"סיום","en":"Conclusion"},"segments":[{"key":"F0BSyiihkW.2","he":[[{"t":"וי\"א קול דודי הנה זה בא מדלג על ההרים מקפץ על הגבעות : דומה דודי לצבי או לעפר האילים הנה זה עומד אחר כתלנו משגיח מן החלונות מציץ מן החרכים : וקדיש דרבנן ואומר לחבירו ג\"פ שלום עליכם וילך לביתו בלב טוב כאלו קיבל פני שכינה :","s":"n"}]]}]}],"credits":[{"title":"Blessing of the Moon — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}