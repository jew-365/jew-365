{"nusach":"teiman","id":"birchot_hashachar","sections":[{"title":{"he":"מודה אני","en":"Modeh Ani"},"segments":[{"key":"oKgo4o-xRd","he":[[{"t":"כשיעור משנתו יאמר:","s":"n"}],[{"t":"מוֹדֶה","voice":["male","unset"]},{"t":"מוֹדָה","voice":["female"]},{"t":" [/מוֹדָה]","voice":["unset"]},{"t":" אֲנִי לְפָנֶיךָ מֶלֶךְ חַי וְקַיָּם שֶׁהִחְזַרְתָּ לִי נִשְׁמָתִי בְּחֶמְלָה, רַבָּה אֱמוּנָתֶךָ."}]]}]},{"title":{"he":"ברכות השחר","en":"Morning Blessings"},"segments":[{"key":"NHnl-EfY9M","he":[[{"t":"אחר שיטול ידיו יברך:","s":"n"}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְווֹתָיו וְצִוָנוּ עַל נְטִילַת יָדָיִם."}]]},{"key":"QMYYYi55Bb","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר יָצַר אֶת הָאָדָם בְּחָכְמָה, וּבָרָא בוֹ נְקָבִים נְקָבִים וַחֲלָלִים חֲלָלִים, מֵהֶם סְתוּמִים וּמֵהֶם פְּתוּחִים, שְׁאִם יִסָּתֵם אֶחָד מֵהֶם אוֹ יִפָּתֵחַ, אֵינוּ יָכוֹל לְהִתְקַיֵּם אַפִלּוּ שָׁעָה אַחַת. בָּרוּךְ אַתָּה יְיָ, רוֹפֵא כָל בָּשָׂר וּמַפְלִיא לַעֲשׂוֹת."}]]},{"key":"zm7XAz8xwq","he":[[{"t":"אֱלֹהַי, הַנְּשָׁמָה שֶׁנָּתַתָּ‏ בִּי טְהוֹרָה. אַתָּה בְרָאתָהּ וְאַתָּה יְצַרְתָּהּ, וְאַתָּה נְפַחְתָּהּ בִּי וְאַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי, וְאַתָּה עֲתִיד לִטְּלָהּ מִמֶּנִּי, וְאַתָּה עֲתִיד לְהַחֲזִירָהּ בִּי לָעֲתִיד לָבוֹא. וְכָל זְמָן שֶהַנְּ‏שָׁמָה בְקִרְבִּי, "},{"t":"מוֹדֶה","voice":["male","unset"]},{"t":"מוֹדָה","voice":["female"]},{"t":" אֲנִי לְפָנֶיךָ יְיָ אֱלֹהַי רִבּ‏וֹן כָּ‏ל הַמַּ‏‏עֲשִׂים. בָּרוּךְ אַתָּה יְיָ, הַמַּחֲזִיר נְשָׁמוֹת לִפְגָרִים מֵתִים."}]]},{"key":"elEYws-IhT","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַנּוֹתֵן לַשֶּׂכְוִי בִינָה לְהָבִין בֵּין יוֹם וּבֵין לָיְלָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, פּוֹקֵחַ עִוְרִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, מַתִּיר אֲסוּרִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, מַלְבִּישׁ עֲרֻמִּים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, זוֹקֵף כְּפוּפִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, רוֹקַע הָאָרֶץ עַל הַמָּיִם."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַמֵּכִין מִצְעֲדֵי גָבֶר."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁעָשָׂה לִי כָּל צְרָכָי.","when":{"none":["tishaBav","yomKippur"]}}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אוֹזֵר יִשְׂרָאֵל בִּגְבוּרָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, עוֹטֵר יִשְׂרָאֵל בַּתִּפְאָרָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי "},{"t":"גּוֹי","voice":["male","unset"]},{"t":"גּוֹיָה","voice":["female"]},{"t":" [/גּוֹיָה]","voice":["unset"]},{"t":"."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי "},{"t":"עָבֶד","voice":["male","unset"]},{"t":"שִׁפְחָה","voice":["female"]},{"t":" [/שִׁפְחָה]","voice":["unset"]},{"t":"."}],[{"t":"אנשים מברכים:","s":"n","voice":["male","unset"]},{"t":" בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי אִשָּׁה.","voice":["male","unset"]}],[{"t":"נשים אומרות:","s":"n","voice":["female","unset"]},{"t":" בָּרוּךְ שֶׁעָשַׂנִי כִּרְצוֹנוֹ.","voice":["female","unset"]}]]},{"key":"ZeJno5bZBu","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַמַּעֲבִיר שִׁינָה מֵעֵינֵינוּ וּתְנוּמָה מֵעַפְעַפֵּינוּ. וִיהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁתַּרְגִילֵנוּ לִדְבַר מִצְוָה וְאַל תַּרְגִילֵנוּ לִדְבַר עֲבֵרָה, וְתַשְׁלֶט בָּנוּ יֵצֶר טוֹב וְאַל תַּשְׁלֶט בָּנוּ יֵצֶר רָע. וּתְחַזְּקֵנוּ בְּמִצְוׂתֶיךָ, וְתִתֵּן חֶלְקֵנוּ בְּתוֹרָתֶךָ, וְתִתְּנֵנוּ לְחֵן לְחֶסֶד וּלְרַחֲמִים בְּעֵינֶיךָ וּבְעֵינֵי כָל רוֹאֵינוּ, וְתִגְמְלֵנוּ חֲסָדִים טוֹבִים מִלְּפָנֶיךָ. בָּרוּךְ אַתָּה יְיָ, גּוֹמֵל חֲסָדִים טוֹבִים."}]],"when":{"none":["tishaBav","yomKippur"]}},{"key":"J0Db-wnQyQ","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁתַּצִּילֵנוּ הַיּוֹם הַזֶּה וּבְכָל יוֹם וָיוֹם, מֵעַזֵּי פָנִים, מֵעַזּוּת פָּנִים, מֵאָדָם רָע, מִיֵּצֶר רָע, מֵחָבֵר רָע, מִשָּׁכֵן רָע, מִפֶּגַע רָע, מֵעַיִן הָרַע, מִלְּשׁוֹן הָרַע, מֵעֵדוּת שֶׁקֶר, מִשִּׂנְאַת הַבְּרִיּוֹת, מֵעֲלִילָה, מִמִּיתָה מְשֻׁנָּה, מֵחֳלָאִים רָעִים, מִמִּקְרִים רָעִים, מִגְּזֵרוֹת קָשׁוֹת, מִדִּין קָשֶׁה, מִבַּעַל דִּין קָשֶׁה, בֵּין שְׁהוּא בֶן בְּרִית וּבֵין שְׁאֵינוּ בֶן בְּרִית, וּמִדִּינָהּ שֶׁלְּגֵיהִנָּם."}]]}]},{"title":{"he":"ברכות התורה","en":"Blessings of the Torah"},"segments":[{"key":"6_UklJFQrq","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ עַל דִּבְרֵי תוֹרָה."}]]},{"key":"XjEYGXXYTY","he":[[{"t":"הַעֲרֵב נָא יְיָ אֱלֹהֵינוּ אֶת דִּבְרֵי תוֹרָתְךָ בְּפִינוּ וּבְפִיפִיּוֹת עַמְּךָ כָל בֵּית יִשְׂרָאֵל, וְנִהְיֶה אֲנַחְנוּ וְצֶאֱצָאֵינוּ וְצֶאֱצָאֵי עַמְּךָ כָל בֵּית יִשְׂרָאֵל יוֹדְעֵי שְׁמֶךָ וְלוֹמְדֵי תוֹרָתְךָ לִשְׁמָהּ. בָּרוּךְ אַתָּה יְיָ, נוֹתֵן הַתּוֹרָה."}]]},{"key":"DXNiUHduCP","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר בָּחַר בָּנוּ מִכָּל הָעַמִּים וְנָתַן לָנוּ אֶת תּוֹרָתוֹ. בָּרוּךְ אַתָּה יְיָ, נוֹתֵן הַתּוֹרָה."}]],"en":"Blessed are You, Adonoy our God, King of the Universe Who chose us from among all the peoples and gave us His Torah. Blessed are You, Adonoy, Giver of the Torah!"},{"key":"yi24X2xeAm","he":[[{"t":"וקורין הציבור יחד עם הש\"ץ:","s":"n"}]]},{"key":"6vyR83mrQ7","he":[[{"t":"וַיְדַבֵּר יְיָ אֶל מֹשֶׁה לֵּאמֹר׃ צַו אֶת בְּנֵי יִשְׂרָאֵל וְאָמַרְתָּ אֲלֵהֶם, אֶת קָרְבָּנִי לַחְמִי לְאִשַּׁי רֵיחַ נִיחֹחִי, תִּשְׁמְרוּ לְהַקְרִיב לִי בְּמוֹעֲדוֹ׃ וְאָמַרְתָּ לָהֶם, זֶה הָאִשֶּׁה אֲשֶׁר תַּקְרִיבוּ לַייָ, כְּבָשִׂים בְּנֵי שָׁנָה תְמִימִם, שְׁנַיִם לַיּוֹם עֹלָה תָמִיד׃ אֶת הַכֶּבֶשׂ אֶחָד תַּעֲשֶׂה בַבֹּקֶר, וְאֵת הַכֶּבֶשׂ הַשֵּׁנִי תַּעֲשֶׂה בֵּין הָעַרְבָּיִם׃ וַעֲשִׂירִית הָאֵיפָה סֹלֶת לְמִנְחָה, בְּלוּלָה בְּשֶׁמֶן כָּתִית רְבִיעִת הַהִין׃ עֹלַת תָּמִיד, הָעֲשֻׂיָה בְּהַר סִינַי לְרֵיחַ נִיחֹחַ אִשֶּׁה לַייָ׃ וְנִסְכּוֹ רְבִיעִת הַהִין לַכֶּבֶשׂ הָאֶחָד, בַּקֹּדֶשׁ הַסֵּךְ נֶסֶךְ שֵׁכָר לַייָ׃ וְאֵת הַכֶּבֶשׂ הַשֵּׁנִי תַּעֲשֶׂה בֵּין הָעַרְבָּיִם, כְּמִנְחַת הַבֹּקֶר וּכְנִסְכּוֹ תַּעֲשֶׂה אִשֵּׁה רֵיחַ נִיחֹחַ לַייָ׃"}]],"en":"(Bamidbar 28:1-8) And Adonoy spoke to Moshe to say: Command the Children of Yisrael, and say to them: My offering, My food, to be consumed by My fires, a pleasing aroma to Me, You shall be diligent to bring unto Me, at its fixed time. And you will say to them: “This is the fire-offering that you will bring unto Adonoy: [male] lambs, in their first year, without blemish, two [of them] each day, as a constant burnt-offering. Offer one lamb in the morning, and the second lamb, offer in the afternoon. And a tenth of an ephah of fine flour as a meal-offering, mixed with oil of crushed [olives] measuring one-fourth of a hin. [This is] a constant burnt-offering as offered at Mount Sinai for a pleasing aroma, a fire-offering to Adonoy. And its libation will be a fourth of a hin for the one lamb; in the Holy [Sanctuary] you will pour out a drink-offering of strong wine to Adonoy. And the second lamb you will offer in the afternoon; as the meal-offering of the morning [together] with its libation, you shall offer a fire-offering of pleasing aroma to Adonoy."},{"key":"VZN3AmfUAq","he":[[{"t":"וְעָרְבָה לַייָ מִנְחַת יְהוּדָה וִירוּשָׁלָ͏ִם כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת׃"}]]},{"key":"COcoK6AGh9","he":[[{"t":"וַיְדַבֵּר יְיָ אֶל מֹשֶׁה לֵּאמֹר׃ דַּבֵּר אֶל אַהֲרֹן וְאֶל בָּנָיו לֵאמֹר, כֹּה תְבָרְכוּ אֶת בְּנֵי יִשְׂרָאֵל, אָמוֹר לָהֶם׃ יְבָרֶכְךָ יְיָ וְיִשְׁמְרֶךָ׃ יָאֵר יְיָ פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ׃ יִשָּׂא יְיָ פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃ וְשָׂמוּ אֶת שְׁמִי עַל בְּנֵי יִשְׂרָאֵל, וַאֲנִי אֲבָרְכֵם׃"}]]},{"key":"LGC-pc8OBe","he":[[{"t":"אֵלּוּ דְבָרִים שֶׁאֵין לָהֶם שֵׁעוּר, הַפֵּאָה וְהַבִּכּוּרִים וְהָרֵאָיוֹן וּגְמִילוּת חֲסָדִים וְתַלְמוּד תּוֹרָה. וְאֵלּוּ דְבָרִים שֶׁאָדָם אוֹכֵל פֵּרוֹתֵיהֶן בָּעוֹלָם הַזֶּה, וְהַקֶּרֶן קַיֶּמֶת לוֹ לָעוֹלָם הַבָּא, כִּבּוּד אָב וָאֵם, וּגְמִילוּת חֲסָדִים, וַהֲבָאַת שָׁלוֹם בֵּין אָדָם לַחֲבֵרוֹ, וְתַלְמוּד תּוֹרָה כְּנֶגֶד כֻּלָּן."}]]},{"key":"voWY6kf_nI","he":[[{"t":"אָמַר רִבִּי זֵירָא, בְּנוֹת יִשְׂרָאֵל הֶן הִחְמִירוּ עַל עַצְמָן שֶׁאַפִלּוּ רוֹאוֹת דָּם טִפָּה כַּחַרְדָּל יוֹשְׁבוֹת עָלֶיהָ שִׁבְעַת יְמֵי נְקִיִּם."}],[{"t":"תַּֽנָא דְּבֵי אֵלִיָּהוּ, כָּל הַשּׁוֹנֶה הֲלָכוֹת בְּכָל יוֹם מֻבְטָח לוֹ שְׁהוּא בֶן הָעוֹלָם הַבָּא. שֶׁנֶּאֱמָר: הֲלִיכוֹת עוֹלָם לוֹ. אַל תִּקְרֵי הֲלִיכוֹת, אֵלָא הֲלָכוֹת."}],[{"t":"אָמַר רִבִּי אֶלְעָזָר אָמַר רִבִּי חֲנִינָא, תַּלְמִידֵי חֲכָמִים מַרְבִּים שָׁלוֹם בָּעוֹלָם. שֶׁנֶּאֱמָר: וְכָל בָּנַיִךְ לִמּוּדֵי יְיָ, וְרַב שְׁלוֹם בָּנָיִךְ."}]]}]}],"credits":[{"title":"Siddur Nusach Teiman Baladi, Weekday Shacharit — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3101141"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}