{"nusach":"teiman","id":"birchot_hareiya","sections":[{"title":{"he":"ברכות שבח והודאה","en":"Further Blessings of Praise"},"segments":[{"key":"miV8Y0Y7By","he":[[{"t":"ברכות הראייה והשבח וההודאה: הבונה בית חדש או הקונה כלים חדשים, והרואה את חברו אחר שלשים יום, והלובש בגד חדש, והרואה פרי ופרח חדשים, מברך שהחיינו. ואם ראה את חברו אחר שנה, מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ מְחַיֶּה הַמֵּתִים:"}]]},{"key":"9EJZ7xUjH8","he":[[{"t":"השומע שמועה טובה מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ הַטּוֹב וְהַמֵּטִיב:"}]]},{"key":"25u8CRzzYf","he":[[{"t":"ואם שמע שמועה רעה מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ דַּיָין הָאֱמֶת:"}]]},{"key":"XgSaBX249U","he":[[{"t":"שמע שמת אביו, אם הניח לו ממון, מברך תחילה:","s":"n"},{"t":" דַּייָן הָאֱמֶת "},{"t":"ואחר כך","s":"n"},{"t":" הַטוב וְהַמֵּטִיב "},{"t":"זה כשיש עמו אחים, אבל אם הוא היורש לבדו, מברך שהחיינו.","s":"n"}]]},{"key":"9c2rI6XuNH","he":[[{"t":"כשיורדים גשמים ורבו המים על הארץ, שכשיורדת טיפה נעשית בועה, והבועות שעל פני המים הולכות זו לקראת זו, אם הגיעו לשיעור הזה: אם יש לו שדה משלו מברך שהחיינו, ואם היא בשותפות לו ולאחר מברך הטוב והמטיב, ואם אין לו שדה מברך כך:","s":"n"}]]},{"key":"JR7Jh-941Z","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ יְיָ אֱלֹהֵינוּ עַל כָּל טִיפָּה וְטִיפָּה שֶׁהוֹרַדְתָּ לָנוּ וְאִלּוּ פִינוּ מָלֵא שִׁירָה כַיָּם "},{"t":"וכו' עד","s":"n"},{"t":" וִיבָרְכוּ אֶת שְׁמָךְ יְיָ אֱלֹהֵינוּ בָּרוּךְ אַתָּה יְיָ רוֹב הַהוֹדָאוֹת וְאֵל הַתּוּשְׁבָּחוֹת:"}]]},{"key":"H9TV5uJNWZ","he":[[{"t":"ארבעה צריכים להודות, והם: חולה כשנתרפא, וחבוש כשיצא מבית האסורים, ויורד הים כשהגיע בשלום. וסדר הדבר: עומד לפני עשרה מישראל, לא פחות מזה, ושנים מהם חכמים בהכרח, ואחר כך אומר:","s":"n"}]]},{"key":"kFZTF33LzD","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם הַגּוֹמֵל לַחַיָּבִים טוֹבוֹת שֶׁגְּמָלַנִי טוֹב:"}]]},{"key":"YKfIiSsz1m","he":[[{"t":"וכל השומעים אומרים לו:","s":"n"},{"t":" שֶׁגְּמָלְךָ טוֹב הוּא יִגְמָלְךָ סֶלָה:"}]]},{"key":"FEI41oIK0z","he":[[{"t":"הרואה מקומות שנעשה בהם נס לישראל, כגון ים סוף והירדן וחומת יריחו וכיוצא בהם, יברך","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵינוּ בַּמָּקוֹם הַזֶּה:"}]]},{"key":"iZWA5SxRYV","he":[[{"t":"אבל מקום שנעשה בו נס ליחיד, אין מברך אלא אותו היחיד ובנו ובן בנו, כשמגיע אליו. בעל הנס עצמו אומר:","s":"n"}]]},{"key":"HUI2N7w3ST","he":[[{"t":"בָּאַ\"יְ אֱמֶ\"הָ שֶׁעָשָׂה לִי נֵס בַּמָּקוֹם הַזֶּה:"}]]},{"key":"NyQ-AZoqKK","he":[[{"t":"ואם הוא בנו וכו' אומר:","s":"n"},{"t":" שֶׁעָשָׂה לְאָבִי נֵס בַּמָּקוֹם הַזֶּה:"}]]},{"key":"5yuoPjdVre","he":[[{"t":"הרואה את גוב האריות שהושלך בו דניאל, ואת כבשן האש שהושלכו בו חנניה מישאל ועזריה, מברך:","s":"n"}]]},{"key":"VsR-sFkL8d","he":[[{"t":"בָּאַ\"יְ אֱמֶ\"הָ שֶׁעָשָׂה נֵס לַצַּדִּיקִים בַּמָּקוֹם הַזֶּה:"}]]},{"key":"s1ZqRyUq_o","he":[[{"t":"הרואה מקום שעובדים בו עבודה זרה מברך:","s":"n"}]]},{"key":"SaQ6BCvPzh","he":[[{"t":"בָּאַ\"יְ אֱמֶ\"הָ שֶׁנָּתַן אֶרֶךְ אַפַּיִם לְעוֹבְרֵי רְצוֹנוֹ:"}]]},{"key":"uTuIQFInNi","he":[[{"t":"הרואה מקום שנעקרה ממנו עבודה זרה, אם הוא בארץ ישראל, מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ שֶׁעָקַר עֲבוֹדָה זָרָה מֵאַרְצֵנוּ:"}]]},{"key":"CbYgZOBuFI","he":[[{"t":"ואם הוא בחוצה לארץ מברך:","s":"n"}]]},{"key":"ELQ0Smx5V1","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ שֶׁעָקַר ע\"ז מִן הַמָּקוֹם הַזֶּה: "},{"t":"ובשתיהן מסיים:","s":"n"},{"t":" כְּשֵׁם שֶׁעָקַרְתָּ מִן הַמָּקוֹם הַזֶּה כָּךְ תַּעֲקוֹר מִכָּל הָאֲרָצוֹת וְתָשִׁיב לֵב עוֹבְדֵיהֶן לְעָבְדָךְ:"}]]},{"key":"TRQrGWU5g7","he":[[{"t":"הרואה בתי ישראל בישובם מברך:","s":"n"}]]},{"key":"XnIxu4Vep2","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ מַצִּיב גְּבוּל אַלְמָנָה:"}]]},{"key":"pDvhpNgS8M","he":[[{"t":"ובחורבנם מברך דיין האמת. הרואה בתי הגויים בישובם אומר:","s":"n"},{"t":" בית גאים יסח יְיָ: "},{"t":"ובחורבנם:","s":"n"},{"t":" אֵל נְקָמוֹת יְיָ: "},{"t":"הרואה קברי ישראל מברך:","s":"n"}]]},{"key":"Bhv9PCKJsW","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר יָצַר אֶתְכֶם בַּדִּין וְזָן אֶתְכֶם בַּדִּין וְכִלְכַּל אֶתְכֶם בַּדִּין וְהֵמִית אֶתְכֶם בַּדִּין וַעֲתִיד לַהֲקִימְכֶם לְחַיֵּי הָעוֹלָם הַבָּא בַּדִּין בָּאַ\"יְ מְחַיֶּה הַמֵּתִים:"}]]},{"key":"83o0G7Awl_","he":[[{"t":"הרואה קברי הגויים אומר:","s":"n"}]]},{"key":"9QRt7o9zQN","he":[[{"t":"בּוֹשָׁה אִמְּכֶם מְאֹד חָפְרָה יוֹלַדְתְּכֶם הִנֵּה אַחֲרִית גּוֹיִם מִדְבָּר צִיָּה וַעֲרָבָה:"}]]},{"key":"ijS96uGXDQ","he":[[{"t":"הרואה שש מאות אלף איש יחד: אם הם גויים אומר \"בושה אמכם מאד\", ואם הם ישראל, והם בארץ ישראל דווקא, מברך:","s":"n"}]]},{"key":"BgM6vN2VO3","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם חֲכַם הָרָזִים:"}]]},{"key":"5QM_Jxokod","he":[[{"t":"הרואה חכמי אומות העולם מברך:","s":"n"}]]},{"key":"eqeVkvUTMp","he":[[{"t":"בָּאַ\"יְ אֱמֶ\"הָ שֶׁנָּתַן מֵחָכְמָתוֹ לְבָשָׂר וָדָם:"}]]},{"key":"HKKI0D63aX","he":[[{"t":"והרואה חכמי ישראל מברך:","s":"n"}]]},{"key":"XJAaacXdY-","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ שֶׁנָּתַן מֵחָכְמָתוֹ לִירֵאָיו:"}]]},{"key":"hHUdQialQc","he":[[{"t":"הרואה מלכי ישראל מברך:","s":"n"}]]},{"key":"fAv21UvFBB","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ שֶׁנָּתַן מִכְּבוֹדוֹ לִירֵאָיו:"}]]},{"key":"LuScgh2tTo","he":[[{"t":"ואם הם מלכי הגויים מברך:","s":"n"},{"t":" שֶׁנָּתַן מִכְּבוֹדוֹ לְבָשָׂר וָדָם:"}]]},{"key":"_ZaIiaUeMf","he":[[{"t":"הרואה את הכושים ואת המשונים בצורת פניהם ואבריהם מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ מְשַׁנֶּה הַבְּרִיוֹת:"}]]},{"key":"Z23iFDeCix","he":[[{"t":"הרואה את הסומא ואת הקיטע ואת המצורע ואת הבוהקן וכיוצא בהם, אם היה בהם הדבר מבטן אמם, מברך:","s":"n"},{"t":" בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ מְשַׁנֶּה הַבְּרִיוֹת:"}]]},{"key":"egkdSpF7Yp","he":[[{"t":"ואם נעשה בהם אחר כך, מברך דיין האמת. הרואה את הפיל ואת הקיפוד ואת הקוף מברך:","s":"n"},{"t":" מְשַׁנֶּה הַבְּרִיוֹת:"}]]},{"key":"4PoCAo9qYg","he":[[{"t":"הרואה בריות נאות ביותר ואילנות נאים למראה מברך:","s":"n"},{"t":" בָּאַ\"יְ אֱמֶ\"הָ שֶׁכָּכָה לּוֹ בְּעוֹלָמוֹ:"}]]}]},{"title":{"he":"ברכת האילנות","en":"Trees in Blossom"},"segments":[{"key":"M_dbGDjJ-D","he":[[{"t":"הרואה את הגנות והפרדסים בפריחתם בימי ניסן מברך:","s":"n"}]]},{"key":"QR8wW4B-BU","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁלֹּא חִיסַּר בְּעוֹלָמוֹ כְּלוּם וּבָרָא בוֹ בְּרִיוֹת טוֹבוֹת כְּדֵי לְהִתְנָאוֹת בָּהֶם בְּנֵי אָדָם:"}]]}]},{"title":{"he":"ברק ורעם","en":"Lightning and Thunder"},"segments":[{"key":"ZyI5ztR0h3","he":[[{"t":"על הרוחות החזקות, ועל הברקים והרעמים והזוועות והזיקים, והכוכבים בעלי הזנב הנראים באויר, מברך:","s":"n"}]]},{"key":"izAsX1Djco","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם עוֹשֶׂה בְּרֵאשִׁית: "},{"t":"או","s":"n"},{"t":" שֶׁכֹּחוֹ מָלֵא עוֹלָם:"}]]}]},{"title":{"he":"הרים, ימים ונהרות","en":"Mountains, Seas and Rivers"},"segments":[{"key":"2UUZu4HhLL","he":[[{"t":"על ההרים והגבעות והמדבריות והימים והנהרות, אם ראה אחד מהם אחר שלשים יום, מברך:","s":"n"}]]},{"key":"VygXq1Dqyy","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ עוֹשֶׂה בְּרֵאשִׁית:"}]]}]},{"title":{"he":"הים הגדול","en":"The Great Sea"},"segments":[{"key":"se7btyKeH_","he":[[{"t":"והרואה את הים הגדול אחר שלשים יום או יותר מברך:","s":"n"}]]},{"key":"rZ1tdYrwLr","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ שֶׁעָשָׂה אֶת הַיָּם הַגָּדוֹל:"}]]}]},{"title":{"he":"ברכת החמה","en":"Blessing of the Sun"},"segments":[{"key":"WO3IRCh9go","he":[[{"t":"הרואה את החמה ביום תקופת ניסן, בשנה הראשונה של מחזור התקופה, שהתקופה בה לעולם בליל רביעי, כשרואה את החמה בבוקר אותו היום, מברך:","s":"n"},{"t":" עוֹשֶׂה בְּרֵאשִׁית "},{"t":"וכן שאר שבעת כוכבי הלכת, כשמגיעים למזל טלה ועומדים בנקודת השוויון ואינם נוטים לא לצפון ולא לדרום, מברך כשרואה אותם:","s":"n"}]]},{"key":"yNWI447DFb","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱמֶ\"הָ עוֹשֶׂה בְּרֵאשִׁית:"}]]}]},{"title":{"he":"הקשת","en":"A Rainbow"},"segments":[{"key":"qwIpO3KGpB","he":[[{"t":"הרואה את הקשת בענן מברך:","s":"n"}]]},{"key":"ACSL8vkBFn","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם זוֹכֵר הַבְּרִית נֶאֱמָן בִּבְרִיתוֹ וְקַיָּם בְּמַאֲמָרוֹ:"}]]}]}],"credits":[{"title":"Blessings of Sight and Praise — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"}]}