{"nusach":"teiman","id":"shacharit","sections":[{"title":{"he":"מודה אני","en":"Modeh Ani"},"chapter":{"he":"ברכות השחר","en":"Morning Blessings"},"segments":[{"key":"oKgo4o-xRd","he":[[{"t":"כשיעור משנתו יאמר:","s":"n"}],[{"t":"מוֹדֶה","voice":["male","unset"]},{"t":"מוֹדָה","voice":["female"]},{"t":" [/מוֹדָה]","voice":["unset"]},{"t":" אֲנִי לְפָנֶיךָ מֶלֶךְ חַי וְקַיָּם שֶׁהִחְזַרְתָּ לִי נִשְׁמָתִי בְּחֶמְלָה, רַבָּה אֱמוּנָתֶךָ."}]]}]},{"title":{"he":"ברכות השחר","en":"Morning Blessings"},"segments":[{"key":"NHnl-EfY9M","he":[[{"t":"אחר שיטול ידיו יברך:","s":"n"}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְווֹתָיו וְצִוָנוּ עַל נְטִילַת יָדָיִם."}]]},{"key":"HgVijAKH_C","he":[[{"t":"ואם עשה צרכיו מברך אשר יצר ומסמיך לה אלהי הנשמה. ועכשיו נהגו לסדר כל הברכות בבית הכנסת, חוץ מברכת נטילת ידים שמברכה כל אחד בביתו סמוך לנטילה. ומתחיל ש\"ץ בנועם ואומר:","s":"n"}]]},{"key":"1cXHg41k8i","he":[[{"t":"אֲדוֹן הָעוֹלָמִים"}],[{"t":"בַּעַל הָרַחֲמִים גְּדוֹל הָעֵצָה"}],[{"t":"דַּרְכּוֹ נַעֲרָצָה הַנּוֹטֶה שְׁחָקִים"}],[{"t":"וְהַיּוֹסֵד אֲרָקִים זֹהַר הָעוֹלָם"}],[{"t":"חוֹפֵשׂ כָּל נֶעְלָם טוֹב לַקּוֹרְאִים"}],[{"t":"יְסוֹד הַנִּבְרָאִים כְּבוֹדוֹ הַנִּפְלָא"}],[{"t":"לַלֵּב נִגְלָה מְרוֹמַם עַל כָּל בְּרָכָה וּתְהִלָּה"}],[{"t":"נוֹרָא עֲלִילָה סוֹמֵך נוֹפְלִים"}],[{"t":"עוֹנֶה מִתְפַּלְּלִים פּוֹדֶה עֲשׁוּקִים"}],[{"t":"צוֹפֶה מַעֲמַקִּים קוֹרֵא הַדּוֹרוֹת"}],[{"t":"רוֹכֵב עֲרָבוֹת שׁוֹמֵעַ תְּפִלּוֹת"}],[{"t":"תְּמִים הַפְּעֻלּוֹת."}]]},{"key":"ZABBVLMWNV","he":[[{"t":"שְׁמַע יְיָ קוֹלִי בְשִׂיחִי, בְּהִתְעַטֵּף לְפָנֶיךָ רוּחִי וְנִשְׁמָתִי, וְתִפָּל נָא תְחִנָּתֵנוּ לְפָנֶיךָ, וְתִשְׁמַע צַעֲקָתֵנוּ מִמְּעוֹנֶךָ, וְתִהְיֶה תְפִלָּתֵנוּ רְצוּיָה לְפָנֶיךָ, כִּקְטֹרֶת סַמִּים עַל מִזְבְּחֶךָ."}]]},{"key":"c6kC1hmmuc","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי, לְטַהֵר מַעַרְכֵי רַעְיוֹנִי, וּלְכוֹנֵן מַעֲנֵה לְשׁוֹנִי, וְתַחְשְׂכֵנִי מִזְּדוֹנוֹת, וּתְנַקֵּנִי מִשִּׁגְיוֹנוֹת, וְתִמְחֹל לִי כָּל עֲו‍ֹנוֹת. וְתִהְיֶה עִם לְבָבִי בְּעֵת מַחֲשָׁבִי, וְעִם פִּי בְּעֵת הַטִּיפִי, וְעִם יָדִי בְּעֵת מַעֲבָדִי, וְעִם רַגְלִי בְּעֵת הִלּוּכִי. וְאַל אוֹמַר לְפָנֶיךָ דָּבָר שֶׁלֹּא כִרְצוֹנָךְ, וּגְעַר בַּשָּׂטָן וְאַל יַבְהִילֵנִי, וּבְיֵצֶר הָרָע וְאַל יַכְשִׁילֵנִי. וְהָאֵר פָּנֶיךָ אֵלַי, וְנָתַתָּ מִהוֹדְךָ עָלַי. וְקַבֵּל תְּחִנָּתִי, וּרְצֵה בְּהִשְׁתַּחֲוָיָתִי, וְעָזְרֵנִי עַל דְּבַר כְּבוֹד שְׁמֶךָ וְחָנֵּנִי. בְּזֹאת אֵדַע כִּי עָשִׂיתָ עִמָּדִי חֶסֶד וְכִי חָפַצְתָּ בִּי וַתַּצִּיבֵנִי לַעֲמֹד לְפָנֶיךָ לְעוֹלָם. יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ, יְיָ צוּרִי וְגֹאֲלִי׃"}]]},{"key":"QMYYYi55Bb","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר יָצַר אֶת הָאָדָם בְּחָכְמָה, וּבָרָא בוֹ נְקָבִים נְקָבִים וַחֲלָלִים חֲלָלִים, מֵהֶם סְתוּמִים וּמֵהֶם פְּתוּחִים, שְׁאִם יִסָּתֵם אֶחָד מֵהֶם אוֹ יִפָּתֵחַ, אֵינוּ יָכוֹל לְהִתְקַיֵּם אַפִלּוּ שָׁעָה אַחַת. בָּרוּךְ אַתָּה יְיָ, רוֹפֵא כָל בָּשָׂר וּמַפְלִיא לַעֲשׂוֹת."}]]},{"key":"zm7XAz8xwq","he":[[{"t":"אֱלֹהַי, הַנְּשָׁמָה שֶׁנָּתַתָּ‏ בִּי טְהוֹרָה. אַתָּה בְרָאתָהּ וְאַתָּה יְצַרְתָּהּ, וְאַתָּה נְפַחְתָּהּ בִּי וְאַתָּה מְשַׁמְּרָהּ בְּקִרְבִּי, וְאַתָּה עֲתִיד לִטְּלָהּ מִמֶּנִּי, וְאַתָּה עֲתִיד לְהַחֲזִירָהּ בִּי לָעֲתִיד לָבוֹא. וְכָל זְמָן שֶהַנְּ‏שָׁמָה בְקִרְבִּי, "},{"t":"מוֹדֶה","voice":["male","unset"]},{"t":"מוֹדָה","voice":["female"]},{"t":" אֲנִי לְפָנֶיךָ יְיָ אֱלֹהַי רִבּ‏וֹן כָּ‏ל הַמַּ‏‏עֲשִׂים. בָּרוּךְ אַתָּה יְיָ, הַמַּחֲזִיר נְשָׁמוֹת לִפְגָרִים מֵתִים."}]]},{"key":"elEYws-IhT","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַנּוֹתֵן לַשֶּׂכְוִי בִינָה לְהָבִין בֵּין יוֹם וּבֵין לָיְלָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, פּוֹקֵחַ עִוְרִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, מַתִּיר אֲסוּרִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, מַלְבִּישׁ עֲרֻמִּים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, זוֹקֵף כְּפוּפִים."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, רוֹקַע הָאָרֶץ עַל הַמָּיִם."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַמֵּכִין מִצְעֲדֵי גָבֶר."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁעָשָׂה לִי כָּל צְרָכָי.","when":{"none":["tishaBav","yomKippur"]}}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אוֹזֵר יִשְׂרָאֵל בִּגְבוּרָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, עוֹטֵר יִשְׂרָאֵל בַּתִּפְאָרָה."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי "},{"t":"גּוֹי","voice":["male","unset"]},{"t":"גּוֹיָה","voice":["female"]},{"t":" [/גּוֹיָה]","voice":["unset"]},{"t":"."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי "},{"t":"עָבֶד","voice":["male","unset"]},{"t":"שִׁפְחָה","voice":["female"]},{"t":" [/שִׁפְחָה]","voice":["unset"]},{"t":"."}],[{"t":"אנשים מברכים:","s":"n","voice":["male","unset"]},{"t":" בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא עָשַׂנִי אִשָּׁה.","voice":["male","unset"]}],[{"t":"נשים אומרות:","s":"n","voice":["female","unset"]},{"t":" בָּרוּךְ שֶׁעָשַׂנִי כִּרְצוֹנוֹ.","voice":["female","unset"]}]]},{"key":"ZeJno5bZBu","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַמַּעֲבִיר שִׁינָה מֵעֵינֵינוּ וּתְנוּמָה מֵעַפְעַפֵּינוּ. וִיהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁתַּרְגִילֵנוּ לִדְבַר מִצְוָה וְאַל תַּרְגִילֵנוּ לִדְבַר עֲבֵרָה, וְתַשְׁלֶט בָּנוּ יֵצֶר טוֹב וְאַל תַּשְׁלֶט בָּנוּ יֵצֶר רָע. וּתְחַזְּקֵנוּ בְּמִצְוׂתֶיךָ, וְתִתֵּן חֶלְקֵנוּ בְּתוֹרָתֶךָ, וְתִתְּנֵנוּ לְחֵן לְחֶסֶד וּלְרַחֲמִים בְּעֵינֶיךָ וּבְעֵינֵי כָל רוֹאֵינוּ, וְתִגְמְלֵנוּ חֲסָדִים טוֹבִים מִלְּפָנֶיךָ. בָּרוּךְ אַתָּה יְיָ, גּוֹמֵל חֲסָדִים טוֹבִים."}]],"when":{"none":["tishaBav","yomKippur"]}},{"key":"J0Db-wnQyQ","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁתַּצִּילֵנוּ הַיּוֹם הַזֶּה וּבְכָל יוֹם וָיוֹם, מֵעַזֵּי פָנִים, מֵעַזּוּת פָּנִים, מֵאָדָם רָע, מִיֵּצֶר רָע, מֵחָבֵר רָע, מִשָּׁכֵן רָע, מִפֶּגַע רָע, מֵעַיִן הָרַע, מִלְּשׁוֹן הָרַע, מֵעֵדוּת שֶׁקֶר, מִשִּׂנְאַת הַבְּרִיּוֹת, מֵעֲלִילָה, מִמִּיתָה מְשֻׁנָּה, מֵחֳלָאִים רָעִים, מִמִּקְרִים רָעִים, מִגְּזֵרוֹת קָשׁוֹת, מִדִּין קָשֶׁה, מִבַּעַל דִּין קָשֶׁה, בֵּין שְׁהוּא בֶן בְּרִית וּבֵין שְׁאֵינוּ בֶן בְּרִית, וּמִדִּינָהּ שֶׁלְּגֵיהִנָּם."}]]}]},{"title":{"he":"ברכות התורה","en":"Blessings of the Torah"},"segments":[{"key":"4UethBs42B","he":[[{"t":"רִבּוֹן הָעוֹלָמִים, אֱלֹהֵי הָאֱלֹהִים וַאֲדֹנֵי הָאֲדֹנִים, אַתָּה צִוִּיתָנוּ לְהַקְרִיב קָרְבַּן הַתָּמִיד בְּמוֹעֲדוֹ, וְלִהְיוֹת כֹּהֲנִים בַּעֲבוֹדָתָם וּלְוִיִּים בְּדוּכָנָם וְיִשְׂרָאֵל בְּמַעֲמָדָם. וְעַתָּה בַּעֲוֹנֹתֵינוּ חָרַב בֵּית הַמִּקְדָּשׁ וּבֻטַּל הַתָּמִיד, וְאֵין לָנוּ לֹא כֹהֵן בַּעֲבוֹדָתוֹ וְלֹא לֵוִי בְּדוּכָנוֹ וְלֹא יִשְׂרָאֵל בְּמַעֲמָדוֹ. וְאַתָּה אָמַרְתָּ וּנְשַׁלְּמָה פָּרִים שְׂפָתֵינוּ. לָכֵן יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁיְּהֵא שִׂיחַ שִׂפְתוֹתֵינוּ זֶה חָשׁוּב וּמְקֻבָּל וּמְרֻצֶּה לְפָנֶיךָ כְּאִלּוּ הִקְרַבְנוּ קָרְבָּן הַתָּמִיד בְּמוֹעֲדוֹ וְעָמַדְנוּ עַל מַעֲמָדוֹ."}],[{"t":"וְנֶאֱמָר: וְשָׁחַט אֹתוֹ עַל יֶרֶךְ הַמִּזְבֵּחַ צָפֹנָה לִפְנֵי יְיָ, וְזָרְקוּ בְּנֵי אַהֲרֹן הַכֹּהֲנִים אֶת דָּמוֹ עַל הַמִּזְבֵּחַ סָבִיב׃ וְנִתַּח אֹתוֹ לִנְתָחָיו וְאֶת רֹאשׁוֹ וְאֶת פִּדְרוֹ, וְעָרַךְ הַכֹּהֵן אֹתָם עַל הָעֵצִים אֲשֶׁר עַל הָאֵשׁ אֲשֶׁר עַל הַמִּזְבֵּחַ׃ וְהַקֶּרֶב וְהַכְּרָעַיִם יִרְחַץ בַּמָּיִם, וְהִקְרִיב הַכֹּהֵן אֶת הַכֹּל וְהִקְטִיר הַמִּזְבֵּחָה, עֹלָה הוּא אִשֵּׁה רֵיחַ נִיחֹחַ לַייָ׃"}],[{"t":"וְנֶאֱמָר: זֹאת הַתּוֹרָה לָעֹלָה לַמִּנְחָה וְלַחַטָּאת וְלָאָשָׁם וְלַמִּלּוּאִים וּלְזֶבַח הַשְּׁלָמִים׃"}]]},{"key":"6_UklJFQrq","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ עַל דִּבְרֵי תוֹרָה."}]]},{"key":"XjEYGXXYTY","he":[[{"t":"הַעֲרֵב נָא יְיָ אֱלֹהֵינוּ אֶת דִּבְרֵי תוֹרָתְךָ בְּפִינוּ וּבְפִיפִיּוֹת עַמְּךָ כָל בֵּית יִשְׂרָאֵל, וְנִהְיֶה אֲנַחְנוּ וְצֶאֱצָאֵינוּ וְצֶאֱצָאֵי עַמְּךָ כָל בֵּית יִשְׂרָאֵל יוֹדְעֵי שְׁמֶךָ וְלוֹמְדֵי תוֹרָתְךָ לִשְׁמָהּ. בָּרוּךְ אַתָּה יְיָ, נוֹתֵן הַתּוֹרָה."}]]},{"key":"DXNiUHduCP","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר בָּחַר בָּנוּ מִכָּל הָעַמִּים וְנָתַן לָנוּ אֶת תּוֹרָתוֹ. בָּרוּךְ אַתָּה יְיָ, נוֹתֵן הַתּוֹרָה."}]],"en":"Blessed are You, Adonoy our God, King of the Universe Who chose us from among all the peoples and gave us His Torah. Blessed are You, Adonoy, Giver of the Torah!"},{"key":"yi24X2xeAm","he":[[{"t":"וקורין הציבור יחד עם הש\"ץ:","s":"n"}]]},{"key":"6vyR83mrQ7","he":[[{"t":"וַיְדַבֵּר יְיָ אֶל מֹשֶׁה לֵּאמֹר׃ צַו אֶת בְּנֵי יִשְׂרָאֵל וְאָמַרְתָּ אֲלֵהֶם, אֶת קָרְבָּנִי לַחְמִי לְאִשַּׁי רֵיחַ נִיחֹחִי, תִּשְׁמְרוּ לְהַקְרִיב לִי בְּמוֹעֲדוֹ׃ וְאָמַרְתָּ לָהֶם, זֶה הָאִשֶּׁה אֲשֶׁר תַּקְרִיבוּ לַייָ, כְּבָשִׂים בְּנֵי שָׁנָה תְמִימִם, שְׁנַיִם לַיּוֹם עֹלָה תָמִיד׃ אֶת הַכֶּבֶשׂ אֶחָד תַּעֲשֶׂה בַבֹּקֶר, וְאֵת הַכֶּבֶשׂ הַשֵּׁנִי תַּעֲשֶׂה בֵּין הָעַרְבָּיִם׃ וַעֲשִׂירִית הָאֵיפָה סֹלֶת לְמִנְחָה, בְּלוּלָה בְּשֶׁמֶן כָּתִית רְבִיעִת הַהִין׃ עֹלַת תָּמִיד, הָעֲשֻׂיָה בְּהַר סִינַי לְרֵיחַ נִיחֹחַ אִשֶּׁה לַייָ׃ וְנִסְכּוֹ רְבִיעִת הַהִין לַכֶּבֶשׂ הָאֶחָד, בַּקֹּדֶשׁ הַסֵּךְ נֶסֶךְ שֵׁכָר לַייָ׃ וְאֵת הַכֶּבֶשׂ הַשֵּׁנִי תַּעֲשֶׂה בֵּין הָעַרְבָּיִם, כְּמִנְחַת הַבֹּקֶר וּכְנִסְכּוֹ תַּעֲשֶׂה אִשֵּׁה רֵיחַ נִיחֹחַ לַייָ׃"}]],"en":"(Bamidbar 28:1-8) And Adonoy spoke to Moshe to say: Command the Children of Yisrael, and say to them: My offering, My food, to be consumed by My fires, a pleasing aroma to Me, You shall be diligent to bring unto Me, at its fixed time. And you will say to them: “This is the fire-offering that you will bring unto Adonoy: [male] lambs, in their first year, without blemish, two [of them] each day, as a constant burnt-offering. Offer one lamb in the morning, and the second lamb, offer in the afternoon. And a tenth of an ephah of fine flour as a meal-offering, mixed with oil of crushed [olives] measuring one-fourth of a hin. [This is] a constant burnt-offering as offered at Mount Sinai for a pleasing aroma, a fire-offering to Adonoy. And its libation will be a fourth of a hin for the one lamb; in the Holy [Sanctuary] you will pour out a drink-offering of strong wine to Adonoy. And the second lamb you will offer in the afternoon; as the meal-offering of the morning [together] with its libation, you shall offer a fire-offering of pleasing aroma to Adonoy."},{"key":"VZN3AmfUAq","he":[[{"t":"וְעָרְבָה לַייָ מִנְחַת יְהוּדָה וִירוּשָׁלָ͏ִם כִּימֵי עוֹלָם וּכְשָׁנִים קַדְמֹנִיּוֹת׃"}]]},{"key":"COcoK6AGh9","he":[[{"t":"וַיְדַבֵּר יְיָ אֶל מֹשֶׁה לֵּאמֹר׃ דַּבֵּר אֶל אַהֲרֹן וְאֶל בָּנָיו לֵאמֹר, כֹּה תְבָרְכוּ אֶת בְּנֵי יִשְׂרָאֵל, אָמוֹר לָהֶם׃ יְבָרֶכְךָ יְיָ וְיִשְׁמְרֶךָ׃ יָאֵר יְיָ פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ׃ יִשָּׂא יְיָ פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃ וְשָׂמוּ אֶת שְׁמִי עַל בְּנֵי יִשְׂרָאֵל, וַאֲנִי אֲבָרְכֵם׃"}]]},{"key":"LGC-pc8OBe","he":[[{"t":"אֵלּוּ דְבָרִים שֶׁאֵין לָהֶם שֵׁעוּר, הַפֵּאָה וְהַבִּכּוּרִים וְהָרֵאָיוֹן וּגְמִילוּת חֲסָדִים וְתַלְמוּד תּוֹרָה. וְאֵלּוּ דְבָרִים שֶׁאָדָם אוֹכֵל פֵּרוֹתֵיהֶן בָּעוֹלָם הַזֶּה, וְהַקֶּרֶן קַיֶּמֶת לוֹ לָעוֹלָם הַבָּא, כִּבּוּד אָב וָאֵם, וּגְמִילוּת חֲסָדִים, וַהֲבָאַת שָׁלוֹם בֵּין אָדָם לַחֲבֵרוֹ, וְתַלְמוּד תּוֹרָה כְּנֶגֶד כֻּלָּן."}]]},{"key":"voWY6kf_nI","he":[[{"t":"אָמַר רִבִּי זֵירָא, בְּנוֹת יִשְׂרָאֵל הֶן הִחְמִירוּ עַל עַצְמָן שֶׁאַפִלּוּ רוֹאוֹת דָּם טִפָּה כַּחַרְדָּל יוֹשְׁבוֹת עָלֶיהָ שִׁבְעַת יְמֵי נְקִיִּם."}],[{"t":"תַּֽנָא דְּבֵי אֵלִיָּהוּ, כָּל הַשּׁוֹנֶה הֲלָכוֹת בְּכָל יוֹם מֻבְטָח לוֹ שְׁהוּא בֶן הָעוֹלָם הַבָּא. שֶׁנֶּאֱמָר: הֲלִיכוֹת עוֹלָם לוֹ. אַל תִּקְרֵי הֲלִיכוֹת, אֵלָא הֲלָכוֹת."}],[{"t":"אָמַר רִבִּי אֶלְעָזָר אָמַר רִבִּי חֲנִינָא, תַּלְמִידֵי חֲכָמִים מַרְבִּים שָׁלוֹם בָּעוֹלָם. שֶׁנֶּאֱמָר: וְכָל בָּנַיִךְ לִמּוּדֵי יְיָ, וְרַב שְׁלוֹם בָּנָיִךְ."}]]}]},{"title":{"he":"לעולם יהא אדם","en":"Accepting the Kingship of Heaven"},"segments":[{"key":"qJoJaOkjQZ","he":[[{"t":"לְעוֹלָם יְהֶא אָדָם יְרֵא שָׁמַיִם בַּסֵּתֶר, וּמוֹדֶה עַל הָאֱמֶת, וְדוֹבֵר אֱמֶת בִּלְבָבוֹ. יַשְׁכִּים וְיֹאמַר: רִבּוֹן כָּל הָעוֹלָמִים לֹא עַל צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ, כִּי עַל רַחֲמֶיךָ הָרַבִּים. מַה אָנוּ, מַה חַיֵּינוּ, מַה חַסְדֵּנוּ, מַה צִּדְקֵנוּ, מַה מַּעֲשֵׂינוּ. מַה נֹּאמַר לְפָנֶיךָ יְיָ אֱלֹהֵינוּ. הֲלֹא הַגִּבּוֹרִים כְּאַיִן לְפָנֶיךָ, וְאַנְשֵׁי הַשֵּׁם כְּלֹא הָיוּ, וַחֲכָמִים כִּבְלִי מַדָּע, וּנְבוֹנִים כִּבְלִי הַשְׂכֵּל, כִּי רֹב מַעֲשֵׂינוּ תֹהוּ וִימֵי חַיֵּינוּ הֶבֶל לְפָנֶיךָ. כְּמוֹ שֶׁכָּתוּב בְּדִבְרֵי קָדְשְׁךָ: וּמוֹתַר הָאָדָם מִן הַבְּהֵמָה אָיִן כִּי הַכֹּל הָבֶל. לְבַד הַנְּשָׁמָה הַטְּהוֹרָה שֶׁהִיא עֲתִידָה לִתֵּן דִּין וְחֶשְׁבּוֹן לִפְנֵי כִסֵּא כְבוֹדֶךָ. וְכָל הַגּוֹיִם כְּאַיִן נֶגְדֶּךָ, שֶׁנֶּאֱמָר: הֵן גּוֹיִם כְּמַר מִדְּלִי וּכְשַׁחַק מֹאזְנַיִם נֶחְשָׁבוּ, הֵן אִיִּים כַּדַּק יִטּוֹל."}]]},{"key":"3vgBjUtqZV","he":[[{"t":"אֲבָל אֲנַחְנוּ עַמְּךָ בְּנֵי בְרִיתֶךָ, בְּנֵי אַבְרָהָם אֹהֲבֶךָ שֶׁנִּשְׁבַּעְתָּ לּוֹ בְּהַר הַמּוֹרִיָּה, זֶרַע יִצְחָק עֲקִדְךָ שֶׁנֶּעְקָד עַל גַּבֵּי מִזְבְּחֶךָ, עֲדַת יַעֲקֹב בִּנְךָ בְכוֹרֶךָ, שֶׁמֵּאַהֲבָתְךָ שֶׁאָהַבְתָּ אוֹתוֹ וּמִשִּׂמְחָתְךָ שֶׁשָּׂמַחְתָּ בּוֹ קָרָאתָ אוֹתוֹ יִשְׂרָאֵל וִישֻׁרוּן."}]]},{"key":"9mvNq_61i8","he":[[{"t":"לְפִיכָּךְ אָנוּ חַיָּבִים לְהוֹדוֹת לְךָ, וּלְשַׁבְּחֶךָ וּלְפָאֲרֶךָ וְלִתֶּן הוֹדָאָה וּשְׁבָח לִשְׁמֶךָ. וְחַיָּבִים אָנוּ לוֹמַר לְפָנֶיךָ בְּכָל יוֹם עֶרֶב וָבֹקֶר: שְׁמַע יִשְׂרָאֵל, יְיָ אֱלֹהֵינוּ, יְיָ אֶחָד. אַשְׁרֵינוּ, מַה טּוֹב חֶלְקֵנוּ, מַה נָּעִים גּוֹרָלֵנוּ, מַה יָּפָה מְאֹד יְרֻשָּׁתֵנוּ. אַשְּׁרֵנוּ שֶׁאָנוּ מַשְׁכִּימִים וּמַעֲרִיבִים וְאוֹמְרִים: שְׁמַע יִשְׂרָאֵל, יְיָ אֱלֹהֵינוּ, יְיָ אֶחָד."}]]},{"key":"-e_RAUc6GG","he":[[{"t":"אַתָּה הוּא קוֹדֵם שֶׁנִּבְרָא הָעוֹלָם, אַתָּה הוּא אַחַר שֶׁנִּבְרָא הָעוֹלָם. אַתָּה הוּא אֵל בָּעוֹלָם הַזֶּה, וְאַתָּה הוּא אֵל לְעוֹלָם הַבָּא. אַתָּה הוּא רִאשׁוֹן וְאַתָּה הוּא אַחֲרוֹן. קַדֵּשׁ אֶת שְׁמָךְ הַגָּדוֹל וְהַקָּדוֹשׁ בְּעוֹלָמָךְ, וּבִישׁוּעָתְךָ תָּרוּם וְתַגְבִּיהַּ קַרְנֵנוּ, בָּרוּךְ מְקַדֵּשׁ שְׁמוֹ בָּרַבִּים."}]]},{"key":"VPI6xZ6nkF","he":[[{"t":"אַתָּה הוּא יְיָ לְבַדֶּךָ, אַתָּה עָשִׂיתָ אֶת הַשָּׁמַיִם, שְׁמֵי הַשָּׁמַיִם וְכָל צְבָאָם, הָאָרֶץ וְכָל אֲשֶׁר עָלֶיהָ, הַיַּמִּים וְכָל אֲשֶׁר בָּהֶם, וְאַתָּה מְחַיֶּה אֶת כֻּלָּם, וּצְבָא הַשָּׁמַיִם לְךָ מִשְׁתַּחֲוִים: אַתָּה הוּא יְיָ הָאֱלֹהִים אֲשֶׁר בָּחַרְתָּ בְּאַבְרָם וְהוֹצֵאתוֹ מֵאוּר כַּשְׂדִּים, וְשַׂמְתָּ שְּׁמוֹ אַבְרָהָם:"}],[{"t":"וְאַתָּה־הוּא וּשְׁנוֹתֶיךָ לֹא יִתָּמּוּ׃"}],[{"t":"יְיָ מֶלֶךְ. יְיָ מָלָךְ. יְיָ יִמְלֹךְ לְעֹלָם וָעֶד׃"}],[{"t":"בָּרוּךְ יְיָ לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"עטיפת טלית והנחת תפילין","en":"Tallit and Tefillin"},"chapter":{"he":"עטיפת טלית והנחת תפילין","en":"Tallit and Tefillin"},"segments":[{"key":"cv_fRO8F_I","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לְהִתְעַטֵּף בַּצִּיצִית.","voice":["male","unset"]}]],"when":{"none":["tishaBav"]},"en":"Blessed are You, Adonoy our God, King of the Universe, Who sanctified us with His commandments and commanded us to enwrap ourselves with tzitzis."},{"key":"a8iL30c3nR","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו, וְצִוָּנוּ לְהָנִיחַ תְּפִלִּין.","voice":["male","unset"]}]],"when":{"none":["tishaBav","cholHamoedPesach","cholHamoedSukkot"]},"en":"Blessed are You, Adonoy our God, King of the Universe, Who sanctified us with His commandments and commanded us to put on tefillin."},{"key":"CIhVN41cmi","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו, וְצִוָּנוּ עַל מִצְוַת תְּפִלִּין.","voice":["male","unset"]}]],"when":{"none":["tishaBav","cholHamoedPesach","cholHamoedSukkot"]},"en":"Blessed are You, Adonoy our God, King of the Universe, Who sanctified us with His commandments, and commanded us concerning the mitzvoh of tefillin."}]},{"title":{"he":"פסוקי דזמרה","en":"Pesukei Dezimra"},"chapter":{"he":"פסוקי דזמרה","en":"Pesukei Dezimra"},"segments":[{"key":"_UyxRNGw6m","he":[[{"t":"הַמְהֻלָּל לְעוֹלָם וּלְעוֹלְמֵי עוֹלָמִים, אָנוּ עֲבָדֶיךָ לְךָ מוֹדִים יוֹדְעִים וּמְעִידִים וּמַגִּידִים: שְׁאֵין אֱלוֹהַּ בִּלְתָּךְ וְאֵין אֱלוֹהַּ זוּלָתָךְ וְאֵין אֱלוֹהַּ כְּעֶרְכָּךְ וְאֵין אֱלוֹהַּ כַּיּוֹצֶא בָךְ וְאֵין אֱלוֹהַּ אֵלָא אַתָּה לְבַדֶּךָ כַּכָּתוּב בְּתוֹרָתֶךָ: אַתָּה הׇרְאֵתָ לָדַעַת כִּי יְיָ הוּא הָאֱלֹהִים, אֵין עוֹד מִלְּבַדּוֹ׃"}]]},{"key":"EU5vRk0_MA","he":[[{"t":"בָּרוּךְ שֶׁאָמַר וְהָיָה הָעוֹלָם."}],[{"t":"בָּרוּךְ הוּא."}],[{"t":"בָּרוּךְ אוֹמֵר וְעֹשֶׂה."}],[{"t":"בָּרוּךְ גּוֹזֵר וּמְקַיֵּם."}],[{"t":"בָּרוּךְ מוֹשִׁיעַ וּמְרַחֵם."}],[{"t":"בָּרוּךְ מְרַחֵם עַל הָאָרֶץ."}],[{"t":"בָּרוּךְ מְרַחֵם עַל הַבְּרִיּוֹת."}],[{"t":"בָּרוּךְ מַעֲבִיר אֲפֵלָה וּמֵבִיא אוֹרָה."}],[{"t":"בָּרוּךְ מְשַׁלֵּם שָׂכָר טוֹב לִירֵאָיו."}],[{"t":"בָּרוּךְ שֶׁאֵין לְפָנָיו לֹא עַוְלָה וְלֹא שִׁכְחָה, לֹא כָזָב וְלֹא מִרְמָה, לֹא מַשּׂוֹא פָנִים וְלֹא מִקַּח שֹׁחַד."}],[{"t":"בָּרוּךְ אֵל חַי לָעַד וְקַיָּם לָנֶצַח."}],[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הָאֵל הַמְהֻלָּל בְּפִי עַמּוֹ, מְשֻׁבָּח וּמְפֹאָר בִּלְשׁוֹן כָּל חֲסִידָיו וַעֲבָדָיו, וּבְשִׁירֵי דָוִד בֶּן יִשַׁי עַבְדְּךָ מְשִׁיחֶךָ נְהַלֶּלְךָ יְיָ אֱלֹהֵינוּ בִּשְׁבָחוֹ וּבִזְמִירוֹ, נוֹדָךְ וּנְשַׁבְּחָךְ, נְפָאֲרָךְ, נַמְלִיכָךְ וְנַזְכִּיר שְׁמָךְ מַלְכֵּנוּ אֱלֹהֵינוּ יַחַד יָחִיד חַי הָעוֹלָמִים, מְשֻׁבָּח וּמְפֹאָר עֲדֵי עַד שְׁמוֹ. בָּרוּךְ אַתָּה יְיָ, מֶלֶךְ מְהֻלָּל בַּתֻּשְׁבָּחוֹת."}]]},{"key":"d_QOZWgiP6","he":[[{"t":"מִזְמוֹר לְתוֹדָה, הָרִיעוּ לַייָ כָּל הָאָרֶץ׃"}],[{"t":"עִבְדוּ אֶת יְיָ בְּשִׂמְחָה, בֹּאוּ לְפָנָיו בִּרְנָנָה׃"}],[{"t":"דְּעוּ כִּי יְיָ הוּא אֱלֹהִים, הוּא עָשָׂנוּ וְלוֹ אֲנַחְנוּ, עַמּוֹ וְצֹאן מַרְעִיתוֹ׃"}],[{"t":"בֹּאוּ שְׁעָרָיו בְּתוֹדָה, חֲצֵרֹתָיו בִּתְהִלָּה, הוֹדוּ לוֹ בָּרְכוּ שְׁמוֹ׃"}],[{"t":"כִּי טוֹב יְיָ לְעוֹלָם חַסְדּוֹ, וְעַד דֹּר וָדֹר אֱמוּנָתוֹ׃"}]]},{"key":"-nRMG4dWrF","he":[[{"t":"יְהִי כְבוֹד יְיָ לְעוֹלָם יִשְׂמַח יְיָ בְּמַעֲשָׂיו׃"}],[{"t":"יְהִי שֵׁם יְיָ מְבֹרָךְ מֵעַתָּה וְעַד־עוֹלָם׃"}],[{"t":"מִמִּזְרַח־שֶׁמֶשׁ עַד־מְבוֹאוֹ מְהֻלָּל שֵׁם יְיָ׃"}],[{"t":"רָם עַל־כָּל־גּוֹיִם יְיָ עַל הַשָּׁמַיִם כְּבוֹדוֹ׃׃"}],[{"t":"יְיָ שִׁמְךָ לְעוֹלָם יְיָ זִכְרְךָ לְדֹר־וָדֹר׃"}],[{"t":"יְיָ בַּשָּׁמַיִם הֵכִין כִּסְאוֹ וּמַלְכוּתוֹ בַּכֹּל מָשָׁלָה׃"}],[{"t":"יִשְׂמְחוּ הַשָּׁמַיִם וְתָגֵל הָאָרֶץ, וְיֹאמְרוּ בַגּוֹיִם יְיָ מָלָךְ׃"}],[{"t":"יְיָ מֶלֶךְ. יְיָ מָלָךְ. יְיָ יִמְלֹךְ לְעֹלָם וָעֶד׃"}],[{"t":"יְיָ מֶלֶךְ עוֹלָם וָעֶד אָבְדוּ גוֹיִם מֵאַרְצוֹ׃"}],[{"t":"יְיָ הֵפִיר עֲצַת־גּוֹיִם הֵנִיא מַחְשְׁבוֹת עַמִּים׃"}],[{"t":"רַבּוֹת מַחֲשָׁבוֹת בְּלֶב אִישׁ, וַעֲצַת יְיָ הִיא תָקוּם׃"}],[{"t":"עֻצוּ עֵצָה וְתֻפָר, דַּבְּרוּ דָבָר וְלֹא יָקוּם, כִּי עִמָּנוּ אֵל׃"}],[{"t":"עֲצַת יְיָ לְעוֹלָם תַּעֲמֹד מַחְשְׁבוֹת לִבּוֹ לְדֹר וָדֹר׃"}],[{"t":"כִּי הוּא אָמַר וַיֶּהִי הוּא־צִוָּה וַיַּעֲמֹד׃"}],[{"t":"כִּי־בָחַר יְיָ בְּצִיּוֹן אִוָּהּ לְמוֹשָׁב לוֹ׃"}],[{"t":"כִּי־יַעֲקֹב בָּחַר לוֹ יָהּ יִשְׂרָאֵל לִסְגֻלָּתוֹ׃"}],[{"t":"כִּי לֹא־יִטֹּשׁ יְיָ עַמּוֹ וְנַחֲלָתוֹ לֹא יַעֲזֹב׃"}],[{"t":"וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃"}],[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}],[{"t":"יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב־לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃"}],[{"t":"יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃"}],[{"t":"אַשְׁרֵי יוֹשְׁבֵי בֵיתֶךָ עוֹד יְהַלְלוּךָ סֶּלָה׃"}],[{"t":"אַשְׁרֵי הָעָם שֶׁכָּכָה לּוֹ אַשְׁרֵי הָעָם שֶׁיֲהוָה אֱלֹהָיו׃"}]]},{"key":"FF6hHtorIO","he":[[{"t":"תְּהִלָּה לְדָוִד אֲרוֹמִמְךָ אֱלוֹהַי הַמֶּלֶךְ וַאֲבָרֲכָה שִׁמְךָ לְעוֹלָם וָעֶד׃"}]]},{"key":"pO4qxtIjV1","he":[[{"t":"בְּכָל־יוֹם אֲבָרֲכֶךָּ וַאֲהַלְלָה שִׁמְךָ לְעוֹלָם וָעֶד׃"}]]},{"key":"9heFHhDcSL","he":[[{"t":"גָּדוֹל יְיָ וּמְהֻלָּל מְאֹד וְלִגְדֻלָּתוֹ אֵין חֵקֶר׃"}]]},{"key":"xhhup2O-TP","he":[[{"t":"דּוֹר לְדוֹר יְשַׁבַּח מַעֲשֶׂיךָ וּגְבוּרֹתֶיךָ יַגִּידוּ׃"}]]},{"key":"gGB3lELR2o","he":[[{"t":"הֲדַר כְּבוֹד הוֹדֶךָ וְדִבְרֵי נִפְלְאוֹתֶיךָ אָשִׂיחָה׃"}]]},{"key":"hb8O5tzx4Y","he":[[{"t":"וֶעֱזוּז נוֹרְאֹתֶיךָ יֹאמֵרוּ וּגְדוּלָּתְךָ אֲסַפְּרֶנָּה׃"}]]},{"key":"RJKjZ8U4cm","he":[[{"t":"זֵכֶר רַב־טוּבְךָ יַבִּיעוּ וְצִדְקָתְךָ יְרַנֵּנוּ׃"}]]},{"key":"ZpwV9xs3kx","he":[[{"t":"חַנּוּן וְרַחוּם יְיָ אֶרֶךְ אַפַּיִם וּגְדָל־חָסֶד׃"}]]},{"key":"o_e_9IVO7S","he":[[{"t":"טוֹב־יְיָ לַכֹּל וְרַחֲמָיו עַל־כָּל־מַעֲשָׂיו׃"}]]},{"key":"WDc9BCtdNQ","he":[[{"t":"יוֹדוּךָ יְיָ כָּל־מַעֲשֶׂיךָ וַחֲסִידֶיךָ יְבָרֲכוּכָה׃"}]]},{"key":"Lcmk-kARAq","he":[[{"t":"כְּבוֹד מַלְכוּתְךָ יֹאמֵרוּ וּגְבוּרָתְךָ יְדַבֵּרוּ׃"}]]},{"key":"bhxpqqRmTw","he":[[{"t":"לְהוֹדִיעַ לִבְנֵי הָאָדָם גְּבוּרֹתָיו וּכְבוֹד הֲדַר מַלְכוּתוֹ׃"}]]},{"key":"-qNIsxdQa3","he":[[{"t":"מַלְכוּתְךָ מַלְכוּת כָּל־עֹלָמִים וּמֶמְשֶׁלְתְּךָ בְּכָל־דּוֹר וָדוֹר׃"}]]},{"key":"PlPaNrrbxR","he":[[{"t":"סוֹמֵךְ יְיָ לְכָל־הַנֹּפְלִים וְזוֹקֵף לְכָל־הַכְּפוּפִים׃"}]]},{"key":"rs-B6ML1jI","he":[[{"t":"עֵינֵי־כֹל אֵלֶיךָ יְשַׂבֵּרוּ וְאַתָּה נוֹתֵן־לָהֶם אֶת־אָכְלָם בְּעִתּוֹ׃"}]]},{"key":"B22zFoHWEx","he":[[{"t":"פּוֹתֵחַ אֶת־יָדֶךָ וּמַשְׂבִּיעַ לְכָל־חַי רָצוֹן׃"}]]},{"key":"F32A0RHp4s","he":[[{"t":"צַדִּיק יְיָ בְּכָל־דְּרָכָיו וְחָסִיד בְּכָל־מַעֲשָׂיו׃"}]]},{"key":"QEl3iV0KxU","he":[[{"t":"קָרוֹב יְיָ לְכָל־קֹרְאָיו לְכֹל אֲשֶׁר יִקְרָאֻהוּ בֶאֱמֶת׃"}]]},{"key":"eW3_96ze9o","he":[[{"t":"רְצוֹן־יְרֵאָיו יַעֲשֶׂה וְאֶת־שַׁוְעָתָם יִשְׁמַע וְיוֹשִׁיעֵם׃"}]]},{"key":"OyEuKnaEIw","he":[[{"t":"שׁוֹמֵר יְיָ אֶת־כָּל־אֹהֲבָיו וְאֵת כָּל־הָרְשָׁעִים יַשְׁמִיד׃"}]]},{"key":"SHHKjUMD13","he":[[{"t":"תְּהִלַּת יְיָ יְדַבֶּר־פִּי וִיבָרֵךְ כָּל־בָּשָׂר שֵׁם קָדְשׁוֹ לְעוֹלָם וָעֶד׃"}]]},{"key":"t-YL_JbtKB","he":[[{"t":"הַלְלוּ־יָהּ הַלְלִי נַפְשִׁי אֶת־יְיָ׃"}]]},{"key":"MxQnv28Azy","he":[[{"t":"אֲהַלְלָה יְיָ בְּחַיָּי אֲזַמְּרָה לֵאלֹהַי בְּעוֹדִי׃"}]]},{"key":"D7NLvZg4eb","he":[[{"t":"אַל־תִּבְטְחוּ בִנְדִיבִים בְּבֶן־אָדָם שֶׁאֵין לוֹ תְשׁוּעָה׃"}]]},{"key":"4j5Q9b7pmz","he":[[{"t":"תֵּצֵא רוּחוֹ יָשֻׁב לְאַדְמָתוֹ בַּיּוֹם הַהוּא אָבְדוּ עֶשְׁתֹּנֹתָיו׃"}]]},{"key":"Wd7jlTNo0V","he":[[{"t":"אַשְׁרֵי שֶׁאֵל יַעֲקֹב בְּעֶזְרוֹ שִׂבְרוֹ עַל־יְיָ אֱלֹהָיו׃"}]]},{"key":"-ZAO8jcDVL","he":[[{"t":"עֹשֶׂה שָׁמַיִם וָאָרֶץ אֶת־הַיָּם וְאֶת־כָּל־אֲשֶׁר־בָּם הַשֹּׁמֵר אֱמֶת לְעוֹלָם׃"}]]},{"key":"ATbgwC-Nnc","he":[[{"t":"עֹשֶׂה מִשְׁפָּט לָעֲשׁוּקִים נֹתֵן לֶחֶם לָרְעֵבִים יְיָ מַתִּיר אֲסוּרִים׃"}]]},{"key":"G5p7S2l8-9","he":[[{"t":"יְיָ פֹּקֵחַ עִוְרִים יְיָ זֹקֵף כְּפוּפִים יְיָ אֹהֵב צַדִּיקִים׃"}]]},{"key":"F71xhT2b87","he":[[{"t":"יְיָ שֹׁמֵר אֶת־גֵּרִים יָתוֹם וְאַלְמָנָה יְעוֹדֵד וְדֶרֶךְ רְשָׁעִים יְעַוֵּת׃"}]]},{"key":"tNvZUFiRka","he":[[{"t":"יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּ־יָהּ׃"}]]},{"key":"9CEqQXIjYZ","he":[[{"t":"הַלְלוּ יָהּ כִּי־טוֹב זַמְּרָה אֱלֹהֵינוּ כִּי־נָעִים נָאוָה תְהִלָּה׃"}]]},{"key":"rg-s78M7gm","he":[[{"t":"בּוֹנֵה יְרוּשָׁלִַם יְיָ נִדְחֵי יִשְׂרָאֵל יְכַנֵּס׃"}]]},{"key":"jdum7G05R7","he":[[{"t":"הָרֹפֵא לִשְׁבוּרֵי לֵב וּמְחַבֵּשׁ לְעַצְּבוֹתָם׃"}]]},{"key":"KZavWRG9_K","he":[[{"t":"מוֹנֶה מִסְפָּר לַכּוֹכָבִים לְכֻלָּם שֵׁמוֹת יִקְרָא׃"}]]},{"key":"w9OC0tESRK","he":[[{"t":"גָּדוֹל אֲדוֹנֵינוּ וְרַב־כֹּחַ לִתְבוּנָתוֹ אֵין מִסְפָּר׃"}]]},{"key":"cqeKk3R_uu","he":[[{"t":"מְעוֹדֵד עֲנָוִים יְיָ מַשְׁפִּיל רְשָׁעִים עֲדֵי־אָרֶץ׃"}]]},{"key":"XBrtCYZmmY","he":[[{"t":"עֱנוּ לַייָ בְּתוֹדָה זַמְּרוּ לֵאלֹהֵינוּ בְכִנּוֹר׃"}]]},{"key":"JDBzfJRSk8","he":[[{"t":"הַמְכַסֶּה שָׁמַיִם בְּעָבִים הַמֵּכִין לָאָרֶץ מָטָר הַמַּצְמִיחַ הָרִים חָצִיר׃"}]]},{"key":"s8MzBZJDBj","he":[[{"t":"נוֹתֵן לִבְהֵמָה לַחְמָהּ לִבְנֵי עֹרֵב אֲשֶׁר יִקְרָאוּ׃"}]]},{"key":"uVmK1B9BoU","he":[[{"t":"לֹא בִגְבוּרַת הַסּוּס יֶחְפָּץ לֹא־בְשׁוֹקֵי הָאִישׁ יִרְצֶה׃"}]]},{"key":"f55ZQ6ejiu","he":[[{"t":"רוֹצֶה יְיָ אֶת־יְרֵאָיו אֶת־הַמְיַחֲלִים לְחַסְדּוֹ׃"}]]},{"key":"-r6Y1E02JH","he":[[{"t":"שַׁבְּחִי יְרוּשָׁלִַם אֶת־יְיָ הַלְלִי אֱלֹהַיִךְ צִיּוֹן׃"}]]},{"key":"hansi7pknK","he":[[{"t":"כִּי־חִזַּק בְּרִיחֵי שְׁעָרָיִךְ בֵּרַךְ בָּנַיִךְ בְּקִרְבֵּךְ׃"}]]},{"key":"Re2nNDC9mj","he":[[{"t":"הַשָּׂם־גְּבוּלֵךְ שָׁלוֹם חֵלֶב חִטִּים יַשְׂבִּיעֵךְ׃"}]]},{"key":"zaLY02kHUy","he":[[{"t":"הַשֹּׁלֵחַ אִמְרָתוֹ אָרֶץ עַד־מְהֵרָה יָרוּץ דְּבָרוֹ׃"}]]},{"key":"Tv-9Gq59Jv","he":[[{"t":"הַנֹּתֵן שֶׁלֶג כַּצָּמֶר כְּפוֹר כָּאֵפֶר יְפַזֵּר׃"}]]},{"key":"QgFXBSD1P_","he":[[{"t":"מַשְׁלִיךְ קַרְחוֹ כְפִתִּים לִפְנֵי קָרָתוֹ מִי יַעֲמֹד׃"}]]},{"key":"51eDgaEFmD","he":[[{"t":"יִשְׁלַח דְּבָרוֹ וְיַמְסֵם יַשֵּׁב רוּחוֹ יִזְּלוּ־מָיִם׃"}]]},{"key":"wai0yAPJOS","he":[[{"t":"מַגִּיד דְּבָרָיו לְיַעֲקֹב חֻקָּיו וּמִשְׁפָּטָיו לְיִשְׂרָאֵל׃"}]]},{"key":"YgvYaZa81z","he":[[{"t":"לֹא עָשָׂה כֵן לְכָל־גּוֹי וּמִשְׁפָּטִים בַּל־יְדָעוּם הַלְלוּ־יָהּ׃"}]]},{"key":"52r1ZwtYo8","he":[[{"t":"הַלְלוּ יָהּ הַלְלוּ אֶת־יְיָ מִן־הַשָּׁמַיִם הַלְלוּהוּ בַּמְּרוֹמִים׃"}]]},{"key":"fg_Nu-b9qS","he":[[{"t":"הַלְלוּהוּ כָל־מַלְאָכָיו הַלְלוּהוּ כָּל־צְבָאָיו׃"}]]},{"key":"engjzvHpni","he":[[{"t":"הַלְלוּהוּ שֶׁמֶשׁ וְיָרֵחַ הַלְלוּהוּ כָּל־כּוֹכְבֵי אוֹר׃"}]]},{"key":"j9CS5XjL7s","he":[[{"t":"הַלְלוּהוּ שְׁמֵי הַשָּׁמָיִם וְהַמַּיִם אֲשֶׁר מֵעַל הַשָּׁמָיִם׃"}]]},{"key":"HRaR_GOPrc","he":[[{"t":"יְהַלְלוּ אֶת־שֵׁם יְיָ כִּי הוּא צִוָּה וְנִבְרָאוּ׃"}]]},{"key":"-W_VbOQ2mq","he":[[{"t":"וַיַּעֲמִידֵם לָעַד לְעוֹלָם חָק־נָתַן וְלֹא יַעֲבוֹר׃"}]]},{"key":"2a9rG1Y0Iv","he":[[{"t":"הַלְלוּ אֶת־יְיָ מִן־הָאָרֶץ תַּנִּינִים וְכָל־תְּהֹמוֹת׃"}]]},{"key":"gYD7XncBV-","he":[[{"t":"אֵשׁ וּבָרָד שֶׁלֶג וְקִיטוֹר רוּחַ סְעָרָה עֹשָׂה דְבָרוֹ׃"}]]},{"key":"yajQ0ouFSW","he":[[{"t":"הֶהָרִים וְכָל־גְּבָעוֹת עֵץ פְּרִי וְכָל־אֲרָזִים׃"}]]},{"key":"0mVY8FT5yA","he":[[{"t":"הַחַיָּה וְכָל־בְּהֵמָה רֶמֶשׂ וְצִפּוֹר כָּנָף׃"}]]},{"key":"sLHhbl8o6I","he":[[{"t":"מַלְכֵי־אֶרֶץ וְכָל־לְאֻמִּים שָׂרִים וְכָל־שֹׁפְטֵי אָרֶץ׃"}]]},{"key":"HoSVZqR8bp","he":[[{"t":"בַּחוּרִים וְגַם־בְּתוּלוֹת זְקֵנִים עִם־נְעָרִים׃"}]]},{"key":"WWtoaAgker","he":[[{"t":"יְהַלְלוּ אֶת־שֵׁם יְיָ כִּי־נִשְׂגָּב שְׁמוֹ לְבַדּוֹ הוֹדוֹ עַל־אֶרֶץ וְשָׁמָיִם׃"}]]},{"key":"FMRkvwrrqD","he":[[{"t":"וַיָּרֶם קֶרֶן לְעַמּוֹ תְּהִלָּה לְכָל־חֲסִידָיו לִבְנֵי יִשְׂרָאֵל עַם־קְרֹבוֹ הַלְלוּ־יָהּ׃"}]]},{"key":"4sfSxDEySc","he":[[{"t":"הַלְלוּ יָהּ שִׁירוּ לַייָ שִׁיר חָדָשׁ תְּהִלָּתוֹ בִּקְהַל חֲסִידִים׃"}]]},{"key":"Tl2bCGFlrG","he":[[{"t":"יִשְׂמַח יִשְׂרָאֵל בְּעֹשָׂיו בְּנֵי־צִיּוֹן יָגִילוּ בְמַלְכָּם׃"}]]},{"key":"ixvVE9KN1S","he":[[{"t":"יְהַלְלוּ שְׁמוֹ בְמָחוֹל בְּתֹף וְכִנּוֹר יְזַמְּרוּ־לוֹ׃"}]]},{"key":"dQIyQa6DEu","he":[[{"t":"כִּי־רוֹצֶה יְיָ בְּעַמּוֹ יְפָאֵר עֲנָוִים בִּישׁוּעָה׃"}]]},{"key":"jCOI_CipVv","he":[[{"t":"יַעְלְזוּ חֲסִידִים בְּכָבוֹד יְרַנְּנוּ עַל־מִשְׁכְּבוֹתָם׃"}]]},{"key":"vZAfZbuNOo","he":[[{"t":"רוֹמְמוֹת אֵל בִּגְרוֹנָם וְחֶרֶב פִּיפִיּוֹת בְּיָדָם׃"}]]},{"key":"dACY7yVOuU","he":[[{"t":"לַעֲשׂוֹת נְקָמָה בַּגּוֹיִם תּוֹכֵחֹת בַּל־אֻמִּים׃"}]]},{"key":"eoG5dFUDx_","he":[[{"t":"לֶאְסֹר מַלְכֵיהֶם בְּזִקִּים וְנִכְבְּדֵיהֶם בְּכַבְלֵי בַרְזֶל׃"}]]},{"key":"mTd9NCPW6U","he":[[{"t":"לַעֲשׂוֹת בָּהֶם מִשְׁפָּט כָּתוּב הָדָר הוּא לְכָל־חֲסִידָיו הַלְלוּ־יָהּ׃"}]]},{"key":"xWtQ8YgYXi","he":[[{"t":"הַלְלוּ יָהּ הַלְלוּ־אֵל בְּקָדְשׁוֹ הַלְלוּהוּ בִּרְקִיעַ עֻזּוֹ׃"}]]},{"key":"Lb7KEzZZ4R","he":[[{"t":"הַלְלוּהוּ בִגְבוּרֹתָיו הַלְלוּהוּ כְּרֹב גֻּדְלוֹ׃"}]]},{"key":"dXKdYLvZnm","he":[[{"t":"הַלְלוּהוּ בְּתֵקַע שׁוֹפָר הַלְלוּהוּ בְּנֵבֶל וְכִנּוֹר׃"}]]},{"key":"edKS16Y01N","he":[[{"t":"הַלְלוּהוּ בְתֹף וּמָחוֹל הַלְלוּהוּ בְּמִנִּים וְעוּגָב׃"}]]},{"key":"movLZVw5ss","he":[[{"t":"הַלְלוּהוּ בְצִלְצְלֵי־שָׁמַע הַלְלוּהוּ בְּצִלְצְלֵי תְרוּעָה׃"}]]},{"key":"R1MORisn4T","he":[[{"t":"כֹּל הַנְּשָׁמָה תְּהַלֵּל יָהּ הַלְלוּ־יָהּ׃"}]]},{"key":"FQfzIlSP9V","he":[[{"t":"בָּרוּךְ יְיָ לְעוֹלָם אָמֵן וְאָמֵן׃"}],[{"t":"יִמְלֹך יְיָ לְעוֹלָם, אָמֵן וְאָמֵן׃"}]]},{"key":"01Tc2yjT08","he":[[{"t":"וַיְבָרֶךְ דָּוִיד אֶת יְיָ לְעֵינֵי כָּל הַקָּהָל, וַיֹּאמֶר דָּוִיד, בָּרוּךְ אַתָּה יְיָ אֱלֹהֵי יִשְׂרָאֵל אָבִינוּ, מֵעוֹלָם וְעַד עוֹלָם׃ לְךָ יְיָ הַגְּדֻלָּה וְהַגְּבוּרָה וְהַתִּפְאֶרֶת וְהַנֵּצַח וְהַהוֹד, כִּי כֹל בַּשָּׁמַיִם וּבָאָרֶץ, לְךָ יְיָ הַמַּמְלָכָה וְהַמִּתְנַשֵּׂא לְכֹל לְרֹאשׁ׃ וְהָעֹשֶׁר וְהַכָּבוֹד מִלְּפָנֶיךָ, וְאַתָּה מוֹשֵׁל בַּכֹּל, וּבְיָדְךָ כֹּחַ וּגְבוּרָה, וּבְיָדְךָ לְגַדֵּל וּלְחַזֵּק לַכֹּל׃ וְעַתָּה אֱלֹהֵינוּ מוֹדִים אֲנַחְנוּ לָךְ, וּמְהַלְלִים לְשֵׁם תִּפְאַרְתֶּךָ׃"}],[{"t":"וִיבָרְכוּ שֵׁם כְּבוֹדֶךָ וּמְרוֹמַם עַל כָּל בְּרָכָה וּתְהִלָּה׃"}]],"en":"And David blessed Adonoy in the presence of all the assembly; and David said, Blessed are You, Adonoy, God of Israel, our father, forever and ever. Yours, Adonoy, is the greatness, the might, the glory the victory and the beauty, for all that is in heaven and on earth [is Yours]; Yours, Adonoy, is the kingdom and You are uplifted, [supreme] over all rulers. The riches and the honor come from You, and You rule over all; in Your hand are power and might, and [it is] in Your hand to bestow greatness and strength upon all. And now, our God, we give thanks to You and praise Your glorious Name."},{"key":"OUVQELPKj4","he":[[{"t":"וַיּוֹשַׁע יְיָ בַּיּוֹם הַהוּא אֶת יִשְׂרָאֵל מִיַּד מִצְרָיִם, וַיַּרְא יִשְׂרָאֵל אֶת מִצְרַיִם מֵת עַל שְׂפַת הַיָּם׃ וַיַּרְא יִשְׂרָאֵל אֶת הַיָּד הַגְּדֹלָה אֲשֶׁר עָשָׂה יְיָ בְּמִצְרַיִם, וַיִּירְאוּ הָעָם אֶת יְיָ, וַיַּאֲמִינוּ בַּייָ וּבְמֹשֶׁה עַבְדּוֹ׃"}]],"en":"On that day, Adonoy delivered Israel from the hand of Egypt, and Israel saw the Egyptians dead on the seashore. And Israel saw the great hand which Adonoy wielded against Egypt, and the people feared Adonoy, and they believed in Adonoy, and that Moses was His servant."},{"key":"jMUVKNZ8ye","he":[[{"t":"אָז יָשִׁיר מֹשֶׁה וּבְנֵי יִשְׂרָאֵל אֶת הַשִּׁירָה הַזֹּאת לַייָ, וַיֹּאמְרוּ לֵאמֹר, אָשִׁירָה לַייָ כִּי גָאֹה גָּאָה סוּס וְרֹכְבוֹ רָמָה בַיָּם׃ עָזִּי וְזִמְרָת יָהּ וַיְהִי לִי לִישׁוּעָה, זֶה אֵלִי וְאַנְוֵהוּ, אֱלֹהֵי אָבִי וַאֲרֹמְמֶנְהוּ׃ יְיָ אִישׁ מִלְחָמָה, יְיָ שְׁמוֹ׃ מַרְכְּבֹת פַּרְעֹה וְחֵילוֹ יָרָה בַיָּם, וּמִבְחַר שָׁלִשָׁיו טֻבְּעוּ בְיַם סוּף׃ תְּהֹמֹת יְכַסְיֻמוּ, יָרְדוּ בִמְצוֹלֹת כְּמוֹ אָבֶן׃ יְמִינְךָ יְיָ נֶאְדָּרִי בַּכֹּחַ, יְמִינְךָ יְיָ תִּרְעַץ אוֹיֵב׃ וּבְרֹב גְּאוֹנְךָ תַּהֲרֹס קָמֶיךָ, תְּשַׁלַּח חֲרֹנְךָ יֹאכְלֵמוֹ כַּקַּשׁ׃ וּבְרוּחַ אַפֶּיךָ נֶעֶרְמוּ מַיִם, נִצְּבוּ כְמוֹ נֵד נֹזְלִים, קָפְאוּ תְהֹמֹת בְּלֶב יָם׃ אָמַר אוֹיֵב אֶרְדֹּף אַשִּׂיג אֲחַלֵּק שָׁלָל, תִּמְלָאֵמוֹ נַפְשִׁי, אָרִיק חַרְבִּי, תּוֹרִישֵׁמוֹ יָדִי׃ נָשַׁפְתָּ בְרוּחֲךָ כִּסָּמוֹ יָם, צָלְלוּ כַּעוֹפֶרֶת בְּמַיִם אַדִּירִים׃ מִי כָמֹכָה בָּאֵלִם יְיָ, מִי כָּמֹכָה נֶאְדָּר בַּקֹּדֶשׁ, נוֹרָא תְהִלֹּת עֹשֵׂה פֶלֶא׃ נָטִיתָ יְמִינְךָ תִּבְלָעֵמוֹ אָרֶץ׃ נָחִיתָ בְחַסְדְּךָ עַם זוּ גָּאָלְתָּ, נֵהַלְתָּ בְעָזְּךָ אֶל נְוֵה קָדְשֶׁךָ׃ שָׁמְעוּ עַמִּים יִרְגָּזוּן, חִיל אָחַז יֹשְׁבֵי פְּלָשֶׁת׃ אָז נִבְהֲלוּ אַלּוּפֵי אֱדוֹם, אֵילֵי מוֹאָב יֹאחֲזֵמוֹ רָעַד, נָמֹגוּ כֹּל יֹשְׁבֵי כְנָעַן׃ תִּפֹּל עֲלֵיהֶם אֵימָתָה וָפַחַד, בִּגְדֹל זְרוֹעֲךָ יִדְּמוּ כָּאָבֶן, עַד יַעֲבֹר עַמְּךָ יְיָ, עַד יַעֲבֹר עַם זוּ קָנִיתָ׃ תְּבִאֵמוֹ וְתִטָּעֵמוֹ בְּהַר נַחֲלָתְךָ, מָכוֹן לְשִׁבְתְּךָ פָּעַלְתָּ יְיָ, מִקְּדָשׁ אֲדֹנָי כּוֹנְנוּ יָדֶיךָ׃ יְיָ יִמְלֹךְ לְעֹלָם וָעֶד׃ כִּי בָא סוּס פַּרְעֹה בְּרִכְבּוֹ וּבְפָרָשָׁיו בַּיָּם, וַיָּשֶׁב יְיָ עֲלֵהֶם אֶת מֵי הַיָּם, וּבְנֵי יִשְׂרָאֵל הָלְכוּ בַיַּבָּשָׁה בְּתוֹךְ הַיָּם׃"}]]},{"key":"0a1-vS-AsM","he":[[{"t":"וַתִּקַּח מִרְיָם הַנְּבִיאָה אֲחוֹת אַהֲרֹן אֶת הַתֹּף בְּיָדָהּ, וַתֵּצֶאןָ כָל הַנָּשִׁים אַחֲרֶיהָ בְּתֻפִּים וּבִמְחֹלֹת׃ וַתַּעַן לָהֶם מִרְיָם, שִׁירוּ לַייָ כִּי גָאֹה גָּאָה, סוּס וְרֹכְבוֹ רָמָה בַיָּם׃ וַיַּסַּע מֹשֶׁה אֶת יִשְׂרָאֵל מִיַּם סוּף וַיֵּצְאוּ אֶל מִדְבַּר שׁוּר, וַיֵּלְכוּ שְׁלֹשֶׁת יָמִים בַּמִּדְבָּר וְלֹא מָצְאוּ מָיִם׃ וַיָּבֹאוּ מָרָתָה, וְלֹא יָכְלוּ לִשְׁתֹּת מַיִם מִמָּרָה כִּי מָרִים הֵם, עַל כֵּן קָרָא שְׁמָהּ מָרָה׃ וַיִּלֹּנוּ הָעָם עַל מֹשֶׁה לֵּאמֹר מַה נִּשְׁתֶּה׃ וַיִּצְעַק אֶל יְיָ וַיּוֹרֵהוּ יְיָ עֵץ וַיַּשְׁלֵךְ אֶל הַמַּיִם וַיִּמְתְּקוּ הַמָּיִם, שָׁם שָׂם לוֹ חֹק וּמִשְׁפָּט וְשָׁם נִסָּהוּ׃ וַיֹּאמֶר, אִם שָׁמוֹעַ תִּשְׁמַע לְקוֹל יְיָ אֱלֹהֶיךָ, וְהַיָּשָׁר בְּעֵינָיו תַּעֲשֶׂה וְהַאֲזַנְתָּ לְמִצְוֹתָיו וְשָׁמַרְתָּ כָּל חֻקָּיו, כָּל הַמַּחֲלָה אֲשֶׁר שַׂמְתִּי בְמִצְרַיִם לֹא אָשִׂים עָלֶיךָ, כִּי אֲנִי יְיָ רֹפְאֶךָ׃"}]]},{"key":"DfWX9keSmk","he":[[{"t":"רְפָאֵנִי יְיָ וְאֵרָפֵא, הוֹשִׁיעֵנִי וְאִוָּשֵׁעָה, כִּי תְהִלָּתִי אָתָּה׃"}],[{"t":"וְאָמַרְתָּ בַּיּוֹם הַהוּא, אוֹדְךָ יְיָ כִּי אָנַפְתָּ בִּי, יָשֹׁב אַפְּךָ וּתְנַחֲמֵנִי׃"}],[{"t":"הִנֵּה אֵל יְשׁוּעָתִי אֶבְטַח וְלֹא אֶפְחָד, כִּי עָזִּי וְזִמְרָת יָהּ יְיָ, וַיְהִי לִי לִישׁוּעָה׃"}],[{"t":"וּשְׁאַבְתֶּם מַיִם בְּשָׂשׂוֹן מִמַּעַיְנֵי הַיְשׁוּעָה׃"}],[{"t":"וַאֲמַרְתֶּם בַּיּוֹם הַהוּא, הוֹדוּ לַייָ קִרְאוּ בִשְׁמוֹ, הוֹדִיעוּ בָעַמִּים עֲלִילֹתָיו, הַזְכִּירוּ כִּי נִשְׂגָּב שְׁמוֹ׃"}],[{"t":"אֱלֹהֵי צוּרִי אֶחֱסֶה בּוֹ, מָגִנִּי וְקֶרֶן יִשְׁעִי, מִשְׂגַּבִּי וּמְנוּסִי, מֹשִׁעִי, מֵחָמָס תֹּשִׁעֵנִי׃"}],[{"t":"מְהֻלָּל אֶקְרָא יְיָ, וּמֵאֹיְבַי אִוָּשֵׁעַ׃"}],[{"t":"כִּי פָדָה יְיָ אֶת יַעֲקֹב וּגְאָלוֹ מִיַּד חָזָק מִמֶּנּוּ׃"}],[{"t":"עַל כֵּן אוֹדְךָ יְיָ בַּגּוֹיִם, וּלְשִׁמְךָ אֲזַמֵּר׃"}],[{"t":"זַמְּרוּ יְיָ כִּי גֵאוּת עָשָׂה, מוּדַעַת זֹאת בְּכָל הָאָרֶץ׃"}],[{"t":"צַהֲלִי וָרֹנִּי יוֹשֶׁבֶת צִיּוֹן, כִּי גָדוֹל בְּקִרְבֵּךְ קְדוֹשׁ יִשְׂרָאֵל׃"}],[{"t":"וְאָמַר בַּיּוֹם הַהוּא, הִנֵּה אֱלֹהֵינוּ זֶה קִוִּינוּ לוֹ וְיוֹשִׁיעֵנוּ, זֶה יְיָ קִוִּינוּ לוֹ, נָגִילָה וְנִשְׂמְחָה בִּישׁוּעָתוֹ׃"}],[{"t":"כִּי לַייָ הַמְּלוּכָה וּמֹשֵׁל בַּגּוֹיִם׃"}],[{"t":"וְעָלוּ מוֹשִׁעִים בְּהַר צִיּוֹן לִשְׁפֹּט אֶת הַר עֵשָׂו, וְהָיְתָה לַייָ הַמְּלוּכָה׃"}],[{"t":"וְהָיָה יְיָ לְמֶלֶךְ עַל כָּל הָאָרֶץ, בַּיּוֹם הַהוּא יִהְיֶה יְיָ אֶחָד, וּשְׁמוֹ אֶחָד׃"}],[{"t":"יְהִי שֵׁם יְיָ מְבֹרָךְ מֵעַתָּה וְעַד־עוֹלָם׃"}],[{"t":"מִמִּזְרַח־שֶׁמֶשׁ עַד־מְבוֹאוֹ מְהֻלָּל שֵׁם יְיָ׃"}],[{"t":"לִישׁוּעָתְךָ קִוִּיתִי יְיָ׃"}]]},{"key":"wEZpD5gtX3","he":[[{"t":"יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּנוּ, הַמֶּלֶךְ הַגָּדוֹל וְהַקָּדוֹשׁ בַּשָּׁמַיִם וּבָאָרֶץ. כִּי לְךָ נָאֶה יְיָ אֱלֹהֵינוּ שִׁיר וּשְׁבָח, הַלֵּל וְזִמְרָה, בְּרָכוֹת וְהוֹדָאוֹת, נֵצַח וּגְבוּרָה, גְּדֻלָּה תְּהִלָּה וְתִפְאֶרֶת עֹז וּמַלְכוּת וּמֶמְשָׁלָה, מֵעַתָּה וְעַד עוֹלָם. בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, מֶלֶךְ גְּדוֹל הַתֻּשְׁבָּחוֹת, אֵל הַהוֹדָאוֹת, אֲדוֹן כָּל הַמַּעֲשִׂים. הַבּוֹחֵר בְּשִׁירֵי זִמְרָה, חַי הָעוֹלָמִים."}]]}]},{"title":{"he":"קריאת שמע וברכותיה","en":"The Shema and its Blessings"},"chapter":{"he":"קריאת שמע וברכותיה","en":"The Shema and its Blessings"},"segments":[{"key":"kaI4FEBzgA","he":[[{"t":"יקום אחד מן הקהל ויפרוס על שמע, ויאמר:","s":"n"}]],"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"xVx6YTd76n","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"kA78oIRzPI","he":[[{"t":"בָּרְכוּ אֶת יְיָ הַמְבֹרָךְ."}],[{"t":"ויענו הקהל והוא עמהם:","s":"n"}],[{"t":"בָּרוּךְ יְיָ הַמְבֹרָךְ לְעוֹלָם וָעֶד."}]],"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"GMfwiK3Fvx","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, יוֹצֵר אוֹר וּבוֹרֵא חֹשֶׁךְ, עֹשֶׂה שָׁלוֹם וּבוֹרֵא אֶת הַכֹּל. הַמֵּאִיר לָאָרֶץ וְלַדָּרִים עָלֶיהָ, הַמְחַדֵּשׁ בְּכָל יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית. מָה־רַבּוּ מַעֲשֶׂיךָ יְיָ כֻּלָּם בְּחָכְמָה עָשִׂיתָ מָלְאָה הָאָרֶץ קִנְיָנֶךָ׃ הַמֶּלֶךְ הַמְּרוֹמָם שְׁמוֹ לְבַדּוֹ מֵאָז, הַמְּשֻׁבָּח הַמְּפֹאָר וְהַמִּתְנַשֵּׂא וְטוֹב מִיְּמוֹת עוֹלָם. אֱלֹהֵי עוֹלָם מַלְכֵּנוּ, בְּרַחֲמֶיךָ הָרַבִּים רַחֵם עָלֵינוּ, אֲדוֹן עֻזֵּנוּ צוּר מִשְׂגַּבֵּנוּ, מָגֵן יִשְׁעֵנוּ מִשְׂגָּב בַּעֲדֵנוּ. אֵל בָּרוּךְ גְּדוֹל דֵּעָה, הִתְקִין וּפָעַל זָהֳרֵי חַמָּה, טוֹב יָצַר כָּבוֹד לִשְׁמוֹ, מְאוֹרוֹת נָתַן סְבִיבוֹת עֻזּוֹ, פִּנּוֹת צִבְאוֹת קְדוֹשִׁים רוֹמְמֵי שַׁדַּי, תָּמִיד יְסַפְּרוּ לָאֵל קְדֻשָּׁתוֹ. תִּתְבָּרַךְ יְיָ אֱלֹהֵינוּ בַּשָּׁמַיִם מִמַּעַל וְעַל הָאָרֶץ מִתָּחַת, וְעַל כָּל שְׁבָח מַעֲשֵׂה יָדֶיךָ, וּמְאוֹרוֹת אֲשֶׁר יָצַרְתָּ הֵמָּה יְפָאֲרוּךָ סֶּלָה."}]]},{"key":"dTBvJjuPGS","he":[[{"t":"תִּתְבָּרַךְ לָעַד צוּרֵנוּ, מַלְכֵּנוּ וְגוֹאֲלֵנוּ, בּוֹרֵא קְדוֹשִׁים. יִשְׁתַּבַּח שִׁמְךָ לָעַד מַלְכֵּנוּ, יוֹצֵר מְשָׁרְתִים. אֲשֶׁר מְשָׁרְתָיו עוֹמְדִים בְּרוּם עוֹלָם, וּמַשְׁמִיעִים אֶת קוֹלָם יַחַד בְּדִבְרֵי אֱלֹהִים חַיִּים וּמֶלֶךְ עוֹלָם. כֻּלָּם אֲהוּבִים, כֻּלָּם בְּרוּרִים, כֻּלָּם גִּבּוֹרִים, עוֹשִׂים בְּאֵימָה רְצוֹן קוֹנֵיהֶם בְּאַהֲבָה. כֻּלָּם מְקַבְּלִים עֲלֵיהֶם עֹל מַלְכוּת שָׁמַיִם זֶה מִזֶּה, וְנוֹתְנִים רְשׁוּת זֶה לָזֶה לְהַקְדִּישׁ לְצוּרָם בְּנַחַת רוּחַ, בְּשָׂפָה בְּרוּרָה, וּבִנְעִימָה טְהוֹרָה. כֻּלָּם כְּאֶחָד עוֹנִים בְּיִרְאָה, וְאוֹמְרִים: קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת, מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ׃ וְהָאוֹפַנִּים וְחַיּוֹת הַקֹּדֶשׁ, יַחַד מִתְנַשְּׂאִים לְעֻמָּתָם: מְשַׁבְּחִים וְאוֹמְרִים: בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ׃ לְאֵל בָּרוּךְ נְעִימוֹת יִתֵּנוּ, לְמֶלֶךְ אֵל חַי וְקַיָּם זְמִירוֹת יֹאמֵרוּ וְתֻשְׁבָּחוֹת יַשְׁמִיעוּ, כִּי הוּא לְבַדּוֹ פּוֹעֵל גְּבוּרוֹת, עוֹשֶׂה חֲדָשׁוֹת, זוֹרֵעַ צְדָקוֹת, מַצְמִיחַ יְשׁוּעוֹת, אֲדוֹן הַנִּפְלָאוֹת, הַמְּחַדֵּשׁ בְּכָל יוֹם תָּמִיד מַעֲשֵׂה בְרֵאשִׁית. כָּאָמוּר: לְעֹשֵׂה אוֹרִים גְּדֹלִים כִּי לְעוֹלָם חַסְדּוֹ׃ הִתְקַנְתָּ מְאוֹרוֹת לְשַׂמֵּחַ עוֹלָם. בָּרוּךְ אַתָּה יְיָ, יוֹצֵר הַמְּאוֹרוֹת."}]]},{"key":"MLU2OAHepk","he":[[{"t":"אַהֲבַת עוֹלָם אֲהַבְתָּנוּ יְיָ אֱלֹהֵינוּ, חֶמְלָה גְדוֹלָה יְתֵרָה חָמַלְתָּ עָלֵינוּ. אָבִינוּ מַלְכֵּנוּ, בַּעֲבוּר שְׁמָךְ וּבַעֲבוּר אֲבוֹתֵינוּ אֲשֶׁר בָּטְחוּ בָךְ, וַתְּלַמְּדֵנוּ חֻקֵּי חַיִּים, כֵּן תְּחָנֵּנוּ אָבִינוּ אָב הָרַחֲמָן. הַמְרַחֵם רַחֵם נָא עָלֵינוּ, וְתֶן בְּלִבֵּנוּ לְהָבִין, לְהַשְׂכִּיל, לִשְׁמֹעַ, לִלְמֹד וּלְלַמֵּד, לִשְׁמֹר וְלַעֲשׂוֹת וּלְקַיֵּם אֶת כָּל דִּבְרֵי תַלְמוּד תּוֹרָתְךָ בְּאַהֲבָה. וְהָאֵר עֵינֵינוּ בְּמִצְוֹתֶיךָ וְדַבֵּק בְּלִבֵּנוּ יִרְאָתֶךָ, וְיַחֵד לְבָבֵנוּ לְאַהֲבָה אֶת שְׁמֶךָ. וּמְלֹךְ עָלֵינוּ מְהֵרָה אַתָּה לְבַדֶּךָ, כִּי שֵׁם קָדְשְׁךָ בֱּאֱמֶת נִקְרָא עָלֵינוּ. בַּעֲבוּר שְׁמָךְ הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא, מְהֵרָה בְּאַהֲבָה תָרוּם קַרְנֵנוּ וְתוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ. בָּךְ בָּטַחְנוּ לֹא נֵבוֹשׁ, וּבְשִׁמְךָ חָסִינוּ לֹא נִכָּלֵם וְלֹא נִכָּשֵׁל עַד עוֹלְמֵי עַד. כִּי אָבִינוּ מַלְכֵּנוּ אָתָּה, נָגִילָה וְנִשְׂמְחָה בִּישׁוּעָתֶךָ. רַחֲמֶיךָ יְיָ אֱלֹהֵינוּ וַחֲסָדֶיךָ אַל יַעַזְבוּנוּ נֵצַח סֶלָה וָעֶד. וְהָבֵא עָלֵינוּ בְּרָכָה וְשָׁלוֹם מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ, וְהוֹלִיכֵנוּ מְהֵרָה קוֹמְמִיּוּת לְאַרְצֵנוּ. כִּי בָנוּ בָחַרְתָּ מִכָּל עָם וְלָשׁוֹן, וְקֵרַבְתָּנוּ לְשִׁמְךָ הַגָּדוֹל לְהוֹדוֹת לָךְ, וּלְיַחֲדָךְ וּלְרוֹמְמָךְ וּלְאַהֲבָה אֶת שְׁמָךְ. בָּרוּךְ אַתָּה יְיָ, הַבּוֹחֵר בְּעַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה."}]]},{"key":"nL33rbeLef","he":[[{"t":"שְׁמַע יִשְׂרָאֵל יְיָ אֱלֹהֵינוּ יְיָ אֶחָד׃"}]],"en":"“Hear Israel, Adonoy is our God, Adonoy is One.”"},{"key":"xbWFPmpL1Q","he":[[{"t":"בלחש׃","s":"n"},{"t":" בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד."}]]},{"key":"JSktW5-wa_","he":[[{"t":"וְאָהַבְתָּ אֵת יְיָ אֱלֹהֶיךָ, בְּכָל לְבָבְךָ וּבְכָל נַפְשְׁךָ וּבְכָל מְאֹדֶךָ׃ וְהָיוּ הַדְּבָרִים הָאֵלֶּה אֲשֶׁר אָנֹכִי מְצַוְּךָ הַיּוֹם עַל לְבָבֶךָ׃ וְשִׁנַּנְתָּם לְבָנֶיךָ, וְדִבַּרְתָּ בָּם, בְּשִׁבְתְּךָ בְּבֵיתֶךָ וּבְלֶכְתְּךָ בַדֶּרֶךְ, וּבְשָׁכְבְּךָ וּבְקוּמֶךָ׃ וּקְשַׁרְתָּם לְאוֹת עַל יָדֶךָ, וְהָיוּ לְטֹטָפֹת בֵּין עֵינֶיךָ׃ וּכְתַבְתָּם עַל מְזֻזוֹת בֵּיתֶךָ וּבִשְׁעָרֶיךָ׃"}]],"en":"And you shall love Adonoy your God with all your heart and with all your soul and with all your possessions. And these words which I command you today, shall be upon your heart. And you shall teach them sharply to your children. And you shall discuss them when you sit in your house, and when you travel on the road, and when you lie down and when you rise. And you shall bind them for a sign upon your hand, and they shall be for totafos between your eyes. And you shall write them upon the doorposts of your house and upon your gateways."},{"key":"pKq6275pqM","he":[[{"t":"וְהָיָה, אִם שָׁמֹעַ תִּשְׁמְעוּ אֶל מִצְוֹתַי אֲשֶׁר אָנֹכִי מְצַוֶּה אֶתְכֶם הַיּוֹם, לְאַהֲבָה אֶת יְיָ אֱלֹהֵיכֶם וּלְעָבְדוֹ בְּכָל לְבַבְכֶם וּבְכָל נַפְשְׁכֶם׃ וְנָתַתִּי מְטַר אַרְצְכֶם בְּעִתּוֹ יוֹרֶה וּמַלְקוֹשׁ, וְאָסַפְתָּ דְגָנֶךָ וְתִירֹשְׁךָ וְיִצְהָרֶךָ׃ וְנָתַתִּי עֵשֶׂב בְּשָׂדְךָ לִבְהֶמְתֶּךָ, וְאָכַלְתָּ וְשָׂבָעְתָּ׃ הִשָּׁמְרוּ לָכֶם פֶּן יִפְתֶּה לְבַבְכֶם, וְסַרְתֶּם וַעֲבַדְתֶּם אֱלֹהִים אֲחֵרִים וְהִשְׁתַּחֲוִיתֶם לָהֶם׃ וְחָרָה אַף יְיָ בָּכֶם, וְעָצַר אֶת הַשָּׁמַיִם וְלֹא יִהְיֶה מָטָר, וְהָאֲדָמָה לֹא תִתֵּן אֶת יְבוּלָהּ, וַאֲבַדְתֶּם מְהֵרָה מֵעַל הָאָרֶץ הַטֹּבָה אֲשֶׁר יְיָ נֹתֵן לָכֶם׃ וְשַׂמְתֶּם אֶת דְּבָרַי אֵלֶּה עַל לְבַבְכֶם וְעַל נַפְשְׁכֶם, וּקְשַׁרְתֶּם אֹתָם לְאוֹת עַל יֶדְכֶם, וְהָיוּ לְטוֹטָפֹת בֵּין עֵינֵיכֶם׃ וְלִמַּדְתֶּם אֹתָם אֶת בְּנֵיכֶם לְדַבֵּר בָּם, בְּשִׁבְתְּךָ בְּבֵיתֶךָ וּבְלֶכְתְּךָ בַדֶּרֶךְ, וּבְשָׁכְבְּךָ וּבְקוּמֶךָ׃ וּכְתַבְתָּם עַל מְזוּזוֹת בֵּיתֶךָ וּבִשְׁעָרֶיךָ׃ לְמַעַן יִרְבּוּ יְמֵיכֶם וִימֵי בְנֵיכֶם, עַל הָאֲדָמָה אֲשֶׁר נִשְׁבַּע יְיָ לַאֲבֹתֵיכֶם לָתֵת לָהֶם, כִּימֵי הַשָּׁמַיִם עַל הָאָרֶץ׃"}]],"en":"And it will be— if you vigilantly obey My commandments which I command you this day, to love Adonoy your God, and serve Him with your entire hearts and with your entire souls— that I will give rain for your land in its proper time, the early (autumn) rain and the late (spring) rain; and you will harvest your grain and your wine and your oil. And I will put grass in your fields for your cattle, and you will eat and be satisfied. Beware lest your hearts be swayed and you turn astray, and you worship alien gods and bow to them. And Adonoy’s fury will blaze among you, and He will close off the heavens and there will be no rain and the earth will not yield its produce; and you will perish swiftly from the good land which Adonoy gives you. Place these words of Mine upon your hearts and upon your souls,— and bind them for a sign upon your hands, and they shall be for totafos between your eyes. And you shall teach them to your sons, to speak them when you sit in your house, and when you travel on the road, and when you lie down and when you rise. And you shall write them upon the doorposts of your house and upon your gateways. In order that your days be prolonged, and the days of your children, upon the land which Adonoy swore to your fathers to give them [for as long] as the heavens are above the earth."},{"key":"sbdvRjFi99","he":[[{"t":"וַיֹאמֶר יְיָ אֶל משֶׁה לֵּאמֹר׃ דַּבֵּר אֶל בְּנֵי יִשְׂרָאֵל וְאָמַרְתָּ אֲלֵהֶם, וְעָשׂוּ לָהֶם צִיצִת עַל כַּנְפֵי בִגְדֵיהֶם לְדֹרֹתָם, וְנָתְנוּ עַל צִיצִת הַכָּנָף פְּתִיל תְּכֵלֶת׃ וְהָיָה לָכֶם לְצִיצִת, וּרְאִיתֶם אֹתוֹ, וּזְכַרְתֶּם אֶת כָּל מִצְוֹת יְיָ וַעֲשִׂיתֶם אֹתָם, וְלֹא תָתוּרוּ אַחֲרֵי לְבַבְכֶם וְאַחֲרֵי עֵינֵיכֶם אֲשֶׁר אַתֶּם זֹנִים אַחֲרֵיהֶם׃ לְמַעַן תִּזְכְּרוּ וַעֲשִׂיתֶם אֶת כָּל מִצְוֹתָי, וִהְיִיתֶם קְדשִׁים לֵאלֹהֵיכֶם׃ אֲנִי יְיָ אֱלֹהֵיכֶם אֲשֶׁר הוֹצֵאתִי אֶתְכֶם מֵאֶרֶץ מִצְרַיִם לִהְיוֹת לָכֶם לֵאלֹהִים, אֲנִי יְיָ אֱלֹהֵיכֶם׃"}]],"en":"And Adonoy spoke to Moses saying: Speak to the children of Israel, and tell them to make for themselves fringes on the corners of their garments throughout their generations; and they will place with the fringes of each corner a thread of blue. And it will be to you for fringes, and you will look upon it and you will remember all the commandments of Adonoy, and you will perform them; and you will not turn aside after your hearts and after your eyes which cause you to go astray. In order that you will remember and perform all My commandments; and you will be holy unto your God. I am Adonoy, your God, Who brought you out of the land of Egypt to be your God: I am Adonoy, your God—"},{"key":"ouFb0m2b2T","he":[[{"t":"מתחילים אֱמֶת, והש\"ץ חוזר על יְיָ אֱלֹהֵיכֶם אֱמֶת.","s":"n"}]],"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"46XwL46NEk","he":[[{"t":"אֱמֶת וְיַצִּיב וְנָכוֹן וְקַיָּם וְיָשָׁר וְנֶאֱמָן וְאָהוּב וְחַבִּיב וְנֶחְמָד וְנָעִים וְנוֹרָא וְאַדִּיר וּמְתֻקָּן וּמְקֻבָּל וְטוֹב וְיָפֶה הַדָּבָר הַזֶּה עָלֵינוּ לְעוֹלָם וָעֶד. אֱמֶת אֱלֹהֵי עוֹלָם מַלְכֵּנוּ, צוּר יַעֲקֹב מָגֵן יִשְׁעֵנוּ. לְדוֹר וָדוֹר הוּא קַיָּם וּשְׁמוֹ קַיָּם, כִּסְאוֹ נָכוֹן וּמַלְכוּתוֹ וֶאֱמוּנָתוֹ קַיֶּמֶת. דְּבָרָיו חַיִּים וְנֶאֱמָנִים לָעַד וּלְעוֹלְמֵי עוֹלָמִים, עָלֵינוּ וְעַל אֲבוֹתֵינוּ, עַל בָּנֵינוּ וְעַל כָּל דּוֹרוֹתֵינוּ, עַל הָרִאשׁוֹנִים וְעַל הָאַחֲרוֹנִים, דָּבָר טוֹב וְקַיָּם בֶּאֱמֶת חָק וְלֹא יַעֲבֹר. אֱמֶת שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, מַלְכֵּנוּ וּמֶלֶךְ אֲבוֹתֵינוּ, גּוֹאֲלֵנוּ וְגָאַל אֶת אֲבוֹתֵינוּ, יוֹצְרֵנוּ וְצוּר יְשׁוּעָתֵנוּ, פּוֹדֵנוּ וּמַצִּילֵנוּ מֵעוֹלָם הוּא שְׁמֶךָ, וְאֵין לָנוּ אֱלֹהִים עוֹד זוּלָתֶךָ. עֶזְרַת אֲבוֹתֵינוּ אַתָּה הוּא מֵעוֹלָם, מָגֵן וּמוֹשִׁיעַ לִבְנֵיהֶם אַחֲרֵיהֶם בְּכָל דּוֹר וָדוֹר. בְּרוּם עוֹלָם מוֹשָׁבֶךָ, וּמִשְׁפָּטֶיךָ וְצִדְקָתְךָ עַד אַפְסֵי אָרֶץ. אֱמֶת אַשְׁרֵי אִישׁ אֲשֶׁר יִשְׁמַע אֶל מִצְוֹתֶיךָ, וְתוֹרָתְךָ וּדְבָרְךָ יָשִׂים עַל לִבּוֹ. אֱמֶת אַתָּה הוּא אָדוֹן לְעַמָּךְ, וּמֶלֶךְ גִּבּוֹר לָרִיב רִיבָם לְאָבוֹת וּבָנִים. אֱמֶת אַתָּה הוּא רִאשׁוֹן וְאַתָּה הוּא אַחֲרוֹן, וּמִבַּלְעָדֶיךָ אֵין לָנוּ מוֹשִׁיעַ. אֱמֶת מִמִּצְרַיִם גְּאַלְתָּנוּ יְיָ אֱלֹהֵינוּ, מִבֵּית עֲבָדִים פְּדִיתָנוּ, כָּל בְּכוֹרֵי מִצְרַיִם בַּדֶּבֶר הָרַגְתָּ, וּבְכוֹרְךָ גָּאַלְתָּ, וְיַם סוּף בָּקַעְתָּ, וְזֵדִים טִבַּעְתָּ, וִידִידִים עָבְרוּ מִיָּם, וַיְכַסּוּ מַיִם צָרֵיהֶם עַד אֶחָד מֵהֶם לֹא נוֹתָר. וְעַל זֹאת שִׁבְּחוּ גְאוּלִים, וְרוֹמְמוּ לָאֵל, וְנָתְנוּ יְדִידִים שִׁירוֹת, זְמִירוֹת, תֻּשְׁבָּחוֹת לְמֶלֶךְ אֵל חַי וְקַיָּם. רָם וְנִשָּׂא, גָּדוֹל גִּבּוֹר וְנוֹרָא, מַשְׁפִּיל גֵּאִים עֲדֵי אָרֶץ, מַגְבִּיהַּ שְׁפָלִים עַד מָרוֹם, מוֹצִיא אֲסִירִים, פּוֹדֶה עֲנָוִים, עוֹזֵר דַּלִּים, וְעוֹנֶה לְעַמּוֹ יִשְׂרָאֵל בְּעֵת שַׁוְּעָם אֵלָיו. תְּהִלָּה לְאֵל עֶלְיוֹן בָּרוּךְ הוּא, מֹשֶׁה וְכָל בְּנֵי יִשְׂרָאֵל לְךָ אָמָרוּ. שִׁירָה בְּשִׂמְחָה רַבָּה אָמְרוּ כֻלָּם: מִי כָמֹכָה בָּאֵלִם יְיָ, מִי כָּמֹכָה נֶאְדָּר בַּקֹּדֶשׁ, נוֹרָא תְהִלֹּת עֹשֵׂה פֶלֶא׃ יְיָ יִמְלֹךְ לְעֹלָם וָעֶד׃ וְנֶאֱמָר: גֹּאֲלֵנוּ יְיָ צְבָאוֹת שְׁמוֹ קְדוֹשׁ יִשְׂרָאֵל׃ בָּרוּךְ אַתָּה יְיָ, גָּאַל יִשְׂרָאֵל."}]]}]},{"title":{"he":"תפילת העמידה","en":"The Amidah"},"chapter":{"he":"תפילת העמידה","en":"The Amidah"},"segments":[{"key":"mL3kZh19gD","he":[[{"t":"אֲדֹנָי שְׂפָתַי תִּפְתָּח וּפִי יַגִּיד תְּהִלָּתֶךָ׃"}]],"en":"My Master, open my lips, and my mouth will declare Your praise."},{"key":"t1lwAuMELv","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ, אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב, הָאֵל הַגָּדֹל הַגִּבֹּר וְהַנּוֹרָא, אֵל עֶלְיוֹן, גּוֹמֵל חֲסָדִים טוֹבִים וְקוֹנֵה הַכֹּל, זוֹכֵר חַסְדֵי אָבוֹת וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם."}],[{"t":"בעשי\"ת:","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" זָכְרֵנוּ לְחַיִּים, אֵל מֶלֶךְ חָפֵץ בַּחַיִּים, כָּתְבֵנוּ בְּסֵפֶר חַיִּים, לְמַעֲנָךְ אֱלֹהִים חַיִּים.","when":{"all":["aseretYemeiTeshuva"]}}],[{"t":"מֶלֶךְ רַחֲמָן מוֹשִׁיעַ וּמָגֵן. בָּרוּךְ אַתָּה יְיָ, מָגֵן אַבְרָהָם."}]]},{"key":"CTVp7jSGhS","he":[[{"t":"אַתָּה גִּבּוֹר לְעוֹלָם יְיָ, מְחַיֶּה מֵתִים אַתָּה רַב לְהוֹשִׁיעַ."}],[{"t":"בקיץ:","s":"n","when":{"none":["winter"]}},{"t":" מוֹרִיד הַטָּל.","when":{"none":["winter"]}},{"t":" "},{"t":"בחורף:","s":"n","when":{"all":["winter"]}},{"t":" מַשִּׁיב הָרוּחַ מוֹרִיד הַגֶּשֶׁם.","when":{"all":["winter"]}}],[{"t":"מְכַלְכֵּל חַיִּים בְּחֶסֶד, מְחַיֶּה מֵתִים בְּרַחֲמִים רַבִּים, רוֹפֵא חוֹלִים, סוֹמֵךְ נוֹפְלִים, מַתִּיר אֲסוּרִים, וּמְקַיֵּם אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת, וּמִי דוֹמֶה לָךְ מֵמִית וּמְחַיֶּה."}],[{"t":"בעשי\"ת:","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" מִי כָמוֹךָ אָב הָרַחֲמָן, זוֹכֵר יְצוּרָיו בְּרַחֲמִים לְחַיִּים.","when":{"all":["aseretYemeiTeshuva"]}}],[{"t":"וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים. בָּרוּךְ אַתָּה יְיָ, מְחַיֶּה הַמֵּתִים."}]]},{"key":"YjLNe3es11","he":[[{"t":"נַקְדִּישָׁךְ וְנַעֲרִיצָךְ וּנְשַׁלֵּשׁ לָךְ קְדֻשָּׁה מְשֻׁלֶּשֶׁת, כַּדָּבָר הָאָמוּר עַל יַד נְבִיאָךְ: וְקָרָא זֶה אֶל זֶה וְאָמַר: "},{"t":"קהל:","s":"n"},{"t":" קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת, מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ׃ "},{"t":"חזן:","s":"n"},{"t":" כְּבוֹדוֹ וְהוֹדוֹ מְלֹא הָעוֹלָם כֻּלּוֹ, וּמְשָׁרְתָיו שׁוֹאֲלִים זֶה לָזֶה אַיֵּה מְקוֹם כְּבוֹדוֹ. "},{"t":"קהל:","s":"n"},{"t":" מְשַׁבְּחִים וְאוֹמְרִים: בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ׃ "},{"t":"חזן:","s":"n"},{"t":" מִמְּקוֹמְךָ מַלְכֵּנוּ תּוֹפִיעַ וְתִתְנַשֵּׂא וְתִמְלֹךְ עָלֵינוּ כִּי מְחַכִּים אָנוּ לָךְ, מָתַי תִּמְלֹךְ בְּצִיּוֹן בְּקָרוֹב בְּחַיֵּינוּ וּבְיָמֵינוּ. אָמֵן תִּשְׁכֹּן תִּתְגַּדַּל וְתִתְקַדַּשׁ בְּתוֹךְ יְרוּשָׁלַיִם עִירָךְ לְדוֹר וָדוֹר וּלְנֵצַח נְצָחִים. וְעֵינֵינוּ תִרְאֶינָה בְּמַלְכוּת עֻזָּךְ כַּדָּבָר הָאָמוּר בְּשִׁירֵי קָדְשָׁךְ עַל יַד דָּוִד עַבְדָּךְ מְשִׁיחַ צִדְקָךְ. "},{"t":"קהל:","s":"n"},{"t":" יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּ־יָהּ׃ "},{"t":"חזן:","s":"n"},{"t":" לְדוֹר וָדוֹר נַגִּיד גָּדְלָךְ וּלְנֵצַח נְצָחִים קְדֻשָּׁתָךְ נַקְדִּישׁ. שְׁבָחָךְ יְיָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ כִּי אֵל מֶלֶךְ גָּדוֹל וְקָדוֹשׁ אָתָּה."}]],"minyan":{"he":"קדושה — נאמרת רק בחזרת הש״ץ","en":"Kedushah — said only in the chazzan's repetition"}},{"key":"1D0CV4Zkgd","he":[[{"t":"אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ, וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלוּךָ סֶּלָה."}]],"en":"You are holy and Your Name is holy and holy beings praise You every day, forever."},{"key":"j2jj_GvMOC","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ, הָאֵל הַקָּדוֹשׁ.","when":{"none":["aseretYemeiTeshuva"]}},{"t":"בעשי\"ת:","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" וּבְכֵן, יִתְקַדַּשׁ שִׁמְךָ יְיָ אֱלֹהֵינוּ עַל יִשְׂרָאֵל עַמֶּךָ. וּבְכֵן, תֵּן פַּחְדְּךָ יְיָ אֱלֹהֵינוּ עַל כָּל מַעֲשֶׂיךָ, וְאֵימָתְךָ עַל כָּל מַה שֶּׁבָּרָאתָ, וְיִירָאוּךָ כָּל הַמַּעֲשִׂים, וְיִשְׁתַּחֲווּ לְפָנֶיךָ כָּל הַבְּרוּאִים, וְיֵעָשׂוּ כֻּלָּם אֲגֻדָּה אַחַת לַעֲשׂוֹת רְצוֹנָךְ בְּלֵבָב שָׁלֵם. כְּמוֹ שֶׁיָּדַעְנוּ יְיָ אֱלֹהֵינוּ שֶׁהַשִּׁלְטוֹן מִלְּפָנֶיךָ, עֹז בְּיָדָךְ וּגְבוּרָה בִּימִינָךְ, וּשְׁמָךְ נוֹרָא עַל כָּל מַה שֶּׁבָּרָאתָ. וּבְכֵן תֵּן כָּבוֹד לְעַמֶּךָ, תְּהִלָּה לִירֵאֶיךָ, תִּקְוָה לְדֹרְשֶׁיךָ, פִּתְחוֹן פֶּה לַמְיַחֲלִים לָךְ. שִׂמְחָה לְאַרְצָךְ, שָׂשׂוֹן לְעִירָךְ, צְמִיחוּת קֶרֶן לְדָוִד עַבְדָּךְ, וַעֲרִיכַת נֵר לְבֶן יִשַׁי מְשִׁיחָךְ. וְאָז, צַדִּיקִים יִרְאוּ וְיִשְׂמָחוּ, וִישָׁרִים יַעֲלֹזוּ, וַחֲסִידִים בְּרִנָּה יָגִילוּ, וְעוֹלָתָה תִּקְפָּץ פִּיהָ, וְכָל הָרִשְׁעָה כֻּלָּהּ כֶּעָשָׁן תִּכְלֶה, כִּי תַעֲבִיר מֶמְשֶׁלֶת זָדוֹן מִן הָאָרֶץ, וּמַלְכוּת הָעַלִּיזָה מְהֵרָה תַּעֲקֹר וְתִשְׁבֹּר. וְתִמְלֹךְ אַתָּה הוּא יְיָ אֱלֹהֵינוּ מְהֵרָה עַל כָּל מַעֲשֶׂיךָ, בִּירוּשָׁלַיִם עִירָךְ וּבְהַר צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ, וְנֶגֶד זְקֵנֶיךָ כָּבוֹד. כַּכָּתוּב: וְחָפְרָה הַלְּבָנָה וּבוֹשָׁה הַחַמָּה, כִּי מָלַךְ יְיָ צְבָאוֹת בְּהַר צִיּוֹן וּבִירוּשָׁלַיִם, וְנֶגֶד זְקֵנָיו כָּבוֹד׃ וְנֶאֱמָר: יְיָ יִמְלֹךְ לְעֹלָם וָעֶד׃ וְנֶאֱמָר: וַיִּגְבַּהּ יְיָ צְבָאוֹת בַּמִּשְׁפָּט, וְהָאֵל הַקָּדוֹשׁ נִקְדָּשׁ בִּצְדָקָה׃ בָּרוּךְ אַתָּה יְיָ, הַמֶּלֶךְ הַקָּדוֹשׁ.","when":{"all":["aseretYemeiTeshuva"]}}]]},{"key":"-B6aWyKMsq","he":[[{"t":"אַתָּה חוֹנֵן לָאָדָם דַּעַת, וּמְלַמֵּד לֶאֱנוֹשׁ בִּינָה. חָנֵּנוּ מֵאִתָּךְ דֵּעָה וּבִינָה וְהַשְׂכֵּל. בָּרוּךְ אַתָּה יְיָ, חוֹנֵן הַדָּעַת."}]]},{"key":"h3F877E8r3","he":[[{"t":"הֲשִׁיבֵנוּ אָבִינוּ לְתוֹרָתֶךָ, וְקָרְבֵנוּ מַלְכֵּנוּ לַעֲבוֹדָתֶךָ, וְהַחְזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה, לְפָנֶיךָ. בָּרוּךְ אַתָּה יְיָ, הָרוֹצֶה בַּתְּשׁוּבָה."}]],"en":"Cause us to return, our Father, to Your Torah and bring us near, our King, to Your service; and bring us back in whole-hearted repentance before You Blessed are You, Adonoy, Who desires penitence."},{"key":"fkBLlrN9Kn","he":[[{"t":"סְלַח לָנוּ אָבִינוּ כִּי חָטָאנוּ, מְחֹל לָנוּ מַלְכֵּנוּ כִּי פָשָׁעְנוּ, כִּי אֵל טוֹב וְסַלָּח אָתָּה. בָּרוּךְ אַתָּה יְיָ, חַנּוּן וּמַרְבֶּה לִסְלֹחַ."}]]},{"key":"1ZavEIrD1X","he":[[{"t":"רְאֵה בְעָנְיֵנוּ וְרִיבָה רִיבֵנוּ, וּמַהֵר לְגָאֳלֵנוּ, כִּי אֵל מֶלֶךְ גּוֹאֵל חָזָק אָתָּה. בָּרוּךְ אַתָּה יְיָ, גּוֹאֵל יִשְׂרָאֵל."}]]},{"key":"bQb6WXyx8m","he":[[{"t":"עֲנֵנוּ יְיָ אֱלֹהֵינוּ בְּיוֹם צוֹם הַתַּעֲנִית הַזֶּה, כִּי בְצָרָה גְדוֹלָה אֲנָחְנוּ. אַל תַּסְתֵּר פָּנֶיךָ מִמֶּנּוּ, וְאַל תַּעְלֵם אָזְנְךָ מִשְּׁמֹעַ תְּפִלָּתֵנוּ, וֶהְיֵה קָרוֹב לְשַׁוְעֵנוּ. טֶרֶם נִקְרָא וְאַתָּה תַעֲנֶה, טֶרֶם נְדַבֵּר וְאַתָּה תִשְׁמָע. כַּדָּבָר שֶׁנֶּאֱמָר: וְהָיָה טֶרֶם יִקְרָאוּ וַאֲנִי אֶעֱנֶה, עוֹד הֵם מְדַבְּרִים וַאֲנִי אֶשְׁמָע׃ כִּי אַתָּה עוֹנֶה בְּכָל עֵת צָרָה וְצוּקָה, פּוֹדֶה וּמַצִּיל מִכָּל צָרָה. בָּרוּךְ אַתָּה יְיָ, הָעוֹנֶה בְּעֵת צָרָה."}]],"when":{"all":["publicFast"]},"minyan":{"he":"עננו — שליח הציבור אומר בחזרת הש״ץ","en":"Aneinu — said by the chazzan in the repetition"}},{"key":"otOvDGx0t-","he":[[{"t":"רְפָאֵנוּ יְיָ אֱלֹהֵינוּ וְנֵרָפֵא, הוֹשִׁיעֵנוּ וְנִוָּשֵׁעָה, וְהַעֲלֵה רְפוּאָה שְׁלֵמָה לְכָל תַּחֲלוּאֵינוּ, כִּי אֵל רוֹפֵא רַחֲמָן אָתָּה. בָּרוּךְ אַתָּה יְיָ, רוֹפֵא חוֹלֵי עַמּוֹ יִשְׂרָאֵל."}]]},{"key":"1U5MgPnPHk","he":[[{"t":"בקיץ:","s":"n"},{"t":" בָּרְכֵנוּ יְיָ אֱלֹהֵינוּ בְּכָל מַעֲשֵׂה יָדֵינוּ, וּבָרֵךְ אֶת שְׁנוֹתֵינוּ בְּטַלְלֵי רָצוֹן בְּרָכָה וּנְדָבָה כַּשָּׁנִים הַטּוֹבוֹת. בָּרוּךְ אַתָּה יְיָ, מְבָרֵךְ הַשָּׁנִים."}]],"when":{"none":["talUmatar"]}},{"key":"CPcnbIIQc0","he":[[{"t":"בחורף:","s":"n"},{"t":" בָּרְכֵנוּ יְיָ אֱלֹהֵינוּ בְּכָל מַעֲשֵׂה יָדֵינוּ, וּבָרֵךְ אֶת שְׁנוֹתֵינוּ, וְתֶן טָל וּמָטָר עַל פְּנֵי הָאֲדָמָה, וְשַׂבַּע אֶת הָעוֹלָם כֻּלּוֹ מִטּוּבָךְ, וְרַוֵּה פְּנֵי תֵבֵל מֵעֹשֶׁר מַתְּנוֹת יָדֶיךָ. וְשָׁמְרָה וְהַצִּילָה יְיָ אֱלֹהֵינוּ אֶת הַשָּׁנָה הַזֹּאת וְאֶת כָּל מִינֵי תְבוּאָתָהּ מִכָּל מִינֵי מַשְׁחִית וּמִכָּל מִינֵי פֻרְעָנִיּוֹת, וְתֶן לָהּ אַחֲרִית וְתִקְוָה וְשֹׂבַע וְשָׁלוֹם וּבְרָכָה כַּשָּׁנִים הַטּוֹבוֹת. בָּרוּךְ אַתָּה יְיָ, מְבָרֵךְ הַשָּׁנִים."}]],"when":{"all":["talUmatar"]}},{"key":"MQcn8YNNMr","he":[[{"t":"תְּקַע בְּשׁוֹפָר גָּדוֹל לְחֵרוּתֵנוּ, וְשָׂא נֵס לְקַבֵּץ אֶת כָּל גָּלִיּוֹתֵינוּ מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ לְאַרְצֵנוּ. בָּרוּךְ אַתָּה יְיָ, מְקַבֵּץ נִדְחֵי עַמּוֹ יִשְׂרָאֵל."}]]},{"key":"kMjGGnfTjN","he":[[{"t":"הָשִׁיבָה שׁוֹפְטֵינוּ כְּבָרִאשׁוֹנָה, וְיוֹעֲצֵינוּ כְּבַתְּחִלָּה, וְהָסֵר מִמֶּנּוּ יָגוֹן וַאֲנָחָה, וּמְלֹךְ עָלֵינוּ אַתָּה לְבַדֶּךָ בְּרַחֲמִים בְּצֶדֶק וּבְמִשְׁפָּט. בָּרוּךְ אַתָּה יְיָ, "},{"t":"מֶלֶךְ אוֹהֵב צְדָקָה וּמִשְׁפָּט.","when":{"none":["aseretYemeiTeshuva"]}},{"t":"הַמֶּלֶךְ הַמִּשְׁפָּט.","when":{"all":["aseretYemeiTeshuva"]}}]]},{"key":"zzgUo4f6Au","he":[[{"t":"לַמְּשֻׁמָּדִים אַל תְּהִי תִקְוָה, כָּל הַמִּינִים וְהַמּוֹסְרִים כְּרֶגַע יֹאבֵדוּ, וּמַלְכוּת זָדוֹן תַּעֲקֹר וְתִשְׁבֹּר מְהֵרָה בְיָמֵינוּ. בָּרוּךְ אַתָּה יְיָ, שׁוֹבֵר אוֹיְבִים וּמַכְנִיעַ זֵדִים."}]]},{"key":"eyFue06k_6","he":[[{"t":"עַל הַצַּדִּיקִים וְעַל הַחֲסִידִים וְעַל גֵּרֵי הַצֶּדֶק, וְעַל שְׁאֵרִית עַמְּךָ בֵית יִשְׂרָאֵל, יֶהֱמוּ רַחֲמֶיךָ יְיָ אֱלֹהֵינוּ. וְתֶן שָׂכָר טוֹב לְכָל הַבּוֹטְחִים בְּשִׁמְךָ בֶּאֱמֶת, וְשִׂים חֶלְקֵנוּ עִמָּהֶם, לְעוֹלָם לֹא נֵבוֹשׁ כִּי בְשִׁמְךָ בָטַחְנוּ וְלִישׁוּעָתְךָ נִשְׁעַנּוּ. בָּרוּךְ אַתָּה יְיָ, מִשְׁעָן וּמִבְטָח לַצַּדִּיקִים."}]]},{"key":"WvchGydAIA","he":[[{"t":"בתשעה באב אומרים במקום תשכון:","s":"n"}],[{"t":"רַחֵם יְיָ אֱלֹהֵינוּ עָלֵינוּ וְעַל יִשְׂרָאֵל עַמָּךְ וְעַל יְרוּשָׁלַיִם עִירָךְ, הָעִיר הָאֲבֵלָה, הַחֲרֵבָה, הַשּׁוֹמֵמָה, הַנְּתוּנָה בְיַד זָרִים, הַיּוֹשֶׁבֶת וְרֹאשׁ לָהּ חָפוּי כְּאִשָּׁה עֲקָרָה שֶׁלֹּא יָלָדָה. וַיְבַלְּעוּהָ לִגְיוֹנִים, וַיִּירָשׁוּהָ עוֹבְדֵי פְסִילִים, וַיִּתְּנוּ אֶת נִבְלַת עֲבָדֶיךָ מַאֲכָל לְעוֹף הַשָּׁמַיִם וּלְבֶהֱמַת הָאָרֶץ. עַל כֵּן צִיּוֹן בִּמְרָר תִּבְכֶּה, וִירוּשָׁלַיִם תִּתֵּן קוֹלָהּ: לִבִּי לִבִּי עַל חַלְלֵיהֶם, מֵעַי מֵעַי עַל הֲרוּגֵיהֶם. רְאֵה יְיָ וְהַבִּיטָה, וְרַחֵם שׁוֹמְמוֹתֶיהָ וְנַחֲמֶהָ. כִּי אַתָּה יְיָ בָּאֵשׁ הִצַּתָּהּ, וּבָאֵשׁ אַתָּה עֲתִיד לִבְנוֹתָהּ. כַּכָּתוּב: וַאֲנִי אֶהְיֶה לָּהּ נְאֻם יְיָ חוֹמַת אֵשׁ סָבִיב וּלְכָבוֹד אֶהְיֶה בְתוֹכָהּ׃ בָּרוּךְ אַתָּה יְיָ, בּוֹנֵה יְרוּשָׁלָיִם."}]],"when":{"all":["tishaBav"]}},{"key":"9x5H8feFN9","he":[[{"t":"תִּשְׁכֹּן בְּתוֹךְ יְרוּשָׁלַיִם עִירָךְ כַּאֲשֶׁר דִּבַּרְתָּ, וּבְנֵה אוֹתָהּ בִּנְיַן עוֹלָם בִּמְהֵרָה בְּיָמֵינוּ. בָּרוּךְ אַתָּה יְיָ, בּוֹנֵה יְרוּשָׁלָיִם."}]],"when":{"none":["tishaBav"]}},{"key":"DyCxXx_o1z","he":[[{"t":"אֶת צֶמַח דָּוִד מְהֵרָה תַצְמִיחַ, וְקַרְנוֹ תָּרוּם בִּישׁוּעָתֶךָ. בָּרוּךְ אַתָּה יְיָ, מַצְמִיחַ קֶרֶן הַיְשׁוּעָה."}]]},{"key":"B0FaytwqaN","he":[[{"t":"שְׁמַע קוֹלֵנוּ יְיָ אֱלֹהֵינוּ, חוּס וְרַחֵם עָלֵינוּ, וְקַבֵּל בְּרַחֲמִים וְרָצוֹן אֶת תְּפִלָּתֵנוּ. מִלְּפָנֶיךָ מַלְכֵּנוּ רֵיקָם אַל תְּשִׁיבֵנוּ."}]]},{"key":"PDPVsQJicr","he":[[{"t":"בתענית ציבור:","s":"n"},{"t":" עֲנֵנוּ יְיָ אֱלֹהֵינוּ בְּיוֹם צוֹם הַתַּעֲנִית הַזֶּה, כִּי בְצָרָה גְדוֹלָה אֲנָחְנוּ. אַל תַּסְתֵּר פָּנֶיךָ מִמֶּנּוּ, וְאַל תַּעְלֵם אָזְנְךָ מִשְּׁמֹעַ תְּפִלָּתֵנוּ, וֶהְיֵה קָרוֹב לְשַׁוְעֵנוּ. טֶרֶם נִקְרָא וְאַתָּה תַעֲנֶה, טֶרֶם נְדַבֵּר וְאַתָּה תִשְׁמָע. כַּדָּבָר שֶׁנֶּאֱמָר: וְהָיָה טֶרֶם יִקְרָאוּ וַאֲנִי אֶעֱנֶה, עוֹד הֵם מְדַבְּרִים וַאֲנִי אֶשְׁמָע׃"}]],"when":{"all":["publicFast"]}},{"key":"T9UPRy5lok","he":[[{"t":"כִּי אַתָּה שׁוֹמֵעַ תְּפִלַּת כָּל פֶּה. בָּרוּךְ אַתָּה יְיָ, שׁוֹמֵעַ הַתְּפִלָּה."}]]},{"key":"YSedd1SYBL","he":[[{"t":"רְצֵה יְיָ אֱלֹהֵינוּ בְּעַמְּךָ יִשְׂרָאֵל וְלִתְפִלָּתָם שְׁעֵה, וְהָשֵׁב הָעֲבוֹדָה אֶל דְּבִיר בֵּיתֶךָ וְאִשֵּׁי יִשְׂרָאֵל, וּתְפִלָּתָם מְהֵרָה בְּאַהֲבָה תְּקַבֵּל בְּרָצוֹן, וּתְהִי לְרָצוֹן תָּמִיד עֲבוֹדַת יִשְׂרָאֵל עַמֶּךָ."}]]},{"key":"0opZTXQ14M","he":[[{"t":"בראש חודש ובחול המועד:","s":"n"}],[{"t":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, יַעֲלֶה וְיָבוֹא, יַגִּיעַ, יֵרָאֶה, יֵרָצֶה, יִשָּׁמַע, יִפָּקֵד, יִזָּכֵר לְפָנֶיךָ זִכְרוֹנֵנוּ, זִכְרוֹן אֲבוֹתֵינוּ, זִכְרוֹן יְרוּשָׁלַיִם עִירָךְ, זִכְרוֹן מָשִׁיחַ בֶּן דָּוִד עַבְדָּךְ, זִכְרוֹן כָּל עַמְּךָ בֵּית יִשְׂרָאֵל לְפָנֶיךָ, לִפְלֵטָה, לְטוֹבָה, לְחֵן, לְחֶסֶד וּלְרַחֲמִים,"}],[{"t":"בראש חודש:","s":"n","when":{"all":["roshChodesh"]}},{"t":" בְּיוֹם רֹאשׁ הַחֹדֶשׁ הַזֶּה.","when":{"all":["roshChodesh"]}}],[{"t":"בפסח:","s":"n","when":{"all":["cholHamoedPesach"]}},{"t":" בְּיוֹם מִקְרָא קֹדֶשׁ הַזֶּה, בְּיוֹם מוֹעֵד חַג הַמַּצּוֹת הַזֶּה.","when":{"all":["cholHamoedPesach"]}}],[{"t":"בסוכות:","s":"n","when":{"all":["cholHamoedSukkot"]}},{"t":" בְּיוֹם מִקְרָא קֹדֶשׁ הַזֶּה, בְּיוֹם מוֹעֵד חַג הַסֻּכּוֹת הַזֶּה.","when":{"all":["cholHamoedSukkot"]}}],[{"t":"לְרַחֵם בּוֹ עָלֵינוּ וּלְהוֹשִׁיעֵנוּ. זָכְרֵנוּ יְיָ אֱלֹהֵינוּ בּוֹ לְטוֹבָה, פָּקְדֵנוּ בוֹ לִבְרָכָה, הוֹשִׁיעֵנוּ בוֹ לְחַיִּים, בִּדְבַר יְשׁוּעָה וְרַחֲמִים. חוּס וְחָנֵּנוּ וְרַחֵם עָלֵינוּ, וּמַלְּטֵנוּ בוֹ מִכָּל צָרָה וְיָגוֹן, וְשַׂמְּחֵנוּ בוֹ שִׂמְחָה שְׁלֵמָה, כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה."}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot","roshChodesh"]}},{"key":"84UfV7m9TN","he":[[{"t":"וְתִרְצֵנוּ, וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְנָוְךָ לְצִיּוֹן בְּרַחֲמִים כְּמֵאָז. בָּרוּךְ אַתָּה יְיָ, הַמַּחְזִיר שְׁכִינָתוֹ לְצִיּוֹן."}]]},{"key":"DIks-r40OL","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ, שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ, צוּר חַיֵּינוּ, מָגֵן יִשְׁעֵנוּ. אַתָּה הוּא לְדוֹר וָדוֹר נוֹדֶה לָךְ וּנְסַפֵּר תְּהִלָּתָךְ, עַל חַיֵּינוּ הַמְּסוּרִים בְּיָדָךְ, עַל נִשְׁמוֹתֵינוּ הַפְּקוּדוֹת לָךְ, עַל נִסֶּיךָ וְנִפְלְאוֹתֶיךָ שֶׁבְּכָל עֵת וָעֵת, עֶרֶב וָבֹקֶר וְצָהֳרָיִם."}]]},{"key":"4R4zpFfj8j","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ, שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ, אֱלֹהֵי כָל בָּשָׂר, יוֹצְרֵנוּ וְיוֹצֵר בְּרֵאשִׁית. בְּרָכוֹת וְהוֹדָאוֹת לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עַל שֶׁהֶחֱיִיתָנוּ וְקִיַּמְתָּנוּ. כֵּן תְּחַיֵּנוּ וּתְחָנֵּנוּ וְתֶאֱסֹף גָּלִיּוֹתֵינוּ לְחַצְרוֹת קָדְשָׁךְ, לִשְׁמֹר חֻקֶּיךָ וּלְעָבְדָךְ וְלַעֲשׂוֹת רְצוֹנָךְ בְּלֵבָב שָׁלֵם, עַל שֶׁאָנוּ מוֹדִים לָךְ, בָּרוּךְ אֵל הַהוֹדָאוֹת."}]],"minyan":{"he":"מודים דרבנן — הקהל אומר בחזרת הש״ץ","en":"Modim DeRabbanan — said by the congregation in the chazzan's repetition"}},{"key":"pspq9eEhyx","he":[[{"t":"בחנוכה:","s":"n","when":{"all":["chanukah"]}},{"t":" עַל הַנִּסִּים וְעַל הַגְּבוּרוֹת וְעַל הַמִּלְחָמוֹת וְעַל הַתְּשׁוּעוֹת וְעַל הַפְּדוּת וְעַל הַפֻּרְקָן, שֶׁעָשִׂיתָ עִמָּנוּ וְעִם אֲבוֹתֵינוּ בַּיָּמִים הָהֵם בַּזְּמָן הַזֶּה, בִּימֵי מַתִּתְיָה בֶן יוֹחָנָן כֹּהֵן גָּדוֹל חַשְׁמֻנַּאי וּבָנָיו, כְּשֶׁעָמְדָה מַלְכוּת יָוָן הָרִשְׁעָה עַל עַמְּךָ בֵית יִשְׂרָאֵל, לְבַטְּלָם מִתּוֹרָתֶךָ וּלְהַעֲבִירָם מֵחֻקֵּי רְצוֹנֶךָ. וְאַתָּה בְּרַחֲמֶיךָ הָרַבִּים עָמַדְתָּ לָהֶם בְּעֵת צָרָתָם, וְדַנְתָּ אֶת דִּינָם וְרַבְתָּ אֶת רִיבָם וְנָקַמְתָּ אֶת נִקְמָתָם, וּמָסַרְתָּ גִּבּוֹרִים בְּיַד חַלָּשִׁים וְרַבִּים בְּיַד מְעַטִּים וּטְמֵאִים בְּיַד טְהוֹרִים וּרְשָׁעִים בְּיַד צַדִּיקִים וּפוֹשְׁעִים בְּיַד עוֹשֵׂי תוֹרָתֶךָ. וְעָשִׂיתָ לְךָ שֵׁם גָּדוֹל בְּעוֹלָמֶךָ, וּלְעַמְּךָ יִשְׂרָאֵל עָשִׂיתָ פֶלֶא וְנִסִּים. כְּשֵׁם שֶׁעָשִׂיתָ עִמָּהֶם נִסִּים וּגְבוּרוֹת, כָּךְ עֲשֵׂה עִמָּנוּ נִסִּים וּגְבוּרוֹת בָּעֵת וּבָעוֹנָה הַזֹּאת. וְעַל כֻּלָּם יְיָ אֱלֹהֵינוּ, אָנוּ מוֹדִים לָךְ.","when":{"all":["chanukah"]}}],[{"t":"בפורים:","s":"n","when":{"all":["purim"]}},{"t":" עַל הַנִּסִּים וְעַל הַגְּבוּרוֹת וְעַל הַתְּשׁוּעוֹת שֶׁעָשִׂיתָ עִמָּנוּ וְעִם אֲבוֹתֵינוּ בַּיָּמִים הָהֵם בַּזְּמָן הַזֶּה, בִּימֵי מָרְדֳּכַי וְאֶסְתֵּר, כְּשֶׁעָמַד הָמָן הָרָע עַל עַמְּךָ בֵית יִשְׂרָאֵל, וּבִקֶּשׁ לְהַשְׁמִיד לַהֲרֹג וּלְאַבֵּד אֶת כָּל הַיְּהוּדִים מִנַּעַר וְעַד זָקֵן טַף וְנָשִׁים בְּיוֹם אֶחָד וּשְׁלָלָם לָבוֹז, וְאַתָּה בְּרַחֲמֶיךָ הָרַבִּים עָמַדְתָּ לָהֶם בְּעֵת צָרָתָם, וְדַנְתָּ אֶת דִּינָם וְרַבְתָּ אֶת רִיבָם וְנָקַמְתָּ אֶת נִקְמָתָם, וְהֵפַרְתָּ אֶת עֲצָתוֹ וְקִלְקַלְתָּ אֶת מַחֲשַׁבְתּוֹ וַהֲשֵׁבוֹתָ לוֹ גְּמוּלוֹ בְּרֹאשׁוֹ, וְתָלוּ אוֹתוֹ וְאֶת בָּנָיו עַל הָעֵץ. וְעָשִׂיתָ לְךָ שֵׁם גָּדוֹל בְּעוֹלָמֶךָ, וּלְעַמְּךָ יִשְׂרָאֵל עָשִׂיתָ פֶלֶא וְנִסִּים. כְּשֵׁם שֶׁעָשִׂיתָ עִמָּהֶם פֶּלֶא וְנִסִּים, כָּךְ עֲשֵׂה עִמָּנוּ נִסִּים וּגְבוּרוֹת בָּעֵת וּבָעוֹנָה הַזֹּאת. וְעַל כֻּלָּם יְיָ אֱלֹהֵינוּ, אָנוּ מוֹדִים לָךְ.","when":{"all":["purim"]}}],[{"t":"הַטּוֹב כִּי לֹא כָלוּ רַחֲמֶיךָ, הַמְרַחֵם כִּי לֹא תַמּוּ חֲסָדֶיךָ. כָּל הַחַיִּים יְהַלְלוּ אֶת שְׁמָךְ הַגָּדוֹל כִּי טוֹב הָאֵל הַטּוֹב."}],[{"t":"בעשרת ימי תשובה:","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" זְכֹר רַחֲמֶיךָ יְיָ אֱלֹהֵינוּ, וּכְבֹשׁ כַּעַסְךָ, וּכְתֹב לְחַיִּים, כָּל בְּנֵי בְרִיתָךְ.","when":{"all":["aseretYemeiTeshuva"]}}],[{"t":"בָּרוּךְ אַתָּה יְיָ, הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת."}]]},{"key":"r2v975WZF_","he":[[{"t":"הכהנים אומרים בלחש:","s":"n"},{"t":" יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ, שֶׁתִּהְיֶה הַבְּרָכָה שֶׁצִּוִּיתָנוּ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּרָכָה שְׁלֵמָה, וְאַל יְהִי בָהּ מִכְשׁוֹל וְעָוֹן מֵעַתָּה וְעַד עוֹלָם."}]],"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"Oc3ocMCnKr","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בִּקְדֻשָּׁתוֹ שֶׁלְּאַהֲרֹן, וְצִוָּנוּ לְבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בְּאַהֲבָה."}]],"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"nSehuRApiP","he":[[{"t":"מכריזים:","s":"n"},{"t":" כֹּהֲנִים!"}]],"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"p8s3wR3bav","he":[[{"t":"יְבָרֶכְךָ יְיָ וְיִשְׁמְרֶךָ׃ אָמֵן"}],[{"t":"יָאֵר יְיָ פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ׃ אָמֵן"}],[{"t":"יִשָּׂא יְיָ פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃ אָמֵן"}]],"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"8TyXPsQAhw","he":[[{"t":"הכהנים אומרים בלחש:","s":"n"},{"t":" עָשִׂינוּ מַה שֶּׁגָּזַרְתָּ עָלֵינוּ, עֲשֵׂה עִמָּנוּ מַה שֶּׁהִבְטַחְתָּנוּ. הַשְׁקִיפָה מִמְּעוֹן קָדְשְׁךָ מִן הַשָּׁמַיִם, וּבָרֵךְ אֶת עַמְּךָ אֶת יִשְׂרָאֵל."}]],"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"t7T4Ns8QeI","he":[[{"t":"אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, בָּרְכֵנוּ בַבְּרָכָה הַמְּשֻׁלֶּשֶׁת בַּתּוֹרָה הָאֲמוּרָה לְאַהֲרֹן וּלְבָנָיו הַכֹּהֲנִים עַם קְדוֹשֶׁיךָ כָּאָמוּר: יְבָרֶכְךָ יְיָ וְיִשְׁמְרֶךָ׃ כֵּן יְהִי רָצוֹן. יָאֵר יְיָ פָּנָיו אֵלֶיךָ וִיחֻנֶּךָּ׃ כֵּן יְהִי רָצוֹן. יִשָּׂא יְיָ פָּנָיו אֵלֶיךָ וְיָשֵׂם לְךָ שָׁלוֹם׃ כֵּן יְהִי רָצוֹן. וְשָׂמוּ אֶת שְׁמִי עַל בְּנֵי יִשְׂרָאֵל, וַאֲנִי אֲבָרֲכֵם׃"}]],"optional":{"he":"כשאין כהנים נושאים כפיים, שליח הציבור אומר","en":"When no kohanim bless the congregation, the chazzan says"},"minyan":{"he":"ברכת כהנים — רק בחזרת הש״ץ","en":"The Priestly Blessing — only in the chazzan's repetition"}},{"key":"6X0s5O6udq","he":[[{"t":"שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה, חֵן וְחֶסֶד וְרַחֲמִים, עָלֵינוּ וְעַל יִשְׂרָאֵל עַמֶּךָ, וּבָרְכֵנוּ כֻּלָּנוּ כְּאֶחָד מִמְּאוֹר פָּנֶיךָ. כִּי מִמְּאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְיָ אֱלֹהֵינוּ, תּוֹרָה וְחַיִּים, אַהֲבָה וְחֶסֶד, צְדָקָה וְשָׁלוֹם. וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת בַּשָּׁלוֹם."}],[{"t":"בעשרת ימי תשובה:","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" וּבְסֵפֶר חַיִּים בְּרָכָה וְשָׁלוֹם, וְנִזָּכֵר וְנִכָּתֵב לְפָנֶיךָ, אָנוּ וְכָל עַמְּךָ בֵּית יִשְׂרָאֵל, לְחַיִּים וּלְשָׁלוֹם.","when":{"all":["aseretYemeiTeshuva"]}}],[{"t":"בָּרוּךְ אַתָּה יְיָ, הַמְּבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם. אָמֵן."}]]},{"key":"KUnF_NIZvZ","he":[[{"t":"עד כאן בתפילת שליח הציבור.","s":"n"}]]},{"key":"TS1sC_8oQF","he":[[{"t":"ובתפילת הלחש מוסיפים:","s":"n"}]]},{"key":"LBNRUHtNlB","he":[[{"t":"יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ, יְיָ צוּרִי וְגֹאֲלִי׃"}]]},{"key":"oTZBRuy4Ua","he":[[{"t":"אֱלֹהַי. נְצֹר לְשׁוֹנִי מֵרָע וְשִׂפְתוֹתַי מִדַּבֵּר מִרְמָה. וְלִמְקַלְלַי נַפְשִׁי תִדֹּם. וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה. פְּתַח לִבִּי בְּתוֹרָתֶךָ, וְאַחֲרֵי מִצְוֹתֶיךָ תִּרְדֹּף נַפְשִׁי. וְכָל הַקָּמִים עָלַי לְרָעָה, מְהֵרָה הָפֵר עֲצָתָם וְקַלְקֵל מַחְשְׁבוֹתָם. יִהְיוּ כְּמֹץ לִפְנֵי־רוּחַ וּמַלְאַךְ יְיָ דּוֹחֶה׃"}]]},{"key":"tYQSZMuIae","he":[[{"t":"עֲשֵׂה לְמַעַן שְׁמָךְ. עֲשֵׂה לְמַעַן יְמִינָךְ. עֲשֵׂה לְמַעַן תּוֹרָתָךְ. עֲשֵׂה לְמַעַן קְדֻשָּׁתָךְ. לְמַעַן יֵחָלְצוּן יְדִידֶיךָ הוֹשִׁיעָה יְמִינְךָ וַעֲנֵנִי׃"}]]},{"key":"JFPYpwq7Im","he":[[{"t":"יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ, יְיָ צוּרִי וְגֹאֲלִי׃"}]]},{"key":"_mDxJzwaZe","he":[[{"t":"עֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו, הוּא בְרַחֲמָיו וַחֲסָדָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל, וִינַחֲמֵנוּ בְצִיּוֹן וְיִבְנֶה בְרַחֲמָיו אֶת יְרוּשָׁלָיִם בְּחַיֵּינוּ וּבְיָמֵינוּ בְּקָרוֹב, אָמֵן וְאָמֵן."}]]}]},{"title":{"he":"נטילת לולב","en":"Taking the Lulav"},"segments":[{"key":"nhLKFKCLSu","he":[[{"t":"וכשגומר ש\"צ החזרה מברך על נטילת לולב וגומרין ההלל בברכה תחלה וסוף.","s":"n"}]],"when":{"all":["cholHamoedSukkot"]}},{"key":"0WDArtKGpv","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ עַל נְטִילַת לוֹלָב: "},{"t":"וביום ראשון לנטילה יברך שהחיינו:","s":"n","when":{"all":["lulavShehecheyanu"]}}]],"when":{"all":["cholHamoedSukkot"]}},{"key":"Ao86Q2s3I6","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁהֶחֱייָנוּ וְקִיְּמָנוּ וְהִגִּיעָנוּ לַזְּמָן הַזֶּה:"}]],"when":{"all":["cholHamoedSukkot","lulavShehecheyanu"]}},{"key":"jSvnNa64EO","he":[[{"t":"ביום שביעי שהוא יום הושענא רבה נוטלין בו ערבה חדשה חוץ מערבה שבלולב ושונין כל ההושענות ומקיפין שבעה פעמים בלולב ובערבה","s":"n"}]],"when":{"all":["hoshanaRabba"]}}]},{"title":{"he":"הלל","en":"Hallel"},"chapter":{"he":"הלל","en":"Hallel"},"optional":{"he":"יש נוהגים לומר הלל היום","en":"Some say Hallel today","when":{"all":["hallelDisputed"]}},"segments":[{"key":"I_NelGBubb","he":[[{"t":"ואח\"כ קורין ההלל בדילוג. וזהו סדר הדילוג: קורא מתחילת ההלל עד חלמיש למעינו מים, ומדלג ואומר ה' זכרנו יברך עד ואנחנו נברך יה, ומדלג ואומר מה אשיב לה' עד בתוככי ירושלם הללויה, ומדלג ואומר מן המצר קראתי יה עד סוף ההלל. וכשמגיע לאודך, ש\"צ מתחיל להם והם עונים אחריו כל פסוק. ואינו מברך לא לפניו ולא לאחריו. ואין נופלין על פניהם.","s":"n"}]],"when":{"all":["roshChodesh","hallelHalf"]}},{"key":"N3hJmIMGyG","he":[[{"t":"וכשגומר ש\"צ תפלת התמיד קורא את ההלל שלם, ומברך לפניו ולאחריו, כמו שנזכיר בסדר לילי הפסח.","s":"n"}]],"when":{"all":["chanukah"]}},{"key":"2uT0I3Hs9e","he":[[{"t":"וקורין ההלל בדילוג בלא ברכה.","s":"n"}]],"when":{"all":["cholHamoedPesach"]}},{"key":"zZlerM3P-a","he":[[{"t":"יש אומרים אותו בברכה ויש בלא ברכה.","s":"n"}]],"en":"Some say it with its blessings and some without.","when":{"any":["hallelDisputed","hallelHalf","hallelWhole"],"all":["hallelDisputed"]}},{"key":"UUVspYwa3m","he":[[{"t":"ובימים שגומרים בהם ההלל יברך","s":"n"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"],"all":["hallelWhole"]}},{"key":"4T1PHUrWck","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לִגְמוֹר אֶת הַהַלֵּל:"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"],"all":["hallelWhole"]}},{"key":"YWprw_IYcJ","he":[[{"t":"הַלְלוּ יָהּ הַלְלוּ עַבְדֵי יְיָ הַלְלוּ אֶת־שֵׁם יְיָ׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"sT-6HwJFeg","he":[[{"t":"יְהִי שֵׁם יְיָ מְבֹרָךְ מֵעַתָּה וְעַד־עוֹלָם׃ מִמִּזְרַח שֶׁמֶשׁ עַד מְבוֹאוֹ מְהֻלָּל שֵׁם יְיָ: רָם עַל־כָּל־גּוֹיִם יְיָ עַל הַשָּׁמַיִם כְּבוֹדוֹ׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"C0ZSFKlcbD","he":[[{"t":"מִי כַּייָ אֱלֹהֵינוּ הַמַּגְבִּיהִי לָשָׁבֶת׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"VCzoOfd5Et","he":[[{"t":"הַמַּשְׁפִּילִי לִרְאוֹת בַּשָּׁמַיִם וּבָאָרֶץ׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"lLcxjJtd_w","he":[[{"t":"מְקִימִי מֵעָפָר דָּל מֵאַשְׁפֹּת יָרִים אֶבְיוֹן׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"p5eH1D3UDe","he":[[{"t":"לְהוֹשִׁיבִי עִם־נְדִיבִים עִם נְדִיב