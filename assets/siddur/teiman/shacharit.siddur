elHalf","hallelWhole"]}},{"key":"u0Lrw0jHZU","he":[[{"t":"לֹא אָמוּת כִּי־אֶחְיֶה וַאֲסַפֵּר מַעֲשֵׂי יָהּ׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"NRwe3ZIBE_","he":[[{"t":"יַסֹּר יִסְּרַנִּי יָּהּ וְלַמָּוֶת לֹא נְתָנָנִי׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"B6VxD-IBNM","he":[[{"t":"פִּתְחוּ־לִי שַׁעֲרֵי־צֶדֶק אָבֹא־בָם אוֹדֶה יָהּ׃"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"5iQH8VY8fe","he":[[{"t":"זֶה־הַשַּׁעַר לַייָ צַדִּיקִים יָבֹאוּ בוֹ׃ אוֹדְךָ כִּי עֲנִיתָנִי וַתְּהִי לִי לִישׁוּעָה: "},{"t":"אודך","s":"n"},{"t":" אֶבֶן מָאֲסוּ הַבּוֹנִים הָיְתָה לְרֹאשׁ פִּנָּה: "},{"t":"אבן","s":"n"},{"t":" מֵאֵת יְיָ הָיְתָה זֹּאת הִיא נִפְלָאת בְּעֵינֵינוּ: "},{"t":"מאת","s":"n"},{"t":" זֶה הַיּוֹם עָשָׂה יְיָ נָגִילָה וְנִשְׂמְחָה בוֹ: "},{"t":"זה","s":"n"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"eF6EkzYU6c","he":[[{"t":"אָנָּא יְיָ הוֹשִׁיעָה נָּא: "},{"t":"אנא","s":"n"},{"t":" אָנָּא יְיָ הַצְלִיחָה נָּא: "},{"t":"אנא","s":"n"},{"t":" בָּרוּךְ הַבָּא: "},{"t":"ועונים הקהל:","s":"n"},{"t":" בְּשֵׁם יְיָ: בֵּרַכְנוּכֶם מִבֵּית יְיָ: "},{"t":"ברכנוכם","s":"n"},{"t":" אֵל יְיָ וַיָּאֶר לָנוּ: "},{"t":"אל","s":"n"},{"t":" אִסְרוּ חַג בַּעֲבֹתִים עַד קַרְנוֹת הַמִּזְבֵּחַ: "},{"t":"אסרו","s":"n"},{"t":" אֵלִי אַתָּה וְאוֹדֶךָּ: "},{"t":"אלי","s":"n"},{"t":" אֱלֹהַי אֲרוֹמְמֶךָּ: "},{"t":"אלהי","s":"n"},{"t":" הוֹדוּ לַֽייָ כִּי טוֹב כִּי לְעוֹלָם חַסְדּוֹ: "},{"t":"הודו","s":"n"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"]}},{"key":"zM1pE76VkW","he":[[{"t":"יְהַלְלוּךָ יְיָ אֱלֹהֵינוּ כָּל מַעֲשֶׂיךָ וַחֲסִידֶיךָ וְצַדִּיקִים עֹשֵׂי רְצוֹנֶךָ וְכָל עַמְּךָ בֵּית יִשְׂרָאֵל בְּרִנָּה יוֹדוּ לְשִׁמְךָ כִּי אַתָּה יְיָ לְךָ טוֹב לְהוֹדוֹת וּלְשִׁמְךָ נָעִים לְזַמֵּר וּמֵעוֹלָם וְעַד עוֹלָם אַתָּה הוּא הָאֵל. בָּרוּךְ אַתָּה יְיָ הָאֵל הַמֶּלֶךְ הַמְּהוּלָּל הַמְּשׁוּבָּח הַמְּפוֹאָר חַי וְקַיָּם תָּמִיד יִמְלוֹךְ לְעוֹלָם וָעֶד:"}]],"when":{"any":["hallelDisputed","hallelHalf","hallelWhole"],"all":["hallelWhole"]}},{"key":"DNsagyLEQK","he":[[{"t":"ואומר קדיש תתקבל ומוציאין ספר תורה ואומר בפתח ההיכל, יהי ה' אלהינו עמנו וכו' ויהי בנסוע וכו' וקורין בו ד' גוברי ראשו' קורא בפ' צו את בני ישראל ג' פסוקים עד ואמרת להם ולוי חוזר וקורא ואמרת להם עם שני פסוקים אחריו וג' קורא עולת תמיד ופ' וביום השבת והד' קורא ובראשי חדשיכם עד סוף הסדר ואומר קדיש, מה רב טובך וכו' ומברך למלך ולקהל ומחזיר ס\"ת למקומו ואומר יהללו את שם ה' וכו' ומתחילין סדר היום והוא רחום תהלה לדוד עד סופו ואין אומרים למנצח יענך ואומר ובא לציון וגומר הסדר ואומר מזמור של יום.","s":"n"}]],"when":{"all":["roshChodesh","hallelHalf"]}},{"key":"lL2RKsHpC7","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"when":{"any":["hallelHalf","hallelWhole"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"a4iwyxlH9q","he":[[{"t":"תִּתְקַבַּל צְלוֹתְכוֹן וְתִתְעֲבֵיד בָּעוּתְכוֹן וּצְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל בֵּית יִשְׂרָאֵל קֳדָם אֲבוּנָא דְּבִשְׁמַיָא: יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָא וְסִיַּעְתָּא וּפוּרְקָנָא ורְוַוחָא וְחִנָּא וְחִסְדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשְׂרָאֵל לְחַיִּים וּלְשָׁלוֹם וְאִמְרוּ אָמֵן: עוֹשֶׂה שָׁלוֹם וכו':"}]],"when":{"any":["hallelHalf","hallelWhole"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"תחנון","en":"Tachanun"},"segments":[{"key":"qgV27GKDcS","he":[[{"t":"יש קהילות שאינן אומרות תחנון היום.","s":"n"}]],"en":"Some communities do not say Tachanun today.","when":{"all":["tachanunShacharit","tachanunDisputed"]}},{"key":"0ChoD-FbDy","he":[[{"t":"לְפָנֶיךָ אֲנִי כּוֹרֵעַ וּמִשְׁתַּחֲוֶה וּמִתְחַנֵּן, אֲדוֹן הָעוֹלָם, אֱלֹהֵי הָאֱלֹהִים וַאֲדֹנֵי הָאֲדֹנִים."}],[{"t":"כִּי לֹא עַל צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ, כִּי עַל רַחֲמֶיךָ הָרַבִּים."}],[{"t":"מַה נֹּאמַר לַייָ, מַה נְּדַבֵּר וּמַה נִּצְטַדָּק."}],[{"t":"חָטָאנוּ וְעָוִינוּ וְהִרְשַׁעְנוּ וּמָרָדְנוּ, וְסוֹר מִמִּצְוֹתֶךָ וּמִמִּשְׁפָּטֶיךָ."}],[{"t":"לְךָ אֲדֹנָי הַצְּדָקָה, וְלָנוּ בֹּשֶׁת הַפָּנִים."}],[{"t":"הָשְׁחֳרוּ פָנֵינוּ מִפְּנֵי אַשְׁמָתֵנוּ, וְנִכְפְּפָה קוֹמָתֵנוּ מִפְּנֵי עֲוֹנוֹתֵינוּ."}],[{"t":"אֵין לָנוּ פֶּה לְהָשִׁיב וְלֹא מֵצַח לְהָרִים רֹאשׁ."}],[{"t":"אֱלֹהַי, בֹּשְׁתִּי וְנִכְלַמְתִּי לְהָרִים אֱלֹהַי פָּנַי אֵלֶיךָ, כִּי עֲוֹנֹתֵינוּ רָבוּ לְמַעְלָה רֹּאשׁ, וְאַשְׁמָתֵנוּ גָדְלָה עַד לַשָּׁמָיִם."}],[{"t":"אֵין בָּנוּ מַעֲשִׂים, עֲשֵׂה עִמָּנוּ צְדָקָה לְמַעַן שְׁמֶךָ."}],[{"t":"כְּמוֹ שֶׁהִבְטַחְתָּנוּ עַל יַד נְבִיאֶךָ:"}],[{"t":"לְמַעַן שְׁמִי אַאֲרִיךְ אַפִּי, וּתְהִלָּתִי אֶחֱטָם לָךְ, לְבִלְתִּי הַכְרִיתֶךָ."}],[{"t":"לֹא לְמַעַנְכֶם אֲנִי עֹשֶׂה בֵּית יִשְׂרָאֵל, כִּי אִם לְשֵׁם קָדְשִׁי."}],[{"t":"לֹא לָנוּ יְיָ לֹא לָנוּ כִּי לְשִׁמְךָ תֵּן כָּבוֹד עַל חַסְדְּךָ עַל אֲמִתֶּךָ."}],[{"t":"לָמָּה יֹאמְרוּ הַגּוֹיִם אַיֵּה נָא אֱלֹהֵיהֶם."}],[{"t":"אָנָּא יְיָ. אַל תֵּפֶן אֶל קְשִׁי הָעָם הַזֶּה וְאֶל רִשְׁעוֹ וְאֶל חַטָּאתוֹ."}],[{"t":"סְלַח נָא לַעֲוֹן הָעָם הַזֶּה כְּגֹדֶל חַסְדֶּךָ, וְכַאֲשֶׁר נָשָׂאתָה לָעָם הַזֶּה מִמִּצְרַיִם וְעַד הֵנָּה."}],[{"t":"לְמַעַן שִׁמְךָ יְיָ, וְסָלַחְתָּ לַעֲוֹנִי כִּי רַב הוּא."}],[{"t":"אֲדֹנָי שְׁמָעָה, אֲדֹנָי סְלָחָה, אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל תְּאַחַר, לְמַעַנְךָ אֱלֹהַי כִּי שִׁמְךָ נִקְרָא עַל עִירְךָ וְעַל עַמֶּךָ."}]],"when":{"all":["tachanunShacharit"]}},{"key":"8huqM8yrc0","he":[[{"t":"אָבִינוּ מַלְכֵּנוּ חָטָאנוּ לְפָנֶיךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ אֵין לָנוּ מֶלֶךְ אֵלָא אָתָּה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ עֲשֵׂה עִמָּנוּ לְמַעַן שְׁמֶךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ חַדֵּשׁ עָלֵינוּ שָׁנָה טוֹבָה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ בַּטֵּל מֵעָלֵינוּ כָּל גְּזֵרוֹת קָשׁוֹת וְרָעוֹת."}],[{"t":"אָבִינוּ מַלְכֵּנוּ בַּטֵּל מַחְשְׁבוֹת שׂוֹנְאֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ הָפֵר עֲצַת כָּל אוֹיְבֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כַּלֵּה כָּל צַר וּמַשְׂטִין מֵעָלֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כַּלֵּה דֶּבֶר וְחֶרֶב וְרָעָב וּשְׁבִי וּבִזָּה וּמַשְׁחִית וּמַגֵּפָה וְשָׂטָן וְיֵצֶר רָע וָחֳלָיִם מִבְּנֵי בְרִיתֶךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ שְׁלַח רְפוּאָה שְׁלֵמָה לְחוֹלֵי עַמֶּךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ מְנַע מַגֵּפָה מִנַּחֲלָתֶךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ זְכֹר כִּי עָפָר אֲנָחְנוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ מְחֹל וּסְלַח לְכָל עֲוֹנוֹתֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ קְרַע רֹעַ גְּזָר דִּינֵנוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ מְחֹק בְּרַחֲמֶיךָ הָרַבִּים כָּל שִׁטְרֵי חוֹבוֹתֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ מְחֵה וְהַעֲבֵר פְּשָׁעֵינוּ מִנֶּגֶד עֵינֶיךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כָּתְבֵנוּ בְּסֵפֶר חַיִּים טוֹבִים."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כָּתְבֵנוּ בְּסֵפֶר פַּרְנָסָה וְכַלְכָּלָה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כָּתְבֵנוּ בְּסֵפֶר מְחִילָה וּסְלִיחָה וְכַפָּרָה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ כָּתְבֵנוּ בְּסֵפֶר גְּאֻלָּה וִישׁוּעָה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ זָכְרֵנוּ בְּזִכְרוֹן טוֹב מִלְּפָנֶיךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ הַצְמִיחַ לָנוּ יְשׁוּעָה בְּקָרוֹב."}],[{"t":"אָבִינוּ מַלְכֵּנוּ הָרֵם קֶרֶן יִשְׂרָאֵל עַמֶּךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ וְהָרֵם קֶרֶן מְשִׁיחֶךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ הַחְזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ שְׁמַע קוֹלֵנוּ, חוּס וְרַחֵם עָלֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ עֲשֵׂה לְמַעֲנָךְ אִם לֹא לְמַעֲנֵנוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ קַבֵּל בְּרַחֲמִים וּבְרָצוֹן אֶת תְּפִלָּתֵנוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ נָא אַל תְּשִׁיבֵנוּ רֵיקָם מִלְּפָנֶיךָ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ "},{"t":"אָבִינוּ מַלְכֵּנוּ","s":"b"},{"t":"."}]],"when":{"all":["aseretYemeiTeshuva","tachanunShacharit"]}},{"key":"McJ9v3WkjN","he":[[{"t":"אָנָּא אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, תָּבוֹא לְפָנֶיךָ תְּפִלָּתֵנוּ וְאַל תִּתְעַלַּם מַלְכֵּנוּ מִתְּחִנָּתֵנוּ. שֶׁאֵין אָנוּ עַזֵּי פָנִים וּקְשֵׁי עֹרֶף לוֹמַר לְפָנֶיךָ צַדִּיקִים אֲנַחְנוּ וְלֹא חָטָאנוּ. אֲבָל חָטָאנוּ אֲנַחְנוּ וַאֲבוֹתֵינוּ. אָשַׁמְנוּ. בָּגַדְנוּ. גָּזַלְנוּ. דִּבַּרְנוּ דֹפִי. הֶעֱוִינוּ. וְהִרְשָׁעְנוּ. זַדְנוּ. חָמַסְנוּ. טָפַלְנוּ שֶׁקֶר. יָעַצְנוּ רָע. כִּזַּבְנוּ. לַצְנוּ. מָרַדְנוּ. נִאַצְנוּ. סָרַרְנוּ. עָוִינוּ. פָּשַׁעְנוּ. צֵרַרְנוּ. קִשִּׁינוּ עֹרֶף. רָשַׁעְנוּ. שִׁחַתְנוּ. תָּעִינוּ. תִּעַבְנוּ. תִּעְתָּעְנוּ. סַרְנוּ מִמִּצְוֹתֶיךָ וּמִמִּשְׁפָּטֶיךָ הַטּוֹבִים וְלֹא שָׁוָה לָנוּ. וְאַתָּה צַדִּיק עַל כָּל הַבָּא עָלֵינוּ, כִּי אֱמֶת עָשִׂיתָ וַאֲנַחְנוּ הִרְשָׁעְנוּ׃"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"WfR1sReGPn","he":[[{"t":"מַה נֹּאמַר לְפָנֶיךָ יוֹשֵׁב מָרוֹם. מַה נְּסַפֵּר לְפָנֶיךָ שׁוֹכֵן שְׁחָקִים. הֲלֹא הַנִּסְתָּרוֹת וְהַנִּגְלוֹת אַתָּה יוֹדֵעַ. אַתָּה יוֹדֵעַ רָזֵי עוֹלָם וְתַעֲלוּמוֹת סִתְרֵי כָל חָי. אַתָּה חוֹפֵשׂ כָּל חַדְרֵי בֶטֶן וְרוֹאֶה כְלָיוֹת וָלֵב. אֵין כָּל דָּבָר נֶעְלָם מִמֶּךָּ, וְאֵין נִסְתָּר מִנֶּגֶד עֵינֶיךָ. יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, שֶׁתִּמְחֹל לָנוּ עַל כָּל חַטֹּאתֵינוּ, וּתְכַפֵּר לָנוּ אֶת כָּל עֲוֹנוֹתֵינוּ, וְתִסְלַח לְכָל פְּשָׁעֵינוּ."}],[{"t":"וְסָלַחְתָּ לַעֲוֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ׃"}],[{"t":"כִּי־אַתָּה אֲדֹנָי טוֹב וְסַלָּח וְרַב־חֶסֶד לְכָל־קֹרְאֶיךָ׃"}],[{"t":"לְמַעַן שִׁמְךָ יְיָ, וְסָלַחְתָּ לַעֲוֹנֵנוּ, כִּי רַב הוּא׃"}],[{"t":"לְמַעַן שִׁמְךָ יְיָ תְּחַיֵּנוּ, בְּצִדְקָתְךָ תּוֹצִיא מִצָּרָה נַפְשֵׁנוּ׃"}],[{"t":"יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב־לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃"}],[{"t":"יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃"}],[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}],[{"t":"הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה, חַדֵּשׁ יָמֵינוּ כְּקֶדֶם׃"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"iUnj2KnUBO","he":[[{"t":"חזן:","s":"n"},{"t":" וַיַּעֲבֹר יְיָ עַל פָּנָיו וַיִּקְרָא."}],[{"t":"קהל וחזן:","s":"n"},{"t":" יְיָ יְיָ אֵל רַחוּם וְחַנּוּן אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת׃ נֹצֵר חֶסֶד לָאֲלָפִים נֹשֵׂא עָוֺן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה׃"}],[{"t":"[וְאַעְבַּר יְיָ שְׁכִינְתֵיהּ עַל אַפּוֹהִי וּקְרָא. יְיָ יְיָ אֱלָהָא רַחְמָנָא וְחַנָּנָא מַרְחֵק רְגַז וּמַסְגֵּי לְמֶעֱבַד טָבְוָן וּקְשֹׁט׃ נָטֵר טֵיבוּ לְאַלְפֵי דָרִין שָׁבֵק לַעֲוָיָן וְלִמְרֹד וּלְחוֹבִין סָלַח׃ וְסָלַחְתָּ לַעֲוֹנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ׃]"}],[{"t":"חזן:","s":"n"},{"t":" וְסָלַחְתָּ לַעֲוֺנֵנוּ וּלְחַטָּאתֵנוּ וּנְחַלְתָּנוּ׃"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]},"minyan":{"he":"נאמר רק במניין","en":"Said only with a minyan"}},{"key":"FiycywLw8j","he":[[{"t":"וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃"}],[{"t":"אַתָּה יְיָ לֹא תִכְלָא רַחֲמֶיךָ מִמֶּנּוּ, חַסְדְּךָ וַאֲמִתְּךָ תָּמִיד יִצְּרוּנוּ׃"}],[{"t":"הוֹשִׁיעֵנוּ יְיָ אֱלֹהֵינוּ וְקַבְּצֵנוּ מִן־הַגּוֹיִם לְהֹדוֹת לְשֵׁם קָדְשֶׁךָ לְהִשְׁתַּבֵּחַ בִּתְהִלָּתֶךָ׃"}],[{"t":"אִם־עֲוֺנוֹת תִּשְׁמָר־יָהּ אֲדֹנָי מִי יַעֲמֹד׃ כִּי־עִמְּךָ הַסְּלִיחָה לְמַעַן תִּוָּרֵא׃"}],[{"t":"לֹא כַחֲטָאֵינוּ עָשָׂה לָנוּ וְלֹא כַעֲוֺנֹתֵינוּ גָּמַל עָלֵינוּ׃"}],[{"t":"אִם עֲוֹנֵינוּ עָנוּ בָנוּ, יְיָ עֲשֵׂה לְמַעַן שְׁמֶךָ׃"}],[{"t":"זְכֹר־רַחֲמֶיךָ יְיָ וַחֲסָדֶיךָ כִּי מֵעוֹלָם הֵמָּה׃"}],[{"t":"יַעַנְךָ יְיָ בְּיוֹם צָרָה יְשַׂגֶּבְךָ שֵׁם אֱלֹהֵי יַעֲקֹב׃"}],[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}],[{"t":"אָבִינוּ מַלְכֵּנוּ חָנֵּנוּ וַעֲנֵנוּ כִּי אֵין בָּנוּ מַעֲשִׂים, עֲשֵׂה עִמָּנוּ צְדָקָה כְּרֹב רַחֲמֶיךָ וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ."}],[{"t":"וְעַתָּה אֲדֹנָי אֱלֹהֵינוּ אֲשֶׁר הוֹצֵאתָ אֶת עַמְּךָ מֵאֶרֶץ מִצְרַיִם בְּיָד חֲזָקָה וַתַּעַשׂ לְךָ שֵׁם כַּיּוֹם הַזֶּה, חָטָאנוּ רָשָעְנוּ׃ אֲדֹנָי, כְּכׇל צִדְקֹתֶךָ יָשׇׁב נָא אַפְּךָ וַחֲמָתְךָ מֵעִירְךָ יְרוּשָׁלַ͏ִם הַר קׇדְשֶׁךָ, כִּי בַחֲטָאֵינוּ וּבַעֲוֺנוֹת אֲבֹתֵינוּ יְרוּשָׁלַ͏ִם וְעַמְּךָ לְחֶרְפָּה לְכׇל סְבִיבֹתֵינוּ׃ וְעַתָּה שְׁמַע אֱלֹהֵינוּ אֶל תְּפִלַּת עַבְדְּךָ וְאֶל תַּחֲנוּנָיו, וְהָאֵר פָּנֶיךָ עַל מִקְדָּשְׁךָ הַשָּׁמֵם, לְמַעַן אֲדֹנָי׃ הַטֵּה אֱלֹהַי אׇזְנְךָ וּשְׁמָע, פְּקַח עֵינֶיךָ וּרְאֵה שֹמְמֹתֵינוּ וְהָעִיר אֲשֶׁר נִקְרָא שִׁמְךָ עָלֶיהָ, כִּי לֹא עַל צִדְקֹתֵינוּ אֲנַחְנוּ מַפִּילִים תַּחֲנוּנֵינוּ לְפָנֶיךָ, כִּי עַל רַחֲמֶיךָ הָרַבִּים׃ אֲדֹנָי שְׁמָעָה, אֲדֹנָי סְלָחָה, אֲדֹנָי הַקְשִׁיבָה וַעֲשֵׂה אַל תְּאַחַר, לְמַעַנְךָ אֱלֹהַי, כִּי שִׁמְךָ נִקְרָא עַל עִירְךָ וְעַל עַמֶּךָ׃"}],[{"t":"אָבִינוּ הָאָב הָרַחֲמָן, הַרְאֵנוּ אוֹת לְטוֹבָה, וְקַבֵּץ נְפוּצוֹתֵינוּ מֵאַרְבַּע כַּנְפוֹת הָאָרֶץ. יַכִּירוּ וְיֵדְעוּ כָּל הַגּוֹיִם כִּי אַתָּה אָבִינוּ אָתָּה."}],[{"t":"אֲנַחְנוּ הַחֹמֶר וְאַתָּה יֹצְרֵנוּ, וּמַעֲשֵׂה יָדְךָ כֻּלָּנוּ׃"}],[{"t":"אָבִינוּ מַלְכֵּנוּ, צוּרֵנוּ וְגוֹאֲלֵנוּ, חוּסָה יְיָ עַל עַמֶּךָ, וְאַל תִּתֵּן נַחֲלָתְךָ לְחֶרְפָּה לִמְשׇׁל בָּם גּוֹיִם, לָמָּה יֹאמְרוּ בָעַמִּים אַיֵּה אֱלֹהֵיהֶם׃"}],[{"t":"יָדַעְנוּ יְיָ כִּי חָטָאנוּ וְאֵין מִי יַעֲמֹד בַּעֲדֵנוּ, אֵלָא שִׁמְךָ הַגָּדוֹל יַעֲמֹד לָנוּ בְּעֵת צָרָה. וּכְרַחֵם אָב עַל בָּנִים רַחֵם עָלֵינוּ. חֲמֹל עַל עַמְּךָ וְרַחֵם עַל נַחֲלָתֶךָ. חוּסָה נָּא כְּרֹב רַחֲמֶיךָ אֵל. חָנֵּנוּ מַלְכֵּנוּ וַעֲנֵנוּ. לְךָ יְיָ הַצְּדָקָה, עֹשֶׂה נִפְלָאוֹת בְּכָל עֵת וָעֵת. הַבֶּט נָא וְהוֹשִׁיעָה נָּא צֹאן מַרְעִיתֶךָ. אַל יִמְשָׁל בָּנוּ קֶצֶף, כִּי לְךָ יְיָ הַיְשׁוּעָה. בְּךָ תוֹחַלְתֵּנוּ אֱלוֹהַּ סְלִיחוֹת. אָנָּא סְלַח נָא כִּי אֵל טוֹב וְסַלָּח אָתָּה. אָנָּא מֶלֶךְ חַנּוּן וְרַחוּם, זְכֹר וְהַבֵּט לִבְרִית בֵּין הַבְּתָרִים, וְתֵרָאֶה לְפָנֶיךָ עֲקֵדַת יָחִיד. וּלְמַעַן יִשְׂרָאֵל אָבִינוּ אַל תַּעַזְבֵנוּ אָבִינוּ וְאַל תִּטְּשֵׁנוּ מַלְכֵּנוּ וְאַל תִּשְׁכָּחֵנוּ יוֹצְרֵנוּ, וְאַל תַּעַשׂ עִמָּנוּ כָּלָה בְּגָלוּתֵנוּ, כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה. אֵין כָּמוֹךָ חַנּוּן וְרַחוּם אֱלֹהֵינוּ. אֵין כָּמוֹךָ אֵל אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת. הוֹשִׁיעֵנוּ וְרַחֲמֵנוּ, מֵרַעַשׁ וּמֵרֹגֶז הַצִּילֵנוּ. זְכֹר לַעֲבָדֶיךָ לְאַבְרָהָם לְיִצְחָק וּלְיַעֲקֹב, אַל תֵּפֶן אֶל קְשִׁי הָעָם הַזֶּה וְאֶל רִשְׁעוֹ וְאֶל חַטָּאתוֹ׃ שׁוּב מֵחֲרוֹן אַפֶּךָ, וְהִנָּחֵם עַל הָרָעָה לְעַמֶּךָ׃ וְהָסֵר מִמֶּנּוּ מַכַּת הַמָּוֶת כִּי רַחוּם אָתָּה, כִּי כֵן דַּרְכְּךָ לַעֲשׂוֹת חֶסֶד חִנָּם בְּכָל דּוֹר וָדוֹר. אָנָּא יְיָ הוֹשִׁיעָה נָּא, אָנָּא יְיָ הַצְלִיחָה נָּא׃ אָנָּא יְיָ עֲנֵנוּ בְיוֹם קָרְאֵנוּ. לְךָ יְיָ קִוִּינוּ, לְךָ יְיָ חִכִּינוּ, לְךָ יְיָ נְיַחֵל, אַל תֶּחֱשֶׁה וּתְעַנֵּנוּ, כִּי נָאֲמוּ גוֹיִם אָבְדָה תִקְוָתָם. כָּל בֶּרֶךְ לְךָ תִכְרַע, וְכָל קוֹמָה לְפָנֶיךָ תִשְׁתַּחֲוֶה."}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"znmbbxhPMT","he":[[{"t":"הַפּוֹתֵחַ יָד בִּתְשׁוּבָה לְקַבֶּל פּוֹשְׁעִים וְחַטָּאִים, נִבְהֲלָה נַפְשֵׁנוּ מֵרֹב עִצְּבוֹנֵנוּ. אַל תִּשְׁכָּחֵנוּ נֶצַח, קוּמָה וְהוֹשִׁיעֵנוּ. אַל תִּשְׁפֹּךְ חֲרוֹנְךָ עָלֵינוּ, כִּי אֲנַחְנוּ עַמְּךָ בְּנֵי בְרִיתֶךָ. אֵל, הַבִּיטָה, דַּל כְּבוֹדֵנוּ בַגּוֹיִם וְשִׁקְּצוּנוּ כְּטֻמְאַת הַנִּדָּה. עַד מָתַי עֻזְּךָ בַשְּׁבִי וְתִפְאַרְתְּךָ בְיַד צָר. עוֹרְרָה גְבוּרָתְךָ וְהוֹשִׁיעֵנוּ לְמַעַן שְׁמֶךָ. הֵמָּה יִרְאוּ וְיֵבוֹשׁוּ וְיֵחַתּוּ מִגְּבוּרָתָם. אַל יִמְעֲטוּ לְפָנֶיךָ תְּלָאוֹתֵינוּ. מַהֵר יְקַדְּמוּנוּ רַחֲמֶיךָ בְּעֵת צָרוֹתֵינוּ. לֹא לְמַעֲנֵנוּ אֵלָא לְמַעַנָךְ פְּעֹל, וְאַל תַּשְׁחֵת אֶת זֵכֶר שְׁאֵרִיתֵנוּ, (כִּי לְךָ מְיַחֲלוֹת עֵינֵינוּ,) כִּי אֵל מֶלֶךְ חַנּוּן וְרַחוּם אָתָּה. וּזְכֹר עֵדוּתֵנוּ בְּכָל יוֹם תָּמִיד, אוֹמְרִים פַּעֲמַיִם בְּאַהֲבָה:"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"8HMRO3l7IT","he":[[{"t":"שְׁמַע יִשְׂרָאֵל יְיָ אֱלֹהֵינוּ יְיָ אֶחָד׃"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]},"en":"“Hear Israel, Adonoy is our God, Adonoy is One.”"},{"key":"JNdWCLAppZ","he":[[{"t":"יְיָ אֱלֹהֵי יִשְׂרָאֵל. שׁוּב מֵחֲרוֹן אַפֶּךָ, וְהִנָּחֵם עַל הָרָעָה לְעַמֶּךָ׃"}],[{"t":"שׁוּב לְמַעַן עֲבָדֶיךָ, שִׁבְטֵי נַחֲלָתֶךָ׃"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"CPmefAdYBY","he":[[{"t":"תחינה לשני:","s":"n"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit","monday"]}},{"key":"Rngq0Ftp7R","he":[[{"t":"סימן: אברהם","s":"n"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit","monday"]}},{"key":"dRTh4Rmzpc","he":[[{"t":"יְיָ אַיֵּה חֲסָדֶיךָ הָרִאשׁוֹנִים / אֲשֶׁר סִפְּרוּ לָנוּ אֲבוֹתֵינוּ מִלְּפָנִים / אֲשֶׁר עָשִׂיתָ עִמָּנוּ בִּזְמַן כְּבוֹדְךָ שָׁכַן / בְּאֹהֶל לְשִׁבְתּוֹ מוּכַן / וְשָׁם יְדַבֵּר עִמָּנוּ רִחַקְתָּ מִמֶּנּוּ זִיו הַשְּׁכִינָה / וְעַתָּה אָנָה פָנָה / אֲשֶׁר אֵינֶנּוּ פֹּה עִמָּנוּ הֲשִׁיבֵהוּ לְקַדְמוּתוֹ וְיִגְבְּרוּ / בָנֶיךָ, וְאָז יֹאמְרוּ / הִגְדִּיל יְיָ לַעֲשׂוֹת עִמָּנוּ מַהֵר לִרְפֹּא נִגְעֵנוּ / שׁוּבֵנוּ אֱלֹהֵי יִשְׁעֵנוּ / וְהָפֵר כַּעַסְךָ עִמָּנוּ"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit","monday"]}},{"key":"_R3nYUw3Ji","he":[[{"t":"תחינה לחמישי:","s":"n"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit","thursday"]}},{"key":"uWZnlfYF0V","he":[[{"t":"סימן: שמואל","s":"n"},{"t":" יְיָ שְׁאֵרִית פְּלֵיטַת אֲרִיאֵל / הֲשָׁכַח חַנּוֹת אֵל / אִם קָפַץ בְּאַף רַחֲמָיו מָאַס דְּבִירוֹ וְסִפּוֹ / וַיִּטְרֹף לָעַד אַפּוֹ / וְשִׁחֵת רַחֲמָיו וְאַיֵּה נִפְלְאוֹתָיו וַחֲסָדָיו / אֲשֶׁר סִפְּרוּ לָנוּ עֲבָדָיו / אֲשֶׁר גְּמָלָם כְּרַחֲמָיו אֹמַר בִּרְבוֹת יְגוֹנָי / נִפְּלָה נָא בְּיַד יְיָ / כִּי רַבִּים רַחֲמָיו לִדְבָרוֹ יִחַלְנוּ וְהִתְנֶחָמְנוּ / חַסְדֵי יְיָ כִּי לֹא תָמְנוּ / כִּי לֹא כָלוּ רַחֲמָיו"}],[{"t":"יְיָ אֱלֹהֵי יִשְׂרָאֵל. שׁוּב מֵחֲרוֹן אַפֶּךָ, וְהִנָּחֵם עַל הָרָעָה לְעַמֶּךָ׃","s":"b"}],[{"t":"שׁוּב לְמַעַן עֲבָדֶיךָ, שִׁבְטֵי נַחֲלָתֶךָ׃","s":"b"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit","thursday"]}},{"key":"e5HJv3ZAz4","he":[[{"t":"אַל תִּקְצֹף יְיָ עַד מְאֹד, וְאַל לָעַד תִּזְכֹּר עָוֹן, הֵן הַבֶּט נָא עַמְּךָ כֻלָּנוּ:"}],[{"t":"אַל תִּנְאַץ לְמַעַן שִׁמְךָ, אַל תְּנַבֵּל כִּסֵּא כְבוֹדֶךָ, זְכֹר אַל תָּפֵר בְּרִיתְךָ אִתָּנוּ:"}],[{"t":"אִם עֲוֹנֵינוּ עָנוּ בָנוּ, יְיָ עֲשֵׂה לְמַעַן שְׁמֶךָ, כִּי רַבּוּ מְשׁוּבֹתֵינוּ, לְךָ חָטָאנוּ:"}],[{"t":"אָדוֹן סְלַח לָנוּ."}],[{"t":"לְךָ חָטָאנוּ. אָדוֹן סְלַח לָנוּ.","s":"b"}]],"when":{"any":["monday","thursday"],"all":["tachanunShacharit"]}},{"key":"IhOLLL7IVH","he":[[{"t":"אָבִינוּ מַלְכֵּנוּ, אָבִינוּ אָתָּה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ, אֵין לָנוּ אֵלָא אָתָּה."}],[{"t":"אָבִינוּ מַלְכֵּנוּ, רַחֵם עָלֵינוּ."}],[{"t":"אָבִינוּ מַלְכֵּנוּ, חָנֵּנוּ וַעֲנֵנוּ, כִּי אֵין בָּנוּ מַעֲשִׂים. עֲשֵׂה עִמָּנוּ צְדָקָה לְמַעַן שְׁמָךְ הַגָּדוֹל וְהַקָּדוֹשׁ וְהוֹשִׁיעֵנוּ."}]],"when":{"all":["tachanunShacharit"]}},{"key":"_2OcaM3BNE","he":[[{"t":"וַאֲנַחְנוּ לֹא נֵדַע מַה נַּעֲשֶׂה, כִּי עָלֶיךָ עֵינֵינוּ׃"}],[{"t":"זְכֹר־רַחֲמֶיךָ יְיָ וַחֲסָדֶיךָ כִּי מֵעוֹלָם הֵמָּה׃"}],[{"t":"אַל־תִּזְכָּר־לָנוּ עֲוֺנֹת רִאשֹׁנִים מַהֵר יְקַדְּמוּנוּ רַחֲמֶיךָ כִּי דַלּוֹנוּ מְאֹד׃"}],[{"t":"קוּמָה עֶזְרָתָה לָּנוּ וּפְדֵנוּ לְמַעַן חַסְדֶּךָ׃"}],[{"t":"יְהִי־חַסְדְּךָ יְיָ עָלֵינוּ כַּאֲשֶׁר יִחַלְנוּ לָךְ׃"}],[{"t":"אִם־עֲוֺנוֹת תִּשְׁמָר־יָהּ אֲדֹנָי מִי יַעֲמֹד׃ כִּי־עִמְּךָ הַסְּלִיחָה לְמַעַן תִּוָּרֵא׃"}],[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}],[{"t":"כִּי־הוּא יָדַע יִצְרֵנוּ זָכוּר כִּי־עָפָר אֲנָחְנוּ׃"}],[{"t":"עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ עַל־דְּבַר כְּבוֹד־שְׁמֶךָ וְהַצִּילֵנוּ וְכַפֵּר עַל־חַטֹּאתֵינוּ לְמַעַן שְׁמֶךָ׃"}]],"when":{"all":["tachanunShacharit"]}}]},{"title":{"he":"חצי קדיש","en":"Half Kaddish"},"minyanOnly":true,"segments":[{"key":"lL2RKsHpC7.1","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"when":{"none":["hallelWhole","hallelHalf"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"קריאת התורה","en":"The Torah Reading"},"minyanOnly":true,"segments":[{"key":"dTBErNNh82","he":[[{"t":"ומוציא ספר תורה ואומר בפתח ההיכל:","s":"n"}]],"when":{"all":["torahReading"],"none":["roshChodesh"]}},{"key":"3GzSbWjzsn","he":[[{"t":"אֵל אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת: אַל בְּאַפְּךָ תוֹכִיחֵנוּ חוּסָה יְיָ עַל יִשְׂרָאֵל עַמֶּךָ וְהוֹשִׁיעֵנוּ מִכָּל רָע חָטָאנוּ לָךְ אָדוֹן סְלַח נָא כְּרוֹב רַחֲמֶיךָ אֵל: אֵל אֶרֶךְ אַפַּיִם וּמָלֵא רַחֲמִים אַל תַּסְתֵּר פָּנֶיךָ מִמֶּנּוּ חוּסָה יְיָ עַל יִשְׂרָאֵל עַמֶּךָ וְהַצִּילֵנוּ מִכָּל רָע חָטָאנוּ לָךְ אָדוֹן סְלַח נָא כְּרוֹב רַחֲמֶיךָ אֵל:"}]],"when":{"all":["torahReading"],"none":["roshChodesh"]}},{"key":"ziRPWoTXR7","he":[[{"t":"ומוציא ס\"ת ומתחיל ואומר הוא והצבור:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"-6Ntu4YPQ5","he":[[{"t":"וַיְהִי בִּנְסֹעַ הָאָרֹן וַיֹאמֶר מֹשֶׁה קוּמָה יְיָ וְיָפֻצוּ אֹיְבֶיךָ וְיָנֻסוּ מְשַׂנְאֶיךָ מִפָּנֶיךָ: יִשְׂמְחוּ הַשָּׁמַיִם וְתָגֵל הָאָרֶץ וְיֹאמְרוּ בַגּוֹיִם יְיָ מָלָךְ: יִשְׂמַח הַר־צִיּוֹן תָּגֵלְנָה בְּנוֹת יְהוּדָה לְמַעַן מִשְׁפָּטֶיךָ׃ אַשְׁרֵי הָעָם שֶׁכָּכָה לּוֹ אַשְׁרֵי הָעָם שֶׁיֲהוָה אֱלֹהָיו׃"}]],"when":{"all":["torahReading"]}},{"key":"nYryqLTcss","he":[[{"t":"ומניח החזן הס\"ת על התיבה ופותח וגולל ובעוד שגולל אומר:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"t4Qp3F46jR","he":[[{"t":"גַּדְּלוּ לַייָ אִתִּי וּנְרוֹמְמָה שְׁמוֹ יַחְדָּו׃ רוֹמְמוּ יְיָ אֱלֹהֵינוּ וְהִשְׁתַּחֲווּ לַהֲדוֹם רַגְלָיו קָדוֹשׁ הוּא: רוֹמְמוּ יְיָ אֱלֹהֵינוּ וְהִשְׁתַּחֲווּ לְהַר קָדְשׁוֹ כִּי־קָדוֹשׁ יְיָ אֱלֹהֵינוּ׃ אֵין קָדוֹשׁ כַּייָ כִּי אֵין בִּלְתֶּךָ וְאֵין צוּר כֵּאלֹהֵינוּ: כִּי מִי אֱלוֹהַּ מִבַּלְעֲדֵי יְיָ וּמִי צוּר זוּלָתִי אֱלֹהֵינוּ׃ תּוֹרָה צִוָּה לָנוּ מֹשֶׁה מוֹרָשָׁה קְהִלַּת יַעֲקֹב: עֵץ חַיִּים הִיא לַמַּחֲזִיקִים בָּהּ וְתֹמְכֶיהָ מְאֻשָּׁר: דְּרָכֶיהָ דַרְכֵי נֹעַם וְכָל נְתִיבוֹתֶיהָ שָׁלוֹם: שָׁלוֹם רָב לְאֹהֲבֵי תוֹרָתֶךָ וְאֵין־לָמוֹ מִכְשׁוֹל׃ יְיָ עֹז לְעַמּוֹ יִתֵּן יְיָ יְבָרֵךְ אֶת עַמּוֹ בַּשָּׁלוֹם:"}]],"when":{"all":["torahReading"]}},{"key":"Vo-GSvBFQq","he":[[{"t":"עַל הַכֹּל יִתְגַּדַּל וְיִתְקַדַּשׁ וְיִתְבָּרַךְ וְיִתְרֹמַם וְיִתְנַשֵּׂא שְׁמוֹ שֶׁלְ מֶלֶךְ מַלְכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא בָּעוֹלָמוֹת שֶׁבָּרָא הָעוֹלָם הַזֶּה וְהָעוֹלָם הַבָּא. כִּרְצוֹנוֹ וְכִרְצוֹן יְרֵאָיו וְכִרְצוֹן כָּל עַמּוֹ בֵּית יִשְׂרָאֵל תִּגָּלֶה וְתֵרָאֶה מַלְכוּתוֹ עָלֵינוּ בִּמְהֵרָה וְיָחוֹן וְיָחוֹם וְיַחְמוֹל וִירַחֵם עָלֵינוּ וְעַל פְּלֵטָתֵנוּ וְעַל פְּלֵטַת כָּל עַמּוֹ בֵּית יִשְׂרָאֵל בְּחֵן בְּחֶסֶד וּבְרַחֲמִים וּבְרָצוֹן וְאִמְרוּ אָמֵן:"}]],"when":{"all":["torahReading"]}},{"key":"vK11c28pyh","he":[[{"t":"הָרַחֲמָן בָּרוּךְ הוּא יַחֲזִיר שִׁבְיָתֵנוּ וְשִׁבְיַת עַמּוֹ כָּל בֵּית יִשְׂרָאֵל בִּמְהֵרָה בְּיָמֵינוּ וְיוֹצִיאֵנוּ מִכָּל צָרוֹתֵינוּ לִרְוָחָה וּמֵאֲפֵלָה לְאוֹרָה וְכֵן יְהִי רָצוֹן וְאִמְרוּ אָמֵן:"}]],"when":{"all":["torahReading"]}},{"key":"hE-WSBlr_m","he":[[{"t":"ואוחז היריעה במטפחת שבידו ומגביה היריעה בשתי ידיו ומראה פני הכתיבה לעומדים לימינו ולשמאלו ומחזירו לפניו ולאחריו שמצוה על כל אנשים ונשים לראות הכתב ולכרוע למולו: וכשמגביה החזן היריעה אומר:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"Tz5N7xCmCp","he":[[{"t":"וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה לִפְנֵי בְּנֵי יִשְׂרָאֵל: הָאֵל תָּמִים דַּרְכּוֹ אִמְרַת יְיָ צְרוּפָה מָגֵן הוּא לְכֹל הַחוֹסִים בּוֹ:"}]],"when":{"all":["torahReading"]}},{"key":"MDqvJX43CP","he":[[{"t":"ובעוד שמגביה הס\"ת להראות לעם ובעוד שאומר הפסוקים האלו במיתון ובנועם אומרים הקהל בעת שכורעים למול הס\"ת:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"nvBEUgIK_0","he":[[{"t":"בֹּאוּ נִשְׁתַּחֲוֶה וְנִבְרָעָה נִבְרְכָה לִפְנֵי יְיָ עֹשֵׂנוּ: וְזֹאת הַתּוֹרָה אֲשֶׁר שָׂם מֹשֶׁה לִפְנֵי בְּנֵי יִשְׂרָאֵל: תּוֹרַת יְיָ תְּמִימָה מְשִׁיבַת נָפֶשׁ עֵדוּת יְיָ נֶאֱמָנָה מַחְכִּימַת פֶּתִי׃"}]],"when":{"all":["torahReading"]}},{"key":"jevP1v3GES","he":[[{"t":"פִּקּוּדֵי יְיָ יְשָׁרִים מְשַׂמְּחֵי־לֵב מִצְוַת יְיָ בָּרָה מְאִירַת עֵינָיִם׃"}]],"when":{"all":["torahReading"]}},{"key":"Kwr4DJjrLR","he":[[{"t":"יִרְאַת יְיָ טְהוֹרָה עוֹמֶדֶת לָעַד מִשְׁפְּטֵי־יְיָ אֱמֶת צָדְקוּ יַחְדָּו׃"}]],"when":{"all":["torahReading"]}},{"key":"GlCPdHNcjU","he":[[{"t":"הַנֶּחֱמָדִים מִזָּהָב וּמִפַּז רָב וּמְתוּקִים מִדְּבַשׁ וְנֹפֶת צוּפִים׃"}]],"when":{"all":["torahReading"]}},{"key":"MAsKuu1x1y","he":[[{"t":"גַּם־עַבְדְּךָ נִזְהָר בָּהֶם בְּשָׁמְרָם עֵקֶב רָב׃"}]],"when":{"all":["torahReading"]}},{"key":"-hFmwYjVCg","he":[[{"t":"שְׁגִיאוֹת מִי־יָבִין מִנִּסְתָּרוֹת נַקֵּנִי׃"}]],"when":{"all":["torahReading"]}},{"key":"XhJY6O0eB4","he":[[{"t":"גַּם מִזֵּדִים חֲשֹׂךְ עַבְדֶּךָ אַל־יִמְשְׁלוּ־בִי אָז אֵיתָם וְנִקֵּיתִי מִפֶּשַׁע רָב׃ יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגוֹאֲלִי:"}]],"when":{"all":["torahReading"]}},{"key":"E3LjNL3ADA","he":[[{"t":"ואומר החזן","s":"n"},{"t":" אֲמַר רִבִּי שִׁמְעוֹן בֶּן יוֹחַאי עָלָיו הַשָּׁלוֹם כַּד מַפְּקִין סִפְרָא דְּאוֹרָיְתָא מִגּוֹ הֵיכְלָא לְמִקְרֵי בֵּיהּ בְּצִבּוּרָא מִתְפַּתְּחִין תַּרְעֵי שְׁמַיָּא דְּרַחֲמֵי וּמְעוֹרְרִין אֶת הָאַהֲבָה לְעֵילָא וְאִבְּעֵי לֵיהּ לְאִנֵּישׁ לְמֵימַר הַכֵי:"}]],"when":{"all":["torahReading"]}},{"key":"nRZQpMUlqs","he":[[{"t":"ואומרים כל הקהל יחד:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"L4Ut2hqACQ","he":[[{"t":"בְּרִיךְ שְׁמֵיהּ דְּמָרֵי עָלְמָא בְּרִיךְ כִּתְרָךְ וְאַתְרָךְ יְהֵא רְעוּתָךְ עִם עַמָּךְ יִשְׂרָאֵל לְעָלַם וּפוּרְקַן יַמִּינָךְ אַחֲזֵי לְעַמָּךְ בְּבֵית מַקְדְּשָׁךְ וּלְאַמְטוּיֵי לָנָא מִטּוּב נְהוֹרָךְ וּלְקַבָּלָא צְלוֹתַנָא בְּרַחֲמֵי יְהֵא רַעֲוָא קֳדָמָךְ דְּתוֹרִיךְ לַן חַיִּין בְּטֵיבוּ וְלִי דַּאֲנָא עַבְדָּךְ פְּקִידָא בְּגוֹ צַדִּיקַיָּא לְמִרְחַם עֲלַי וּלְמִטַּר יָתִי וְיָת כָּל דִּילִי וְדִי לְעַמָּךְ יִשְׂרָאֵל אַנְתְּ הוּא זָן לְכֹלָא וּמְפַרְנֵס לְכֹלָא אַנְתְּ הוּא דְּשַׁלִּיט עַל כֹּלָא אַנְתְּ הוּא דְּשַׁלִּיט עַל מַלְכַיָּא וּמַלְכוּתָא דִּילָךְ הִיא. אֲנָא עַבְדָּא דְּקֻדְשָׁא בְּרִיךְ הוּא דְּסְגֵידְנָא קַמֵּיהּ מִקַּמֵּי יְקָר אוֹרָיְתֵיהּ בְּכָל עִידָּן וְעִידָּן לָא עַל אִינֵּישׁ רְחֵיצְנָא וְלָא עַל בַּר אֱלָהִין סְמֵיכְנָא אֵלָא בֶּאֱלָהָא דִּשְׁמַיָּא דְּהוּא אֱלָהּ קְשׁוֹט וְאוֹרָיְתֵיהּ קְשׁוֹט וּנְבִיאוֹהִי קְשׁוֹט וּמַסְגֵּי לְמֶעְבַּד טָבְוָן וּקְשׁוֹט בֵּיהּ אֲנָא רְחִיץ וְלִשְׁמֵיהּ קַדִּישָׁא וְיַקִּירָא אֲנָא אֵמַר תֻּשְׁבְּחָן יְהֵא רַעֲוָא קֳדָמָךְ דְּתִפְתַּח לִבִּי בְּאוֹרָיְתָךְ וְתַשְׁלֵים מַשְׁאֲלָן דְּלִבַּאי וְלִבָּא דְּכָל עַמָּךְ יִשְׂרָאֵל לְטָב וּלְחַיִּין אֲרִיכִין וְלִשְׁלָם:"}]],"when":{"all":["torahReading"]}},{"key":"zq9za_xWLG","he":[[{"t":"ואומר החזן","s":"n"},{"t":" הַכֹּל תְּנוּ עֹז לֵאלֹהִים וּתְנוּ כָבוֹד לַתּוֹרָה:"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"Keznozow3t","he":[[{"t":"והקהל אומרים:","s":"n"},{"t":" תּוֹרַת יְיָ תְּמִימָה מְשִׁיבַת נָפֶשׁ"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"vI7-AWAhrW","he":[[{"t":"וחוזר החזן ואומר:","s":"n"},{"t":" יְיָ עֹז לְעַמּוֹ יִתֵּן"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"W6a8CU0NsU","he":[[{"t":"ואומרים","s":"n"},{"t":" יְיָ יְבָרֵךְ אֶת עַמּוֹ בַּשָּׁלוֹם:"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"FDRq0FZYss","he":[[{"t":"וקורא לכהן ולוי וישראל ואחר השלמת קריאת ישראל מסיים קדיש לעילא","s":"n"}]],"when":{"all":["torahReading"],"none":["roshChodesh"]}},{"key":"lL2RKsHpC7.2","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"when":{"all":["torahReading"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"9TNIj6_YS4","he":[[{"t":"ואומרים הקהל","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"komMTRMtKT","he":[[{"t":"מָה רַב טוּבְךָ אֲשֶׁר צָפַנְתָּ לִּירֵאֶיךָ פָּעַלְתָּ לַחוֹסִים בָּךְ נֶגֶד בְּנֵי אָדָם: לְךָ יְיָ הַגְּדֻלָּה וְהַגְּבוּרָה וְהַתִּפְאֶרֶת וְהַנֵּצַח וְהַהוֹד כִּי כֹל בַּשָּׁמַיִם וּבָאָרֶץ לְךָ יְיָ הַמַּמְלָכָה וְהַמִּתְנַשֵּׂא לְכֹל לְרֹאשׁ וְהָעֹשֶׁר וְהַכָּבוֹד מִלְּפָנֶיךָ וְאַתָּה מוֹשֵׁל בַּכֹּל וּבְיָדְךָ כֹּח וּגְבוּרָה וּבְיָדְךָ לְגַדֵּל וּלְחַזֵּק לַכֹּל. וְעַתָּה אֱלֹהֵינוּ מוֹדִים אֲנַחְנוּ לָךְ וּמְהַלְלִים לְשֵׁם תִּפְאַרְתֶּךָ וִיבָרְכוּ שֵׁם כְּבוֹדֶךָ וּמְרוֹמַם עַל כָּל בְּרָכָה וּתְהִלָּה:"}]],"when":{"all":["torahReading"]}},{"key":"yvGr2Lilap","he":[[{"t":"ומברך למלך ולקהל ומי שבירך ליחיד ואח\"כ אומר החזן:","s":"n"}]],"when":{"all":["torahReading"]}},{"key":"E7yC-BZH-4","he":[[{"t":"וְיָדַעְתָּ כִּי יְיָ אֱלֹהֶיךָ הוּא הָאֱלֹהִים הָאֵל הַנֶּאֱמָן שׁוֹמֵר הַבְּרִית וְהַחֶסֶד לְאֹהֲבָיו וּלְשֹׁמְרֵי מִצְוֹתָיו לְאֶלֶף דּוֹר: כִּי אֵל רַחוּם יְיָ אֱלֹהֶיךָ לֹא יַרְפְּךָ וְלֹא יַשְׁחִיתֶךָ וְלֹא יִשְׁכַּח אֶת בְּרִית אֲבֹתֶיךָ אֲשֶׁר נִשְׁבַּע לָהֶם: כִּי כֹה אָמַר יְיָ רָנּוּ לְיַעֲקֹב שִׂמְחָה וְצַהֲלוּ בְּרֹאשׁ הַגּוֹיִם הַשְׁמִיעוּ הַלְלוּ וְאִמְרוּ הוֹשַׁע יְיָ אֶת עַמְּךָ אֵת שְׁאֵרִית יִשְׂרָאֵל:"}]],"when":{"all":["torahReading"]}}]},{"title":{"he":"הכנסת ספר התורה","en":"Returning the Torah"},"minyanOnly":true,"segments":[{"key":"x9ZtD7uspe","he":[[{"t":"ולוקח החזן הס\"ת מהתיבה להוליכו להיכל ואומרים הקהל:","s":"n"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"s3e7h44YWm","he":[[{"t":"יְהַלְלוּ אֶת־שֵׁם יְיָ כִּי־נִשְׂגָּב שְׁמוֹ לְבַדּוֹ הוֹדוֹ עַל־אֶרֶץ וְשָׁמָיִם׃"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"OUVNA0z9bn","he":[[{"t":"וַיָּרֶם קֶרֶן לְעַמּוֹ תְּהִלָּה לְכָל־חֲסִידָיו לִבְנֵי יִשְׂרָאֵל עַם־קְרֹבוֹ הַלְלוּ־יָהּ׃"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"TQW_XwA2N5","he":[[{"t":"ואומר החזן בפתח ההיכל","s":"n"},{"t":" יְיָ הוּא הָאֱלֹהִים יְיָ הוּא הָאֱלֹהִים בַּשָּׁמַיִם מִמַּעַל וְעַל הָאָרֶץ מִתָּחַת אֵין עוֹד. אֵין כָּמוֹךָ בָּאֱלֹהִים יְיָ וְאֵין כְּמַעֲשֶׂיךָ:"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"s7hRxkVvDZ","he":[[{"t":"ואומרים הקהל","s":"n"},{"t":" שׁוּבָה לִמְעוֹנָךְ וּשְׁכוֹן בְּבֵית מַאֲוַיָּךְ כִּי כָל פֶּה וְכָל לָשׁוֹן יִתְּנוּ הוֹד וְהָדָר לְמַלְכוּתָךְ. וּבְנֻחֹה יֹאמַר שׁוּבָה יְיָ רִבְבוֹת אַלְפֵי יִשְׂרָאֵל: הֲשִׁיבֵנוּ יְיָ אֵלֶיךָ וְנָשׁוּבָה חַדֵּשׁ יָמֵינוּ כְּקֶדֶם:"}]],"when":{"all":["torahReading"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}}]},{"title":{"he":"אשרי ובא לציון","en":"Ashrei and Uva Letzion"},"chapter":{"he":"אשרי ובא לציון","en":"Ashrei and Uva Letzion"},"segments":[{"key":"2sF2YKm5vX","he":[[{"t":"וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃"}],[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}],[{"t":"יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב־לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃"}],[{"t":"יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃"}],[{"t":"אַשְׁרֵי יוֹשְׁבֵי בֵיתֶךָ עוֹד יְהַלְלוּךָ סֶּלָה׃"}],[{"t":"אַשְׁרֵי הָעָם שֶׁכָּכָה לּוֹ אַשְׁרֵי הָעָם שֶׁיֲהוָה אֱלֹהָיו׃"}]]},{"key":"Q-Gyg3AZDE","he":[[{"t":"תְּהִלָּה לְדָוִד אֲרוֹמִמְךָ אֱלוֹהַי הַמֶּלֶךְ וַאֲבָרֲכָה שִׁמְךָ לְעוֹלָם וָעֶד׃"}]]},{"key":"rBZf6a49mV","he":[[{"t":"בְּכָל־יוֹם אֲבָרֲכֶךָּ וַאֲהַלְלָה שִׁמְךָ לְעוֹלָם וָעֶד׃"}]]},{"key":"XTBmIok2hi","he":[[{"t":"גָּדוֹל יְיָ וּמְהֻלָּל מְאֹד וְלִגְדֻלָּתוֹ אֵין חֵקֶר׃"}]]},{"key":"WKHQVX-A2x","he":[[{"t":"דּוֹר לְדוֹר יְשַׁבַּח מַעֲשֶׂיךָ וּגְבוּרֹתֶיךָ יַגִּידוּ׃"}]]},{"key":"pjXj8nAV0y","he":[[{"t":"הֲדַר כְּבוֹד הוֹדֶךָ וְדִבְרֵי נִפְלְאוֹתֶיךָ אָשִׂיחָה׃"}]]},{"key":"KXERmaMtaB","he":[[{"t":"וֶעֱזוּז נוֹרְאֹתֶיךָ יֹאמֵרוּ וּגְדוּלָּתְךָ אֲסַפְּרֶנָּה׃"}]]},{"key":"5JvhDRNid3","he":[[{"t":"זֵכֶר רַב־טוּבְךָ יַבִּיעוּ וְצִדְקָתְךָ יְרַנֵּנוּ׃"}]]},{"key":"sihGHGFAcK","he":[[{"t":"חַנּוּן וְרַחוּם יְיָ אֶרֶךְ אַפַּיִם וּגְדָל־חָסֶד׃"}]]},{"key":"qEWAXmsF7e","he":[[{"t":"טוֹב־יְיָ לַכֹּל וְרַחֲמָיו עַל־כָּל־מַעֲשָׂיו׃"}]]},{"key":"714L44PCnu","he":[[{"t":"יוֹדוּךָ יְיָ כָּל־מַעֲשֶׂיךָ וַחֲסִידֶיךָ יְבָרֲכוּכָה׃"}]]},{"key":"u11FGX9444","he":[[{"t":"כְּבוֹד מַלְכוּתְךָ יֹאמֵרוּ וּגְבוּרָתְךָ יְדַבֵּרוּ׃"}]]},{"key":"UL1AQE_3Vh","he":[[{"t":"לְהוֹדִיעַ לִבְנֵי הָאָדָם גְּבוּרֹתָיו וּכְבוֹד הֲדַר מַלְכוּתוֹ׃"}]]},{"key":"dsSL9d8GDy","he":[[{"t":"מַלְכוּתְךָ מַלְכוּת כָּל־עֹלָמִים וּמֶמְשֶׁלְתְּךָ בְּכָל־דּוֹר וָדוֹר׃"}]]},{"key":"G7NnD-NMqS","he":[[{"t":"סוֹמֵךְ יְיָ לְכָל־הַנֹּפְלִים וְזוֹקֵף לְכָל־הַכְּפוּפִים׃"}]]},{"key":"aXWnUEeDt4","he":[[{"t":"עֵינֵי־כֹל אֵלֶיךָ יְשַׂבֵּרוּ וְאַתָּה נוֹתֵן־לָהֶם אֶת־אָכְלָם בְּעִתּוֹ׃"}]]},{"key":"R-yH7HxjMX","he":[[{"t":"פּוֹתֵחַ אֶת־יָדֶךָ וּמַשְׂבִּיעַ לְכָל־חַי רָצוֹן׃"}]]},{"key":"J-qHON1BB2","he":[[{"t":"צַדִּיק יְיָ בְּכָל־דְּרָכָיו וְחָסִיד בְּכָל־מַעֲשָׂיו׃"}]]},{"key":"D3lIttZNxl","he":[[{"t":"קָרוֹב יְיָ לְכָל־קֹרְאָיו לְכֹל אֲשֶׁר יִקְרָאֻהוּ בֶאֱמֶת׃"}]]},{"key":"M2ZuOjtMCG","he":[[{"t":"רְצוֹן־יְרֵאָיו יַעֲשֶׂה וְאֶת־שַׁוְעָתָם יִשְׁמַע וְיוֹשִׁיעֵם׃"}]]},{"key":"9e22wdDBtl","he":[[{"t":"שׁוֹמֵר יְיָ אֶת־כָּל־אֹהֲבָיו וְאֵת כָּל־הָרְשָׁעִים יַשְׁמִיד׃"}]]},{"key":"lYbspe0p0c","he":[[{"t":"תְּהִלַּת יְיָ יְדַבֶּר־פִּי וִיבָרֵךְ כָּל־בָּשָׂר שֵׁם קָדְשׁוֹ לְעוֹלָם וָעֶד׃ וַאֲנַחְנוּ נְבָרֵךְ יָהּ מֵעַתָּה וְעַד־עוֹלָם הַלְלוּ־יָהּ׃"}]]},{"key":"evyUW9tR16","he":[[{"t":"לַמְנַצֵּחַ מִזְמוֹר לְדָוִד׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"27cdKkv0TQ","he":[[{"t":"יַעַנְךָ יְיָ בְּיוֹם צָרָה יְשַׂגֶּבְךָ שֵׁם אֱלֹהֵי יַעֲקֹב׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"0C9MpmKtn9","he":[[{"t":"יִשְׁלַח־עֶזְרְךָ מִקֹּדֶשׁ וּמִצִּיּוֹן יִסְעָדֶךָּ׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"xm_3FmIy78","he":[[{"t":"יִזְכֹּר כָּל־מִנְחֹתֶךָ וְעוֹלָתְךָ יְדַשְּׁנֶה סֶלָה׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"dw12jdiwqe","he":[[{"t":"יִתֶּן־לְךָ כִלְבָבֶךָ וְכָל־עֲצָתְךָ יְמַלֵּא׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"1VC7QQXiVI","he":[[{"t":"נְרַנְּנָה בִּישׁוּעָתֶךָ וּבְשֵׁם־אֱלֹהֵינוּ נִדְגֹּל יְמַלֵּא יְיָ כָּל־מִשְׁאֲלוֹתֶיךָ׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"sFk9Kf37fN","he":[[{"t":"עַתָּה יָדַעְתִּי כִּי הוֹשִׁיעַ יְיָ מְשִׁיחוֹ יַעֲנֵהוּ מִשְּׁמֵי קָדְשׁוֹ בִּגְבֻרוֹת יֵשַׁע יְמִינוֹ׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"rXZkwRghbM","he":[[{"t":"אֵלֶּה בָרֶכֶב וְאֵלֶּה בַסּוּסִים וַאֲנַחְנוּ בְּשֵׁם־יְיָ אֱלֹהֵינוּ נַזְכִּיר׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"E1xaRQYdcQ","he":[[{"t":"הֵמָּה כָּרְעוּ וְנָפָלוּ וַאֲנַחְנוּ קַּמְנוּ וַנִּתְעוֹדָד׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"Q1RlPjQOOx","he":[[{"t":"יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְיוֹם־קָרְאֵנוּ׃"}]],"when":{"all":["tachanunShacharit"]}},{"key":"v_G9vondS4","he":[[{"t":"ואומר ש\"צ","s":"n"}]]},{"key":"WWQ-5zhFBg","he":[[{"t":"וּבָא לְצִיּוֹן גּוֹאֵל וּלְשָׁבֵי פֶשַׁע בְּיַעֲקֹב נְאֻם יְיָ: וַאֲנִי זֹאת בְּרִיתִי אוֹתָם אָמַר יְיָ רוּחִי אֲשֶׁר עָלֶיךָ וּדְבָרַי אֲשֶׁר שַׂמְתִּי בְּפִיךָ לֹא יָמוּשׁוּ מִפִּיךָ וּמִפִּי זַרְעֲךָ וּמִפִּי זֶרַע זַרְעֲךָ אָמַר יְיָ מֵעַתָּה וְעַד עוֹלָם: וְאַתָּה קָדוֹשׁ יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל׃ וְקָרָא זֶה אֶל זֶה וְאָמַר קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ "},{"t":"ואומר ש\"צ","s":"n"},{"t":" וּמְקַבְּלִין דֵּין מִדֵּין וְאָמְרִין קַדִּישׁ בִּשְׁמֵי מְרוֹמָא בֵּית שְׁכִינְתֵיהּ קַדִּישׁ עַל אַרְעָא עוֹבָד גְּבוּרְתֵיהּ קַדִּישׁ בְּעָלַם עָלְמַיָּא יְיָ צְבָאוֹת: מַלְיָא כָל אַרְעָא זִיו יְקָרֵיהּ: וַתִּשָׂאֵנִי רוּחַ וָאֶשְׁמַע אַחֲרַי קוֹל רַעַשׁ גָּדוֹל בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ: וּנְטַלַתְנִי רוּחָא וּשְׁמַעִית בָּתְרַי קָל זְיָע סַגִּי דִּמְשַׁבְּחִין וְאָמְרִין בְּרִיךְ יְקָרָא דַּייָ מֵאֲתַר בֵּית שְׁכִינְתֵיהּ: יְיָ יִמְלֹךְ לְעוֹלָם וָעֶד: יְיָ מַלְכוּתֵיהּ לְעָלְמָא וּלְעָלְמֵי עָלְמַיָּא: יְיָ אֱלֹהֵי אַבְרָהָם יִצְחָק וְיִשְׂרָאֵל אֲבוֹתֵינוּ שָׁמְרָה זֹאת לְעוֹלָם לְיֵצֶר מַחְשְׁבוֹת לְבַב עַמֶּךָ וְהָכֵן לְבָבָם אֵלֶיךָ: וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃ כִּי אַתָּה יְיָ טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ: צִדְקָתְךָ צֶדֶק לְעוֹלָם וְתוֹרָתְךָ אֱמֶת׃ מִי אֵל כָּמוֹךָ נֹשֵׂא עָוֹן וְעֹבֵר עַל פֶּשַׁע לִשְׁאֵרִית נַחֲלָתוֹ לֹא הֶחֱזִיק לָעַד אַפּוֹ כִּי חָפֵץ חֶסֶד הוּא: יָשׁוּב יְרַחֲמֵנוּ יִכְבּוֹשׁ עֲוֹנוֹתֵינוּ וְתַשְׁלִיךְ בִּמְצוּלוֹת יָם כָּל חַטֹּאתָם: תִּתֵּן אֱמֶת לְיַעֲקֹב חֶסֶד לְאַבְרָהָם אֲשֶׁר נִשְׁבַּעְתָּ לַאֲבוֹתֵינוּ מִימֵי קֶדֶם: בָּרוּךְ אֲדֹנָי יוֹם יוֹם יַעֲמָס־לָנוּ הָאֵל יְשׁוּעָתֵנוּ סֶלָה׃ יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב־לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃ יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃"}]]},{"key":"Tsx52UPMdx","he":[[{"t":"בָּרוּךְ אֱלֹהֵינוּ בָּרוּךְ אֲדֹנֵינוּ בָּרוּךְ בּוֹרְאֵנוּ שֶׁבְּרָאָנוּ לִכְבוֹדוֹ שֶׁהִבְדִּילָנוּ מִן הַתּוֹעִים וְנָתַן לָנוּ תּוֹרַת אֱמֶת עַל יְדֵי מֹשֶׁה רַבֵּינוּ חַיֵּי עוֹלָם נָטַע בְּתוֹכֵנוּ הָרַחֲמָן יִפְתַּח לִבֵּנוּ לְתַלְמוּד תּוֹרָתוֹ וְיִתֵּן בְּלִבֵּנוּ אַהֲבָתוֹ וְיִרְאָתוֹ לַעֲשׂוֹת רְצוֹנוֹ כִּרְצוֹנוֹ וּלְעָבְדוֹ בְּלֵבָב שָׁלֵם וּבְנֶפֶשׁ חֲפֵצָה לְמַעַן לֹא נִיגַע לָרִיק וְלֹא נֵלֵד לַבֶּהָלָה. כֵּן יְהִי רָצוֹן וְרַחֲמִים מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ שֶׁנִּחְיֶה לִשְׁמוֹר חֻקֶּיךָ בָּעוֹלָם הַזֶּה וְלִימוֹת הַמָּשִׁיחַ כְּדֵי שֶׁנִּזְכֶּה וְנִירַשׁ טוֹב לְחַיֵי הָעוֹלָם הַבָּא: לְמַעַן יְזַמֶּרְךָ כָבוֹד וְלֹא יִדֹּם יְיָ אֱלֹהַי לְעוֹלָם אוֹדֶךָּ׃ יִהְיוּ לְרָצוֹן אִמְרֵי־פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי׃"}]]}]},{"title":{"he":"שיר של יום","en":"Song of the Day"},"segments":[{"key":"b4xVwf79Fi","he":[[{"t":"ליום ראשון.","s":"n"},{"t":" לְדָוִד מִזְמוֹר לַייָ הָאָרֶץ וּמְלוֹאָהּ תֵּבֵל וְיֹשְׁבֵי בָהּ׃"}]],"when":{"all":["sunday"]}},{"key":"in3BVekWLy","he":[[{"t":"כִּי־הוּא עַל־יַמִּים יְסָדָהּ וְעַל־נְהָרוֹת יְכוֹנְנֶהָ׃"}]],"when":{"all":["sunday"]}},{"key":"iDhHJJ68Jv","he":[[{"t":"מִי־יַעֲלֶה בְהַר־יְיָ וּמִי־יָקוּם בִּמְקוֹם קָדְשׁוֹ׃"}]],"when":{"all":["sunday"]}},{"key":"ISBWGtu5y5","he":[[{"t":"נְקִי כַפַּיִם וּבַר־לֵבָב אֲשֶׁר לֹא־נָשָׂא לַשָּׁוְא נַפְשִׁי וְלֹא נִשְׁבַּע לְמִרְמָה׃"}]],"when":{"all":["sunday"]}},{"key":"TuLceQsop4","he":[[{"t":"יִשָּׂא בְרָכָה מֵאֵת יְיָ וּצְדָקָה מֵאֱלֹהֵי יִשְׁעוֹ׃"}]],"when":{"all":["sunday"]}},{"key":"3vVjSzmsH1","he":[[{"t":"זֶה דּוֹר דֹּרְשָׁיו מְבַקְשֵׁי פָנֶיךָ יַעֲקֹב סֶלָה׃"}]],"when":{"all":["sunday"]}},{"key":"jwkPUMCvTC","he":[[{"t":"שְׂאוּ שְׁעָרִים רָאשֵׁיכֶם וְהִנָּשְׂאוּ פִּתְחֵי עוֹלָם וְיָבוֹא מֶלֶךְ הַכָּבוֹד׃"}]],"when":{"all":["sunday"]}},{"key":"gAY_hCDkOZ","he":[[{"t":"מִי זֶה מֶלֶךְ הַכָּבוֹד יְיָ עִזּוּז וְגִבּוֹר יְיָ גִּבּוֹר מִלְחָמָה׃"}]],