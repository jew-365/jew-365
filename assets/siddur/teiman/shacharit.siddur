he":"אין כאלהינו","en":"Ein Keloheinu"},"segments":[{"key":"-SsdwFHU7r","he":[[{"t":"אָמַר רִבִּי אֶלְעָזָר אָמַר רִבִּי חֲנִינָא תַּלְמִידֵי חֲכָמִים מַרְבִּים שָׁלוֹם בָּעוֹלָם שֶׁנֶּאֱמַר וְכָל בָּנַיִךְ לִמּוּדֵי יְיָ וְרַב שְׁלוֹם בָּנָיִךְ: אֵין קָדוֹשׁ כַּייָ כִּי אֵין בִּלְתֶּךָ וְאֵין צוּר כֵּאלֹהֵינוּ: כִּי מִי אֱלוֹהַּ מִבַּלְעֲדֵי יְיָ וּמִי צוּר זוּלָתִי אֱלֹהֵינוּ: אֵין כֵּאלֹהֵינוּ אֵין כַּאדֹנֵינוּ אֵין כְּמַלְכֵּנוּ אֵין כְּמוֹשִׁיעֵנוּ: מִי כֵּאלֹהֵינוּ מִי כַּאדֹנֵינוּ מִי כְּמַלְכֵּנוּ מִי כְּמוֹשִׁיעֵנוּ: נוֹדֶה לֵאלֹהֵינוּ נוֹדֶה לַאדֹנֵינוּ נוֹדֶה לְמַלְכֵּנוּ נוֹדֶה לְמוֹשִׁיעֵנוּ: בָּרוּךְ אֱלֹהֵינוּ בָּרוּךְ אֲדֹנֵינוּ בָּרוּךְ מַלְכֵּנוּ בָּרוּךְ מוֹשִׁיעֵנוּ: אַתָּה הוּא אֱלֹהֵינוּ אַתָּה הוּא אֲדֹנֵינוּ אַתָּה הוּא מַלְכֵּנוּ אַתָּה הוּא מוֹשִׁיעֵנוּ: אַתָּה תּוֹשִׁיעֵנוּ: אַתָּה תָקוּם תְּרַחֵם צִיּוֹן כִּי עֵת לְחֶנְנָהּ כִּי בָא מוֹעֵד: אַךְ צַדִּיקִים יוֹדוּ לִשְׁמֶךָ יֵשְׁבוּ יְשָׁרִים אֶת פָּנֶיךָ: וְיִבְטְחוּ בְךָ יוֹדְעֵי שְׁמֶךָ כִּי לֹא עָזַבְתָּ דוֹרְשֶׁיךָ יְיָ: כִּי כָל הָעַמִּים יֵלְכוּ אִישׁ בְּשֵׁם אֱלֹהָיו וַאֲנַחְנוּ נֵלֵךְ בְּשֵׁם יְיָ אֱלֹהֵינוּ לְעוֹלָם וָעֶד:"}]]}]},{"title":{"he":"קדיש","en":"Kaddish"},"minyanOnly":true,"segments":[{"key":"lL2RKsHpC7.3","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"a4iwyxlH9q.1","he":[[{"t":"תִּתְקַבַּל צְלוֹתְכוֹן וְתִתְעֲבֵיד בָּעוּתְכוֹן וּצְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל בֵּית יִשְׂרָאֵל קֳדָם אֲבוּנָא דְּבִשְׁמַיָא: יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָא וְסִיַּעְתָּא וּפוּרְקָנָא ורְוַוחָא וְחִנָּא וְחִסְדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשְׂרָאֵל לְחַיִּים וּלְשָׁלוֹם וְאִמְרוּ אָמֵן: עוֹשֶׂה שָׁלוֹם וכו':"}]],"when":{"none":["musaf"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"מוסף","en":"Musaf"},"chapter":{"he":"מוסף","en":"Musaf"},"segments":[{"key":"FKkhfDlC5V","he":[[{"t":"אֲדֹנָי שְׂפָתַי תִּפְתָּח וּפִי יַגִּיד תְּהִלָּתֶךָ:"}]],"when":{"all":["roshChodesh"]},"en":"My Master, open my lips, and my mouth will declare Your praise."},{"key":"0T4XaRecuP","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא אֵל עֶלְיוֹן גּוֹמֵל חֲסָדִים טוֹבִים וְקוֹנֵה הַכֹּל זוֹכֵר חַסְדֵי אָבוֹת וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם מֶלֶךְ רַחֲמָן מוֹשִׁיעַ וּמָגֵן בָּרוּךְ אַתָּה יְיָ מָגֵן אַבְרָהָם:"}]],"when":{"all":["roshChodesh"]}},{"key":"Uyki_dbk5_","he":[[{"t":"אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי. מְחַיֶּה מֵתִים אַתָּה. רַב לְהוֹשִׁיעַ "},{"t":"בקיץ אומר","s":"n","when":{"none":["winter"]}},{"t":" מוֹרִיד הַטָּל","when":{"none":["winter"]}},{"t":"בחורף אומר","s":"n","when":{"all":["winter"]}},{"t":" מַשִּׁיב הָרוּחַ וּמוֹרִיד הַגֶּשֶׁם","when":{"all":["winter"]}},{"t":" מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֶּה מֵתִים בְּרַחֲמִים רַבִּים רוֹפֵא חוֹלִים סוֹמֵךְ נוֹפְלִים מַתִּיר אֲסוּרִים וּמְקַיֵּים אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דוֹמֶה לָךְ מֵמִית וּמְחַיֶּה וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים בָּרוּךְ אַתָּה יְיָ מְחַיֶּה הַמֵּתִים:"}]],"when":{"all":["roshChodesh"]}},{"key":"GeC0Qnk54O","he":[[{"t":"כֶּתֶר יִתְּנוּ לְךָ יְיָ אֱלֹהֵינוּ מַלְאָכִים הֲמוֹנֵי מַעְלָה עִם עַמְּךָ יִשְׂרָאֵל קְבוּצֵי מַטָּה יַחַד כֻּלָּם קְדוּשָּׁה לְךָ יְשַׁלֵּשׁוּ וְכֵן כָּתוּב עַל יַד נְבִיאָךְ וְקָרָא זֶה אֶל זֶה וְאָמַר "},{"t":"ועונין הקהל","s":"n"},{"t":" קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" כְּבוֹדוֹ וְהוֹדוֹ מְלֹא הָעוֹלָם כֻּלּוֹ וּמְשָׁרְתָיו שׁוֹאֲלִים זֶה לָזֶה אַיֵּה מְקוֹם כְּבוֹדוֹ: "},{"t":"ואומרים הקהל","s":"n"},{"t":" מְשַׁבְּחִים וְאוֹמְרִים בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" מִמְּקוֹמְךָ מַלְכֵּנוּ תּוֹפִיעַ וְתִתְנַשֵּׂא וְתִמְלוֹךְ עָלֵינוּ כִּי מְחַכִּים אָֽנוּ לָךְ מָתַי תִּמְלוֹךְ בְּצִיּוֹן בְּקָרוֹב בְּחַיֵּינוּ וּבְיָמֵינוּ "},{"t":"ועונין הצבור","s":"n"},{"t":" אָמֵן "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" תִּשְׁכּוֹן תִּתְגַּדַּל וְתִתְקַדַּשׁ בְּתוֹךְ יְרוּשָׁלַםִ עִירָךְ לְדֹר וָדֹר וּלְנֵצַח נְצָחִים וְעֵינֵינוּ תִרְאֶינָה בְּמַלְכוּת עֻזָּךְ כַּדָּבָר הָאָמוּר בְּשִׁירֵי קָדְשָׁךְ עַל יַד דָּוִד עַבְדָּךְ מְשִׁיחַ צִדְקָךְ: "},{"t":"ואומרים הקהל","s":"n"},{"t":" יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" לְדֹר וָדֹר נַגִּיד גָּדְלָךְ וּלְנֵצַח נְצָחִים קְדוּשָּׁתָךְ נַקְדִּישׁ שְׁבָחָךְ יְיָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ כִּי אֵל מֶלֶךָ גָּדוֹל וְקָדוֹשׁ אָתָּה בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:"}]],"when":{"all":["roshChodesh"]},"minyan":{"he":"קדושה — נאמרת רק בחזרת הש״ץ","en":"Kedushah — said only in the chazzan's repetition"}},{"key":"eidxyvMclk","he":[[{"t":"אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלוּךָ סֶלָה בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:"}]],"when":{"all":["roshChodesh"]}},{"key":"sOojNhlmGQ","he":[[{"t":"רָאשֵׁי חֳדָשִׁים לְעַמְּךָ נָתַתָּה זְמַן כַּפָּרָה לְכָל תּוֹלְדוֹתָם בִּהְיוֹתָם מַקְרִיבִים לְפָנֶיךָ. בְחֵי רָצוֹן וּשְׂעִירֵי חַטָּאת לְכַפֵּר בַּעֲדָם. זִכָּרוֹן לְכֻלָּם יִהְיֶה. תְּשׁוּעַת נַפְשָׁם מִיַּד שׂוֹנֵא. מִזְבֵּחַ חָדָשׁ בְּצִיּוֹן תָּכִין וְעוֹלַת רֹאשׁ חֹדֶשׁ נַעֲלֶה עָלָיו. שִׁירֵי דָוִד נִשְׁמַע בְּעִירָךְ הָאֲמוּרִים לִפְנֵי מִזְבְּחָךְ לְרָצוֹן אַהֲבַת עוֹלָם תָּבִיא לָהֶם וּבְרִית אָבוֹת לַבָּנִים תִּזְכּוֹר. אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ מִפְּנֵי חֲטָאֵינוּ גָּלִינוּ מֵאַרְצֵנוּ וַנִּתְרַחַק מֵעַל אַדְמָתֵנוּ וְאֵין אָֽנוּ יְכוּלִים לַעֲשׂוֹת לְפָנֶיךָ אֶת קָרְבְּנוֹת חוֹבָתֵנוּ. יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ שֶׁתַּעֲלֵנוּ לְאַרְצֵנוּ וְתִטָּעֵנוּ בִּגְבוּלֵנוּ וְשָׁם נַעֲשֶׂה לְפָנֶיךָ אֶת קָרְבְּנוֹת חוֹבָתֵנוּ תְּמִידִין כְּסִדְרָן וּמוּסָפִין כְּהִלְכָתָן וְאֶת מוּסָפֵי יוֹם רֹאשׁ הַחֹדֶשׁ הַזֶּה נַעֲשֶׂה וְנַקְרִיב לְפָנֶיךָ בְּאַהֲבָה כְּמִצְוַת רְצוֹנָךְ כְּמוֹ שֶׁכָּתַבְתָּ עָלֵינוּ בְּתוֹרָתָךְ עַל יְדֵי מֹשֶׁה עַבְדָּךְ. יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁתְּחַדֵּשׁ עָלֵינוּ אֶת רֹאשׁ הַחֹדֶשׁ הַזֶּה לְטוֹבָה לִבְרָכָה לְחֵן וּלְחֶסֶד וּלְרַחֲמִים לְחַיִּים וּלְשָׁלוֹם וִיהִי רֹאשׁ הַחֹדֶשׁ הַזֶּה סוֹף וְקֵץ לְכָל חַטֹּאתֵינוּ וְצָרוֹתֵינוּ תְּחִלָּה וְרֹאשׁ לִפְדוּת נַפְשֵׁנוּ כִּי בְעַמְּךָ יִשְׂרָאֵל מִכָּל הָאוּמּוֹת בָּחַרְתָּ וְרָאשֵׁי חֳדָשִׁים לָהֶם נָתַתָּ, בָּרוּךְ אַתָּה יְיָ מְקַדֵּשׁ יִשְׂרָאֵל וְרָאשֵׁי חֳדָשִׁים:"}]],"when":{"all":["roshChodesh"]}},{"key":"kkEyue6iAw","he":[[{"t":"רְצֵה יְיָ אֱלֹהֵינוּ בְּעַמְּךָ יִשְׂרָאֵל וְלִתְפִלָּתָם שְׁעֵה וְהָשֵׁב הָעֲבוֹדָה אֶל דְּבִיר בֵּיתֶךָ וְאִשֵּׁי יִשְׂרָאֵל, וּתְפִלָּתָם מְהֵרָה תְּקַבֵּל בְּרָצוֹן וּתְהִי לְרָצוֹן תָּמִיד עֲבוֹדַת יִשְׂרָאֵל עַמֶּךָ וְתִרְצֵנוּ וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְנָוְךָ לְצִיּוֹן בְּרַחֲמִים כְּמֵאָז בָּרוּךְ אַתָּה יְיָ הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:"}]],"when":{"all":["roshChodesh"]}},{"key":"DIks-r40OL.1","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ, שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ, אֱלֹהֵי כָל בָּשָׂר, יוֹצְרֵנוּ וְיוֹצֵר בְּרֵאשִׁית. בְּרָכוֹת וְהוֹדָאוֹת לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עַל שֶׁהֶחֱיִיתָנוּ וְקִיַּמְתָּנוּ. כֵּן תְּחַיֵּנוּ וּתְחָנֵּנוּ וְתֶאֱסֹף גָּלִיּוֹתֵינוּ לְחַצְרוֹת קָדְשָׁךְ, לִשְׁמֹר חֻקֶּיךָ וּלְעָבְדָךְ וְלַעֲשׂוֹת רְצוֹנָךְ בְּלֵבָב שָׁלֵם, עַל שֶׁאָנוּ מוֹדִים לָךְ, בָּרוּךְ אֵל הַהוֹדָאוֹת."}]],"when":{"all":["roshChodesh"]},"minyan":{"he":"מודים דרבנן — הקהל אומר בחזרת הש״ץ","en":"Modim DeRabbanan — said by the congregation in the chazzan's repetition"}},{"key":"c9qVQa-tr2","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ צוּר חַיֵּינוּ מָגֵן יִשְׁעֵנוּ אַתָּה הוּא לְדֹר וָדֹר נוֹדֶה לָךְ וּנְסַפֵּר תְּהִלָּתֶךָ עַל חַיֵּינוּ הַמְּסוּרִים בְּיָדָךְ עַל נִשְׁמוֹתֵינוּ הַפְּקוּדוֹת לָךְ עַל נִסֶּיךָ וְנִפְלְאוֹתֶיךָ שֶׁבְּכָל עֵת וָעֵת עֶרֶב וָבֹקֶר וְצָהֳרָיִם"}]],"when":{"all":["roshChodesh"]}},{"key":"SVeLqE6qFl","he":[[{"t":"עַל הַנִּסִּים וְעַל הַגְּבוּרוֹת וְעַל הַמִּלְחָמוֹת וְעַל הַתְּשׁוּעוֹת וְעַל הַפְּדוּת וְעַל הַפּוּרְקָן שֶׁעָשִׂיתָ עִמָּנוּ וְעִם אֲבוֹתֵינוּ בַּיָּמִים הָהֵם בַּזְּמָן הַזֶּה בִּימֵי מַתִּתְיָה בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל חַשְׁמוֹנַאי וּבָנָיו כְּשֶׁעָמְדָה מַלְכוּת יָוָן הָרְשָׁעָה עַל עַמְּךָ בֵּית יִשְׂרָאֵל לְבַטְלָם מִתּוֹרָתֶךָ וּלְהַעֲבִירָם מֵחֻקֵּי רְצוֹנֶךָ. וְאַתָּה בְּרַחֲמֶיךָ הָרַבִּים עָמַדְתָּ לָהֶם בְּעֵת צָרָתָם. וְדַנְתָּ אֶת דִּינָם וְרַבְתָּ אֶת רִיבָם וְנָקַמְתָּ אֶת נִקְמָתָם וּמָסַרְתָּ גִבּוֹרִים בְּיַד חַלָּשִׁים וְרַבִּים בְּיַד מְעַטִּים וּטְמֵאִים בְּיַד טְהוֹרִים וּרְשָׁעִים בְּיַד צַדִּיקִים. וּפוֹשְׁעִים בְּיַד עוֹשֵׂי תוֹרָתֶךָ וְעָשִׂיתָ לְּךָ שֵׁם גָדוֹל בְּעוֹלָמֶךָ וּלְעַמְּךָ יִשְׂרָאֵל עָשִׂיתָ פֶּלֶא וְנִסִּים כְּשֵׁם שֶׁעָשִׂיתָ עִמָּהֶם נִסִּים וּגְבוּרוֹת. כָּךְ עֲשֵׂה עִמָּנוּ נִסִּים וּגְבוּרוֹת בָּעֵת וּבָעוֹנָה הַזּוֹאת:"}]],"when":{"all":["roshChodesh","chanukah"]}},{"key":"SVeLqE6qFl.1","he":[[{"t":"וְעַל כּוּלָּם יְיָ אֱלֹהֵינוּ אָֽנוּ מוֹדִים לָךְ"}]],"when":{"all":["roshChodesh","chanukah"]}},{"key":"c9qVQa-tr2.1","he":[[{"t":"הַטּוֹב כִּי לֹא כָלוּ רַחֲמֶיךָ הַמְרַחֵם כִּי לֹא תַמּוּ חֲסָדֶיךָ. כָּל הַחַיִּים יְהַלְלוּ אֶת שִׁמְךָ הַגָּדוֹל כִּי טוֹב הָאֵל הַטּוֹב בָּרוּךְ אַתָּה יְיָ הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת:"}]],"when":{"all":["roshChodesh"]}},{"key":"evExEY45Lr","he":[[{"t":"שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה חֵן וְחֶסֶד וְרַחֲמִים עָלֵינוּ וְעַל יִשְׂרָאֵל עַמֶּךָ וּבָרְכֵנוּ כֻּלָּנוּ כְּאֶחָד מִמְּאוֹר פָּנֶיךָ כִּי מִמְּאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְיָ אֱלֹהֵינוּ תּוֹרָה וְחַיִּים אַהֲבָה וְחֶסֶד צְדָקָה וְשָׁלוֹם וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת בַּשָּׁלוֹם בָּרוּךְ אַתָּה יְיָ הַמְּבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם. אָמֵן: יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי:"}]],"when":{"all":["roshChodesh"]}},{"key":"xl_TEq6Qiv","he":[[{"t":"ונהגו להתחנן בתחנה זו","s":"n"}]],"when":{"all":["roshChodesh"]}},{"key":"PwicsFoQzB","he":[[{"t":"אֱלֹהַי נְצוֹר לְשׁוֹנִי מֵרָע וְשִׂפְתוֹתַי מִדַּבֵּר מִרְמָה וְלִמְקַלְלַי נַפְשִׁי תִדּוֹם וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה. פְּתַח לִבִּי בְּתוֹרָתֶךָ וְאַחֲרֵי מִצְוֹתֶיךָ תִּרְדּוֹף נַפְשִׁי וְכָל הַקָּמִים עָלַי לְרָעָה מְהֵרָה הָפֵר עֲצָתָם וְקַלְקֵל מַחְשְׁבוֹתָם: יִהְיוּ כְּמוֹץ לִפְנֵי רוּחַ וּמַלְאַךְ יְיָ דּוֹחֶה: עֲשֵׂה לְמַעַן שְׁמָךְ עֲשֵׂה לְמַעַן יְמִינָךְ עֲשֵׂה לְמַעַן תּוֹרָתָךְ עֲשֵׂה לְמַעַן קְדוּשָּׁתָךְ. לְמַעַן יֵחָלְצוּן יְדִידֶיךָ הוֹשִׁיעָה יְמִינְךָ וַעֲנֵנִי: יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי: עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא בְּרַחֲמָיו וַחֲסָדָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל וִינַחֲמֵנוּ בְּצִיּוֹן וְיִבְנֶה בְּרַחֲמָיו אֶת יְרוּשָׁלָםִ בְּחַיֵּינוּ וּבְיָמֵינוּ בְּקָרוֹב אָמֵן וְאָמֵן:"}]],"when":{"all":["roshChodesh"]}},{"key":"TJWp26ewNC","he":[[{"t":"אֲדֹנָי שְׂפָתַי תִּפְתָּח וּפִי יַגִּיד תְּהִלָּתֶךָ:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]},"en":"My Master, open my lips, and my mouth will declare Your praise."},{"key":"rxQMwSUSop","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ אֱלֹהֵי אַבְרָהָם אֱלֹהֵי יִצְחָק וֵאלֹהֵי יַעֲקֹב הָאֵל הַגָּדוֹל הַגִּבּוֹר וְהַנּוֹרָא אֵל עֶלְיוֹן גּוֹמֵל חֲסָדִים טוֹבִים וְקוֹנֵה הַכֹּל זוֹכֵר חַסְדֵי אָבוֹת וּמֵבִיא גוֹאֵל לִבְנֵי בְנֵיהֶם מֶלֶךְ רַחֲמָן מוֹשִׁיעַ וּמָגֵן בָּרוּךְ אַתָּה יְיָ מָגֵן אַבְרָהָם:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"-nYnKCTh6q","he":[[{"t":"אַתָּה גִּבּוֹר לְעוֹלָם אֲדֹנָי. מְחַיֶּה מֵתִים אַתָּה. רַב לְהוֹשִׁיעַ "},{"t":"בקיץ אומר","s":"n","when":{"none":["winter"]}},{"t":" מוֹרִיד הַטָּל","when":{"none":["winter"]}},{"t":"בחורף אומר","s":"n","when":{"all":["winter"]}},{"t":" מַשִּׁיב הָרוּחַ וּמוֹרִיד הַגֶּשֶׁם","when":{"all":["winter"]}},{"t":" מְכַלְכֵּל חַיִּים בְּחֶסֶד מְחַיֶּה מֵתִים בְּרַחֲמִים רַבִּים רוֹפֵא חוֹלִים סוֹמֵךְ נוֹפְלִים מַתִּיר אֲסוּרִים וּמְקַיֵּים אֱמוּנָתוֹ לִישֵׁנֵי עָפָר. מִי כָמוֹךָ בַּעַל גְּבוּרוֹת וּמִי דוֹמֶה לָךְ מֵמִית וּמְחַיֶּה וְנֶאֱמָן אַתָּה לְהַחֲיוֹת מֵתִים בָּרוּךְ אַתָּה יְיָ מְחַיֶּה הַמֵּתִים:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"GeC0Qnk54O.1","he":[[{"t":"כֶּתֶר יִתְּנוּ לְךָ יְיָ אֱלֹהֵינוּ מַלְאָכִים הֲמוֹנֵי מַעְלָה עִם עַמְּךָ יִשְׂרָאֵל קְבוּצֵי מַטָּה יַחַד כֻּלָּם קְדוּשָּׁה לְךָ יְשַׁלֵּשׁוּ וְכֵן כָּתוּב עַל יַד נְבִיאָךְ וְקָרָא זֶה אֶל זֶה וְאָמַר "},{"t":"ועונין הקהל","s":"n"},{"t":" קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" כְּבוֹדוֹ וְהוֹדוֹ מְלֹא הָעוֹלָם כֻּלּוֹ וּמְשָׁרְתָיו שׁוֹאֲלִים זֶה לָזֶה אַיֵּה מְקוֹם כְּבוֹדוֹ: "},{"t":"ואומרים הקהל","s":"n"},{"t":" מְשַׁבְּחִים וְאוֹמְרִים בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" מִמְּקוֹמְךָ מַלְכֵּנוּ תּוֹפִיעַ וְתִתְנַשֵּׂא וְתִמְלוֹךְ עָלֵינוּ כִּי מְחַכִּים אָֽנוּ לָךְ מָתַי תִּמְלוֹךְ בְּצִיּוֹן בְּקָרוֹב בְּחַיֵּינוּ וּבְיָמֵינוּ "},{"t":"ועונין הצבור","s":"n"},{"t":" אָמֵן "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" תִּשְׁכּוֹן תִּתְגַּדַּל וְתִתְקַדַּשׁ בְּתוֹךְ יְרוּשָׁלַםִ עִירָךְ לְדֹר וָדֹר וּלְנֵצַח נְצָחִים וְעֵינֵינוּ תִרְאֶינָה בְּמַלְכוּת עֻזָּךְ כַּדָּבָר הָאָמוּר בְּשִׁירֵי קָדְשָׁךְ עַל יַד דָּוִד עַבְדָּךְ מְשִׁיחַ צִדְקָךְ: "},{"t":"ואומרים הקהל","s":"n"},{"t":" יִמְלֹךְ יְיָ לְעוֹלָם אֱלֹהַיִךְ צִיּוֹן לְדֹר וָדֹר הַלְלוּיָהּ: "},{"t":"וחוזר ש\"ץ ואומר","s":"n"},{"t":" לְדֹר וָדֹר נַגִּיד גָּדְלָךְ וּלְנֵצַח נְצָחִים קְדוּשָּׁתָךְ נַקְדִּישׁ שְׁבָחָךְ יְיָ אֱלֹהֵינוּ מִפִּינוּ לֹא יָמוּשׁ כִּי אֵל מֶלֶךָ גָּדוֹל וְקָדוֹשׁ אָתָּה בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]},"minyan":{"he":"קדושה — נאמרת רק בחזרת הש״ץ","en":"Kedushah — said only in the chazzan's repetition"}},{"key":"9WeSNNo_ll","he":[[{"t":"והיחיד אומר נוסח זה:","s":"n"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"V5WK1cUFhS","he":[[{"t":"אַתָּה קָדוֹשׁ וְשִׁמְךָ קָדוֹשׁ וּקְדוֹשִׁים בְּכָל יוֹם יְהַלְלוּךָ סֶלָה בָּרוּךְ אַתָּה יְיָ הָאֵל הַקָּדוֹשׁ:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"NDTY9n1YvN","he":[[{"t":"אַתָּה בְחַרְתָּנוּ מִכָּל הָעַמִּים וְרָצִיתָ בָּנוּ מִכָּל הַלְּשׁוֹנוֹת קִדַּשְׁתָּנוּ בְּמִצְוֹתֶיךָ וְקֵרַבְתָּנוּ מַלְכֵּנוּ לַעֲבוֹדָתֶךָ וְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עָלֵינוּ קָרָאתָ: וַתִּתֶּן לָנוּ יְיָ אֱלֹהֵינוּ מוֹעֲדִים לְשִׂמְחָה חַגִּים וּזְמַנִּים לְשָׂשׂוֹן אֶת יוֹם מִקְרָא קֹדֶשׁ הַזֶּה אֶת יוֹם מוֹעֵד חַג "},{"t":"הַמַּצּוֹת הַזֶּה זְמַן חֵירוּתֵנוּ","when":{"all":["cholHamoedPesach"]}},{"t":"הַסּוּכּוֹת הַזֶּה זְמַן שִׂמְחָתֵנוּ","when":{"all":["cholHamoedSukkot"]}},{"t":" בְּאַהֲבָה זֵכֶר לִיצִיאַת מִצְרָיִם:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"BLHc9CshV1","he":[[{"t":"וּמִפְּנֵי חֲטָאֵינוּ גָּלִינוּ מֵאַרְצֵנוּ וַנִּתְרַחַק מֵעַל אַדְמָתֵנוּ וְאֵין אָֽנוּ יְכוּלִים לַעֲלוֹת לֵרָאוֹת לְהִשְׁתַּחֲוֹת לְפָנֶיךָ בְּבֵית בְּחִירָתָךְ בִּנְוֵה הֲדָרָךְ בַּבַּיִת הַגָּדוֹל וְהַקָּדוֹשׁ שֶׁנִּקְרָא שִׁמְךָ עָלָיו מִפְּנֵי הַיָּד שֶׁנִּשְׁתַּלְּחָה בְּמִקְדָּשָׁךְ: יְהִי רָצוֹן מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ שֶׁתָּשׁוּב וּתְרַחֵם עָלָיו וְעָלֵינוּ בְּרַחֲמֶיךָ הָרַבִּים וּתְקַבֵּץ פְּזוּרֵינוּ מִבֵּין הַגּוֹיִם וּנְפוּצוֹתֵינוּ כְּנוֹס מִיַּרְכְּתֵי אָרֶץ וַהֲבִיאֵנוּ לְצִיּוֹן עִירָךְ בְּרִנָּה וְלִירוּשָׁלַםִ בַּית מִקְדָּשָׁךְ בְּשִׂמְחַת עוֹלָם וְשָׁם נַעֲשֶׂה לְפָנֶיךָ אֶת קָרְבְּנוֹת חוֹבָתֵינוּ תְּמִידִין כְּסִדְרָן וּמוּסָפִין כְּהִלְכָתָן וְאֶת מוּסָפֵי יוֹם מִקְרָא קֹדֶשׁ הַזֶּה יוֹם מוֹעֵד חַג "},{"t":"הַמַּצּוֹת הַזֶּה","when":{"all":["cholHamoedPesach"]}},{"t":"הַסּוּכּוֹת הַזֶּה","when":{"all":["cholHamoedSukkot"]}},{"t":" נַעֲשֶׂה וְנַקְרִיב לְפָנֶיךָ בְּאַהֲבָה כְּמִצְוַת רְצוֹנָךְ כְּמוֹ שֶׁכָּתַבְתָּ עָלֵינוּ בְּתוֹרָתָךְ עַל יְדֵי מֹשֶׁה עַבְדָּךְ:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"I_GED6VP56","he":[[{"t":"מֶלֶךְ רַחֲמָן רַחֵם עָלֵינוּ טוֹב וּמֵטִיב הִדָּרֵשׁ לָנוּ שׁוּבָה עָלֵינוּ בַּהֲמוֹן רַחֲמֶיךָ בִּגְלַל אֲבוֹתֵינוּ שֶׁעָשׂוּ אֶת רְצוֹנָךְ בְּנֵה בֵיתָךְ כְּבַתְּחִלָּה וְכוֹנֵן מִקְדָּשָׁךְ עַל מְכוֹנוֹ. וְהַרְאֵנוּ בְּבִנְיָנוֹ וְשַׂמְּחֵנוּ בְּתִקּוּנוֹ וְהָשֵׁב יִשְׂרָאֵל אֶל נָוֵהוּ כֹּהֲנִים לַעֲבוֹדָתָם וּלְוִיִּם לְדוּכָנָם וְיִשְׂרָאֵל לְמַעֲמָדָם. וְאַרְמוֹן עַל מִשְׁפָּטוֹ יֵשֵׁב. וְשָׁם נַעֲלֶה וְנֵרָאֶה וְנִשְׁתַּחֲוֶה לְפָנֶיךָ בְּשָׁלשׁ פַּעֲמֵי רְגָלֵינוּ כַּכָּתוּב בְּתוֹרָתֶךָ שָׁלשׁ פְּעָמִים בַּשָּׁנָה יֵרָאֶה כָּל זְכוּרְךָ אֶת פְּנֵי יְיָ אֱלֹהֶיךָ בַּמָּקוֹם אֲשֶׁר יִבְחָר בְּחַג הַמַּצּוֹת וּבְחַג הַשָּׁבוּעוֹת וּבְחַג הַסֻּכּוֹת וְלֹא יֵרָאֶה אֶת פְּנֵי יְיָ רֵיקָם: וְנֶאֱמַר אִישׁ כְּמַתְּנַת יָדוֹ כְּבִרְכַּת יְיָ אֱלֹהֶיךָ אֲשֶׁר נָתַן לָךְ:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"fBSgME7vVv","he":[[{"t":"וְהַשִּׂיאֵנוּ יְיָ אֱלֹהֵינוּ אֶת בִּרְכַּת מוֹעֲדֶיךָ לְחַיִּים לְשִׂמְחָה וּלְשָׁלוֹם כַּאֲשֶׁר רָצִיתָ וְאָמַרְתָּ לְבָרְכֵנוּ כֵּן תְּבָרְכֵנוּ סֶלָה:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"dJZaK_6Ko4","he":[[{"t":"קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתָךְ וְשַׂמַּח נַפְשֵׁנוּ בִּישׁוּעָתָךְ וְשַׂבְּעֵנוּ מִטּוּבָךְ וְטַהֵר לִבֵּנוּ לְעָבְדָךְ בֶּאֱמֶת וְהַנְחִילֵנוּ בְּשִׂמְחָה וּבְשָׂשׂוֹן מוֹעֲדֵי קָדְשָׁךְ וְיִשְׂמְחוּ בָם כָּל יִשְׂרָאֵל אוֹהֲבֵי שְׁמֶךָ. בָּרוּךְ אַתָּה יְיָ מְקַדֵּשׁ יִשְׂרָאֵל וְהַזְּמַנִּים:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"5BcAbAIOe4","he":[[{"t":"רְצֵה יְיָ אֱלֹהֵינוּ בְּעַמְּךָ יִשְׂרָאֵל וְלִתְפִלָּתָם שְׁעֵה וְהָשֵׁב הָעֲבוֹדָה אֶל דְּבִיר בֵּיתֶךָ וְאִשֵּׁי יִשְׂרָאֵל. וּתְפִלָּתָם מְהֵרָה תְּקַבֵּל בְּרָצוֹן וּתְהִי לְרָצוֹן תָּמִיד עֲבוֹדַת יִשְׂרָאֵל עַמֶּךָ: וְתִרְצֵנוּ וְתֶחֱזֶינָה עֵינֵינוּ בְּשׁוּבְךָ לְנָוְךָ לְצִיּוֹן בְּרַחֲמִים כְּמֵאָז בָּרוּךְ אַתָּה יְיָ הַמַּחֲזִיר שְׁכִינָתוֹ לְצִיּוֹן:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"DIks-r40OL.2","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ, שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ, אֱלֹהֵי כָל בָּשָׂר, יוֹצְרֵנוּ וְיוֹצֵר בְּרֵאשִׁית. בְּרָכוֹת וְהוֹדָאוֹת לְשִׁמְךָ הַגָּדוֹל וְהַקָּדוֹשׁ עַל שֶׁהֶחֱיִיתָנוּ וְקִיַּמְתָּנוּ. כֵּן תְּחַיֵּנוּ וּתְחָנֵּנוּ וְתֶאֱסֹף גָּלִיּוֹתֵינוּ לְחַצְרוֹת קָדְשָׁךְ, לִשְׁמֹר חֻקֶּיךָ וּלְעָבְדָךְ וְלַעֲשׂוֹת רְצוֹנָךְ בְּלֵבָב שָׁלֵם, עַל שֶׁאָנוּ מוֹדִים לָךְ, בָּרוּךְ אֵל הַהוֹדָאוֹת."}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]},"minyan":{"he":"מודים דרבנן — הקהל אומר בחזרת הש״ץ","en":"Modim DeRabbanan — said by the congregation in the chazzan's repetition"}},{"key":"nidZeI-IKx","he":[[{"t":"מוֹדִים אֲנַחְנוּ לָךְ שֶׁאַתָּה הוּא יְיָ אֱלֹהֵינוּ צוּר חַיֵּינוּ מָגֵן יִשְׁעֵנוּ אַתָּה הוּא לְדֹר וָדֹר נוֹדֶה לָךְ וּנְסַפֵּר תְּהִלָּתֶךָ עַל חַיֵּינוּ הַמְּסוּרִים בְּיָדָךְ עַל נִשְׁמוֹתֵינוּ הַפְּקוּדוֹת לָךְ עַל נִסֶּיךָ וְנִפְלְאוֹתֶיךָ שֶׁבְּכָל עֵת וָעֵת עֶרֶב וָבֹקֶר וְצָהֳרָיִם הַטּוֹב כִּי לֹא כָלוּ רַחֲמֶיךָ הַמְרַחֵם כִּי לֹא תַמּוּ חֲסָדֶיךָ. כָּל הַחַיִּים יְהַלְלוּ אֶת שִׁמְךָ הַגָּדוֹל כִּי טוֹב הָאֵל הַטּוֹב בָּרוּךְ אַתָּה יְיָ הַטּוֹב שִׁמְךָ וּלְךָ נָאֶה לְהוֹדוֹת:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"8YWGRpFFyA","he":[[{"t":"שִׂים שָׁלוֹם טוֹבָה וּבְרָכָה חֵן וְחֶסֶד וְרַחֲמִים עָלֵינוּ וְעַל יִשְׂרָאֵל עַמֶּךָ וּבָרְכֵנוּ כֻּלָּנוּ כְּאֶחָד מִמְּאוֹר פָּנֶיךָ כִּי מִמְּאוֹר פָּנֶיךָ נָתַתָּ לָּנוּ יְיָ אֱלֹהֵינוּ תּוֹרָה וְחַיִּים אַהֲבָה וְחֶסֶד צְדָקָה וְשָׁלוֹם וְטוֹב בְּעֵינֶיךָ לְבָרֵךְ אֶת עַמְּךָ יִשְׂרָאֵל בְּכָל עֵת בַּשָּׁלוֹם בָּרוּךְ אַתָּה יְיָ הַמְּבָרֵךְ אֶת עַמּוֹ יִשְׂרָאֵל בַּשָּׁלוֹם אָמֵן: יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי:"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"WZwNe5Nnbv","he":[[{"t":"ונהגו להתחנן בתחנה זו","s":"n"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"AWAb7rtpnv","he":[[{"t":"אֱלֹהַי נְצוֹר לְשׁוֹנִי מֵרָע וְשִׂפְתוֹתַי מִדַּבֵּר מִרְמָה וְלִמְקַלְלַי נַפְשִׁי תִדּוֹם וְנַפְשִׁי כֶּעָפָר לַכֹּל תִּהְיֶה. פְּתַח לִבִּי בְּתוֹרָתֶךָ וְאַחֲרֵי מִצְוֹתֶיךָ תִּרְדּוֹף נַפְשִׁי וְכָל הַקָּמִים עָלַי לְרָעָה מְהֵרָה הָפֵר עֲצָתָם וְקַלְקֵל מַחְשְׁבוֹתָם. יִהְיוּ כְּמוֹץ לִפְנֵי רוּחַ וּמַלְאַךְ יְיָ דּוֹחֶה: עֲשֵׂה לְמַעַן שְׁמָךְ עֲשֵׂה לְמַעַן יְמִינָךְ עֲשֵׂה לְמַעַן תּוֹרָתָךְ עֲשֵׂה לְמַעַן קְדוּשָּׁתָךְ. לְמַעַן יֵחָלְצוּן יְדִידֶיךָ הוֹשִׁיעָה יְמִינְךָ וַעֲנֵנִי: יִהְיוּ לְרָצוֹן אִמְרֵי פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי: עוֹשֶׂה שָׁלוֹם בִּמְרוֹמָיו הוּא בְּרַחֲמָיו וַחֲסָדָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל וִינַחֲמֵנוּ בְּצִיּוֹן וְיִבְנֶה בְּרַחֲמָיו אֶת יְרוּשָׁלָםִ בְּחַיֵּינוּ וּבְיָמֵינוּ בְּקָרוֹב אָמֵן וְאָמֵן: "},{"t":"וחוזר ש\"ץ התפלה ואומר אבות וגבורות ואומר ברכה ג' בנוסח כתר וכו' (כנז\"ל) עד האל הקדוש. אתה בחרתנו וכו' עד מקדש ישראל והזמנים רצה ומודים ועולים הכהנים לדוכן ונושאים כפיהם וכשאין כהן בבהכנ\"ס אומר ש\"ץ אלהינו וכו' שים שלום וקדיש תתקבל וגומרין התפלה:","s":"n"}]],"when":{"any":["cholHamoedPesach","cholHamoedSukkot"]}},{"key":"lL2RKsHpC7.4","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵהּ רַבָּא "},{"t":"(אמן)","s":"n"},{"t":" בְּעָלְמָא דִּי בְרָא כִרְעוּתֵהּ וְיִמְלֹךְ מַלְכוּתֵהּ וְיַצְמַח פֻּרְקָנֵהּ וִיקָרֵב מְשִׁיחֵהּ וְיִפְרֹק עַמֵּהּ, בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל, בַּעֲגַלָא וּבִזְמָן קָרִיב. וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":" יְהֶא שְׁמֵהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא. יִתְבָּרַךְ "},{"t":"(אמן)","s":"n"},{"t":" וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵהּ דְּקֻדְשָׁא בְּרִיךְ הוּא "},{"t":"(אמן)","s":"n"},{"t":" לְעֵילָא לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתֻשְׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן "},{"t":"(אמן)","s":"n"},{"t":"."}]],"when":{"all":["musaf"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"a4iwyxlH9q.2","he":[[{"t":"תִּתְקַבַּל צְלוֹתְכוֹן וְתִתְעֲבֵיד בָּעוּתְכוֹן וּצְלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל בֵּית יִשְׂרָאֵל קֳדָם אֲבוּנָא דְּבִשְׁמַיָא: יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָא וְסִיַּעְתָּא וּפוּרְקָנָא ורְוַוחָא וְחִנָּא וְחִסְדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשְׂרָאֵל לְחַיִּים וּלְשָׁלוֹם וְאִמְרוּ אָמֵן: עוֹשֶׂה שָׁלוֹם וכו':"}]],"when":{"all":["musaf"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"פטום הקטורת","en":"Pitum HaKetoret"},"segments":[{"key":"RY9PwXGyqb","he":[[{"t":"ונהגו עתה לקרות פטום הקטרת וזה נוסחה","s":"n"}]]},{"key":"kjINOhuaS5","he":[[{"t":"אַתָּה הוּא יְיָ אֱלֹהֵינוּ שֶׁהִקְטִירוּ אֲבוֹתֵינוּ לְפָנֶיךָ אֶת קְטֹרֶת הַסַּמִּים בִּזְמָן שֶׁבֵּית הַמִּקְדָּשׁ קַיָּים כַּאֲשֶׁר צִוִּיתָ אוֹתָם עַל יַד מֹשֶׁה נְבִיאֶךָ כַּכָּתוּב בְּתוֹרָתֶךָ וַיֹאמֶר יְיָ אֶל מֹשֶׁה קַח לְךָ סַמִּים נָטָף וּשְׁחֵלֶת וְחֶלְבְּנָה סַמִּים וּלְבוֹנָה זַכָּה בַּד בְּבַד יִהְיֶה: וְעָשִׂיתָ אֹתָהּ קְטֹרֶת רֹקַח מַעֲשֵׂה רוֹקֵח מְמֻלָּח טָהוֹר קֹדֶשׁ: וְשָׁחַקְתָּ מִמֶּנָּה הָדֵק וְנָתַתָּה מִמֶּנָּה לִפְנֵי הָעֵדוּת בְּאֹהֶל מוֹעֵד אֲשֶׁר אִוָּעֵד לְךָ שָׁמָּה קֹדֶשׁ קָדָשִׁים תִּהְיֶה לָכֶם: וְנֶאֱמַר וְהִקְטִיר עָלָיו אַהֲרֹן קְטֹרֶת סַמִּים בַּבֹּקֶר בַּבֹּקֶר בְּהֵיטִיבוֹ אֶת הַנֵרֹת יַקְטִירֶנָּה: וּבְהַעֲלֹת אַהֲרֹן אֶת הַנֵּרֹת בֵּין הָעַרְבַּיִם יַקְטִירֶנָּה קְטֹרֶת תָּמִיד לִפְנֵי יְיָ לְדֹרֹתֵיכֶם: תְּנוֹ רַבָּנַן פִּטּוּם הַקְּטֹרֶת כֵּיצַד. שְׁלשׁ מֵאוֹת וְשִׁשִּׁים וּשְׁמֹנֶה מָנִים הָיוּ בָהּ. שְׁלשׁ מֵאוֹת וְשִׁשִּׁים וַחֲמִשָּׁה כְּמִנְיַן יְמוֹת הַחַמָּה וּשְׁלשָׁה מָנִים יְתֵרִים שֶׁמֵּהֶם מַכְנִיס כֹּהֵן גָּדוֹל מְלֹא חָפְנָיו בְּיוֹם הַכִּפּוּרִים וּמַחֲזִירָן לַמַּכְתֶּשֶׁת בְּעֶרֶב יוֹם הַכִּפּוּרִים כְּדֵי לְקַיֵּים בָּהּ מִצְוַת דַּקָּה מִן הַדַּקָּה וְאַחַד עָשָׂר סַמָּנִים הָיוּ בָהּ וְאֵלּוּ הֵן הַצֳּרִי וְהַצִּפּוֹרֶן הַחֶלְבְּנָה וְהַלְּבֹנָה מִשְׁקַל שִׁבְעִים שִׁבְעִים מָנֶה. מוֹר וּקְצִיעָה. וְשִׁבּוֹלֶת נֵרְדְּ. וְכַרְכּוֹם. מִשְׁקַל שִׁשָּׁה עָשָׂר שִׁשָּׁה עָשָׂר מָנֶה. הַקּוֹשְׁטְ שְׁנֵים עָשָׂר: קְלוּפָה שְׁלשָׁה. קִנָּמוֹן תִּשְׁעָה. בּוֹרִית כַּרְשִׁינָא תִּשְׁעָה קַבִּין. יֵין קַפְרִיסִין סְאִין תְּלָת וְקַבִּין תְּלָתָא. וְאִם לֹא מָצָא יֵין קַפְרִיסִין מֵבִיא חֲמַר חִיוָר עַתִּיק. מֶלַח סְדוֹמִית רוֹבַע הַקָּב. מַעֲלֶה עָשָׁן כָּל שֶׁהוּא. רִבִּי נָתָן הַבָּבְלִי אוֹמֵר אַף מִכִּפַּת הַיַרְדֵּן כָּל שֶׁהוּא, אִם נָתַן בָּהּ דְּבַשׁ פְּסָלָהּ. וְאִם חִסַּר אַחַת מִכָּל סַמָּנֶיהָ חַיָּיב מִיתָה: רַבַּן שִׁמְעוֹן בֶּן גַּמְלִיאֵל אוֹמֵר הַצֳּרִי אֵינוּ אֵלָא שֶׂרֶף הַנּוֹטֵף מֵעֲצֵי הַקְּטָף. בּוֹרִית כַּרְשִׁינָא לְמַה הִיא בָאָה כְּדֵי לְשַׁפּוֹת בָּהּ אֶת הַצִּפּוֹרֶן כְּדֵי שֶׁתְּהֵא נָאָה: יֵין קַפְרִיסִין לְמַה הוּא בָא. כְּדֵי לִשְׁרוֹת בּוֹ אֶת הַצִּפּוֹרֶן כְּדֵי שֶׁתְּהֵא עַזָה. וַהֲלֹא מֵי רַגְלַיִם יָפִין לָהּ. אֵלָּא שֶׁאֵין מַכְנִיסִין מֵי רַגְלַיִם בַּמִּקְדָּשׁ מִפְּנֵי הַכָּבוֹד: תַּנְיָא רִבִּי נָתָן אוֹמֵר כְּשֶׁהוּא שׁוֹחֵק אוֹמֵר הָדֵק הֵיטֵב הֵיטֵב הָדֵק מִפְּנֵי שֶׁהַקּוֹל יָפֶה לַבְּשָׂמִים פִּטְּמָהּ לַחֲצָאִין כְּשֵׁרָה לִשְׁלִישׁ וְלִרְבִיעַ לֹא שָׁמַעְנוּ אָמַר רִבִּי יְהוּדָה זֶה הַכְּלָל אִם כְּמִדָּתָהּ כְּשֵׁרָה לַחֲצָאִין וְאִם חִסַּר אַחַת מִכָּל סַמָּנֶיהָ חַיָּיב מִיתָה: תַּנֵי בַּר קַפַּרָא אַחַת לְשִׁשִּׁים אוֹ לְשִׁבְעִים שָׁנָה הָיְתָה בָּאָה שֶׁל שְׁיָרַיִם לַחֲצָאִין וְעוֹד תַּנֵי בַּר קַפַּרָא אִלּוּ הָיָה נוֹתֵן בָּהּ קוּרְטוֹב שֶׁל דְבַשׁ אֵין אָדָם יָכוֹל לַעֲמוֹד מִפְּנֵי רֵיחָהּ. וְלָמָּה אֵין מְעָרְבִין בָּהּ דְּבַשׁ מִפְּנֵי שֶׁהַתּוֹרָה אָמְרָה כִּי כָל שְׂאֹר וְכָל דְּבַשׁ לֹא תַקְטִירוּ מִמֶּנּוּ אִשֶּׁה לַייָ:"}]]},{"key":"jY9sCQxBl9","he":[[{"t":"רִבּוֹן הָעוֹלָמִים בָּאנוּ לְחַלּוֹת פָּנֶיךָ שֶׁתַּעְצוֹר הַמַּגֵּפָה מֵעָלֵינוּ וְלֹא תִתֵּן הַמַּשְׁחִית לָבֹא אֶל בָּתֵּינוּ וְרַחֵם עָלֵינוּ וְעַל טַפֵּנוּ וְעַל עוֹלָלֵינוּ וְעַל כָּל יִשְׂרָאֵל עַמֶּךָ וְקַבֵּל תְּפִלָּתֵנוּ כְּמוֹ שֶׁקִּבַּלְתָּ קְטֹרֶת הַסַּמִּים שֶׁהִקְטִיר לְפָנֶיךָ אַהֲרֹן הַכֹּהֵן כַּאֲשֶׁר הֵחֵל הַנֶּגֶף בָּעָם שֶׁנֶּאֱמַר וַיֹּאמֶר מֹשֶׁה אֶל אַהֲרֹן קַח אֶת הַמַּחְתָּה וְתֶן עָלֶיהָ אֵשׁ מֵעַל הַמִּזְבֵּחַ וְשִׂים קְטֹרֶת וְהוֹלֵךְ מְהֵרָה אֶל הָעֵדָה וְכַפֵּר עֲלֵיהֶם כִּי יָצָא הַקֶּצֶף מִלִּפְנֵי יְיָ הֵחֵל הַנָּגֶף: וַיִּקַּח אַהֲרֹן כַּאֲשֶׁר דִּבֶּר מֹשֶׁה וַיָּרָץ אֶל תּוֹךְ הַקָּהָל וְהִנֵּה הֵחֵל הַנֶּגֶף בָּעָם וַיִּתֵּן אֶת הַקְּטֹרֶת וַיְכַפֵּר עַל הָעָם: וַיַּעֲמֹד בֵּין הַמֵּתִים וּבֵין הַחַיִּים וַתֵּעָצַר הַמַּגֵּפָה: וְכֵן פִּנְחָס שֶׁנֶּאֱמַר וַיַּעֲמֹד פִּינְחָס וַיְפַלֵּל וַתֵּעָצַר הַמַּגֵּפָה וְכֵן דָּוִד שֶׁנֶּאֱמַר וַיִּבֶן שָׁם דָּוִד מִזְבֵּחַ לַייָ וַיַּעַל עֹלוֹת וּשְׁלָמִים וַיֵּעָתֵר יְיָ לָאָרֶץ וַתֵּעָצַר הַמַּגֵּפָה מֵעַל יִשְׂרָאֵל:"}]],"optional":{"he":"כשיש, חס ושלום, מגפה בעיר אומרים","en":"Said when, God forbid, there is a plague in the town"}},{"key":"f86ungYl77","he":[[{"t":"כִּי אַתָּה אָבִינוּ. וּלְךָ תְּלוּיוֹת עֵינֵינוּ: רְפָאֵנוּ יְיָ וְנֵרָפֵא הוֹשִׁיעֵנוּ וְנִוָּשֵׁעָה כִּי תְהִלָּתֵנוּ אָתָּה: שֶׁכֵּן כָּתוּב בְּתוֹרָתֶךָ וְהֵסִיר יְיָ מִמְּךָ כָּל חוֹלִי וְכָל מַדְוֵי מִצְרַיִם הָרָעִים אֲשֶׁר יָדַעְתָּ לֹא יְשִׂימָם בָּךְ וּנְתָנָם בְּכָל שׂוֹנְאֶיךָ:"}]],"optional":{"he":"כשיש, חס ושלום, מגפה בעיר אומרים","en":"Said when, God forbid, there is a plague in the town"}},{"key":"eHkL-HdPUX","he":[[{"t":"יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה: יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ: יְיָ הוֹשִׁיעָה הַמֶּלֶךְ יַעֲנֵנוּ בְּיוֹם קָרְאֵנוּ:"}]],"en":"Adonoy of Hosts is with us, a stronghold for us is the God of Jacob, Selah! Adonoy of Hosts, fortunate is the man who trusts in You. Adonoy, deliver [us]! The King will answer us on the day we call."},{"key":"lDfLsNKHer","he":[[{"t":"תַּנָא דְּבֵי אֵלִיָּהוּ כָּל הַשּׁוֹנֶה הֲלָכוֹת בְּכָל יוֹם מוּבְטָח לוֹ שֶׁהוּא בֶּן הָעוֹלָם הַבָּא שֶׁנֶּאֱמַר הֲלִיכוֹת עוֹלָם לוֹ אַל תִּקְרֵי הֲלִיכוֹת אֶלָּא הֲלָכוֹת אָמַר רִבִּי אֶלְעָזָר אָמַר רִבִּי חֲנִינָא תַּלְמִידֵי חֲכָמִים מַרְבִּים שָׁלוֹם בָּעוֹלָם שֶׁנֶּאֱמַר וְכָל בָּנַיִךְ לִמּוּדֵי יְיָ וְרַב שְׁלוֹם בָּנָיִךְ אַל תִּקְרֵי בָּנָיִךְ אֶלָּא בּוֹנָיִךְ: יְהִי שָׁלוֹם בְּחֵילֵךְ שַׁלְוָה בְּאַרְמְנוֹתָיִךְ: לְמַעַן אַחַי וְרֵעָי אֲדַבְּרָה נָּא שָׁלוֹם בָּךְ: לְמַעַן בֵּית יְיָ אֱלֹהֵינוּ אֲבַקְשָׁה טוֹב לָךְ: וּרְאֵה בָנִים לְבָנֶיךָ שָׁלוֹם עַל יִשְׂרָאֵל: שָׁלוֹם רָב לְאֹהֲבֵי תוֹרָתֶךָ וְאֵין לָמוֹ מִכְשׁוֹל: יְיָ עֹז לְעַמּוֹ יִתֵּן יְיָ יְבָרֵךְ אֶת עַמּוֹ בַּשָּׁלוֹם:"}]]}]},{"title":{"he":"רבי חנניא בן עקשיא","en":"Rabbi Chananya ben Akashya"},"segments":[{"key":"4MK17Zvs-b","he":[[{"t":"ונהגו שהחזן קורא לעם עתה בקצת הלכות כגון פסקי הלכות הש\"ע או הרמב\"ם בעבור אותם המקדימים לצאת למלאכתם תכף אחר השלמת התפלה שבזה יהיה בטחון בחלק לעוה\"ב כדאמר התם כל השונה הלכות בכל יום מובטח לו וכו' וכשמסיים החזן לקרות מתחילים ואומרים","s":"n"}]]},{"key":"CoCFgYG5C6","he":[[{"t":"רִבִּי חֲנַנְיָא בֶּן עֲקַשְׁיָא אוֹמֵר רָצָה הַקָּדוֹשׁ בָּרוּךְ הוּא לְזַכּוֹת אֶת יִשְׂרָאֵל לְפִיכָּךְ הִרְבָּה לָהֶם תּוֹרָה וּמִצְוֹת שֶׁנֶּאֱמַר יְיָ חָפֵץ לְמַעַן צִדְקוֹ יַגְדִּיל תּוֹרָה וְיַאְדִּיר:"}]]}]},{"title":{"he":"קדיש דרבנן","en":"Kaddish DeRabbanan"},"minyanOnly":true,"segments":[{"key":"wlvPyNJaJj","he":[[{"t":"יִתְגַּדַּל וְיִתְקַדַּשׁ שְׁמֵיהּ רַבָּא. (אָמֵן). דַּעֲתִיד לְחַדָּתָא עָלְמָא וּלְאַחָאָה מֵיתַיָא וּלְמִפְרַק חַיַיָא וּלְמִבְנֵי קַרְתָּא יְרוּשְׁלַם וּלְשַׁכְלָלָא הֵיכְלָא קַדִּישָׁא וּלְמִעְקַר פּוּלְחָנָא נוּכְרָאָה מִן אַרְעָא וּלְאָתָבָא פּוּלְחָנָא דִי שְׁמֵיהּ לְאַתְרֵיהּ בְּהַדְרֵיהּ בְּזִיוֵיהּ וּבִיקָרֵיהּ וְיִמְלוֹךְ מַלְכוּתֵיהּ וְיַצְמַח פּוּרְקָנֵיהּ וְיִבַּע מְשִׁיחֵיהּ וְיִפְרוֹק עַמֵּיהּ בְּחַיֵּיכוֹן וּבְיוֹמֵיכוֹן וּבְחַיֵּיהוֹן דְּכָל בֵּית יִשְׂרָאֵל בַּעֲגָלָא וּבִזְמָן קָרִיב וְאִמְרוּ אָמֵן יְהֵא שְׁמֵיהּ רַבָּא מְבָרַךְ לְעָלַם וּלְעָלְמֵי עָלְמַיָּא: יִתְבָּרַךְ: (אָמֵן). וְיִשְׁתַּבַּח וְיִתְפָּאַר וְיִתְרוֹמַם וְיִתְעַלֶּה וְיִתְהַדַּר וְיִתְהַלַּל וְיִתְנַשֵּׂא שְׁמֵיהּ דְּקוּדְשָׁא בְּרִיךְ הוּא, (אָמֵן) לְעֵילָא מִכָּל בִּרְכָתָא שִׁירָתָא וְתוּשְׁבְּחָתָא וְנֶחָמָתָא דִּי אֲמִירָן בְּעָלְמָא וְאִמְרוּ אָמֵן: עַל יִשְׂרָאֵל וְעַל רַבָּנַן וְעַל תַּלְמִידֵיהוֹן וְעַל כָּל תַּלְמִידֵי תַּלְמִידֵיהוֹן דְּעָסְקִין בְּאוֹרָיְתָא דִּי בְּאַתְרָא הָדֵין וְדִי בְּכָל אֲתַר וַאֲתַר יְהֵי לְכוֹן וְלַנָא חִנָּא וְחִסְדָּא וְרַחֲמֵי מִן קֳדָם אֲבוּנָא דְּבִשְׁמַיָא וְאִמְרוּ אָמֵן: יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָא וְסִיַּעְתָּא וּפוּרְקָנָא וּרְוַוחָא וְחִנָּא וְחִסְדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשְׂרָאֵל לְחַיִּים וּלְשָׁלוֹם וְאִמְרוּ אָמֵן: "},{"t":"עושה שלום וכו':","s":"n"}]],"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"ברכו לסיום","en":"Closing Barchu"},"minyanOnly":true,"segments":[{"key":"r9S7i9Tdcy","he":[[{"t":"בָּרְכוּ אֶת יְיָ הַמְּבוֹרָךְ:"}]],"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"H-Fi3nYH7q","he":[[{"t":"בָּרוּךְ יְיָ הַמְּבוֹרָךְ לְעוֹלָם וָעֶד:"}]],"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}}]},{"title":{"he":"עלינו לשבח","en":"Aleinu"},"segments":[{"key":"J48_IUpAZQ","he":[[{"t":"עָלֵינוּ לְשַׁבֵּחַ לַאֲדוֹן הַכֹּל לָתֵת גְּדֻלָּה לְיוֹצֵר בְּרֵאשִׁית שֶׁלֹּא עָשָׂנוּ כְּגוֹיֵי הָאֲרָצוֹת וְלֹא שָׂמָנוּ כְּכָל מִשְׁפְּחוֹת הָאֲדָמָה שֶׁלֹּא שָׂם חֶלְקֵנוּ כְּחֶלְקָם וְלֹא גוֹרָלֵנוּ כְּכָל הֲמוֹנָם שֶׁהֵם מִשְׁתַּחֲוִים לְהֶבֶל וָרִיק וּמִתְפַּלְּלִים אֶל אֵל לֹא יוֹשִׁיעַ:"}]]},{"key":"SAgGNTGcHp","he":[[{"t":"וַאֲנַחְנוּ מִשְׁתַּחֲוִים לִפְנֵי מֶלֶךְ מַלְכֵי הַמְּלָכִים בָּרוּךְ הוּא שְׁהוּא נוֹטֶה שָׁמַיִם וְיוֹסֵד אָרֶץ מוֹשַׁב יְקָרוֹ בַּשָּׁמַיִם מִמַּעַל וּשְׁכִינַת עֻזוֹ בְּגָבְהֵי מְרוֹמִים הוּא אֱלֹהֵינוּ וְאֵין עוֹד. אֱמֶת מַלְכֵּנוּ וְאֵין זוּלָתוֹ. כַּכָּתוּב בְּתוֹרָתוֹ וְיָדַעְתָּ הַיוֹם וַהֲשֵׁבוֹתָ אֶל לְבָבֶךָ כִּי יְיָ הוּא הָאֱלֹהִים בַּשָּׁמַיִם מִמַּעַל וְעַל הָאָרֶץ מִתָּחַת אֵין עוֹד:"}]]},{"key":"cTRhsUaOIE","he":[[{"t":"עַל כֵּן נְקַוֶּה לָּךְ יְיָ אֱלֹהֵינוּ לִרְאוֹת מְהֵרָה בְּתִפְאֶרֶת עֻזָךְ לְהַעֲבִיר גִּלּוּלִים מִן הָאָרֶץ וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן לְתַקֵּן עוֹלָם בְּמַלְכוּת שַׁדַּי וְכָל בְּנֵי בָשָׂר יִקְרְאוּ בִשְׁמֶךָ לְהַפְנוֹת אֵלֶיךָ כָּל רִשְׁעֵי אָרֶץ יַכִּירוּ וְיֵדְעוּ כָּל יוֹשְׁבֵי תֵבֵל כִּי לְךָ תִּכְרַע כָּל בֶּרֶךְ תִּשָּׁבַע כָּל לָשׁוֹן. לְפָנֶיךָ יְיָ אֱלֹהֵינוּ יִכְרְעוּ וְיִפֹּלוּ וְלִכְבוֹד שְׁמָךְ הַגָּדוֹל יְקָר יִתֵּנוּ וִיקַבְּלוּ כֻלָּם עוֹל מַלְכוּתֶךָ וְתִמְלוֹךְ עֲלֵיהֶם לְעוֹלָם וָעֶד כִּי הַמַּלְכוּת שֶׁלָּךְ הִיא וּלְעוֹלְמֵי עַד תִּמְלוֹךְ בְּכָבוֹד כַּכָּתוּב בְּתוֹרָתֶךָ יְיָ יִמְלוֹךְ לְעוֹלָם וָעֶד. וְכָתוּב וְהָיָה יְיָ לְמֶלֶךְ עַל כָּל הָאָרֶץ בַּיּוֹם הַהוּא יִהְיֶה יְיָ אֶחָד וּשְׁמוֹ אֶחָד:"}]]}]}],"credits":[{"title":"Siddur Nusach Teiman Baladi, Weekday Shacharit — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3101143"},{"title":"Adon HaOlamim — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3081615"},{"title":"Yihyu LeRatzon (template) — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3003259"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"},{"title":"HaMehulal — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3081625"},{"title":"Weekday Hallel — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Taking the Lulav — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Lighting the Chanukah Candles — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Weekday Shacharit: the Song of the Day to Aleinu — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Lefanecha Ani Kore'a — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3095956"},{"title":"Weekday Shacharit: the Torah Reading and Uva LeTzion — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Musaf of Rosh Chodesh and the Festivals — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Weekday Mincha — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"},{"title":"Siddur Sefard — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Sefard"}]}