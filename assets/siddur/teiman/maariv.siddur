נוּ׃"}]],"when":{"all":["omer"]}},{"key":"KLgUVP0HYH","he":[[{"t":"יְבָרְכֵנוּ אֱלֹהִים וְיִירְאוּ אֹתוֹ כָּל־אַפְסֵי־אָרֶץ׃"}]],"when":{"all":["omer"]}}]},{"title":{"he":"מזמורים לאחר התפילה","en":"Psalms After the Prayer"},"segments":[{"key":"6msLtewjPn","he":[[{"t":"אומרים מזמורים אלו","s":"n"},{"t":" לַמנַצֵּחַ עַל הַגִּתִּית מִזמוֹר לְדָוִד: יְיָ אֲדֹנֵינוּ מָה אַדִּיר שִׁמךָ בְּכָל הָאָרֶץ אֲשֶׁר תְּנָה הוֹדְךָ עַל הַשָּׁמָיִם: מִפִּי עוֹלְלִים וְֽיֹנְקִים יִסַּדתָּ עֹז לְמַעַן צוֹרְרֶיךָ לְהַשׁבִּית אוֹיֵב וּמִתנַקֵּם: כִּי אֶראֶה שָׁמֶיךָ מַעֲשֵׂה אֶצבְּעֹתֶיךָ יָרֵחַ וְכוֹכָבִים אֲשֶׁר כּוֹנָנתָּה: מָה אֱנוֹשׁ כִּי תִזכְּרֶנּוּ וּבֶן אָדָם כִּי תִפקְדֶנּוּ: וַתְּחַסְּרֵהוּ מְּעַט מֵאֱלֹהִים וְכָבוֹד וְהָדָר תְּעַטְּרֵהוּ: תַּמשִׁילֵהוּ בְּמַעֲשֵׂי יָדֶיךָ כֹּל שַֽׁתָּה תַחַת רַגלָיו: צֹנֶה וַאֲלָפִים כֻּלָּם וְגַם בַּהֲמוֹת שָׂדָי: צִפּוֹר שָׁמַיִם וּדגֵי הַיָּם עֹבֵר אָרחוֹת יַמִּים: יְיָ אֲדֹנֵינוּ מָה אַדִּיר שִׁמךָ בְּכָל הָאָרֶץ:"}]],"when":{"none":["tishaBav"]}},{"key":"ijhqGuk7Li","he":[[{"t":"שִׁיר לַמַּעֲלוֹת אֶשָּׂא עֵינַי אֶל הֶהָרִים מֵאַיִן יָבֹא עֶזרִי: עֶזרִי מֵעִם יְיָ עֹשֵׂה שָׁמַיִם וָאָרֶץ: אַל יִתֵּן לַמּוֹט רַגלֶךָ אַל יָנוּם שֹׁמְרֶךָ: הִנֵּה לֹא יָנוּם וְלֹא יִישָׁן שׁוֹמֵר יִשׂרָאֵל: יְיָ שֹׁמְרֶךָ יְיָ צִלְּךָ עַל יַד יְמִינֶךָ: יוֹמָם הַשֶּׁמֶשׁ לֹא יַכֶּכָּה וְיָרֵחַ בַּלָּילָה: יְיָ יִשׁמָרךָ מִכָּל רָע יִשׁמֹר אֶת נַפשֶׁךָ: יְיָ יִשׁמָר צֵאתְךָ וּבוֹאֶךָ מֵעַתָּה וְעַד עוֹלָם:"}]],"when":{"none":["tishaBav"]},"en":"A song of ascents. I lift my eyes to the mountains— from where will my help come? My help [comes] from Adonoy, Maker of heaven and earth. He will not let your foot slip, He will not slumber—your Guardian. Behold—He does not slumber nor does He sleep—the Guardian of Israel. Adonoy is your guardian, Adonoy is your shelter at your right hand. By day the sun will not smite you, nor the moon at night. Adonoy will guard you from all evil, He will preserve your soul, Adonoy will guard your going and coming from now and forever."}]},{"title":{"he":"רבי חנניא בן עקשיא","en":"Rabbi Chananya ben Akashya"},"segments":[{"key":"vlwvHPu1gU","he":[[{"t":"רִבִּי חֲנַניָא בֶּן עֲקַשׁיָא אוֹמֵר רָצָה הַקָּדוֹשׁ בָּרוּךְ הוּא לְזַכּוֹת אֶת יִשׂרָאֵל לְפִיכָּךְ הִרבָּה לָהֶם תּוֹרָה וּמִצו‍ֹת שֶׁנֶּאֱמָר יְיָ חָפֵץ לְמַעַן צִדקוֹ יַגדִּיל תּוֹרָה וְיַאדִּיר:"}]],"when":{"none":["tishaBav"]}}]},{"title":{"he":"קדיש דרבנן","en":"Kaddish DeRabbanan"},"minyanOnly":true,"segments":[{"key":"kbeLe9tSOb","he":[[{"t":"יִתגַּדַּל וְיִתקַדַּשׁ שְׁמֵיהּ רַבָּא. (אָמֵן). דַּעֲתִיד לְחַדָּתָא עָלְמָא וּלאַחָאָה מִיתַיָּא וּלמִפרַק חַיַיָּא וּלמִבנֵי קַרתָּא יְרוּשׁלַם וּלשַׁכלָלָא הֵיכְלָא קַדִּישָׁא וּלמִעקַר פּוּלְחָנָא נוּכְרָאָה מִן אַרעָא וּלאָתָבָא פוּלחָנָא דִּי שְׁמֵיהּ לְאַתרֵיהּ בְּהַדרֵיהּ בְּזִיוֵיהּ וּבִיקָרֵיהּ. וְיִמלוֹךְ מַלכוּתֵיהּ וְיַצמַח פֻּרקָנֵיהּ (וִיקָרֵב) [וְיַבַּע] מְשִׁיחֵיהּ וְיִפרוֹק עַמֵּיהּ. בְּחַיֵּיכוֹן וּביוֹמֵיכוֹן וּבחַיֵּיהוֹן דְכָל בֵּית יִשׂרָאֵל בַּעֲגַלָא וּבִזמָן קָרִיב וְאִמרוּ אָמֵן. "},{"t":"ועונים הצבור והוא עמהם","s":"n"},{"t":" אָמֵן. יְהֶא שְׁמֵיהּ רַבָּא מְבָרַךְ לְעָלַם וּלעָלְמֵי עָלְמַיָּא: יִתבָּרַךְ: (אָמֵן) וְיִשׁתַּבַּח וְיִתפָּאַר וְיִתרוֹמַם וְיִתעַלֶּה וְיִתהַדַּר וְיִתהַלַּל וְיִתנַשֵּׂא שְׁמֵיהּ דְּקֻדשָׁא בְּרִיךְ הוּא. (אָמֵן) לְעֵילָא לְעֵילָא מִכָּל בִּרכָתָא שִׁירָתָא וְתֻשׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמרוּ אָמֵן: (אָמֵן)"}]],"when":{"none":["tishaBav"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"0IlzUff79R","he":[[{"t":"עַל יִשׂרָאֵל וְעַל רַבָּנַן וְעַל תַּלמִידֵיהוֹן וְעַל (כָּל) תַּלמִידֵי תַּלמִידֵיהוֹן דְּעָסְקִין בְּאוֹרָיתָא (קַדִּישְׁתָא) דִּי בְאַתרָא הָדֵין וְדִי בְכָל אֲתַר וַאֲתַר יְהֵא לְהוֹן וְלַנָא חִנָּא וְחִסדָּא וְרַחֲמֵי מִן קֳדָם אֲבוּנָא דְּבִשׁמַיָּא וְאִמרוּ אָמֵן: (אָמֵן) יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָּא וְסִיַּעתָּא וּפוּרְקָנָא וּרוַחָא וְחִנָּא וְחִסדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשׂרָאֵל לְחַיִּים וּלשָׁלוֹם וְאִמרוּ אָמֵן: (אָמֵן). "},{"t":"וש\"צ אומר מכאן עם הצבור","s":"n"},{"t":" עוֹשֶׂה שָׁלוֹם בִּמרוֹמָיו הוּא בְרַחֲמָיו וַחֲסָדָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשׂרָאֵל (וִינַחֲמֵנוּ בְצִיּוֹן וְיִבנֶה בְרַחֲמָיו אֶת יְרוּשָׁלָיִם בְּחַיֵּינוּ וּביָמֵינוּ בְּקָרוֹב אָמֵן וְאָמֵן):"}]],"when":{"none":["tishaBav"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"ברכו לסיום","en":"Closing Barchu"},"minyanOnly":true,"segments":[{"key":"uYQvLEec9t","he":[[{"t":"וכורע הש\"צ ואומר","s":"n"},{"t":" בָּרְכוּ אֶת יְיָ הַמְּבוֹרָךְ:"}]],"when":{"none":["tishaBav"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}},{"key":"HEm3PBtd6N","he":[[{"t":"ועונין הקהל והוא עמהם","s":"n"},{"t":" בָּרוּךְ יְיָ הַמְּבוֹרָךְ לְעוֹלָם וָעֶד:"}]],"when":{"none":["tishaBav"]},"minyan":{"he":"שליח הציבור אומר והקהל עונה","en":"The chazzan says, and the congregation responds"}}]},{"title":{"he":"עלינו לשבח","en":"Aleinu"},"segments":[{"key":"RIn2aNn9LH","he":[[{"t":"עָלֵינוּ לְשַׁבֵּחַ לַאֲדוֹן הַכֹּל לָתֵת גְּדֻלָּה לְיוֹצֵר בְּרֵאשִׁית. שֶׁלֹּא עָשָׂנוּ כְּגוֹיֵי הָאֲרָצוֹת וְלֹא שָׂמָנוּ כְּכָל מִשׁפְּחוֹת הָאֲדָמָה. שֶׁלֹּא שָׂם חֶלקֵנוּ "},{"t":"(בעשי\"ת אומר","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" כָּהֵם ","when":{"all":["aseretYemeiTeshuva"]}},{"t":"ולא וכו')","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" כְּחֶלקָם וְלֹא גוֹרָלֵנוּ כְּכָל הֲמוֹנָם. שֶׁהֵם מִשׁתַּחֲוִים לְהֶבֶל וְרִיק וּמִתפַּֽלְלִים "},{"t":"(בעשי\"ת אומר","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" לְלֹא יוֹעִיל ","when":{"all":["aseretYemeiTeshuva"]}},{"t":"ואנחנו וכו')","s":"n","when":{"all":["aseretYemeiTeshuva"]}},{"t":" אֶל אֵל לֹא יוֹשִׁיעַ. וַאֲנַחנוּ מִשׁתַּחֲוִים לִפנֵי מֶלֶךְ מַלכֵי הַמְּלָכִים הַקָּדוֹשׁ בָּרוּךְ הוּא. שְׁהוּא נוֹטֶה שָׁמַיִם וְיוֹסֵד אָרֶץ. מוֹשַׁב יְקָרוֹ בַּשָּׁמַיִם מִמַּעַל. וּשׁכִינַת עֻזּוֹ בְּגָבהֵי מְרוֹמִים. הוּא אֱלֹהֵינוּ וְאֵין עוֹד, אֱמֶת מַלכֵּנוּ וְאֵין זוּלָתוֹ. כַּכָּתוּב בְּתוֹרָתוֹ וְיָדַעתָּ הַיּוֹם וַהֲשֵׁבוֹתָ אֶל לְבָבֶךָ כִּי יְיָ הוּא הָאֱלֹהִים בַּשָּׁמַיִם מִמַּעַל וְעַל הָאָרֶץ מִתָּחַת. אֵין עוֹד:"}]]},{"key":"IJ72laeKGL","he":[[{"t":"עַל כֵּן נְקַוֶּה לָּךְ יְיָ אֱלֹהֵינוּ לִראוֹת מְהֵרָה בְּתִפאֶרֶת עֻזָּךְ. לְהַעֲבִיר גִּלּוּלִים מִן הָאָרֶץ וְהָאֱלִילִים כָּרוֹת יִכָּרֵתוּן. לְתַכֶּן עוֹלָם בְּמַלכוּת שַׁדַּי. וְכָל בְּנֵי בָשָׂר יִקרְאוּ בִשׁמֶךָ, לְהַפנוֹת אֵלֶיךָ כָּל רִשׁעֵי אָרֶץ. יַכִּירוּ וְיֵדְעוּ כָּל יוֹשְׁבֵי תֵבֵל כִּי לְךָ תִּכרַע כָּל בֶּרֶךְ תִּשָּׁבַע כָּל לָשׁוֹן. לְפָנֶיךָ יְיָ אֱלֹהֵינוּ יִכרְעוּ וְיִפֹּלוּ. וְלִכבוֹד שְׁמָךְ הַגָּדוֹל יְקָר יִתֵּנוּ. וִיקַבְּלוּ כֻלָּם עוֹל מַלכוּתֶךָ וְתִמלוֹךְ עֲלֵיהֶם לְעוֹלָם וָעֶד. כִּי הַמַּלכוּת שֶׁלָּךְ הִיא וּלעוֹלְמֵי עַד תִּמלוֹךְ בְּכָבוֹד. כַּכָּתוּב בְּתוֹרָתֶךָ יְיָ יִמלֹךְ לְעֹלָם וָעֶד: וְכָתוּב וְהָיָה יְיָ לְמֶלֶךְ עַל כָּל הָאָרֶץ. בַּיּוֹם הַהוּא יִהיֶה יְיָ אֶחָד וּשׁמוֹ אֶחָד:"}]]},{"key":"sj4OaQRIcl","he":[[{"t":"כשחל ט\"ב במ\"ש אין פושטין בגדי שבת מבע\"י. ואין אומרים מעלות ומתפללים כבשאר ימים ואומרים הבדלה בחונן הדעת ואומרים קדיש ואומרים ויהי נועם וכו' ואתה קדוש וישלים סדרא דיומא וקדיש תתקבל ואומרים עלינו לשבח ויושב ומברך על הנר בורא מאורי האש קודם איכה ואינו מברך על הבשמים. ומוצאי ט\"ב מבדיל על הכוס ואינו מברך לא על הנר ולא על הבשמים. ומתחילין לקונן למי אבכה וכו' עד סוף הסדר הכתוב לעיל:","s":"n"}]],"when":{"all":["tishaBav","motzaeiShabbat"]}},{"key":"nGmlvjx1Oy","he":[[{"t":"ויושב לארץ ומתחיל ש\"ץ לקונן:","s":"n"}]],"when":{"all":["tishaBav"]}},{"key":"hLhrct8wCB","he":[[{"t":"בליל תשעה באב קוראים כאן מגילת איכה ואומרים קינות.","s":"n"}]],"en":"On the night of Tisha B'Av, Eichah and kinot are read here.","when":{"all":["tishaBav"]}}]}],"credits":[{"title":"Maariv of Tisha B'Av — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"},{"title":"Siddur Nusach Teiman Baladi, Weekday Maariv — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=2896952"},{"title":"Siddur Nusach Teiman Baladi, Weekday Shacharit — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3101143"},{"title":"Yihyu LeRatzon (template) — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3003259"},{"title":"Maariv after Shabbat: Vihi No'am and V'Atah Kadosh — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"Weekday Shacharit: the Torah Reading and Uva LeTzion — Tiklal Etz Chaim, Jerusalem 1894 (transcription)","license":"Public Domain","url":"https://archive.org/details/Tiklal_Eiz_Hayyim_Jerusalem_1894"},{"title":"The Order of Counting the Omer — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=2929975"},{"title":"The Omer Count, Nusach Teiman Baladi (template) — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=400058"},{"title":"Ana BeKoach — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=3085666"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}