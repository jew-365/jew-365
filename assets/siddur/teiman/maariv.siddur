tzaeiShabbat"]}},{"key":"4mzl1XiGS1","he":[[{"t":"ואומר ש\"צ: ואתה קדוש יושב וכו' ואומרים סדר הקדושה ומשלימין כמו בחול","s":"n"},{"t":", ומבדיל על הכוס, ומדליק נר של שעווה או של שמן, ומתחיל. אם הוא כוס של יין, מברך","s":"n","when":{"none":["tishaBav"]}},{"t":".","s":"n"}]],"when":{"any":["tishaBav","viHiNoam"],"all":["motzaeiShabbat"]}},{"key":"lMOsL94Iv-","he":[[{"t":"וְאַתָּה קָדוֹשׁ יוֹשֵׁב תְּהִלּוֹת יִשְׂרָאֵל׃ וְקָרָא זֶה אֶל זֶה וְאָמַר קָדוֹשׁ קָדוֹשׁ קָדוֹשׁ יְיָ צְבָאוֹת מְלֹא כָל הָאָרֶץ כְּבוֹדוֹ "},{"t":"ואומר ש\"צ","s":"n"},{"t":" וּמְקַבְּלִין דֵּין מִדֵּין וְאָמְרִין קַדִּישׁ בִּשְׁמֵי מְרוֹמָא בֵּית שְׁכִינְתֵיהּ קַדִּישׁ עַל אַרְעָא עוֹבָד גְּבוּרְתֵיהּ קַדִּישׁ בְּעָלַם עָלְמַיָּא יְיָ צְבָאוֹת: מַלְיָא כָל אַרְעָא זִיו יְקָרֵיהּ: וַתִּשָׂאֵנִי רוּחַ וָאֶשְׁמַע אַחֲרַי קוֹל רַעַשׁ גָּדוֹל בָּרוּךְ כְּבוֹד יְיָ מִמְּקוֹמוֹ: וּנְטַלַתְנִי רוּחָא וּשְׁמַעִית בָּתְרַי קָל זְיָע סַגִּי דִּמְשַׁבְּחִין וְאָמְרִין בְּרִיךְ יְקָרָא דַּייָ מֵאֲתַר בֵּית שְׁכִינְתֵיהּ: יְיָ יִמְלֹךְ לְעוֹלָם וָעֶד: יְיָ מַלְכוּתֵיהּ לְעָלְמָא וּלְעָלְמֵי עָלְמַיָּא: יְיָ אֱלֹהֵי אַבְרָהָם יִצְחָק וְיִשְׂרָאֵל אֲבוֹתֵינוּ שָׁמְרָה זֹאת לְעוֹלָם לְיֵצֶר מַחְשְׁבוֹת לְבַב עַמֶּךָ וְהָכֵן לְבָבָם אֵלֶיךָ: וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃ כִּי אַתָּה יְיָ טוֹב וְסַלָּח וְרַב חֶסֶד לְכָל קֹרְאֶיךָ: צִדְקָתְךָ צֶדֶק לְעוֹלָם וְתוֹרָתְךָ אֱמֶת׃ מִי אֵל כָּמוֹךָ נֹשֵׂא עָוֹן וְעֹבֵר עַל פֶּשַׁע לִשְׁאֵרִית נַחֲלָתוֹ לֹא הֶחֱזִיק לָעַד אַפּוֹ כִּי חָפֵץ חֶסֶד הוּא: יָשׁוּב יְרַחֲמֵנוּ יִכְבּוֹשׁ עֲוֹנוֹתֵינוּ וְתַשְׁלִיךְ בִּמְצוּלוֹת יָם כָּל חַטֹּאתָם: תִּתֵּן אֱמֶת לְיַעֲקֹב חֶסֶד לְאַבְרָהָם אֲשֶׁר נִשְׁבַּעְתָּ לַאֲבוֹתֵינוּ מִימֵי קֶדֶם: בָּרוּךְ אֲדֹנָי יוֹם יוֹם יַעֲמָס־לָנוּ הָאֵל יְשׁוּעָתֵנוּ סֶלָה׃ יְיָ צְבָאוֹת עִמָּנוּ מִשְׂגָּב־לָנוּ אֱלֹהֵי יַעֲקֹב סֶלָה׃ יְיָ צְבָאוֹת אַשְׁרֵי אָדָם בֹּטֵחַ בָּךְ׃"}]],"when":{"any":["tishaBav","viHiNoam"],"all":["motzaeiShabbat"]}},{"key":"Tsx52UPMdx","he":[[{"t":"בָּרוּךְ אֱלֹהֵינוּ בָּרוּךְ אֲדֹנֵינוּ בָּרוּךְ בּוֹרְאֵנוּ שֶׁבְּרָאָנוּ לִכְבוֹדוֹ שֶׁהִבְדִּילָנוּ מִן הַתּוֹעִים וְנָתַן לָנוּ תּוֹרַת אֱמֶת עַל יְדֵי מֹשֶׁה רַבֵּינוּ חַיֵּי עוֹלָם נָטַע בְּתוֹכֵנוּ הָרַחֲמָן יִפְתַּח לִבֵּנוּ לְתַלְמוּד תּוֹרָתוֹ וְיִתֵּן בְּלִבֵּנוּ אַהֲבָתוֹ וְיִרְאָתוֹ לַעֲשׂוֹת רְצוֹנוֹ כִּרְצוֹנוֹ וּלְעָבְדוֹ בְּלֵבָב שָׁלֵם וּבְנֶפֶשׁ חֲפֵצָה לְמַעַן לֹא נִיגַע לָרִיק וְלֹא נֵלֵד לַבֶּהָלָה. כֵּן יְהִי רָצוֹן וְרַחֲמִים מִלְּפָנֶיךָ יְיָ אֱלֹהֵינוּ שֶׁנִּחְיֶה לִשְׁמוֹר חֻקֶּיךָ בָּעוֹלָם הַזֶּה וְלִימוֹת הַמָּשִׁיחַ כְּדֵי שֶׁנִּזְכֶּה וְנִירַשׁ טוֹב לְחַיֵי הָעוֹלָם הַבָּא: לְמַעַן יְזַמֶּרְךָ כָבוֹד וְלֹא יִדֹּם יְיָ אֱלֹהַי לְעוֹלָם אוֹדֶךָּ׃ יִהְיוּ לְרָצוֹן אִמְרֵי־פִי וְהֶגְיוֹן לִבִּי לְפָנֶיךָ יְיָ צוּרִי וְגֹאֲלִי׃"}]],"when":{"any":["tishaBav","viHiNoam"],"all":["motzaeiShabbat"]}}]},{"title":{"he":"קדיש שלם","en":"Full Kaddish"},"minyanOnly":true,"segments":[{"key":"khQEV5gNnC.1","he":[[{"t":"יִתגַּדַּל וְיִתקַדַּשׁ שְׁמֵיהּ רַבָּא. (אָמֵן). בְּעָלְמָא דִי בְרָא כִרעוּתֵיהּ וְיִמלוֹךְ מַלכוּתֵיהּ וְיַצמַח פֻּרקָנֵיהּ וִיקָרֵב מְשִׁיחֵיהּ וְיִפרוֹק עַמֵּיהּ. בְּחַיֵּיכוֹן וּביוֹמֵיכוֹן וּבחַיֵּיהוֹן דְכָל בֵּית יִשׂרָאֵל בַּעֲגַֽלָא וּבִזמָן קָרִיב וְאִמרוּ אָמֵן. "},{"t":"ועונים הצבור והוא עמהם","s":"n"},{"t":" אָמֵן. יְהֶא שְׁמֵיהּ רַבָּא מְבָרַךְ לְעָלַם וּלעָלְמֵי עָלְמַיָּא: יִתבָּרַךְ: (אָמֵן) וְיִשׁתַּבַּח וְיִתפָּאַר וְיִתרוֹמַם וְיִתעַלֶּה וְיִתהַדַּר וְיִתהַלַּל וְיִתנַשֵּׂא שְׁמֵיהּ דְּקֻדשָׁא בְּרִיךְ הוּא. (אָמֵן) לְעֵילָא לְעֵילָא מִכָּל בִּרכָתָא שִׁירָתָא וְתֻשׁבְּחָתָא וְנֶחָמָתָא דַּאֲמִירָן בְּעָלְמָא וְאִמרוּ אָמֵן. (אָמֵן)"}]],"when":{"any":["tishaBav","viHiNoam"],"all":["motzaeiShabbat"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}},{"key":"9MyUIEzwU7.2","he":[[{"t":"תִּתקַבַּל צְלוֹתְכוֹן וְתִתעֲבֵיד בָּעוּתְכוֹן וּצלוֹתְהוֹן וּבָעוּתְהוֹן דְּכָל בֵּית יִשׂרָאֵל קֳדָם אֲבוּנָא דְבִשׁמַיָּא. יְהֶא שְׁלָמָא רַבָּא מִן שְׁמַיָּא וְסִיַּעתָּא וּפוּרְקָנָא וּרוַחָא וְחִנָּא וְחִסדָּא וְרַחֲמֵי עֲלֵיכוֹן וַעֲלַנָא וְעַל כָּל קְהָלְהוֹן דְּכָל בֵּית יִשׂרָאֵל לְחַיִּים וּלשָׁלוֹם וְאִמרוּ אָמֵן: (אָמֵן). "},{"t":"וש\"צ אומר מכאן עם הצבור","s":"n"},{"t":" עוֹשֶׂה שָׁלוֹם בִּמרוֹמָיו הוּא בְרַחֲמָיו וַחֲסָדָיו יַעֲשֶׂה שָׁלוֹם עָלֵינוּ וְעַל כָּל יִשׂרָאֵל וִינַחֲמֵנוּ בְצִיּוֹן וְיִבנֶה בְרַחֲמָיו אֶת יְרוּשָׁלָיִם בְּחַיֵּינוּ וּביָמֵינוּ בְּקָרוֹב אָמֵן וְאָמֵן:"}]],"when":{"any":["tishaBav","viHiNoam"],"all":["motzaeiShabbat"]},"minyan":{"he":"רק שליח הציבור אומר","en":"Said by the chazzan only"}}]},{"title":{"he":"ספירת העומר","en":"Counting of the Omer"},"segments":[{"key":"SjE28Yp505","he":[[{"t":"לפני הברכה הש״צ מזכיר כמה ספרו אתמול, למשל, בליל שביעי הוא אומר: \"אֶתְמוֹל, שִׁיתָּא יוֹמֵי בעומרא\"","s":"n"}]],"when":{"all":["omer"]}},{"key":"yqgHn1hKg-","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֹתָיו וְצִוָּֽנוּ עַל סְפִירַת הָעֹֽמֶר."}]],"when":{"all":["omer"]},"en":"Blessed are You, Adonoy, our God, King of the universe, Who sanctified us with His commandments and commanded us to count the Omer."},{"key":"jTpHjI8YvP","he":[[{"t":"ט\"ז ניסן","s":"n"},{"t":" הַאידַּאנָא חַד יוֹמָא בְּעֻמרָא"}]],"en":"Today is 1 day of the Omer","when":{"all":["omer"],"omerDay":1}},{"key":"Mgw0Y8gZOw","he":[[{"t":"י\"ז ניסן","s":"n"},{"t":" הַאידַּאנָא תְּרֵין יוֹמֵי בְּעֻמרָא"}]],"en":"Today is 2 days of the Omer","when":{"all":["omer"],"omerDay":2}},{"key":"8byR2ieU-Y","he":[[{"t":"י\"ח ניסן","s":"n"},{"t":" הַאידַּאנָא תְּלָתָא יוֹמֵי בְּעֻמרָא"}]],"en":"Today is 3 days of the Omer","when":{"all":["omer"],"omerDay":3}},{"key":"mrCn6Q7djD","he":[[{"t":"י\"ט ניסן","s":"n"},{"t":" הַאידַּאנָא אַרבְּעָא יוֹמֵי בְּעֻמרָא"}]],"en":"Today is 4 days of the Omer","when":{"all":["omer"],"omerDay":4}},{"key":"D4zYN5nJDl","he":[[{"t":"כ' ניסן","s":"n"},{"t":" הַאידַּאנָא חַמשָׁא יוֹמֵי בְּעֻמרָא"}]],"en":"Today is 5 days of the Omer","when":{"all":["omer"],"omerDay":5}},{"key":"AAyhGzrQz5","he":[[{"t":"כ\"א ניסן","s":"n"