{"nusach":"teiman","id":"al_hamichya","sections":[{"title":{"he":"ברכה מעין שלוש","en":"Me'ein Shalosh"},"segments":[{"key":"t5WW8mx3qw","he":[[{"t":"על חמשת מיני דגן מברך על המחיה, על היין מברך על הגפן, ועל פירות משבעת המינים – על העץ. אם צריך לברך על יותר מסוג אחד, מצרפם לברכה אחת, בסדר הנ\"ל. בחתימת הברכה, גם על היין חותם ב\"פירות\".","s":"n"}]]},{"key":"PqBpO6hDgZ","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם,"}]]},{"key":"qdQ2RPDpGv","he":[[{"t":"עַל הַמִּחְיָה","s":"b"}],[{"t":"וְעַל הַכַּלְכָּלָה","s":"b"}]]},{"key":"Qj-s9489Za","he":[[{"t":"[וְ]עַל הַגֶּפֶן"}],[{"t":"וְעַל פְּרִי הַגֶּפֶן"}]]},{"key":"4nrCXA54zW","he":[[{"t":"[וְ]עַל הָעֵץ"}],[{"t":"וְעַל פְּרִי הָעֵץ"},{"t":" וְעַל אֶרֶץ חֶמְדָּה טוֹבָה וּרְחָבָה, שֶׁרָּצִיתָ וְהִנְחַלְתָּ לַאֲבֹתֵינוּ. רַחֶם‏ יְיָ אֱלֹהֵינוּ עַל יִשְׂרָאֵל עַמָּךְ, וְעַל יְרוּשָׁלַיִם עִירָךְ, וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ. וְהַעֲלֵנוּ לְתוֹכָהּ, וְשַׂמְּחֵנוּ בְּבִנְיָנָהּ, (וְנֹאכַל מִפִּרְיָהּ, וְנִשְׂבַּע מִטּוּבָהּ,) וּנְבָרֶכְךָ עָלֶיהָ בִּקְדֻשָּׁה וּבְטָהֳרָה.","s":"b"}]]},{"key":"-qAq2gxz9v","he":[[{"t":"(כִּי אֵל טוֹב וּמֵטִיב אָתָּה.) בָּרוּךְ אַתָּה יְיָ, עַל הָאָרֶץ וְעַל "},{"t":"הַמִּחְיָה","s":"b"}]]},{"key":"M1_pUhJaHJ","he":[[{"t":"על היין ועל הפירות: ","s":"n"},{"t":"הַפֵּירוֹת","s":"b"}]]}]},{"title":{"he":"לפירות ארץ ישראל","en":"For Produce of the Land of Israel"},"optional":{"he":"לפירות ארץ ישראל","en":"For produce of the Land of Israel"},"segments":[{"key":"npwjeaHEGu","he":[[{"t":"על פירות ארץ ישראל מסיימים:","s":"n"}]],"en":"For produce of the Land of Israel, the blessing ends:"},{"key":"-qAq2gxz9v.1","he":[[{"t":"(כִּי אֵל טוֹב וּמֵטִיב אָתָּה.) בָּרוּךְ אַתָּה יְיָ, עַל הָאָרֶץ וְעַל "},{"t":"הַמִּחְיָה","s":"b"}]]},{"key":"M1_pUhJaHJ.1","he":[[{"t":"על הפירות: ","s":"n"},{"t":"פֵּרוֹתֶיהָ","s":"b"}]]}]}],"credits":[{"title":"Me'ein Shalosh, Nusach Teiman Baladi — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=2896943"}]}