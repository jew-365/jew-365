{"nusach":"teiman","id":"birkat_hamazon","sections":[{"title":{"he":"לפני ברכת המזון","en":"Before Grace"},"segments":[{"key":"8zvlhhETng","he":[[{"t":"קודם ברכת המזון בנוסח הבלאדי אומרים מזמור לדוד השם רועי וגו', ולאחר מכן מזמור של אותו המאורע על פי הפירוט דלהלן, ולבסוף למנצח בנגינות.","s":"n"}]]},{"key":"lhHUOOcqoj","he":[[{"t":"מִזְמוֹר לְדָוִד יְיָ רֹעִי לֹא אֶחְסָר׃"}]]},{"key":"P3ApZQ8IX9","he":[[{"t":"בִּנְאוֹת דֶּשֶׁא יַרְבִּיצֵנִי עַל־מֵי מְנֻחוֹת יְנַהֲלֵנִי׃"}]]},{"key":"4MMQ-YxFsn","he":[[{"t":"נַפְשִׁי יְשׁוֹבֵב יַנְחֵנִי בְמַעְגְּלֵי־צֶדֶק לְמַעַן שְׁמוֹ׃"}]]},{"key":"JuYKDUfMvF","he":[[{"t":"גַּם כִּי־אֵלֵךְ בְּגֵיא צַלְמָוֶת לֹא־אִירָא רָע כִּי־אַתָּה עִמָּדִי שִׁבְטְךָ וּמִשְׁעַנְתֶּךָ הֵמָּה יְנַחֲמֻנִי׃"}]]},{"key":"5QmjuXpKbc","he":[[{"t":"תַּעֲרֹךְ לְפָנַי שֻׁלְחָן נֶגֶד צֹרְרָי דִּשַּׁנְתָּ בַשֶּׁמֶן רֹאשִׁי כּוֹסִי רְוָיָה׃"}]]},{"key":"oowuGy19iP","he":[[{"t":"אַךְ טוֹב וָחֶסֶד יִרְדְּפוּנִי כָּל־יְמֵי חַיָּי וְשַׁבְתִּי בְּבֵית־יְיָ לְאֹרֶךְ יָמִים׃"}]]},{"key":"RA0_DSV_aY","he":[[{"t":"לברית מילה – מזמור יב. לסעודת חתן – מזמור מה. לחנוכת הבית – מזמור ל. לבית האבל – מזמור מט.","s":"n"}]]},{"key":"RWEUwmlf5Y","he":[[{"t":"לַמְנַצֵּח בִּנְגִינֹת מִזְמוֹר שִׁיר׃"}]]},{"key":"G7OdaVq7Dr","he":[[{"t":"אֱלֹהִים יְחָנֵּנוּ וִיבָרְכֵנוּ יָאֵר פָּנָיו אִתָּנוּ סֶלָה׃"}]]},{"key":"Yk9ViKFMcf","he":[[{"t":"לָדַעַת בָּאָרֶץ דַּרְכֶּךָ בְּכָל־גּוֹיִם יְשׁוּעָתֶךָ׃"}]]},{"key":"geV4iswlLr","he":[[{"t":"יוֹדוּךָ עַמִּים אֱלֹהִים יוֹדוּךָ עַמִּים כֻּלָּם׃"}]]},{"key":"4s1Bqq-VIZ","he":[[{"t":"יִשְׂמְחוּ וִירַנְּנוּ לְאֻמִּים כִּי־תִשְׁפֹּט עַמִּים מִישׁוֹר וּלְאֻמִּים בָּאָרֶץ תַּנְחֵם סֶלָה׃"}]]},{"key":"B4oHF9fpeC","he":[[{"t":"יוֹדוּךָ עַמִּים אֱלֹהִים יוֹדוּךָ עַמִּים כֻּלָּם׃"}]]},{"key":"Qn04G9CDNa","he":[[{"t":"אֶרֶץ נָתְנָה יְבוּלָהּ יְבָרְכֵנוּ אֱלֹהִים אֱלֹהֵינוּ׃"}]]},{"key":"cKC8NMovvb","he":[[{"t":"יְבָרְכֵנוּ אֱלֹהִים וְיִירְאוּ אֹתוֹ כָּל־אַפְסֵי־אָרֶץ׃"}]]},{"key":"Wf1zruh7aj","he":[[{"t":"גָּבְרוּ חֲסָדָיו עָלֵֽינוּ, וְלֹא כָלוּ רַחֲמָיו מִמֶּֽנּוּ. וַיְדַבֵּר אֵלַי זֶה הַשֻּׁלְחָן אֲשֶׁר לִפְנֵי יְיָ:"}]]}]},{"title":{"he":"זימון","en":"Zimun"},"segments":[{"key":"Pql97NrcDe","he":[[{"t":"אֲבָרְכָה אֶת יְיָ בְּכׇל עֵת תָּמִיד תְּהִלָּתוֹ בְּפִי."}]]},{"key":"bR1RL_Erx2","he":[[{"t":"וִיבָרְכוּ שֵׁם כְּבוֹדֶֽךָ וּמְרוֹמַם עַל כׇּל בְּרָכָה וּתְהִלָּה:"}]],"optional":{"he":"יש מוסיפים","en":"Some add"}},{"key":"hPel9GfFR7","he":[[{"t":"("},{"t":"בעשרה:","s":"n"},{"t":" רִבּוֹתַי) בָּרֵֽכוּ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"}},{"key":"PU-6Dk3k5m","he":[[{"t":"בָּרֵךְ."}]],"minyan":{"he":"המסובים עונים","en":"The others respond"}},{"key":"68v9SEdQzd","he":[[{"t":"נְבָרֵךְ ("},{"t":"בעשרה:","s":"n"},{"t":" לֵאלֹהֵֽינוּ) שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"}},{"key":"JZCcsdWIP2","he":[[{"t":"בָּרוּךְ ("},{"t":"בעשרה:","s":"n"},{"t":" אֱלֹהֵֽינוּ) שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ וּבְטוּבוֹ חָיִֽינוּ."}]],"minyan":{"he":"המסובים עונים","en":"The others respond"},"en":"Blessed is (our God) He for we have eaten of His bounty and through His goodness we live."},{"key":"tTuuHdgZpT","he":[[{"t":"בָּרוּךְ ("},{"t":"בעשרה:","s":"n"},{"t":" אֱלֹהֵֽינוּ) שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ וּבְטוּבוֹ חָיִֽינוּ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"},"en":"Blessed is (our God) He for we have eaten of His bounty and through His goodness we live."}]},{"title":{"he":"זימון בסעודת שבע ברכות","en":"Zimun at a Sheva Berachot Meal"},"optional":{"he":"בסעודת שבע ברכות","en":"At a sheva berachot meal"},"segments":[{"key":"RnO3Iaj5iP","he":[[{"t":"("},{"t":"בעשרה:","s":"n"},{"t":" רִבּוֹתַי) בָּרֵֽכוּ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"}},{"key":"9QuFGdm7qT","he":[[{"t":"בָּרֵךְ."}]],"minyan":{"he":"המסובים עונים","en":"The others respond"}},{"key":"ixSW94r16_","he":[[{"t":"נְבָרֵךְ ("},{"t":"בעשרה:","s":"n"},{"t":" לֵאלֹהֵֽינוּ) שֶׁהַשִּׂמְחָה בִּמְעוֹנוֹ שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"}},{"key":"ukrfzAqlID","he":[[{"t":"בָּרוּךְ ("},{"t":"בעשרה:","s":"n"},{"t":" אֱלֹהֵֽינוּ) שֶׁהַשִּׂמְחָה בִּמְעוֹנוֹ שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ וּבְטוּבוֹ חָיִֽינוּ."}]],"minyan":{"he":"המסובים עונים","en":"The others respond"}},{"key":"L_JY2ZDeHA","he":[[{"t":"בָּרוּךְ ("},{"t":"בעשרה:","s":"n"},{"t":" אֱלֹהֵינוּ) שֶׁהַשִּׂמְחָה בִּמְעוֹנוֹ שֶׁאָכַֽלְנוּ מִשֶּׁלּוֹ וּבְטוּבוֹ חָיִֽינוּ."}]],"minyan":{"he":"המזמן אומר","en":"The leader says"}},{"key":"4YQLcwe_Fu","he":[[{"t":"אֲבָרְכָה אֶת יְיָ בְּכׇל עֵת תָּמִיד תְּהִלָּתוֹ בְּפִי."}]]}]},{"title":{"he":"ברכת המזון","en":"Grace After Meals"},"segments":[{"key":"LfJcD4eG86","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, הַזָּן אֶת הָעוֹלָם כֻּלּוֹ, בְּטוֹב, בְּחֵן, בְּחֶֽסֶד, וּבְרַחֲמִים. וְטוּבוֹ הַגָּדוֹל לֹא חָסַר לָֽנוּ, וְאַל יְחַסֵּר לָֽנוּ לְעוֹלָם וָעֶד. כִּי הוּא זָן (וּמֵזִין), וּמְפַרְנֵס לַכֹּל. כָּאָמוּר, פּוֹתֵֽחַ אֶת יָדֶֽךָ, וּמַשְׂבִּֽיַע לְכׇל חַי רָצוֹן. וּמֵכִין מָזוֹן לְכׇל בִּרְיוֹתָיו אֲשֶׁר בָּרָא. בָּרוּךְ אַתָּה יְיָ, הַזָּן בְּרַחֲמָיו אֶת הַכֹּל:","s":"b"}]]},{"key":"V01r1jrBDy","he":[[{"t":"נוֹדֶה לָךְ יְיָ אֱלֹהֵֽינוּ, וּנְבָרְכָךְ מַלְכֵּֽנוּ. כִּי הִנְחַֽלְתָּ אֶת אֲבֹתֵֽינוּ, אֶֽרֶץ חֶמְדָּה, טוֹבָה וּרְחָבָה, בְּרִית וְתוֹרָה. וְעַל שֶׁהוֹצֵאתָֽנוּ מֵאֶֽרֶץ מִצְרַֽיִם, וּפְדִיתָֽנוּ מִבֵּית עֲבָדִים. וְעַל תּוֹרָתָךְ שֶׁלִּמַּדְתָּֽנוּ, וְעַל חֻקֵּי רְצוֹנָךְ שֶׁהוֹדַעְתָּֽנוּ:","s":"b"}]]},{"key":"XB7jJLUMlN","he":[[{"t":"בחנוכה אומר","s":"n","when":{"any":["chanukah","chanukahYesterday"]}}],[{"t":"עַל הַנִּסִּים וְעַל הַגְּבוּרוֹת, וְעַל הַמִּלְחָמוֹת וְעַל הַתְּשׁוּעוֹת, וְעַל הַפְּדוּת וְעַל הַפֻּרְקָן, שֶׁעָשִֽׂיתָ עִמָּֽנוּ וְעִם אֲבוֹתֵֽינוּ, בַּיָּמִים הָהֵם בַּזְּמָן הַזֶּה:","when":{"any":["chanukah","chanukahYesterday"]}}],[{"t":"בִּימֵי מַתִּתְיָה בֶּן יוֹחָנָן כֹּהֵן גָּדוֹל חַשְׁמוּנַּאי וּבָנָיו. כְּשֶׁעָמְדָה מַלְכוּת יָוָן הָרִשְׁעָה עַל עַמְּךָ בֵית יִשְׂרָאֵל, לְבַטְּלָם מִתּוֹרָתֶֽךָ, וּלְהַעֲבִירָם מֵחֻקֵּי רְצוֹנֶֽךָ. וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים, עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם, וְדַֽנְתָּ אֶת דִּינָם, וְרַֽבְתָּ אֶת רִיבָם, וְנָקַֽמְתָּ אֶת נִקְמָתָם. וּמָסַֽרְתָּ גִבּוֹרִים בְּיַד חַלָּשִׁים, וְרַבִּים בְּיַד מְעַטִּים, וּטְמֵאִים בְּיַד טְהוֹרִים, וּרְשָׁעִים בְּיַד צַדִּיקִים, וּפֹשְׁעִים בְּיַד עוֹשֵׂי תוֹרָתֶֽיךָ. וְעָשִֽׂיתָ לְּךָ שֵׁם גָּדוֹל בְּעוֹלָמֶֽךָ. וּלְעַמְּךָ יִשְׂרָאֵל עָשִֽׂיתָ פֶֽלֶא וְנִסִּים. כְּשֵׁם שֶׁעָשִֽׂיתָ עִמָּהֶם נִסִּים וּגְבוּרוֹת, כָּךְ עֲשֵׂה עִמָּֽנוּ נִסִּים וּגְבוּרוֹת, בָּעֵת וּבָעוֹנָה הַזֹּאת:","when":{"any":["chanukah","chanukahYesterday"]}}]],"optional":{"he":"אם התחילו לאכול לפני השקיעה בחנוכה או בפורים","en":"If the meal began before sunset on Chanukah or Purim","when":{"any":["chanukahYesterday","purimYesterday"]}}},{"key":"oZrAs7UmNy","he":[[{"t":"בפורים אומר","s":"n"}],[{"t":"עַל הַנִּסִּים וְעַל הַגְּבוּרוֹת וְעַל הַתְּשׁוּעוֹת, שֶׁעָשִֽׂיתָ עִמָּֽנוּ וְעִם אֲבוֹתֵֽינוּ, בַּיָּמִים הָהֵם בַּזְּמָן הַזֶּה: בִּימֵי מָרְדֳּכַי וְאֶסְתֵּר. כְּשֶׁעָמַד הָמָן הָרָע עַל עַמְּךָ בֵית יִשְׂרָאֵל, וּבִקַּשׁ לְהַשְׁמִיד לַהֲרוֹג וּלְאַבֵּד אֶת כׇּל הַיְּהוּדִים מִנַּעַר וְעַד זָקֵן טַף וְנָשִׁים בְּיוֹם אֶחָד, וּשְׁלָלָם לָבוֹז. וְאַתָּה בְּרַחֲמֶֽיךָ הָרַבִּים, עָמַֽדְתָּ לָהֶם בְּעֵת צָרָתָם, וְדַֽנְתָּ אֶת דִּינָם, וְרַֽבְתָּ אֶת רִיבָם, וְנָקַֽמְתָּ אֶת נִקְמָתָם. וְהֵפַֽרְתָּ אֶת עֲצָתוֹ, וְקִלְקַֽלְתָּ אֶת מַחֲשַׁבְתּוֹ, וַהֲשֵׁבוֹתָ לוֹ גְּמוּלוֹ בְרֹאשׁוֹ, וְתָלוּ אוֹתוֹ וְאֶת בָּנָיו עַל הָעֵץ. וְעָשִֽׂיתָ לְּךָ שֵׁם גָּדוֹל בְּעוֹלָמֶֽךָ. וּלְעַמְּךָ יִשְׂרָאֵל עָשִֽׂיתָ פֶֽלֶא וְנִסִּים. כְּשֵׁם שֶׁעָשִֽׂיתָ עִמָּהֶם פֶּֽלֶא וְנִסִּים, כָּךְ עֲשֵׂה עִמָּֽנוּ נִסִּים וּגְבוּרוֹת, בָּעֵת וּבָעוֹנָה הַזֹּאת:"}]],"when":{"any":["purim","purimYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בחנוכה או בפורים","en":"If the meal began before sunset on Chanukah or Purim","when":{"any":["chanukahYesterday","purimYesterday"]}}},{"key":"jb1xIHfSa_","he":[[{"t":"וְעַל כֻּלָּם, יְיָ אֱלֹהֵֽינוּ, אָֽנוּ מוֹדִים לָךְ, וּמְבָרְכִים אֶת שְׁמָךְ. כָּאָמוּר, וְאָכַלְתָּ וְשָׂבָֽעְתָּ, וּבֵרַכְתָּ אֶת יְיָ אֱלֹהֶיךָ, עַל הָאָרֶץ הַטּוֹבָה אֲשֶׁר נָֽתַן לָךְ. בָּרוּךְ אַתָּה יְיָ, עַל הָאָֽרֶץ וְעַל הַמָּזוֹן:","s":"b"}]]},{"key":"7nB26vg-eC","he":[[{"t":"רַחֵם יְיָ אֱלֹהֵֽינוּ, עַל יִשְׂרָאֵל עַמָּךְ, וְעַל יְרוּשָׁלַֽיִם עִירָךְ, וְעַל צִיּוֹן מִשְׁכַּן כְּבוֹדָךְ. וְעַל הַבַּֽיִת הַגָּדוֹל וְהַקָּדוֹשׁ, שֶׁנִּקְרָא שִׁמְךָ עָלָיו. וּמַלְכוּת בֵּית דָּוִד מְשִׁיחָךְ, תַּחְזִיר לִמְקוֹמָהּ בְּיָמֵֽינוּ:","s":"b"}]]},{"key":"X5LLyuUxDd","he":[[{"t":"בראש חדש וחול המועד מוסיף","s":"n","when":{"any":["roshChodesh","cholHamoedPesach","cholHamoedSukkot","roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}],[{"t":"אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ. יַעֲלֶה וְיָבֹא, יַגִּיעַ, יֵרָאֶה, יֵרָצֶה, יִשָּׁמַע, יִפָּקֵד, יִזָּכֵר (לְפָנֶֽיךָ) זִכְרוֹנֵֽינוּ, זִכְרוֹן אֲבוֹתֵֽינוּ, זִכְרוֹן יְרוּשָׁלַֽיִם עִירָךְ, זִכְרוֹן מָשִֽׁיחַ בֶּן דָּוִד עַבְדָּךְ, זִכְרוֹן כׇּל עַמְּךָ בֵּית יִשְׂרָאֵל לְפָנֶֽיךָ, לִפְלֵטָה, לְטוֹבָה, לִבְרָכָה, לְחֵן, לְחֶֽסֶד וּלְרַחֲמִים.","when":{"any":["roshChodesh","cholHamoedPesach","cholHamoedSukkot","roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}]],"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"key":"P0bx8hj6ty","he":[[{"t":"בראש חדש:","s":"n","when":{"any":["roshChodesh","roshChodeshYesterday"]}},{"t":" בְּיוֹם רֹאשׁ הַחֹֽדֶשׁ הַזֶּה,","when":{"any":["roshChodesh","roshChodeshYesterday"]}},{"t":" "},{"t":"בחוהמ״ע פסח:","s":"n","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday"]}},{"t":" בְּיוֹם מִקְרָא קֹֽדֶשׁ הַזֶּה, בְּיוֹם מוֹעֵד חַג הַמַּצּוֹת הַזֶּה,","when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday"]}},{"t":" "},{"t":"בחוהמ״ע סוכות:","s":"n","when":{"any":["cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":" בְּיוֹם מִקְרָא קֹֽדֶשׁ הַזֶּה, בְּיוֹם מוֹעֵד חַג הַסֻּכּוֹת הַזֶּה,","when":{"any":["cholHamoedSukkot","cholHamoedSukkotYesterday"]}},{"t":" לְרַחֵם בּוֹ עָלֵֽינוּ וּלְהוֹשִׁיעֵֽנוּ. זׇכְרֵֽנוּ יְיָ אֱלֹהֵֽינוּ בּוֹ לְטוֹבָה. פׇּקְדֵֽנוּ בוֹ לִבְרָכָה. הוֹשִׁיעֵֽנוּ בוֹ לְחַיִּים. בִּדְבַר יְשׁוּעָה וְרַחֲמִים. חוּס וְחׇנֵּֽנוּ, וְרַחֵם עָלֵֽינוּ. וּמַלְּטֵֽנוּ בוֹ מִכׇּל צָרָה וְיָגוֹן, וְשַׂמְּחֵֽנוּ בוֹ שִׂמְחָה שְׁלֵמָה, כִּי אֵל מֶֽלֶךְ רַחוּם וְחַנּוּן אָֽתָּה:"}]],"when":{"any":["cholHamoedPesach","cholHamoedPesachYesterday","cholHamoedSukkot","cholHamoedSukkotYesterday","roshChodesh","roshChodeshYesterday"]},"optional":{"he":"אם התחילו לאכול לפני השקיעה בראש חודש או בחול המועד","en":"If the meal began before sunset on Rosh Chodesh or Chol Hamoed","when":{"any":["roshChodeshYesterday","cholHamoedPesachYesterday","cholHamoedSukkotYesterday"]}}},{"key":"FnPZaZcfJc","he":[[{"t":"וּבְנֵה אֶת יְרוּשָׁלַֽיִם עִירָךְ בְּקָרוֹב, כַּאֲשֶׁר דִּבַּֽרְתָּ. בָּרוּךְ אַתָּה יְיָ, בּוֹנֵה בְרַחֲמָיו אֶת יְרוּשָׁלָֽיִם: (","s":"b"},{"t":"המברך אומר בלחש","s":"n"},{"t":") אָמֵן.","s":"b"}]]},{"key":"4hmGrb9ALv","he":[[{"t":"בָּרוּךְ אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם. הָאֵל, אָבִֽינוּ, מַלְכֵּֽנוּ, אַדִּירֵֽנוּ, בּוֹרְאֵֽנוּ, קְדוֹשֵֽׁנוּ קְדוֹשׁ יַעֲקֹב. הַמֶּֽלֶךְ הַטּוֹב וְהַמֵּטִיב שֶׁבְּכׇל יוֹם וָיוֹם, הוּא גּוֹמְלֵֽנוּ חֵן וְחֶֽסֶד וְרַחֲמִים וְכׇל טוּב: הָרַחֲמָן יִשְׁתַּבַּח לְדוֹרֵי דוֹרִים: הָרַחֲמָן יִתְפָּאֵר לְנֵצַח נְצָחִים: הָרַחֲמָן יְפַרְנְסֵנוּ בְּכָבוֹד:","s":"b"},{"t":" ("},{"t":"יש המוסיפים כאן עוד תוספות","s":"n"},{"t":")"}]]},{"key":"KtEdm1RclR","he":[[{"t":"הָרַחֲמָן יְבָרֵךְ בַּֽעַל הַבַּֽיִת הַזֶּה: הָרַחֲמָן יְיַשֵּׁר אוֹרְחוֹתָיו: הָרַחֲמָן יַצְלִיחַ אֶת דְּרָכָיו: הָרַחֲמָן מִכׇּל צָרָה וָנֶֽזֶק יַצִּילֵֽהוּ:"}]],"optional":{"he":"אורח אומר","en":"A guest says"}},{"key":"rYf8aLzKi8","he":[[{"t":"הָרַחֲמָן יְזַכֵּֽנוּ לִימוֹת הַמָּשִֽׁיחַ, וּלְבִנְיַן בֵּית הַמִּקְדָּשׁ, וּלְחַיֵּי הָעוֹלָם הַבָּא:","s":"b"}]]},{"key":"IIQ6Zh1TDN","he":[[{"t":"מַגְדִּיל (","s":"b"},{"t":"או","s":"n"},{"t":" מִגְדּוֹל) יְשׁוּעוֹת מַלְכּוֹ, וְעוֹשֶׂה חֶֽסֶד לִמְשִׁיחוֹ, לְדָוִד וּלְזַרְעוֹ עַד עוֹלָם: כְּפִירִים רָשׁוּ וְרָעֵֽבוּ, וְדוֹרְשֵׁי יְיָ לֹא יַחְסְרוּ כׇל טוֹב: הוֹדוּ לַייָ כִּי טוֹב, כִּי לְעוֹלָם חַסְדּוֹ: בָּרוּךְ הָאֵל הַמּוֹשִֽׁיעַ:","s":"b"}]]}]}],"credits":[{"title":"Birkat HaMazon with the Zimun, Nusach Teiman Baladi — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=2929642"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"},{"title":"Birkat HaMazon, Nusach Teiman Baladi — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=2929770"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}