{"nusach":"ashkenaz","id":"birchot_hareiya","sections":[{"title":{"he":"ברק ורעם","en":"Lightning and Thunder"},"segments":[{"key":"v9Lac8tlqi","he":[[{"t":"על הברקים מברך:","s":"n"}]]},{"key":"A_qCbnBVNO","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, עוֹשֵׂה מַעֲשֵׂה בְּרֵאשִׁית:"}]]},{"key":"hNRlnHxef6","he":[[{"t":"על הרעמים מברך:","s":"n"}]]},{"key":"W1V4NovKjn","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁכֹּחוֹ וּגְבוּרָתוֹ מָלֵא עוֹלָם:"}]]}]},{"title":{"he":"הקשת","en":"A Rainbow"},"segments":[{"key":"rmX8jvXt2r","he":[[{"t":"הרואה קשת צריך לברך ברכה זו, ואסור להסתכל בו:","s":"n"}]]},{"key":"GGMjUqvK_2","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, זוֹכֵר הַבְּרִית וְנֶאֱמָן בִּבְרִיתוֹ וְקַיָּם בְּמַאֲמָרוֹ:"}]]}]},{"title":{"he":"הים הגדול","en":"The Great Sea"},"segments":[{"key":"SCT46tLgaX","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁעָשָׂה אֶת הַיָּם הַגָּדוֹל:"}]]}]},{"title":{"he":"ברכת האילנות","en":"Trees in Blossom"},"segments":[{"key":"ZxZIL7pGjS","he":[[{"t":"הרואה בימי ניסן עצי פרי פורחים אומר:","s":"n"}]]},{"key":"3q1kyWK2AY","he":[[{"t":"וִיהִי נֹעַם אֲדֹנָי אֱלֹהֵינוּ עָלֵינוּ, וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנָה עָלֵינוּ, וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנֵהוּ:"}]],"en":"May the pleasantness of my Master our God be upon us, and the work of our hands established for us, and the work of our hands—establish it."},{"key":"qZegwTntZW","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא חִסֵּר בְּעוֹלָמוֹ כְּלוּם, וּבָרָא בוֹ בְּרִיּוֹת טוֹבוֹת וְאִילָנוֹת טוֹבוֹת, לֵהָנוֹת בָּהֶם בְּנֵי אָדָם:"}]]}]},{"title":{"he":"ברכות שבח והודאה","en":"Further Blessings of Praise"},"segments":[{"key":"xzM-1oDR_W","he":[[{"t":"על שמועות שהם טובות לו ולאחרים מברך:","s":"n"}]]},{"key":"BRnaEZc4Wj","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַטּוֹב וְהַמֵּטִיב:"}]]},{"key":"63N67PMorq","he":[[{"t":"על שמועות רעות מברך:","s":"n"}]]},{"key":"yPVEGA1g8e","he":[[{"t":"בָּרוּךְ אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, דַּיַּן הָאֱמֶת:"}]]},{"key":"vxYH8TH-uW","he":[[{"t":"מי שלא ראה קברי ישראל שלשים יום יברך בראייתם:","s":"n"}]]},{"key":"h4h1lZ494f","he":[[{"t":"ברוך אתה יְהֹוָה אלהינו מלך העולם, אשר יצר אתכם בדין, וזן וכלכל אתכם בדין, והמית אתכם בדין, ויודע מספר כלכם בדין, והוא עתיד להחיותכם ולקים אתכם בדין. ברוך אתה יְהֹוָה, מחיה המתים."}]]}]}],"credits":[{"title":"Siddur Ashkenaz — Daat Siddur Ashkenaz","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Ashkenaz"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}