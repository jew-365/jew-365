{"nusach":"sefard","id":"mezuzah","sections":[{"title":{"he":"קביעת מזוזה","en":"Affixing a Mezuzah"},"segments":[{"key":"QFkq2YAvEm","he":[[{"t":"הקובע מזוזה מברך:","s":"n"}]]},{"key":"wpXGeyZB2O","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לִקְבֹּעַ מְזוּזָה:"}]]}]}],"credits":[{"title":"Siddur Sefard — Torat Emet 357","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Sefard"}]}