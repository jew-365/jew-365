{"nusach":"sefard","id":"ushpizin","sections":[{"title":{"he":"הכניסה לסוכה","en":"Entering the Sukkah"},"segments":[{"key":"oxU4cFU398","he":[[{"t":"הֲרֵינִי","s":"b"},{"t":" מוּכָן וּמְזוּמָן לְקַיֵּים מִצְוַת סֻכָּה כַּאֲשֶׁר צִוַּנִי הַבּוֹרֵא יִתְבָּרַךְ שְׁמוֹ בַּסֻּכּוֹת תֵּשְׁבוּ שִׁבְעַת יָמִים כָּל הָאֶזְרָח בְּיִשְׂרָאֵל יֵשְׁבוּ בַּסֻּכּוֹת: לְמַעַן יֵדְעוּ דֹרֹתֵיכֶם כִּי בַסֻּכּוֹת הוֹשַׁבְתִּי אֶת בְּנֵי יִשְׂרָאֵל בְּהוֹצִיאִי אוֹתָם מֵאֶרֶץ מִצְרָיִם:"}]]}]},{"title":{"he":"אושפיזין","en":"Ushpizin"},"segments":[{"key":"JXWp0shmvr","he":[[{"t":"תִּיבוּ","s":"b"},{"t":" תִּיבוּ אוּשְׁפִּיזִין עִילָאִין, תִּיבוּ תִּיבוּ אוּשְׁפִּיזִין קַדִּישִׁין, תִּיבוּ תִּיבוּ אוּשְׁפִּיזִין דִמְהֵימְנוּתָא, זַכָּאָה חוּלְקֵיהוֹן דְיִשְׂרָאֵל דִּכְתִיב כִּי חֵלֶק יְהֹוָה עַמּוֹ יַעֲקֹב חֶבֶל נַחֲלָתוֹ:"}]]},{"key":"xemjsdqCa3","he":[[{"t":"יְהִי","s":"b"},{"t":" רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהַי וֵאלֹהֵי אֲבוֹתַי שֶׁתַּשְׁרֶה שְׁכִינָתְךָ בֵּינֵינוּ וְתִפְרוֹס עָלֵינוּ סֻכַּת שְׁלוֹמֶךָ בִּזְכוּת מִצְוַת סֻכָּה שֶׁאֲנַחְנוּ מְקַיְּמִין לְיַחְדָא שְׁמָא דְקוּדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּהּ בִּדְחִילוּ וּרְחִימוּ לְיַחֲדָא שֵׁם י\"ה בו\"ה בְּיִחוּדָא שְׁלִים בְּשֵׁם כָּל יִשְׂרָאֵל, וּלְהַקִּיף אוֹתָם מִזִּיו כְּבוֹדֶךָ הַקָּדוֹשׁ וְהַטָּהוֹר נָטוּי עַל רָאשֵׁיהֶם מִלְּמָעְלָה כְּנֶשֶׁר יָעִיר קִנּוֹ, וּמִשָּׁם יוּשְׁפַּע שֶׁפַע הַחַיִּים לְעַבְדֶּךָ "},{"t":" (פב\"פ)","s":"n"},{"t":" אֲמָתֶךָ. וּבִזְכוּת צֵאתִי מִבֵּיתִי הַחוּצָה וְדֶרֶךְ מִצְוֹתֶיךָ אָרוּצָה יֵחָשֵׁב לִי זֹאת כְּאִלּוּ הִרְחַקְתִּי נְדוֹד, וְהֶרֶב כַּבְּסֵנִי מֵעֲוֹנִי וּמֵחַטָּאתִי טַהֲרֵנִי, וּמֵאוּשְׁפִּיזִין עִלָּאִין אוּשְׁפִּיזִין דִּמְהֵימְנוּתָא תִּהְיֶינָה אָזְנֶיךָ קַשּׁוּבוֹת רַב בְּרָכוֹת, וְלָרְעֵבִים גַּם צְמֵאִים תֶּן לַחְמָם וּמֵימָם הַנֶּאֱמָנִים, וְתִתֶּן לִי זְכוּת לָשֶׁבֶת וְלַחֲסוֹת בְּסֵתֶר צֵל כְּנָפֶךָ בְּעֵת פְּטִירָתִי מִן הָעוֹלָם, וְלַחֲסוֹת מִזֶּרֶם וּמִמָּטָר, כִּי תַמְטִיר עַל רְשָׁעִים פַּחִים, וּתְהֵא חֲשׁוּבָה מִצְוַת סֻכָּה זוּ שֶׁאֲנִי מְקַיֵּם כְּאִלּוּ קִיַּמְתִּיהָ בְּכָל פְּרָטֶיהָ וְדִקְדּוּקֶיהָ וּתְנָאֶיהָ וְכָל מִצְוֹת הַתְּלוּיִם בָּהּ. וְתֵיטִיב לָנוּ הַחֲתִימָה, וּתְזַכֵּנוּ לֵישֵׁב יָמִים רַבִּים עַל הָאֲדָמָה אַדְמַת קֹדֶשׁ בַּעֲבוֹדָתֶךָ וּבְיִרְאָתֶךָ: בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן:"}]]},{"key":"lXf0KwqTxL","he":[[{"t":"בלילה ראשון כשנכנס לסוכה קודם שישב לאכול ובכל יום קודם סעודתו יאמר זה:","s":"n"}]]},{"key":"swik5c4KpI","he":[[{"t":"אֲזַמִין","s":"b"},{"t":" לִסְעוּדָתִי אוּשְׁפִּיזִין עִילָאִין אַבְרָהָם יִצְחָק יַעֲקֹב מֹשֶׁה אַהֲרֹן יוֹסֵף וְדָּוִד:"}]]},{"key":"g5LGBT3SvU","he":[[{"t":"ביום הראשון אומר:","s":"n"}]],"when":{"all":["ushpizinNight1"]}},{"key":"xh1HnW2rdQ","he":[[{"t":"בְּמָטֵי","s":"b"},{"t":" מִינָךְ אַבְרָהָם אוּשְׁפִּיזִי עִילָאִי דְיַתְבֵי עִמִּי וְעִמָּךְ כָּל אוּשְׁפִּיזֵי עִילָאִי יִצְחָק יַעֲקֹב מֹשֶׁה אַהֲרֹן יוֹסֵף וְדָּוִד:"}]],"when":{"all":["ushpizinNight1"]}},{"key":"cl37Quap3n","he":[[{"t":"ביום השני אומר:","s":"n"}]],"when":{"all":["ushpizinNight2"]}},{"key":"lSvnHpsJcN","he":[[{"t":"בְּמָטֵי","s":"b"},{"t":" מִינָךְ יִצְחָק אוּשְׁפִּיזִי עִילָאִי דְיַתְבֵי עִמִּי וְעִמָּךְ כָּל אוּשְׁפִּיזֵי עִילָאִי אַבְרָהָם יַעֲקֹב מֹשֶׁה אַהֲרֹן יוֹסֵף וְדָּוִד:"}]],"when":{"all":["ushpizinNight2"]}},{"key":"XKKg4UdHZG","he":[[{"t":"ביום השלישי אומר:","s":"n"}]],"when":{"all":["ushpizinNight3"]}},{"key":"N0sQTmRjMa","he":[[{"t":"בְּמָטֵי","s":"b"},{"t":" מִינָךְ יַעֲקֹב אוּשְׁפִּיזִי עִילָאִי דְיַתְבֵי עִמִּי וְעִמָּךְ כָּל אוּשְׁפִּיזֵי עִילָאִי אַבְרָהָם יִצְחָק מֹשֶׁה אַהֲרֹן יוֹסֵף וְדָּוִד:"}]],"when":{"all":["ushpizinNight3"]}},{"key":"0FxTAWcBU_","he":[[{"t":"ביום הרביעי אומר:","s":"n"}]],"when":{"all":["ushpizinNight4"]}},{"key":"pozV1vfPua","he":[[{"t":"בְּמָטֵי","s":"b"},{"t":" מִינָךְ מֹשֶׁה אוּשְׁפִּיזִי עִילָאִי דְיַתְבֵי עִמִּי וְעִמָּךְ כָּל אוּשְׁפִּיזֵי עִילָאִי אַבְרָהָם יִצְחָק יַעֲקֹב אַהֲרֹן יוֹסֵף וְדָּוִד:"}]],"when":{"all":["ushpizinNight4"]}},{"key":"lFGH-7batU","he":[[{"t":"ביום החמישי אומר:","s":"n"}]],"when":{"all":["ushpizinNight5"]}},{"key