{"nusach":"sefard","id":"birchot_hanehenin","sections":[{"title":{"he":"נטילת ידיים לסעודה","en":"Washing Hands Before Bread"},"segments":[{"key":"4BwnU6uGzS","he":[[{"t":"קודם הסעודה יטול ידיו ויברך:","s":"n"}]]},{"key":"o7JLNf7ieB","he":[[{"t":"שְׂאוּ","s":"b"},{"t":" יְדֵיכֶם קוֹדֶשׁ וּבָרְכוּ אֶת יְהֹוָה: וְאֶשָׂא כַפַּי אֶל מִצְוֹתֶיךָ אֲשֶׁר אָהַבְתִּי וְאָשִׂחָה בְחֻקֶּיךָ:"}]]},{"key":"MVyPpHUpmg","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו, וְצִוָּנוּ עַל נְטִילַת יָדָיִם:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Who sanctified us with His commandments and commanded us concerning the washing of hands."}]},{"title":{"he":"המוציא","en":"Over Bread"},"segments":[{"key":"1QM3X6UwRp","he":[[{"t":"על הלחם מברך:","s":"n"}]]},{"key":"XJmRqRieyz","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם הַמּוֹצִיא לֶחֶם מִן הָאָרֶץ:"}]]}]},{"title":{"he":"בורא מיני מזונות","en":"Over Grain Foods"},"segments":[{"key":"7tRhrxX8Pr","he":[[{"t":"על תבשיל מחמשת מיני דגן ועל מיני מאפה מברך:","s":"n"}]]},{"key":"EA65yp0nlK","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא מִינֵי מְזוֹנוֹת:"}]]}]},{"title":{"he":"בורא פרי הגפן","en":"Over Wine"},"segments":[{"key":"Z3J8kB0EWv","he":[[{"t":"על היין מברך:","s":"n"}]]},{"key":"CVkrIglrIa","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא פְּרִי הַגָּפֶן:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Creator of the fruit of the vine."}]},{"title":{"he":"בורא פרי העץ","en":"Over Tree Fruit"},"segments":[{"key":"oWLkPGBc2I","he":[[{"t":"על כל פרי העץ מברך:","s":"n"}]]},{"key":"BL6hin_7b7","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא פְּרִי הָעֵץ:"}]]}]},{"title":{"he":"בורא פרי האדמה","en":"Over Produce of the Ground"},"segments":[{"key":"vrgpOCkGtW","he":[[{"t":"על פרי האדמה מברך:","s":"n"}]]},{"key":"k4sJItLlr3","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם בּוֹרֵא פְּרִי הָאֲדָמָה:"}]]}]},{"title":{"he":"שהכל נהיה בדברו","en":"Over Other Foods and Drinks"},"segments":[{"key":"hxzTzaXE_Q","he":[[{"t":"על בשר ודגים. חלב וביצה וגבינה. כמהין ופטריות וכדומה. גם על המשקים חוץ מיין אומר:","s":"n"}]]},{"key":"2PSVcMVgnG","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁהַכֹּל נִהְיָה בִּדְבָרוֹ:"}]]}]},{"title":{"he":"ברכות הריח","en":"Over Fragrances"},"segments":[{"key":"JWeoccr8A9","he":[[{"t":"על ריח בשמים מברך:","s":"n"}]]},{"key":"0bH_9CZzr3","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, בּוֹרֵא מִינֵי בְשָׂמִים:"}]]},{"key":"M7KPk3ZxHT","he":[[{"t":"על ריח טוב שבעשבים מברך:","s":"n"}]]},{"key":"hpr-jwXDVo","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, בּוֹרֵא עִשְׂבֵּי בְשָׂמִים:"}]]},{"key":"4pCttZ3qE4","he":[[{"t":"על ריח טוב שבעצים ושיחים מברך:","s":"n"}]]},{"key":"-3sfzkZ_cC","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, בּוֹרֵא עֲצֵי בְשָׂמִים:"}]]},{"key":"11MWYrZWOL","he":[[{"t":"על ריח טוב שבפירות מברך:","s":"n"}]]},{"key":"H4Nm2R4cej","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, הַנּוֹתֵן רֵיחַ טוֹב בַּפֵּירוֹת:"}]]},{"key":"zBXYYylH3k","he":[[{"t":"על שמן אפרסמון מברך:","s":"n"}]]},{"key":"CC3T5jZebK","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה, אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, בּוֹרֵא שֶׁמֶן עָרֵב:"}]]}]},{"title":{"he":"שהחיינו","en":"Shehecheyanu"},"segments":[{"key":"TdTe9da2Wd","he":[[{"t":"הלובש מלבוש חדש וכן האוכל פרי חדש הגדל בזמן קבוע בשנה ומתחדש משנה לשנה מברך:","s":"n"}]]},{"key":"ZiT8aIUUQ3","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁהֶחֱיָנוּ וְקִיְּמָנוּ וְהִגִּיעָנוּ לַזְמַן הַזֶּה:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Who has kept us alive and sustained us and brought us to this time."}]}],"credits":[{"title":"Siddur Sefard — Torat Emet 357","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Sefard"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"},{"title":"Siddur Sefard — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Sefard"}]}