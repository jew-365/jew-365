{"nusach":"sefard","id":"chanukah_candles","sections":[{"title":{"he":"הנחת הנרות","en":"Placing the Candles"},"segments":[{"key":"8Q6gGn0xkZ","he":[[{"t":"מצות נר חנוכה להדליק בפתח הסמוך לרשות הרבים, משום הנס וכו', אם יש לו חלון לרשות הרבים ידליקם שם, ואם לא, מדליקם אצל הפתח. ומצוה שיניחם בטפח הסמוך לפתח משמאל, שתהא מזוזה מימין ונר משמאל, ונמצא שהוא מסובב במצוות:","s":"n"}]]}]},{"title":{"he":"לשם יחוד","en":"Leshem Yichud"},"segments":[{"key":"P3m2uoNeTx","he":[[{"t":"תפילה מהגה\"ק ר' צבי אלימלך מדינוב בעל בני יששכר זצוק\"ל:","s":"n"}]]},{"key":"JDSLeTZq7x","he":[[{"t":"לְשֵׁם","s":"b"},{"t":" יִחוּד קֻדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּהּ, בִּדְחִילוּ וּרְחִימוּ וּרְחִימוּ וּדְחִילוּ, לְיַחֵד שֵׁם י\"ה בְּו\"ה בְּיִחוּדָא שְׁלִים בְּשֵׁם כָּל יִשְׂרָאֵל. הִנְנִי "},{"t":"מְכַוֵּן","voice":["male","unset"]},{"t":"מְכַוֶּנֶת","voice":["female"]},{"t":" בְּהַדְלָקַת נֵר חֲנוּכָּה לְקַיֵם מִצְוַת בּוֹרְאִי כַּאֲשֶׁר צִוּוּנִי חֲכָמֵינוּ ז\"ל לְתַקֵן אֶת שׁוֹרְשָׁה בְּמָקוֹם עֶלְיוֹן: וּבְכֵן יְהִי רָצוֹן מִלְפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ שֶׁתְּהֵא חֲשׁוּבָה וּמְקֻבֶּלֶת וּמְרֻצָּה לְפָנֶיךָ מִצְוַת הַדְלָקַת נֵר חֲנוּכָּה כְּאִלּוּ כִּוַּנְתִּי כָּל הַכַּוָּנוֹת שֶׁכִּוְּנוּ הַכֹּהֲנִים מְשָׁרְתֵי הַשֵׁם בְּעֵת אֲשֶׁר הֶעֱרוּ לַמָּוֶת נַפְשָׁם בִּשְׁבִיל כְּבוֹד שִׁמְךָ הַגָדוֹל הַגִּבּוֹר וְהַנּוֹרָא. וְאַתָּה בְּרַחֲמֶיךָ הָרַבִּים עוֹרַרְתָּ נִצְחֲךָ עֲלֵיהֶם לְנַצֵּחַ אֶת אוֹיְבֵיהֶם וּלְנַצֵחַ עַל מְלֶאכֶת בֵּית יְהֹוָה, וְהִנְנִי "},{"t":"עוֹשֶׂה","voice":["male","unset"]},{"t":"עוֹשָׂה","voice":["female"]},{"t":" עַל דַּעְתָּם וְעַל כַּוָּנָתָם וְעַל דַּעַת כָּל הַצַדִּיקִים וְהַחֲסִידִים שֶׁהָיוּ בְּאוֹתוֹ הַדּוֹר שֶׁהִשְׁפַּעְתָּ לָהֶם נִסֶּיךָ וְזָכוּ לֵאוֹר בְּאוֹר הַחַיִּים, וְעַל דַּעַת כָּל הַצַּדִּיקִים וְהַחֲסִידִים שֶׁבְּדוֹרוֹתֵינוּ, וּפִי כְּפִיהֶם וַעֲשִׂיָּתִי כַּעֲשִׂיָּתָם, וּבִזְכוּת הַמִּצְוָה הַזֹּאת תְּזַכֵּנוּ לְנַצֵּחַ אֶת אוֹיְבֵינוּ וּלְנַצֵּחַ עַל מְלֶאכֶת בֵּית יְהֹוָה, וְגַלֵּה כְּבוֹד מַלְכוּתְךָ עָלֵינוּ מְהֵרָה וְלֹא יָמוּשׁ הַתּוֹרָה מִפִּינוּ וּמִפִּי זַרְעֵינוּ וּמִפִּי זֶרַע זַרְעֵינוּ מֵעַתָּה וְעַד עוֹלָם, וְנִזְכֶּה לְבָנִים תַּלְמִידֵי חֲכָמִים אָמֵן כֵּן יְהִי רָצוֹן. קַדְּשֵׁנוּ בְּמִצְוֹתֶיךָ וְתֵן חֶלְקֵנוּ בְּתוֹרָתֶךָ שַׂבְּעֵנוּ מִטוּבֶךָ וְשַׂמַּח נַפְשֵׁנוּ בִּישׁוּעָתֶךָ וְטַהֵר לִבֵּנוּ לְעָבְדְךָ בֶּאֱמֶת. מְלֹךְ עַל כָּל הָעוֹלָם כֻּלּוֹ בִּכְבוֹדֶךָ וְהִנָּשֵׂא עַל כָּל הָאָרֶץ בִּיקָרֶךָ וְהוֹפַע בַּהֲדַר גְּאוֹן עֻזֶּךָ עַל כָּל יוֹשְׁבֵי תֵבֵל אַרְצֶךָ, וְיֵדַע כָּל פָּעוּל כִּי אַתָּה פְעַלְתּוֹ וְיָבִין כָּל יְצִיר כִּי אַתָּה יְצַרְתּוֹ וְיֹאמַר כֹּל אֲשֶׁר נְשָׁמָה בְאַפּ\"וֹ "},{"t":" (בגי' חנוכ\"ה) ","s":"n"},{"t":" יְהֹוָ\"ה אֱלֹהֵ\"י יִשְׂרָאֵ\"ל מֶלֶ\"ךְ וּמַלְכוּת\"וֹ בַּכֹּ\"ל מָשָׁלָ\"ה "},{"t":" (בגי' כ\"ו פעמים חנ\"ה אותיות חנוכ\"ה, ובגי' מתתיה\"ו ב\"ן יוחנ\"ן כה\"ן גדו\"ל חשמנא\"י ובני\"ו)","s":"n"},{"t":". אָמֵן נֶצַח סֶלָה וָעֶד:"}]]}]},{"title":{"he":"ברכות הדלקת נרות חנוכה","en":"Blessings for Lighting the Chanukah Candles"},"segments":[{"key":"YMnBXROJH5","he":[[{"t":"לפני ההדלקה מברכים להדליק נר ושעשה נסים","s":"n"},{"t":" ובערב הראשון מוסיפים ברכת שהחיינו","s":"n","when":{"all":["chanukahFirstNight"]}},{"t":":","s":"n"}]]},{"key":"Xmh4ODeyHD","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם אֲשֶׁר קִדְּשָׁנוּ בְּמִצְוֹתָיו וְצִוָּנוּ לְהַדְלִיק נֵר חֲנֻכָּה:"}]]},{"key":"Hs9GOC9vgd","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁעָשָׂה נִסִּים לַאֲבוֹתֵינוּ בַּיָּמִים הָהֵם בַּזְּמַן הַזֶּה:"}]]},{"key":"XkHh3EL1FB","he":[[{"t":"רק בלילה הראשון:","s":"n"}]],"when":{"all":["chanukahFirstNight"]}},{"key":"Bq0mArIcF5","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְהֹוָה אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם שֶׁהֶחֱיָנוּ וְקִיְּמָנוּ וְהִגִּיעָנוּ לַזְּמַן הַזֶּה:"}]],"when":{"all":["chanukahFirstNight"]},"en":"Blessed are You, Adonoy our God, King of the Universe, Who has kept us alive and sustained us and brought us to this time."}]},{"title":{"he":"הנרות הללו","en":"Hanerot Hallalu"},"segments":[{"key":"7v_ATNx2dw","he":[[{"t":"אחרי שהדליק הנר הראשון משמאל יאמר זאת","s":"n"},{"t":" כשמדליק השאר","s":"n","when":{"none":["chanukahFirstNight"]}},{"t":":","s":"n"}]]},{"key":"FSU1Hif1Kv","he":[[{"t":"הַנֵּרוֹת","s":"b"},{"t":" הַלָּלוּ אָנוּ מַדְלִיקִין עַל הַנִּסִּים וְעַל הַנִּפְלָאוֹת וְעַל הַתְּשׁוּעוֹת וְעַל הַמִּלְחָמוֹת. שֶׁעָשִׂיתָ לַאֲבוֹתֵינוּ בַּיָּמִים הָהֵם בַּזְּמַן הַזֶּה. עַל יְדֵי כֹּהֲנֶיךָ הַקְּדוֹשִׁים. וְכָל מִצְוַת שְׁמוֹנַת יְמֵי חֲנֻכָּה. הַנֵּרוֹת הַלָּלוּ קֹדֶשׁ הֵם. וְאֵין לָנוּ רְשׁוּת לְהִשְׁתַּמֵּשׁ בָּהֶם. אֶלָּא לִרְאוֹתָם בִּלְבָד. כְּדֵי לְהוֹדוֹת וּלְהַלֵּל לְשִׁמְךָ הַגָּדוֹל עַל נִסֶּיךָ וְעַל נִפְלְאוֹתֶיךָ וְעַל יְשׁוּעָתֶךָ:"}]]}]},{"title":{"he":"מעוז צור","en":"Maoz Tzur"},"segments":[{"key":"H7BJufhhLA","he":[[{"t":"מָעוֹז","s":"b"},{"t":" צוּר יְשׁוּעָתִי לְךָ נָאֶה לְשַׁבֵּחַ. תִּכּוֹן בֵּית תְּפִלָּתִי וְשָׁם תּוֹדָה נְזַבֵּחַ. לְעֵת תָּכִין מַטְבֵּחַ מִצָּר הַמְנַבֵּחַ. אָז אֶגְמוֹר בְּשִׁיר מִזְמוֹר חֲנֻכַּת הַמִּזְבֵּחַ:"}]]},{"key":"xSfOkSNLJB","he":[[{"t":"רָעוֹת","s":"b"},{"t":" שָׂבְעָה נַפְשִׁי בְּיָגוֹן כֹּחִי כִּלָה. חַיַּי מָרְרוּ בְּקוּשִׁי בְּשִׁעְבּוּד מַלְכוּת עֶגְלָה. וּבְיָדוֹ הַגְּדוֹלָה הוֹצִיא אֶת הַסְּגֻלָּה. חֵיל פַּרְעֹה וְכָל זַרְעוֹ יָרְדוּ כְאֶבֶן בִּמְצוּלָה:"}]]},{"key":"rcVx0YBTz5","he":[[{"t":"דְּבִיר","s":"b"},{"t":" קָדְשׁוֹ הֱבִיאַנִי וְגַם שָׁם לֹא שָׁקַטְתִּי. וּבָא נוֹגֵשׂ וְהִגְלַנִי. כִּי זָרִים עָבַדְתִּי. וְיֵין רַעַל מָסַכְתִּי כִּמְעַט שֶׁעָבַרְתִּי. קֵץ בָּבֶל. זְרֻבָּבֶל. לְקֵץ שִׁבְעִים נוֹשָׁעְתִּי:"}]]},{"key":"xDh5B4nSxM","he":[[{"t":"כְּרוֹת","s":"b"},{"t":" קוֹמַת בְּרוֹשׁ בִּקֵּשׁ אֲגָגִי בֶּן הַמְּדָתָא. וְנִהְיָתָה לוֹ לְפַח וּלְמוֹקֵשׁ וְגַאֲוָתוֹ נִשְׁבָּתָה. רֹאשׁ יְמִינִי נִשֵּׂאתָ. וְאוֹיֵב שְׁמוֹ מָחִיתָ. רֹב בָּנָיו וְקִנְיָנָיו עַל הָעֵץ תָּלִיתָ:"}]]},{"key":"5VIDVYyLuM","he":[[{"t":"יְוָנִים","s":"b"},{"t":" נִקְבְּצוּ עָלַי אֲזַי בִּימֵי חַשְׁמַנִּים. וּפָרְצוּ חוֹמוֹת מִגְדָּלַי וְטִמְּאוּ כָּל הַשְּׁמָנִים. וּמִנּוֹתַר קַנְקַנִּים נַעֲשֶׂה נֵס לַשּׁוֹשַׁנִּים. בְּנֵי בִינָה יְמֵי שְׁמוֹנָה קָבְעוּ שִׁיר וּרְנָנִים:"}]]},{"key":"QYm4G1iPz9","he":[[{"t":"חֲשׂוֹף","s":"b"},{"t":" זְרוֹעַ קָדְשֶׁךָ וְקָרֵב קֵץ הַיְשׁוּעָה. נְקֹם נִקְמַת דַם עֲבָדֶיךָ מֵאֻמָּה הָרְשָׁעָה. כִּי אָרְכָה לָנוּ הַשָּׁעָה. וְאֵין קֵץ לִימֵי הָרָעָה. דְּחֵה אַדְמוֹן בְּצֵל צַלְמוֹן הָקֵם לָנוּ רוֹעֶה שִׁבְעָה:"}]]},{"key":"w1jocgkYGe","he":[[{"t":"תוספת שהוסיף הרמ\"א מופיע בספר אשל הגדולים","s":"n"}]]},{"key":"VEAYRAw2O8","he":[[{"t":"מֵעוֹלָם","s":"b"},{"t":" הָיִיתָ יִשְׁעִי, כְּבוֹדִי וּמֵרִים רֹאשִׁי, שְׁמַע נָא קוֹל שַׁוְעִי, מַלְכִּי אֱלֹהַי קְדוֹשִׁי, הַעֲבֵר חֶטְאִי וּפִשְׁעִי, גַּם בְּגָלוּת הָרְבִיעִי, חַזֵּק יִשְׂרָאֵל, וְתַכְנִיעַ יִשְׁמָעֵאל, וּמֵאֱדוֹם תִּפְדֶה נַפְשִׁי."}]]}]},{"title":{"he":"מזמור שיר חנוכת הבית","en":"Psalm 30: Dedication of the House"},"segments":[{"key":"tcQ1F-xBlA","he":[[{"t":"מִזְמוֹר","s":"b"},{"t":" שִׁיר חֲנֻכַּת הַבַּיִת לְדָוִד: אֲרוֹמִמְךָ יְהֹוָה כִּי דִלִּיתָנִי וְלֹא שִׂמַּחְתָּ אֹיְבַי לִי: יְהֹוָה אֱלֹהָי שִׁוַּעְתִּי אֵלֶיךָ וַתִּרְפָּאֵנִי: יְהֹוָה הֶעֱלִיתָ מִן שְׁאוֹל נַפְשִׁי חִיִּיתַנִי מִיָּרְדִי בוֹר: זַמְּרוּ לַיהֹוָה חֲסִידָיו וְהוֹדוּ לְזֵכֶר קָדְשׁוֹ: כִּי רֶגַע בְּאַפּוֹ חַיִּים בִּרְצוֹנוֹ. בָּעֶרֶב יָלִין בֶּכִי וְלַבֹּקֶר רִנָּה: וַאֲנִי אָמַרְתִּי בְשַׁלְוִי בַּל אֶמּוֹט לְעוֹלָם: יְהֹוָה בִּרְצוֹנְךָ הֶעֱמַדְתָּה לְהַרְרִי עֹז. הִסְתַּרְתָּ פָנֶיךָ הָיִיתִי נִבְהָל: אֵלֶיךָ יְהֹוָה אֶקְרָא וְאֶל אֲדֹנָי אֶתְחַנָּן: מַה בֶּצַע בְּדָמִי בְּרִדְתִּי אֶל שַׁחַת הֲיוֹדְךָ עָפָר הֲיַגִּיד אֲמִתֶּךָ: שְׁמַע יְהֹוָה וְחָנֵּנִי יְהֹוָה הֱיֵה עֹזֵר לִי: הָפַכְתָּ מִסְפְּדִי לְמָחוֹל לִי פִּתַּחְתָּ שַׂקִּי וַתְּאַזְּרֵנִי שִׂמְחָה: לְמַעַן יְזַמֶּרְךָ כָבוֹד וְלֹא יִדֹּם יְהֹוָה אֱלֹהַי לְעוֹלָם אוֹדֶךָּ:"}]],"en":"A Psalm, a song for the inauguration of the Temple, by David. I will exalt You, Adonoy, for You have upheld me, and not let my foes rejoice over me. Adonoy, my God, I cried out to You, and You healed me. Adonoy, You have raised my soul from the lower world. You have kept me alive, lest I descend to the Pit. Sing to Adonoy, [you,] His pious ones, and give thanks to His holy Name. For His anger lasts only a moment, but there is [long] life, in His conciliation. In the evening, one retires weeping, but in the morning there is [a cry of] joy! I said, in my serenity, I would never be moved. [But,] Adonoy, it was Your will [alone] that established my mountain as a stronghold. When You concealed Your Presence, I was terrified. To You, Adonoy, I called, and my Master I beseeched. What gain is there in [the shedding of] my blood? In my going down to destruction? Will the dust acknowledge You? Will it proclaim Your truth? Hear [me] Adonoy, and be gracious to me, Adonoy, be a help to me. You have turned my mourning into dancing, You have loosened my sackcloth and supported me with joy. In order that my soul might sing to You and not be stilled, Adonoy, my God, forever will I thank You."}]},{"title":{"he":"מזמור קיא","en":"Psalm 111"},"segments":[{"key":"nNESUhe1EE","he":[[{"t":"הַלְלוּיָהּ","s":"b"},{"t":" אוֹדֶה יְהֹוָה בְּכָל לֵבָב בְּסוֹד יְשָׁרִים וְעֵדָה: גְּדֹלִים מַעֲשֵׂי יְהֹוָה דְּרוּשִׁים לְכָל חֶפְצֵיהֶם: הוֹד וְהָדָר פָּעֳלוֹ וְצִדְקָתוֹ עֹמֶדֶת לָעַד: זֵכֶר עָשָׂה לְנִפְלְאֹתָיו חַנּוּן וְרַחוּם יְהֹוָה: טֶרֶף נָתַן לִירֵאָיו יִזְכֹּר לְעוֹלָם בְּרִיתוֹ: כֹּחַ מַעֲשָׂיו הִגִּיד לְעַמּוֹ לָתֵת לָהֶם נַחֲלַת גּוֹיִם: מַעֲשֵׂי יָדָיו אֱמֶת וּמִשְׁפָּט נֶאֱמָנִים כָּל פִּקּוּדָיו: סְמוּכִים לָעַד לְעוֹלָם עֲשׂוּיִם בֶּאֱמֶת וְיָשָׁר: פְּדוּת שָׁלַח לְעַמּוֹ צִוָּה לְעוֹלָם בְּרִיתוֹ קָדוֹשׁ וְנוֹרָא שְׁמוֹ: רֵאשִׁית חָכְמָה יִרְאַת יְהֹוָה שֵׂכֶל טוֹב לְכָל עֹשֵׂיהֶם תְּהִלָּתוֹ עֹמֶדֶת לָעַד:"}]]}]},{"title":{"he":"מזמור קיב","en":"Psalm 112"},"segments":[{"key":"oDaCEvS7b3","he":[[{"t":"הַלְלוּיָהּ","s":"b"},{"t":" אַשְׁרֵי אִישׁ יָרֵא אֶת יְהֹוָה בְּמִצְוֹתָיו חָפֵץ מְאֹד: גִּבּוֹר בָּאָרֶץ יִהְיֶה זַרְעוֹ דּוֹר יְשָׁרִים יְבֹרָךְ: הוֹן וָעֹשֶׁר בְּבֵיתוֹ וְצִדְקָתוֹ עֹמֶדֶת לָעַד: זָרַח בַּחֹשֶׁךְ אוֹר לַיְשָׁרִים חַנּוּן וְרַחוּם וְצַדִּיק: טוֹב אִישׁ חוֹנֵן וּמַלְוֶה יְכַלְכֵּל דְּבָרָיו בְּמִשְׁפָּט: כִּי לְעוֹלָם לֹא יִמּוֹט לְזֵכֶר עוֹלָם יִהְיֶה צַדִּיק: מִשְּׁמוּעָה רָעָה לֹא יִירָא נָכוֹן לִבּוֹ בָּטֻחַ בַּיְהֹוָה: סָמוּךְ לִבּוֹ לֹא יִירָא עַד אֲשֶׁר יִרְאֶה בְצָרָיו: פִּזַּר נָתַן לָאֶבְיוֹנִים צִדְקָתוֹ עֹמֶדֶת לָעַד קַרְנוֹ תָּרוּם בְּכָבוֹד: רָשָׁע יִרְאֶה וְכָעָס שִׁנָּיו יַחֲרֹק וְנָמָס תַּאֲוַת רְשָׁעִים תֹּאבֵד:"}]]}]},{"title":{"he":"ויהי נועם ויושב בסתר","en":"Vihi No'am and Yoshev BeSeter"},"segments":[{"key":"N6k8FJSfYA","he":[[{"t":"וִיהִי","s":"b"},{"t":" נֹעַם אֲדֹנָי אֱלֹהֵינוּ עָלֵינוּ וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנָה עָלֵינוּ וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנֵהוּ:"}]],"en":"May the pleasantness of my Master our God be upon us, and the work of our hands established for us, and the work of our hands—establish it."},{"key":"6eZTn4SEZb","he":[[{"t":"יֹשֵׁב","s":"b"},{"t":" בְּסֵתֶר עֶלְיוֹן בְּצֵל שַׁדַּי יִתְלוֹנָן: אֹמַר לַיהֹוָה מַחְסִי וּמְצוּדָתִי אֱלֹהַי אֶבְטַח בּוֹ: כִּי הוּא יַצִּילְךָ מִפַּח יָקוּשׁ מִדֶּבֶר הַוּוֹת: בְּאֶבְרָתוֹ יָסֶךְ לָךְ וְתַחַת כְּנָפָיו תֶּחְסֶה צִנָּה וְסֹחֵרָה אֲמִתּוֹ: לֹא תִירָא מִפַּחַד לָיְלָה מֵחֵץ יָעוּף יוֹמָם: מִדֶּבֶר בָּאֹפֶל יַהֲלֹךְ מִקֶּטֶב יָשׁוּד צָהֳרָיִם: יִפֹּל מִצִּדְּךָ אֶלֶף וּרְבָבָה מִימִינֶךָ אֵלֶיךָ לֹא יִגָּשׁ: רַק בְּעֵינֶיךָ תַבִּיט וְשִׁלֻּמַת רְשָׁעִים תִּרְאֶה: כִּי אַתָּה יְהֹוָה מַחְסִי עֶלְיוֹן שַׂמְתָּ מְעוֹנֶךָ: לֹא תְאֻנֶּה אֵלֶיךָ רָעָה וְנֶגַע לֹא יִקְרַב בְּאָהֳלֶךָ: כִּי מַלְאָכָיו יְצַוֶּה לָּךְ לִשְׁמָרְךָ בְּכָל דְּרָכֶיךָ: עַל כַּפַּיִם יִשָּׂאוּנְךָ פֶּן תִּגּוֹף בָּאֶבֶן רַגְלֶךָ: עַל שַׁחַל וָפֶתֶן תִּדְרֹךְ תִּרְמֹס כְּפִיר וְתַנִּין: כִּי בִי חָשַׁק וַאֲפַלְּטֵהוּ אֲשַׂגְּבֵהוּ כִּי יָדַע שְׁמִי: יִקְרָאֵנִי וְאֶעֱנֵהוּ עִמּוֹ אָנֹכִי בְצָרָה אֲחַלְּצֵהוּ וַאֲכַבְּדֵהוּ: אֹרֶךְ יָמִים אַשְׂבִּיעֵהוּ וְאַרְאֵהוּ בִּישׁוּעָתִי: אֹרֶךְ יָמִים אַשְׂבִּיעֵהוּ וְאַרְאֵהוּ בִּישׁוּעָתִי:"}]]}]},{"title":{"he":"מזמור סז","en":"Psalm 67"},"segments":[{"key":"AmUSoFZs9K","he":[[{"t":"לַמְנַצֵּחַ","s":"b"},{"t":" בִּנְגִינוֹת מִזְמוֹר שִׁיר: אֱלֹהִים יְחָנֵּנוּ וִיבָרְכֵנוּ. יָאֵר פָּנָיו אִתָּנוּ. סֶלָה: לָדַעַת בָּאָרֶץ דַּרְכֶּךָ. בְּכָל גּוֹיִם יְשׁוּעָתֶךָ: יוֹדוּךָ עַמִּים אֱלֹהִים. יוֹדוּךָ עַמִּים כֻּלָּם: יִשְׂמְחוּ וִירַנְּנוּ לְאֻמִּים. כִּי תִשְׁפֹּט עַמִּים מִישֹׁר. וּלְאֻמִּים בָּאָרֶץ תַּנְחֵם סֶלָה: יוֹדוּךָ עַמִּים אֱלֹהִים. יוֹדוּךָ עַמִּים כֻּלָּם: אֶרֶץ נָתְנָה יְבוּלָהּ. יְבָרְכֵנוּ אֱלֹהִים אֱלֹהֵינוּ: יְבָרְכֵנוּ אֱלֹהִים. וְיִירְאוּ אוֹתוֹ כָּל אַפְסֵי אָרֶץ:"}]]}]},{"title":{"he":"אנא בכח","en":"Ana BeKoach"},"segments":[{"key":"FeFC6jbPTp","he":[[{"t":"אומרים אנא בכח שש פעמים ובפעם השביעי מנגנים:","s":"n"}]]},{"key":"MG3PW3sYpm","he":[[{"t":"אָנָּא","s":"b"},{"t":" בְּכֹחַ גְּדֻלַּת יְמִינְךָ תַּתִּיר צְרוּרָה. "},{"t":"אב\"ג ית\"ץ","s":"n"},{"t":":"}]]},{"key":"AkoKV3OtKz","he":[[{"t":"קַבֵּל רִנַּת עַמְּךָ שַׂגְּבֵנוּ טַהֲרֵנוּ נוֹרָא. "},{"t":"קר\"ע שט\"ן","s":"n"},{"t":":"}]]},{"key":"jKc1WqTDii","he":[[{"t":"נָא גִבּוֹר דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם. "},{"t":"נג\"ד יכ\"ש","s":"n"},{"t":":"}]]},{"key":"j2XZuJ6x_y","he":[[{"t":"בָּרְכֵם טַהֲרֵם רַחֲמֵי צִדְקָתְךָ תָּמִיד גָּמְלֵם. "},{"t":"בט\"ר צת\"ג","s":"n"},{"t":":"}]]},{"key":"X0XeTsrfpg","he":[[{"t":"חֲסִין קָדוֹשׁ בְּרוֹב טוּבְךָ נַהֵל עֲדָתֶךָ. "},{"t":"חק\"ב טנ\"ע","s":"n"},{"t":":"}]]},{"key":"Tg2JKnI0uE","he":[[{"t":"יָחִיד גֵּאֶה לְעַמְּךָ פְּנֵה זוֹכְרֵי קְדֻשָּׁתֶךָ. "},{"t":"יג\"ל פז\"ק","s":"n"},{"t":":"}]]},{"key":"NPpK1u2ed4","he":[[{"t":"שַׁוְעָתֵנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵנוּ יוֹדֵעַ תַּעֲלוּמוֹת. "},{"t":"שק\"ו צי\"ת","s":"n"},{"t":":"}]]},{"key":"nz8ct3aCwV","he":[[{"t":"בלחש:","s":"n"},{"t":" בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:"}]]}]},{"title":{"he":"מזמור לג","en":"Psalm 33"},"segments":[{"key":"v3CeEGrTsd","he":[[{"t":"רַנְּנוּ","s":"b"},{"t":" צַדִּיקִים בַּיְהֹוָה לַיְשָׁרִים נָאוָה תְהִלָּה: הוֹדוּ לַיְהֹוָה בְּכִנּוֹר בְּנֵבֶל עָשׂוֹר זַמְּרוּ לוֹ: שִׁירוּ לוֹ שִׁיר חָדָשׁ הֵיטִיבוּ נַגֵּן בִּתְרוּעָה: כִּי יָשָׁר דְּבַר יְהֹוָה וְכָל מַעֲשֵׂהוּ בֶּאֱמוּנָה: אֹהֵב צְדָקָה וּמִשְׁפָּט חֶסֶד יְהֹוָה מָלְאָה הָאָרֶץ: בִּדְבַר יְהֹוָה שָׁמַיִם נַעֲשׂוּ וּבְרוּחַ פִּיו כָּל צְבָאָם: כֹּנֵס כַּנֵּד מֵי הַיָּם נֹתֵן בְּאֹצָרוֹת תְּהוֹמוֹת: יִירְאוּ מֵיְהֹוָה כָּל הָאָרֶץ מִמֶּנּוּ יָגוּרוּ כָּל יֹשְׁבֵי תֵבֵל: כִּי הוּא אָמַר וַיֶּהִי הוּא צִוָּה וַיַּעֲמֹד: יְהֹוָה הֵפִיר עֲצַת גּוֹיִם הֵנִיא מַחְשְׁבוֹת עַמִּים: עֲצַת יְהֹוָה לְעוֹלָם תַּעֲמֹד מַחְשְׁבוֹת לִבּוֹ לְדֹר וָדֹר: אַשְׁרֵי הַגּוֹי אֲשֶׁר יְהֹוָה אֱלֹהָיו הָעָם בָּחַר לְנַחֲלָה לוֹ: מִשָּׁמַיִם הִבִּיט יְהֹוָה רָאָה אֶת כָּל בְּנֵי הָאָדָם: מִמְּכוֹן שִׁבְתּוֹ הִשְׁגִּיחַ אֶל כָּל יֹשְׁבֵי הָאָרֶץ: הַיֹּצֵר יַחַד לִבָּם הַמֵּבִין אֶל כָּל מַעֲשֵׂיהֶם: אֵין הַמֶּלֶךְ נוֹשָׁע בְּרָב חָיִל גִּבּוֹר לֹא יִנָּצֵל בְּרָב כֹּחַ: שֶׁקֶר הַסּוּס לִתְשׁוּעָה וּבְרֹב חֵילוֹ לֹא יְמַלֵּט: הִנֵּה עֵין יְהֹוָה אֶל יְרֵאָיו לַמְיַחֲלִים לְחַסְדּוֹ: לְהַצִּיל מִמָּוֶת נַפְשָׁם וּלְחַיּוֹתָם בָּרָעָב: נַפְשֵׁנוּ חִכְּתָה לַיְהֹוָה עֶזְרֵנוּ וּמָגִנֵּנוּ הוּא: כִּי בוֹ יִשְׂמַח לִבֵּנוּ כִּי בְשֵׁם קָדְשׁוֹ בָטָחְנוּ: יְהִי חַסְדְּךָ יְהֹוָה עָלֵינוּ כַּאֲשֶׁר יִחַלְנוּ לָךְ:"}]]}]},{"title":{"he":"מזמור קלג","en":"Psalm 133"},"segments":[{"key":"kKExvBNGA-","he":[[{"t":"שִׁיר","s":"b"},{"t":" הַמַּעֲלוֹת לְדָוִד הִנֵּה מַה טּוֹב וּמַה נָּעִים שֶׁבֶת אַחִים גַּם יָחַד: כַּשֶּׁמֶן הַטּוֹב עַל הָרֹאשׁ יֹרֵד עַל הַזָּקָן זְקַן אַהֲרֹן שֶׁיֹּרֵד עַל פִּי מִדּוֹתָיו: כְּטַל חֶרְמוֹן שֶׁיֹּרֵד עַל הַרְרֵי צִיּוֹן כִּי שָׁם צִוָּה יְהֹוָה אֶת הַבְּרָכָה חַיִּים עַד הָעוֹלָם:"}]]}]}],"credits":[{"title":"Siddur Sefard — Torat Emet 357","license":"Public Domain","url":"https://www.sefaria.org/Siddur_Sefard"},{"title":"Siddur Sefard — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Sefard"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}