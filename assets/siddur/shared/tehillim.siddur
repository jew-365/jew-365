ֹוָה אוֹתוֹ מִכַּף כָּל־אֹיְבָיו וּמִיַּד שָׁאוּל׃"}]]},{"key":"QuOxgmRMje","he":[[{"t":"וַיֹּאמַר אֶרְחָמְךָ יְהֹוָה חִזְקִי׃"}]]},{"key":"5DYKItYuIE","he":[[{"t":"יְהֹוָה סַלְעִי וּמְצוּדָתִי וּמְפַלְטִי אֵלִי צוּרִי אֶחֱסֶה־בּוֹ מָגִנִּי וְקֶרֶן־יִשְׁעִי מִשְׂגַּבִּי׃"}]]},{"key":"UVpdS5EU4b","he":[[{"t":"מְהֻלָּל אֶקְרָא יְהֹוָה וּמִן־אֹיְבַי אִוָּשֵׁעַ׃"}]]},{"key":"q6I-lhx25v","he":[[{"t":"אֲפָפוּנִי חֶבְלֵי־מָוֶת וְנַחֲלֵי בְלִיַּעַל יְבַעֲתוּנִי׃"}]]},{"key":"7gXw6wdeo5","he":[[{"t":"חֶבְלֵי שְׁאוֹל סְבָבוּנִי קִדְּמוּנִי מוֹקְשֵׁי מָוֶת׃"}]]},{"key":"kG32lI_AmF","he":[[{"t":"בַּצַּר־לִי אֶקְרָא יְהֹוָה וְאֶל־אֱלֹהַי אֲשַׁוֵּעַ יִשְׁמַע מֵהֵיכָלוֹ קוֹלִי וְשַׁוְעָתִי לְפָנָיו תָּבוֹא בְאָזְנָיו׃"}]]},{"key":"DmvvnEI_YU","he":[[{"t":"וַתִּגְעַשׁ וַתִּרְעַשׁ הָאָרֶץ וּמוֹסְדֵי הָרִים יִרְגָּזוּ וַיִּתְגָּעֲשׁוּ כִּי־חָרָה לוֹ׃"}]]},{"key":"4ZEj2DWqvf","he":[[{"t":"עָלָה עָשָׁן בְּאַפּוֹ וְאֵשׁ־מִפִּיו תֹּאכֵל גֶּחָלִים בָּעֲרוּ מִמֶּנּוּ׃"}]]},{"key":"krKBAyB_gO","he":[[{"t":"וַיֵּט שָׁמַיִם וַיֵּרַד וַעֲרָפֶל תַּחַת רַגְלָיו׃"}]]},{"key":"5nWyqoSgvZ","he":[[{"t":"וַיִּרְכַּב עַל־כְּרוּב וַיָּעֹף וַיֵּדֶא עַל־כַּנְפֵי־רוּחַ׃"}]]},{"key":"qA8CwoomF1","he":[[{"t":"יָשֶׁת חֹשֶׁךְ סִתְרוֹ סְבִיבוֹתָיו סֻכָּתוֹ חֶשְׁכַת־מַיִם עָבֵי שְׁחָקִים׃"}]]},{"key":"0xXO0bYGf3","he":[[{"t":"מִנֹּגַהּ נֶגְדּוֹ עָבָיו עָבְרוּ בָּרָד וְגַחֲלֵי־אֵשׁ׃"}]]},{"key":"BN2zCTx3KT","he":[[{"t":"וַיַּרְעֵם בַּשָּׁמַיִם יְהֹוָה וְעֶלְיוֹן יִתֵּן קֹלוֹ בָּרָד וְגַחֲלֵי־אֵשׁ׃"}]]},{"key":"zbWZ7p2c3w","he":[[{"t":"וַיִּשְׁלַח חִצָּיו וַיְפִיצֵם וּבְרָקִים רָב וַיְהֻמֵּם׃"}]]},{"key":"fA9QhjLMMs","he":[[{"t":"וַיֵּרָאוּ אֲפִיקֵי מַיִם וַיִּגָּלוּ מוֹסְדוֹת תֵּבֵל מִגַּעֲרָתְךָ יְהֹוָה מִנִּשְׁמַת רוּחַ אַפֶּךָ׃"}]]},{"key":"tU2T6UGgfD","he":[[{"t":"יִשְׁלַח מִמָּרוֹם יִקָּחֵנִי יַמְשֵׁנִי מִמַּיִם רַבִּים׃"}]]},{"key":"1smwhqHeh1","he":[[{"t":"יַצִּילֵנִי מֵאֹיְבִי עָז וּמִשֹּׂנְאַי כִּי־אָמְצוּ מִמֶּנִּי׃"}]]},{"key":"JJzPUBCO4O","he":[[{"t":"יְקַדְּמוּנִי בְיוֹם־אֵידִי וַיְהִי־יְהֹוָה לְמִש