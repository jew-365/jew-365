:"מִקְצֵה הָאָרֶץ אֵלֶיךָ אֶקְרָא בַּעֲטֹף לִבִּי בְּצוּר־יָרוּם מִמֶּנִּי תַנְחֵנִי׃"}]]},{"key":"tw3_D6KCFB","he":[[{"t":"כִּי־הָיִיתָ מַחְסֶה לִי מִגְדַּל־עֹז מִפְּנֵי אוֹיֵב׃"}]]},{"key":"xZP8fE5Z7F","he":[[{"t":"אָגוּרָה בְאָהָלְךָ עוֹלָמִים אֶחֱסֶה בְסֵתֶר כְּנָפֶיךָ סֶּלָה׃"}]]},{"key":"V8xh2qrUrV","he":[[{"t":"כִּי־אַתָּה אֱלֹהִים שָׁמַעְתָּ לִנְדָרָי נָתַתָּ יְרֻשַּׁת יִרְאֵי שְׁמֶךָ׃"}]]},{"key":"nfOxGWx0uJ","he":[[{"t":"יָמִים עַל־יְמֵי־מֶלֶךְ תּוֹסִיף שְׁנוֹתָיו כְּמוֹ־דֹר וָדֹר׃"}]]},{"key":"baqahR2YpS","he":[[{"t":"יֵשֵׁב עוֹלָם לִפְנֵי אֱלֹהִים חֶסֶד וֶאֱמֶת מַן יִנְצְרֻהוּ׃"}]]},{"key":"Y183C9iuic","he":[[{"t":"כֵּן אֲזַמְּרָה שִׁמְךָ לָעַד לְשַׁלְּמִי נְדָרַי יוֹם יוֹם׃"}]]}]},{"title":{"he":"פרק סב","en":"Psalm 62"},"segments":[{"key":"hGGqiez_5r","he":[[{"t":"לַמְנַצֵּחַ עַל־יְדוּתוּן מִזְמוֹר לְדָוִד׃"}]]},{"key":"LBvPb2R2lT","he":[[{"t":"אַךְ אֶל־אֱלֹהִים דּוּמִיָּה נַפְשִׁי מִמֶּנּוּ יְשׁוּעָתִי׃"}]]},{"key":"KnKVuEvA8F","he":[[{"t":"אַךְ־הוּא צוּרִי וִישׁוּעָתִי מִשְׂגַּבִּי לֹא־אֶמּוֹט רַבָּה׃"}]]},{"key":"SM0XHnLGWK","he":[[{"t":"עַד־אָנָה תְּהוֹתְתוּ עַל אִישׁ תְּרָצְּחוּ כֻלְּכֶם כְּקִיר נָטוּי גָּדֵר הַדְּחוּיָה׃"}]]},{"key":"NTKXpsAyN0","he":[[{"t":"אַךְ מִשְּׂאֵתוֹ יָעֲצוּ לְהַדִּיחַ יִרְצוּ כָזָב בְּפִיו יְבָרֵכוּ וּבְקִרְבָּם יְקַלְלוּ־סֶלָה׃"}]]},{"key":"REjnxBU3FN","he":[[{"t":"אַךְ לֵאלֹהִים דּוֹמִּי נַפְשִׁי כִּי־מִמֶּנּוּ תִּקְוָתִי׃"}]]},{"key":"dkFdrF3n9w","he":[[{"t":"אַךְ־הוּא צוּרִי וִישׁוּעָתִי מִשְׂגַּבִּי לֹא אֶמּוֹט׃"}]]},{"key":"WAijSTqq1D","he":[[{"t":"עַל־אֱלֹהִים יִשְׁעִי וּכְבוֹדִי צוּר־עֻזִּי מַחְסִי בֵּאלֹהִים׃"}]]},{"key":"gkf63gp3-0","he":[[{"t":"בִּטְחוּ בוֹ בְכָל־עֵת עָם שִׁפְכוּ־לְפָנָיו לְבַבְכֶם אֱלֹהִים מַחֲסֶה־לָּנוּ סֶלָה׃"}]]},{"key":"GmBmlRwWDm","he":[[{"t":"אַךְ הֶבֶל בְּנֵי־אָדָם כָּזָב בְּנֵי אִישׁ בְּמֹאזְנַיִם לַעֲלוֹת הֵמָּה מֵהֶבֶל יָחַד׃"}]]},{"key":"GNON88sphj","he":[[{"t":"אַל־תִּבְטְחוּ בְעֹשֶׁק וּבְגָזֵל אַל־תֶּהְבָּלוּ חַיִל כִּי־יָנוּב אַל־תָּשִׁיתוּ לֵב׃"}]]},{"key":"lQUnfQlVAd","he":[[{"t":"אַחַת דִּבֶּר אֱלֹהִים שְׁתַּיִם־זוּ שָׁמָעְתִּי כִּי עֹז לֵאלֹהִים׃"}]]},{"key":"USiT4DtvOf","he":[[{"t":"וּלְךָ־אֲדֹנָי חָסֶד כִּי־אַתָּה תְשַׁלֵּם לְאִישׁ כְּמַעֲשֵׂהוּ׃"}]]}]},{"title":{"he":"פרק סג","en":"Psalm 63"},"segments":[{"key":"VP70f1LclK","he":[[{"t":"מִזְמוֹר לְדָוִד בִּהְיוֹתוֹ בְּמִדְבַּר יְהוּדָה׃"}]]},{"key":"OlvR5Pnj5a","he":[[{"t":"אֱלֹהִים אֵלִי אַתָּה אֲשַׁחֲרֶךָּ צָמְאָה לְךָ נַפְשִׁי כָּמַהּ לְךָ בְשָׂרִי בְּאֶרֶץ־צִיָּה וְעָיֵף בְּלִי־מָיִם׃"}]]},{"key":"FLgBbehW7q","he":[[{"t":"כֵּן בַּקֹּדֶשׁ חֲזִיתִיךָ לִרְאוֹת עֻזְּךָ וּכְבוֹדֶךָ׃"}]]},{"key":"Sfl1Y9ilVU","he":[[{"t":"כִּי־טוֹב חַסְדְּךָ מֵחַיִּים שְׂפָתַי יְשַׁבְּחוּנְךָ׃"}]]},{"key":"kQtvC3Xlk5","he":[[{"t":"כֵּן אֲבָרֶכְךָ בְחַיָּי בְּשִׁמְךָ אֶשָּׂא כַפָּי׃"}]]},{"key":"k6Tj4xtSv-","he":[[{"t":"כְּמוֹ חֵלֶב וָדֶשֶׁן תִּשְׂבַּע נַפְשִׁי וְשִׂפְתֵי רְנָנוֹת יְהַלֶּל־פִּי׃"}]]},{"key":"eD4B7xhv69","he":[[{"t":"אִם־זְכַרְתִּיךָ עַל־יְצוּעָי בְּאַשְׁמֻרוֹת אֶהְגֶּה־בָּךְ׃"}]]},{"key":"iH1nvYFuI3","he":[[{"t":"כִּי־הָיִיתָ עֶזְרָתָה לִּי וּבְצֵל כְּנָפֶיךָ אֲרַנֵּן׃"}]]},{"key":"cuxXlG8I3e","he":[[{"t":"דָּבְקָה נַפְשִׁי אַחֲרֶיךָ בִּי תָּמְכָה יְמִינֶךָ׃"}]]},{"key":"eBVuhXch34","he":[[{"t":"וְהֵמָּה לְשׁוֹאָה יְבַקְשׁוּ נַפְשִׁי יָבֹאוּ בְּתַחְתִּיּוֹת הָאָרֶץ׃"}]]},{"key":"WdvZZYEdfB","he":[[{"t":"יַגִּירֻהוּ עַל־יְדֵי־חָרֶב מְנָת שֻׁעָלִים יִהְיוּ׃"}]]},{"key":"qQ53nyuv26","he":[[{"t":"וְהַמֶּלֶךְ יִשְׂמַח בֵּאלֹהִים יִתְהַלֵּל כָּל־הַנִּשְׁבָּע בּוֹ כִּי יִסָּכֵר פִּי דוֹבְרֵי־שָׁקֶר׃"}]]}]},{"title":{"he":"פרק סד","en":"Psalm 64"},"segments":[{"key":"9Vt0n7zFQ_","he":[[{"t":"לַמְנַצֵּחַ מִזְמוֹר לְדָוִד׃"}]]},{"key":"iv-GxjZDCt","he":[[{"t":"שְׁמַע־אֱלֹהִים קוֹלִי בְשִׂיחִי מִפַּחַד אוֹיֵב תִּצֹּר חַיָּי׃"}]]},{"key":"eBITBc4Bph","he":[[{"t":"תַּסְתִּירֵנִי מִסּוֹד מְרֵעִים מֵרִגְשַׁת פֹּעֲלֵי אָוֶן׃"}]]},{"key":"2M2qY0eAwp","he":[[{"t":"אֲשֶׁר שָׁנְנוּ כַחֶרֶב לְשׁוֹנָם דָּרְכוּ חִצָּם דָּבָר מָר׃"}]]},{"key":"LHs9-RD54g","he":[[{"t":"לִירוֹת בַּמִּסְתָּרִים תָּם פִּתְאֹם יֹרֻ