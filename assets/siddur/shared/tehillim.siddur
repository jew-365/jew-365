ְדּוֹ כִּי לְעוֹלָם חַסְדּוֹ׃"}]]},{"key":"dvS929jduS","he":[[{"t":"שֶׁבְּשִׁפְלֵנוּ זָכַר לָנוּ כִּי לְעוֹלָם חַסְדּוֹ׃"}]]},{"key":"evRtcdPihQ","he":[[{"t":"וַיִּפְרְקֵנוּ מִצָּרֵינוּ כִּי לְעוֹלָם חַסְדּוֹ׃"}]]},{"key":"GqMO7GaNmB","he":[[{"t":"נֹתֵן לֶחֶם לְכָל־בָּשָׂר כִּי לְעוֹלָם חַסְדּוֹ׃"}]]},{"key":"yey6hXyJ-Y","he":[[{"t":"הוֹדוּ לְאֵל הַשָּׁמָיִם כִּי לְעוֹלָם חַסְדּוֹ׃"}]]}]},{"title":{"he":"פרק קלז","en":"Psalm 137"},"segments":[{"key":"YhXBqfCLTA","he":[[{"t":"עַל נַהֲרוֹת בָּבֶל שָׁם יָשַׁבְנוּ גַּם־בָּכִינוּ בְּזָכְרֵנוּ אֶת־צִיּוֹן׃"}]]},{"key":"RTqtYbEyTq","he":[[{"t":"עַל־עֲרָבִים בְּתוֹכָהּ תָּלִינוּ כִּנֹּרוֹתֵינוּ׃"}]]},{"key":"SUuzATAz_T","he":[[{"t":"כִּי שָׁם שְׁאֵלוּנוּ שׁוֹבֵינוּ דִּבְרֵי־שִׁיר וְתוֹלָלֵינוּ שִׂמְחָה שִׁירוּ לָנוּ מִשִּׁיר צִיּוֹן׃"}]]},{"key":"_c7e7w9mS5","he":[[{"t":"אֵיךְ נָשִׁיר אֶת־שִׁיר־יְהֹוָה עַל אַדְמַת נֵכָר׃"}]]},{"key":"qJ2zKzl1NV","he":[[{"t":"אִם־אֶשְׁכָּחֵךְ יְרוּשָׁלִָם תִּשְׁכַּח יְמִינִי׃"}]]},{"key":"iWUuaeMZx3","he":[[{"t":"תִּדְבַּק־לְשׁוֹנִי לְחִכִּי אִם־לֹא אֶזְכְּרֵכִי אִם־לֹא אַעֲלֶה אֶת־יְרוּשָׁלִַם עַל רֹאשׁ שִׂמְחָתִי׃"}]]},{"key":"VW1xcrOwyO","he":[[{"t":"זְכֹר יְהֹוָה לִבְנֵי אֱדוֹם אֵת יוֹם יְרוּשָׁלִָם הָאֹמְרִים עָרוּ עָרוּ עַד הַיְסוֹד בָּהּ׃"}]]},{"key":"eQTx47y9qq","he":[[{"t":"בַּת־בָּבֶל הַשְּׁדוּדָה אַשְׁרֵי שֶׁיְשַׁלֶּם־לָךְ אֶת־גְּמוּלֵךְ שֶׁגָּמַלְתְּ לָנוּ׃"}]]},{"key":"QZ6ZZTC00f","he":[[{"t":"אַשְׁרֵי שֶׁיֹּאחֵז וְנִפֵּץ אֶת־עֹלָלַיִךְ אֶל־הַסָּלַע׃"}]]}]},{"title":{"he":"פרק קלח","en":"Psalm 138"},"segments":[{"key":"RxcRb0FXEK","he":[[{"t":"לְדָוִד אוֹדְךָ בְכָל־לִבִּי נֶגֶד אֱלֹהִים אֲזַמְּרֶךָּ׃"}]]},{"key":"Hy1IX4ZWIL","he":[[{"t":"אֶשְׁתַּחֲוֶה אֶל־הֵיכַל קָדְשְׁךָ וְאוֹדֶה אֶת־שְׁמֶךָ עַל־חַסְדְּךָ וְעַל־אֲמִתֶּךָ כִּי־הִגְדַּלְתָּ עַל־כָּל־שִׁמְךָ אִמְרָתֶךָ׃"}]]},{"key":"nJrUHIvfTW","he":[[{"t":"בְּיוֹם קָרָאתִי וַתַּעֲנֵנִי תַּרְהִבֵנִי בְנַפְשִׁי עֹז׃"}]]},{"key":"oMc8kHuEbd","he":[[{"t":"יוֹדוּךָ יְהֹוָה כָּל־מַלְכֵי־אָרֶץ כִּי שָׁמְעוּ אִמְרֵי־פִיךָ׃"}]]},{"key":"dj6yJZQ0le","he":[[{"t":"וְיָשִׁירוּ בְּדַרְכֵי יְהֹוָה כִּי גָדוֹל כְּבוֹד יְהֹוָה׃"}]]},{"key":"Blk8c1XPTd","he":[[{"t":"כִּי־רָם יְהֹוָה וְשָׁפָל יִרְאֶה וְגָבֹהַּ מִמֶּרְחָק יְיֵדָע׃"}]]},{"key":"X7hOnOIxRz","he":[[{"t":"אִם־אֵלֵךְ בְּקֶרֶב צָרָה תְּחַיֵּנִי עַל אַף אֹיְבַי תִּשְׁלַח יָדֶךָ וְתוֹשִׁיעֵנִי יְמִינֶךָ׃"}]]},{"key":"zd661rykQX","he":[[{"t":"יְהֹוָה יִגְמֹר בַּעֲדִי יְהֹוָה חַסְדְּךָ לְעוֹלָם מַעֲשֵׂי יָדֶיךָ אַל־תֶּרֶף׃"}]]}]},{"title":{"he":"פרק קלט","en":"Psalm 139"},"segments":[{"key":"bymhQTwRsP","he":[[{"t":"לַמְנַצֵּחַ לְדָוִד מִזְמוֹר יְהֹוָה חֲקַרְתַּנִי וַתֵּדָע׃"}]]},{"key":"iZUdjZH-sp","he":[[{"t":"אַתָּה יָדַעְתָּ שִׁבְתִּי וְקוּמִי בַּנְתָּה לְרֵעִי מֵרָחוֹק׃"}]]},{"key":"KpdoZ9t15A","he":[[{"t":"אָרְחִי וְרִבְעִי זֵרִיתָ וְכָל־דְּרָכַי הִסְכַּנְתָּה׃"}]]},{"key":"6ygwnJfTUM","he":[[{"t":"כִּי אֵין מִלָּה בִּלְשׁוֹנִי הֵן יְהֹוָה יָדַעְתָּ כֻלָּהּ׃"}]]},{"key":"a-1X7S_dHC","he":[[{"t":"אָחוֹר וָקֶדֶם צַרְתָּנִי וַתָּשֶׁת עָלַי כַּפֶּכָה׃"}]]},{"key":"MHxSTDAgwT","he":[[{"t":"פְּלִיאָה דַעַת מִמֶּנִּי נִשְׂגְּבָה לֹא־אוּכַל לָהּ׃"}]]},{"key":"gm4bJdUHVS","he":[[{"t":"אָנָה אֵלֵךְ מֵרוּחֶךָ וְאָנָה מִפָּנֶיךָ אֶבְרָח׃"}]]},{"key":"Im-ak5cNnU","he":[[{"t":"אִם־אֶסַּק שָׁמַיִם שָׁם אָתָּה וְאַצִּיעָה שְּׁאוֹל הִנֶּךָּ׃"}]]},{"key":"xdoP1w_A0i","he":[[{"t":"אֶשָּׂא כַנְפֵי־שָׁחַר אֶשְׁכְּנָה בְּאַחֲרִית יָם׃"}]]},{"key":"rOytIb1jnA","he":[[{"t":"גַּם־שָׁם יָדְךָ תַנְחֵנִי וְתֹאחֲזֵנִי יְמִינֶךָ׃"}]]},{"key":"76r_Q5GCT0","he":[[{"t":"וָאֹמַר אַךְ־חֹשֶׁךְ יְשׁוּפֵנִי וְלַיְלָה אוֹר בַּעֲדֵנִי׃"}]]},{"key":"Gx8XSjoDWq","he":[[{"t":"גַּם־חֹשֶׁךְ לֹא־יַחְשִׁיךְ מִמֶּךָ וְלַיְלָה כַּיּוֹם יָאִיר כַּחֲשֵׁיכָה כָּאוֹרָה׃"}]]},{"key":"-n0GVo6iJs","he":[[{"t":"כִּי־אַתָּה קָנִיתָ כִלְיֹתָי תְּסֻכֵּנִי בְּבֶטֶן אִמִּי׃"}]]},{"key":"KM0xX2TneE","he":[[{"t":"אוֹדְךָ עַל כִּי נוֹרָאוֹת נִפְלֵיתִי נִפְלָאִים מַעֲשֶׂיךָ וְנַפְשִׁי יֹדַעַת מְאֹד׃"}]]},{"key":"JFE_D1BI8k","he":[[{"t":"לֹא־נִכְחַד עָצְמִי מִמֶּךָּ אֲשֶׁר־עֻשֵּׂיתִי בַסֵּתֶר רֻקַּמְתִּי בְּתַחְת