":"מִי יִתֵּן מִצִּיּוֹן יְשׁוּעַת יִשְׂרָאֵל בְּשׁוּב יְהֹוָה שְׁבוּת עַמּוֹ יָגֵל יַעֲקֹב יִשְׂמַח יִשְׂרָאֵל׃"}]]}]},{"title":{"he":"פרק טו","en":"Psalm 15"},"segments":[{"key":"z53FvkPoXw","he":[[{"t":"מִזְמוֹר לְדָוִד יְהֹוָה מִי־יָגוּר בְּאָהֳלֶךָ מִי־יִשְׁכֹּן בְּהַר קָדְשֶׁךָ׃"}]]},{"key":"K1cuRZvuXs","he":[[{"t":"הוֹלֵךְ תָּמִים וּפֹעֵל צֶדֶק וְדֹבֵר אֱמֶת בִּלְבָבוֹ׃"}]]},{"key":"Lwwxbxn9WO","he":[[{"t":"לֹא־רָגַל עַל־לְשֹׁנוֹ לֹא־עָשָׂה לְרֵעֵהוּ רָעָה וְחֶרְפָּה לֹא־נָשָׂא עַל־קְרֹבוֹ׃"}]]},{"key":"wlRCNqf7Kj","he":[[{"t":"נִבְזֶה בְּעֵינָיו נִמְאָס וְאֶת־יִרְאֵי יְהֹוָה יְכַבֵּד נִשְׁבַּע לְהָרַע וְלֹא יָמִר׃"}]]},{"key":"5cy12SLOxw","he":[[{"t":"כַּסְפּוֹ לֹא־נָתַן בְּנֶשֶׁךְ וְשֹׁחַד עַל־נָקִי לֹא לָקָח עֹשֵׂה־אֵלֶּה לֹא יִמּוֹט לְעוֹלָם׃"}]]}]},{"title":{"he":"פרק טז","en":"Psalm 16"},"segments":[{"key":"6DOTtNwp5J","he":[[{"t":"מִכְתָּם לְדָוִד שָׁמְרֵנִי אֵל כִּי־חָסִיתִי בָךְ׃"}]]},{"key":"0U0njrxRuT","he":[[{"t":"אָמַרְתְּ לַיהֹוָה אֲדֹנָי אָתָּה טוֹבָתִי בַּל־עָלֶיךָ׃"}]]},{"key":"54ZpiCZTL-","he":[[{"t":"לִקְדוֹשִׁים אֲשֶׁר־בָּאָרֶץ הֵמָּה וְאַדִּירֵי כָּל־חֶפְצִי־בָם׃"}]]},{"key":"meDKKtyr3I","he":[[{"t":"יִרְבּוּ עַצְּבוֹתָם אַחֵר מָהָרוּ בַּל־אַסִּיךְ נִסְכֵּיהֶם מִדָּם וּבַל־אֶשָּׂא אֶת־שְׁמוֹתָם עַל־שְׂפָתָי׃"}]]},{"key":"ty4TyWJ-_6","he":[[{"t":"יְהֹוָה מְנָת־חֶלְקִי וְכוֹסִי אַתָּה תּוֹמִיךְ גּוֹרָלִי׃"}]]},{"key":"K49F_yVjQs","he":[[{"t":"חֲבָלִים נָפְלוּ־לִי בַּנְּעִמִים אַף־נַחֲלָת שָׁפְרָה עָלָי׃"}]]},{"key":"niCCm7o0Y2","he":[[{"t":"אֲבָרֵךְ אֶת־יְהֹוָה אֲשֶׁר יְעָצָנִי אַף־לֵילוֹת יִסְּרוּנִי כִלְיוֹתָי׃"}]]},{"key":"1pgJrUwW8g","he":[[{"t":"שִׁוִּיתִי יְהֹוָה לְנֶגְדִּי תָמִיד כִּי מִימִינִי בַּל־אֶמּוֹט׃"}]]},{"key":"597R4toqKf","he":[[{"t":"לָכֵן שָׂמַח לִבִּי וַיָּגֶל כְּבוֹדִי אַף־בְּשָׂרִי יִשְׁכֹּן לָבֶטַח׃"}]]},{"key":"YlijYkNr3N","he":[[{"t":"כִּי לֹא־תַעֲזֹב נַפְשִׁי לִשְׁאוֹל לֹא־תִתֵּן חֲסִידְךָ לִרְאוֹת שָׁחַת׃"}]]},{"key":"aQDPV7Hi30","he":[[{"t":"תּוֹדִיעֵנִי אֹרַח חַיִּים שֹׂבַע שְׂמָחוֹת אֶת־פָּנֶיךָ נְעִמוֹת בִּימ