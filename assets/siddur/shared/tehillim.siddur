{"id":"tehillim","sections":[{"title":{"he":"תפילה לפני אמירת תהלים","en":"Prayer Before Tehillim"},"chapter":{"he":"תפילה לפני אמירת תהלים","en":"Prayer Before Tehillim"},"segments":[{"key":"IJdrHHigvS","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ ואֱלֹהֵי אֲבוֹתֵינוּ הַבּוֹחֵר בְּדָוִד עַבְדוֹ וּבְזַרְעוֹ אַחֲרָיו וְהַבּוֹחֵר בְּשִׁירוֹת וְתִשְׁבָּחוֹת, שֶׁתֵּפֶן בְּרַחֲמִים אֶל קְרִיאַת מִזְמוֹרֵי תְּהִלִּים שֶׁאֶקְרָא כְּאִלּוּ אֲמָרָם דָּוִד הַמֶּלֶךְ עָלָיו הַשָּׁלוֹם בְּעַצְמוֹ זְכוּתוֹ יָגֵן עָלֵינוּ. וְיַעֲמָד לָנוּ זְכוּת פְּסוּקֵי תְּהִלִּים וּזְכוּת תֵּבוֹתֵיהֶם וְאוֹתִיוֹתֵיהֶם וּנְקֻדּוֹתֵיהֶם וְטַעֲמֵיהֶם וְהַשֵּׁמוֹת הַיּוֹצְאִים מֵהֶם מֵרָאשֵׁי תֵּבוֹת וּמִסּוֹפֵי תֵּבוֹת, לְכַפֵּר פְּשָּׁעֵינוּ וַעֲוֹנוֹתֵינוּ וְחַטֹּאתֵינוּ, וּלְזַמֵּר עָרִיצִים וּלְהַכְרִית כָּל הַחוֹחִים וְהַקּוֹצִים הַסּוֹבְבִים אֶת הַשּׁוֹשַׁנָּה הָעֶלְיוֹנָה, וּלְחַבֵּר אֵשֶׁת נְעוּרִים עִם דּוֹדָהּ בְּאַהֲבָה וְאַחֲוָה וְרֵעוּת, וּמִשָּׁם יִמָּשֵׁךְ לָנוּ שֶׁפַע לְנֶפֶשׁ רוּחַ וּנְשָׁמָה לְטַהֲרֵנוּ מֵעֲוֹנוֹתֵינוּ וְלִסְלֹחַ חַטֹּאתֵינוּ וּלְכַפֵּר פְּשָּׁעֵינוּ, כְּמוֹ שֶׁסָלַחְתָּ לְדָוִד שֶׁאָמַר מִזְמוֹרִים אֵלּוּ לְפָנֶיךָ, כְּמוֹ שֶׁנֶּאֱמַר גַּם יְהֹוָה הֶעֱבִיר חַטָּאתְךָ לֹא תָּמוּת. וְאַל תִּקָּחֵנוּ מֵהָעוֹלָם הַזֶּה קֹדֶם זְמַנֵּנוּ עַד מְלֹאת שְנוֹתֵינוּ בָּהֶם שִׁבְעִים שָׁנָה בְּאֹפֶן שֶׁנּוּכַל לְתַקֵּן אֵת אָשֵׁר שִׁחַתְנוּ. וּזְכוּת דָּוִד הַמֶּלֶךְ עָלָיו הַשָּׁלוֹם יָגֵן עָלֵינוּ וּבַּעֲדֵנוּ שְׁתַּאֲרִיךְ אַפְּךָ עַד שׁוּבֵנוּ אֵלֶיךָ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ. וּמֵאוֹצַר מַתְּנַת חִנָּם חֲנָנוֹ, כְּדִּכְתִיב וְחַנּוֹתִי אֶת אֲשֶׁר אָחֹן וְרִחַמְתִּי אֶת אָשֵׁר אֲרַחֵם. וּכְשֵׁם שֶׁאָנוּ אוֹמְרִים לְפָנֶיךָ שִׁירָה בָּעוֹלָם הַזֶּה כָּךְ נִזְכֶּה לוֹמַר לְפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ שִׁיר וּשְׁבָחָה לָעוֹלָם הַבָּא. וְעַל יְדֵי אֲמִירַת תְּהִלִּים תִּתְעוֹרֵר חֲבַצֶּלֶת הַשָּׁרוֹן וְלָשִׁיר בְּקוֹל נָעִים בְּגִילַת וְרַנֵּן, כְּבוֹד הַלְּבָנוֹן נִתָּן לָהּ, הוֹד וְהָדָר בְּבֵית אֱלֹהֵינוּ בִּמְהֵרָה בְּיָמֵינוּ אָמֵן סֶלָה:"}]],"when":{"none":["shabbat","yomTov"]}},{"key":"gSlBd1Z2KK","he":[[{"t":"לְכוּ נְרַנְּנָה לַיהֹוָה נָרִיעָה לְצוּר יִשְׁעֵנוּ׃"}]]},{"key":"vkOLRmBFMZ","he":[[{"t":"נְקַדְּמָה פָנָיו בְּתוֹדָה בִּזְמִרוֹת נָרִיעַ לוֹ׃"}]]},{"key":"CP7_aAsx9M","he":[[{"t":"כִּי אֵל גָּדוֹל יְהֹוָה וּמֶלֶךְ גָּדוֹל עַל־כָּל־אֱלֹהִים׃"}]]}]},{"title":{"he":"פרק א","en":"Psalm 1"},"headings":[{"he":"ספר ראשון","en":"First Book","level":1},{"he":"ליום ראשון","en":"Sunday","level":2}],"chapter":{"he":"ליום ראשון","en":"Sunday"},"segments":[{"key":"NqSujD4iRN","he":[[{"t":"אַשְׁרֵי־הָאִישׁ אֲשֶׁר לֹא הָלַךְ בַּעֲצַת רְשָׁעִים וּבְדֶרֶךְ חַטָּאִים לֹא עָמָד וּבְמוֹשַׁב לֵצִים לֹא יָשָׁב׃"}]]},{"key":"bV7KefURIP","he":[[{"t":"כִּי אִם בְּתוֹרַת יְהֹוָה חֶפְצוֹ וּבְתוֹרָתוֹ יֶהְגֶּה יוֹמָם וָלָיְלָה׃"}]]},{"key":"NV4FJ4YWph","he":[[{"t":"וְהָיָה כְּעֵץ שָׁתוּל עַל־פַּלְגֵי מָיִם אֲשֶׁר פִּרְיוֹ יִתֵּן בְּעִתּוֹ וְעָלֵהוּ לֹא־יִבּוֹל וְכֹל אֲשֶׁר־יַעֲשֶׂה יַצְלִיחַ׃"}]]},{"key":"z2H8L4BE1i","he":[[{"t":"לֹא־כֵן הָרְשָׁעִים כִּי אִם־כַּמֹּץ אֲשֶׁר־תִּדְּפֶנּוּ רוּחַ׃"}]]},{"key":"IJqfqmkoWG","he":[[{"t":"עַל־כֵּן לֹא־יָקֻמוּ רְשָׁעִים בַּמִּשְׁפָּט וְחַטָּאִים בַּעֲדַת צַדִּיקִים׃"}]]},{"key":"0pzj-LeVip","he":[[{"t":"כִּי־יוֹדֵעַ יְהֹוָה דֶּרֶךְ צַדִּיקִים וְדֶרֶךְ רְשָׁעִים תֹּאבֵד׃"}]]}]},{"title":{"he":"פרק ב","en":"Psalm 2"},"segments":[{"key":"IvNJ3pSVPg","he":[[{"t":"לָמָּה רָגְשׁוּ גוֹיִם וּלְאֻמִּים יֶהְגּוּ־רִיק׃"}]]},{"key":"lq5eHD1pzB","he":[[{"t":"יִתְיַצְּבוּ מַלְכֵי־אֶרֶץ וְרוֹזְנִים נוֹסְדוּ־יָחַד עַל־יְהֹוָה וְעַל־מְשִׁיחוֹ׃"}]]},{"key":"YO5e0Moc5x","he":[[{"t":"נְנַתְּקָה אֶת־מוֹסְרוֹתֵימוֹ וְנַשְׁלִיכָה מִמֶּנּוּ עֲבֹתֵימוֹ׃"}]]},{"key":"zWiSA1Ueb3","he":[[{"t":"יוֹשֵׁב בַּשָּׁמַיִם יִשְׂחָק אֲדֹנָי יִלְעַג־לָמוֹ׃"}]]},{"key":"Qp1G15KjcK","he":[[{"t":"אָז יְדַבֵּר אֵלֵימוֹ בְאַפּוֹ וּבַחֲרוֹנוֹ יְבַהֲלֵמוֹ׃"}]]},{"key":"y4pgxoWvAX","he":[[{"t":"וַאֲנִי נָסַכְתִּי מַלְכִּי עַל־צִיּוֹן הַר־קָדְשִׁי׃"}]]},{"key":"3Jj2r2SkaS","he":[[{"t":"אֲסַפְּרָה אֶל חֹק יְהֹוָה אָמַר אֵלַי בְּנִי אַתָּה אֲנִי הַיּוֹם יְלִדְתִּיךָ׃"}]]},{"key":"UsFNnHRop9","he":[[{"t":"שְׁאַל מִמֶּנִּי וְאֶתְּנָה גוֹיִם נַחֲלָתֶךָ וַאֲחֻזָּתְךָ אַפְסֵי־אָרֶץ׃"}]]},{"key":"rlVCTbEPqt","he":[[{"t":"תְּרֹעֵם בְּשֵׁבֶט בַּרְזֶל כִּכְלִי יוֹצֵר תְּנַפְּצֵם׃"}]]},{"key":"A4Q9p-kFpj","he":[[{"t":"וְעַתָּה מְלָכִים הַשְׂכִּילוּ הִוָּסְרוּ שֹׁפְטֵי אָרֶץ׃"}]]},{"key":"zMYhPWpH6C","he":[[{"t":"עִבְדוּ אֶת־יְהֹוָה בְּיִרְאָה וְגִילוּ בִּרְעָדָה׃"}]]},{"key":"t7oQpbW50U","he":[[{"t":"נַשְּׁקוּ־בַר פֶּן־יֶאֱנַף וְתֹאבְדוּ דֶרֶךְ כִּי־יִבְעַר כִּמְעַט אַפּוֹ אַשְׁרֵי כָּל־חוֹסֵי בוֹ׃"}]]}]},{"title":{"he":"פרק ג","en":"Psalm 3"},"segments":[{"key":"8UrGB26-DE","he":[[{"t":"מִזְמוֹר לְדָוִד בְּבָרְחוֹ מִפְּנֵי אַבְשָׁלוֹם בְּנוֹ׃"}]]},{"key":"kepsa9ayNp","he":[[{"t":"יְהֹוָה מָה־רַבּוּ צָרָי רַבִּים קָמִים עָלָי׃"}]]},{"key":"HCAF3o_mo8","he":[[{"t":"רַבִּים אֹמְרִים לְנַפְשִׁי אֵין יְשׁוּעָתָה לּוֹ בֵאלֹהִים סֶלָה׃"}]]},{"key":"aZMA-pWcK9","he":[[{"t":"וְאַתָּה יְהֹוָה מָגֵן בַּעֲדִי כְּבוֹדִי וּמֵרִים רֹאשִׁי׃"}]]},{"key":"XIY38jaj11","he":[[{"t":"קוֹלִי אֶל־יְהֹוָה אֶקְרָא וַיַּעֲנֵנִי מֵהַר קָדְשׁוֹ סֶלָה׃"}]]},{"key":"HDIn-1bqBx","he":[[{"t":"אֲנִי שָׁכַבְתִּי וָאִישָׁנָה הֱקִיצוֹתִי כִּי יְהֹוָה יִסְמְכֵנִי׃"}]]},{"key":"dSPkmmAjJN","he":[[{"t":"לֹא־אִירָא מֵרִבְבוֹת עָם אֲשֶׁר סָבִיב שָׁתוּ עָלָי׃"}]]},{"key":"_8v3VCQ2so","he":[[{"t":"קוּמָה יְהֹוָה הוֹשִׁיעֵנִי אֱלֹהַי כִּי־הִכִּיתָ אֶת־כָּל־אֹיְבַי לֶחִי שִׁנֵּי רְשָׁעִים שִׁבַּרְתָּ׃"}]]},{"key":"wuj3uwP_9F","he":[[{"t":"לַיהֹוָה הַיְשׁוּעָה עַל־עַמְּךָ בִרְכָתֶךָ סֶּלָה׃"}]]}]},{"title":{"he":"פרק ד","en":"Psalm 4"},"segments":[{"key":"mNWGY3VCpX","he":[[{"t":"לַמְנַצֵּחַ בִּנְגִינוֹת מִזְמוֹר לְדָוִד׃"}]]},{"key":"8KpTzDp0p3","he":[[{"t":"בְּקָרְאִי עֲנֵנִי אֱלֹהֵי צִדְקִי בַּצָּר הִרְחַבְתָּ לִּי חָנֵּנִי וּשְׁמַע תְּפִלָּתִי׃"}]]},{"key":"WncrRGtrfF","he":[[{"t":"בְּנֵי אִישׁ עַד־מֶה כְבוֹדִי לִכְלִמָּה תֶּאֱהָבוּן רִיק תְּבַקְשׁוּ כָזָב סֶלָה׃"}]]},{"key":"bYVlKTEeOX","he":[[{"t":"וּדְעוּ כִּי־הִפְלָה יְהֹוָה חָסִיד לוֹ יְהֹוָה י