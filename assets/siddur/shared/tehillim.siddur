 אַתָּה יָדַעְתָּ לְאִוַּלְתִּי וְאַשְׁמוֹתַי מִמְּךָ לֹא־נִכְחָדוּ׃"}]]},{"key":"eBYRUNm1UZ","he":[[{"t":"אַל־יֵבֹשׁוּ בִי קֹוֶיךָ אֲדֹנָי יְהוִה צְבָאוֹת אַל־יִכָּלְמוּ בִי מְבַקְשֶׁיךָ אֱלֹהֵי יִשְׂרָאֵל׃"}]]},{"key":"CxYa9yH4gD","he":[[{"t":"כִּי־עָלֶיךָ נָשָׂאתִי חֶרְפָּה כִּסְּתָה כְלִמָּה פָנָי׃"}]]},{"key":"A7aL5oQQPq","he":[[{"t":"מוּזָר הָיִיתִי לְאֶחָי וְנָכְרִי לִבְנֵי אִמִּי׃"}]]},{"key":"jMaSnRArQu","he":[[{"t":"כִּי־קִנְאַת בֵּיתְךָ אֲכָלָתְנִי וְחֶרְפּוֹת חוֹרְפֶיךָ נָפְלוּ עָלָי׃"}]]},{"key":"lAUPEltk35","he":[[{"t":"וָאֶבְכֶּה בַצּוֹם נַפְשִׁי וַתְּהִי לַחֲרָפוֹת לִי׃"}]]},{"key":"krRvJ9FoQ2","he":[[{"t":"וָאֶתְּנָה לְבוּשִׁי שָׂק וָאֱהִי לָהֶם לְמָשָׁל׃"}]]},{"key":"_w77sUHXzH","he":[[{"t":"יָשִׂיחוּ בִי יֹשְׁבֵי שָׁעַר וּנְגִינוֹת שׁוֹתֵי שֵׁכָר׃"}]]},{"key":"zN9EglNjl1","he":[[{"t":"וַאֲנִי תְפִלָּתִי־לְךָ יְהֹוָה עֵת רָצוֹן אֱלֹהִים בְּרָב־חַסְדֶּךָ עֲנֵנִי בֶּאֱמֶת יִשְׁעֶךָ׃"}]]},{"key":"t_Hxq38VYQ","he":[[{"t":"הַצִּילֵנִי מִטִּיט וְאַל־אֶטְבָּעָה אִנָּצְלָה מִשֹּׂנְאַי וּמִמַּעֲמַקֵּי־מָיִם׃"}]]},{"key":"xtqg4ywbFI","he":[[{"t":"אַל־תִּשְׁטְפֵנִי שִׁבֹּלֶת מַיִם וְאַל־תִּבְלָעֵנִי מְצוּלָה וְאַל־תֶּאְטַר־עָלַי בְּאֵר פִּיהָ׃"}]]},{"key":"Hf1l_m6C62","he":[[{"t":"עֲנֵנִי יְהֹוָה כִּי־טוֹב חַסְדֶּךָ כְּרֹב רַחֲמֶיךָ פְּנֵה אֵלָי׃"}]]},{"key":"ou3lR0ynuE","he":[[{"t":"וְאַל־תַּסְתֵּר פָּנֶיךָ מֵעַבְדֶּךָ כִּי־צַר־לִי מַהֵר עֲנֵנִי׃"}]]},{"key":"3TMgPPS4n4","he":[[{"t":"קָרְבָה אֶל־נַפְשִׁי גְאָלָהּ לְמַעַן אֹיְבַי פְּדֵנִי׃"}]]},{"key":"R5hwftGk5s","he":[[{"t":"אַתָּה יָדַעְתָּ חֶרְפָּתִי וּבָשְׁתִּי וּכְלִמָּתִי נֶגְדְּךָ כָּל־צוֹרְרָי׃"}]]},{"key":"gsDSh_u5G2","he":[[{"t":"חֶרְפָּה שָׁבְרָה לִבִּי וָאָנוּשָׁה וָאֲקַוֶּה לָנוּד וָאַיִן וְלַמְנַחֲמִים וְלֹא מָצָאתִי׃"}]]},{"key":"koF1c_3iyD","he":[[{"t":"וַיִּתְּנוּ בְּבָרוּתִי רֹאשׁ וְלִצְמָאִי יַשְׁקוּנִי חֹמֶץ׃"}]]},{"key":"zdTlgM-M0p","he":[[{"t":"יְהִי־שֻׁלְחָנָם לִפְנֵיהֶם לְפָח וְלִשְׁלוֹמִים לְמוֹקֵשׁ׃"}]]},{"key":"S8F-XAy2dH","he":[[{"t":"תֶּחְשַׁכְנָה עֵינֵיהֶם מֵרְאוֹת וּמָתְנֵיהֶם 