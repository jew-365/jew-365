","he":[[{"t":"רַבּוֹת עָשִׂיתָ אַתָּה יְהֹוָה אֱלֹהַי נִפְלְאֹתֶיךָ וּמַחְשְׁבֹתֶיךָ אֵלֵינוּ אֵין עֲרֹךְ אֵלֶיךָ אַגִּידָה וַאֲדַבֵּרָה עָצְמוּ מִסַּפֵּר׃"}]]},{"key":"jLVKUjqnMt","he":[[{"t":"זֶבַח וּמִנְחָה לֹא־חָפַצְתָּ אָזְנַיִם כָּרִיתָ לִּי עוֹלָה וַחֲטָאָה לֹא שָׁאָלְתָּ׃"}]]},{"key":"PC4pOUe3RS","he":[[{"t":"אָז אָמַרְתִּי הִנֵּה־בָאתִי בִּמְגִלַּת־סֵפֶר כָּתוּב עָלָי׃"}]]},{"key":"GoA3aEFi4P","he":[[{"t":"לַעֲשׂוֹת־רְצוֹנְךָ אֱלֹהַי חָפָצְתִּי וְתוֹרָתְךָ בְּתוֹךְ מֵעָי׃"}]]},{"key":"_8YbQ-JTIC","he":[[{"t":"בִּשַּׂרְתִּי צֶדֶק בְּקָהָל רָב הִנֵּה שְׂפָתַי לֹא אֶכְלָא יְהֹוָה אַתָּה יָדָעְתָּ׃"}]]},{"key":"LJlesx6zc0","he":[[{"t":"צִדְקָתְךָ לֹא־כִסִּיתִי בְּתוֹךְ לִבִּי אֱמוּנָתְךָ וּתְשׁוּעָתְךָ אָמָרְתִּי לֹא־כִחַדְתִּי חַסְדְּךָ וַאֲמִתְּךָ לְקָהָל רָב׃"}]]},{"key":"XkaBxmNIqO","he":[[{"t":"אַתָּה יְהֹוָה לֹא־תִכְלָא רַחֲמֶיךָ מִמֶּנִּי חַסְדְּךָ וַאֲמִתְּךָ תָּמִיד יִצְּרוּנִי׃"}]]},{"key":"xTsS6AV_si","he":[[{"t":"כִּי אָפְפוּ־עָלַי רָעוֹת עַד־אֵין מִסְפָּר הִשִּׂיגוּנִי עֲוֺנֹתַי וְלֹא־יָכֹלְתִּי לִרְאוֹת עָצְמוּ מִשַּׂעֲרוֹת רֹאשִׁי וְלִבִּי עֲזָבָנִי׃"}]]},{"key":"eeCMm5OUFG","he":[[{"t":"רְצֵה יְהֹוָה לְהַצִּילֵנִי יְהֹוָה לְעֶזְרָתִי חוּשָׁה׃"}]]},{"key":"x7wBJflj_t","he":[[{"t":"יֵבֹשׁוּ וְיַחְפְּרוּ יַחַד מְבַקְשֵׁי נַפְשִׁי לִסְפּוֹתָהּ יִסֹּגוּ אָחוֹר וְיִכָּלְמוּ חֲפֵצֵי רָעָתִי׃"}]]},{"key":"1yRDTeIQ0p","he":[[{"t":"יָשֹׁמּוּ עַל־עֵקֶב בָּשְׁתָּם הָאֹמְרִים לִי הֶאָח הֶאָח׃"}]]},{"key":"_9GJi8wY2p","he":[[{"t":"יָשִׂישׂוּ וְיִשְׂמְחוּ בְּךָ כָּל־מְבַקְשֶׁיךָ יֹאמְרוּ תָמִיד יִגְדַּל יְהֹוָה אֹהֲבֵי תְּשׁוּעָתֶךָ׃"}]]},{"key":"UNhggq7rSx","he":[[{"t":"וַאֲנִי עָנִי וְאֶבְיוֹן אֲדֹנָי יַחֲשָׁב לִי עֶזְרָתִי וּמְפַלְטִי אַתָּה אֱלֹהַי אַל־תְּאַחַר׃"}]]}]},{"title":{"he":"פרק מא","en":"Psalm 41"},"segments":[{"key":"4owuBkFyVp","he":[[{"t":"לַמְנַצֵּחַ מִזְמוֹר לְדָוִד׃"}]]},{"key":"4L0S0RBpbM","he":[[{"t":"אַשְׁרֵי מַשְׂכִּיל אֶל־דָּל בְּיוֹם רָעָה יְמַלְּטֵהוּ יְהֹוָה׃"}]]},{"key":"G0j_qnlRP-","he":[[{"t":"יְהֹוָה יִשְׁמְרֵהוּ וִיחַיֵּהוּ וְאֻשַּׁר בָּאָרֶץ וְאַל־תִּתְּנֵהוּ בְּנֶפֶשׁ אֹיְבָיו׃"}]]},{"key":"0_yqUkbffV","he":[[{"t":"יְהֹוָה יִסְעָדֶנּוּ עַל־עֶרֶשׂ דְּוָי כָּל־מִשְׁכָּבוֹ הָפַכְתָּ בְחָלְיוֹ׃"}]]},{"key":"uIqQmR9MlN","he":[[{"t":"אֲנִי־אָמַרְתִּי יְהֹוָה חָנֵּנִי רְפָאָה נַפְשִׁי כִּי־חָטָאתִי לָךְ׃"}]]},{"key":"U8INYILCt1","he":[[{"t":"אוֹיְבַי יֹאמְרוּ רַע לִי מָתַי יָמוּת וְאָבַד שְׁמוֹ׃"}]]},{"key":"XijumAZVhZ","he":[[{"t":"וְאִם־בָּא לִרְאוֹת שָׁוְא יְדַבֵּר לִבּוֹ יִקְבָּץ־אָוֶן לוֹ יֵצֵא לַחוּץ יְדַבֵּר׃"}]]},{"key":"IFJkULtQAp","he":[[{"t":"יַחַד עָלַי יִתְלַחֲשׁוּ כָּל־שֹׂנְאָי עָלַי יַחְשְׁבוּ רָעָה לִי׃"}]]},{"key":"-f6lBF7M1v","he":[[{"t":"דְּבַר־בְּלִיַּעַל יָצוּק בּוֹ וַאֲשֶׁר שָׁכַב לֹא־יוֹסִיף לָקוּם׃"}]]},{"key":"2-djB_VOQZ","he":[[{"t":"גַּם־אִישׁ שְׁלוֹמִי אֲשֶׁר־בָּטַחְתִּי בוֹ אוֹכֵל לַחְמִי הִגְדִּיל עָלַי עָקֵב׃"}]]},{"key":"4KJkmA1IBG","he":[[{"t":"וְאַתָּה יְהֹוָה חָנֵּנִי וַהֲקִימֵנִי וַאֲשַׁלְּמָה לָהֶם׃"}]]},{"key":"aJ7i6a2Sxl","he":[[{"t":"בְּזֹאת יָדַעְתִּי כִּי־חָפַצְתָּ בִּי כִּי לֹא־יָרִיעַ אֹיְבִי עָלָי׃"}]]},{"key":"2n6fHXSkVi","he":[[{"t":"וַאֲנִי בְּתֻמִּי תָּמַכְתָּ בִּי וַתַּצִּיבֵנִי לְפָנֶיךָ לְעוֹלָם׃"}]]},{"key":"YjoN9MF8Vc","he":[[{"t":"בָּרוּךְ יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל מֵהָעוֹלָם וְעַד הָעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"יהי רצון לאחר ספר ראשון","en":"After the First Book"},"optional":{"he":"המסיים ספר ראשון אומר","en":"Said on finishing the First Book"},"segments":[{"key":"pFsuKUU6hw","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, בִּזְכוּת סֵפֶר רִאשׁוֹן שֶׁבַּתְּהִלִּים שֶׁקָּרָאנוּ לְפָנֶיךָ, שֶׁהוּא כְּנֶגֶד סֵפֶר בְּרֵאשִׁית בִּזְכוּת מִזְמוֹרָיו, וּבִזְכוּת פְּסוּקָיו, וּבִזְכוּת תֵּבוֹתָיו, וּבִזְכוּת שְׁמוֹתֶיךָ הַקְּדוֹשִׁים וְהַטְּהוֹרִים הַיּוֹצְאִים מִמֶּנּוּ, שֶׁתְּכַפֶּר לָנוּ עַל כָּל חַטֹּאתֵינוּ, וְתִסְלַח לָנוּ עַל כָּל עֲוֹנֹתֵינוּ, וְתִמְחָל לָנוּ עַל כָּל פְּשָׁעֵינוּ, שֶׁחָטָאנוּ וְשֶׁעָוִינוּ וְשֶׁפָּשַׁעְנוּ לְפָנֶיךָ. וְהַחֲזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ, וְהַדְרִיכֵנוּ לַעֲבֹדָתְךָ וְתִפְתַּח לִבֵּנוּ בְּתַלְמוּד תּוֹרָתֶךָ. וְתִשְׁלַח רְפוּאָה שְׁלֵמָה לְחוֹלֵי עַמֶּךָ (ולפב\"פ). וְתִקְרָא לִשְׁבוּיִם דְּרוֹר וְלַאֲסוּרִים פְּקַח קוֹחַ, וּלְכָל הוֹלְכֵי דְּרָכִים וְעוֹבְרֵי יַמִּים וּנְהָרוֹת מֵעַמְּךָ יִשְׂרָאֵל, תַּצִּילֵם מִכָּל צַעַר וְנֶזֶק, וְתַגִּיעֵם לִמְחוֹז חֶפְצָם לְחַיִּים וּלְשָׁלוֹם. וְתִפְקֹד לְכָל חֲשׂוּכֵי בָנִים בְּזֶרַע שֶׁל קַיָּמָא לַעֲבוֹדָתְךָ וּלְיִרְאָתֶךָ. וְעֻבָּרוֹת שֶׁל עַמְּךָ בֵּית יִשְׂרָאֵל תַּצִּילֵן שֶׁלֹּא תַּפֵּלְנָה וַלְדוֹתֵיהֶן. וְהַיּוֹשְׁבוֹת עַל הַמַּשְׁבֵּר, בְּרַחֲמֶיךָ הָרַבִּים תַּצִּילֵן מִכָּל רָע. וְאֶל הַמְּנִיקוֹת תַּשְׁפִּיעַ שֶׁלֹּא יֶחְסַר חָלָב מִדַּדֵּיהֶן. וְאַל יִמְשֹׁל אַסְכָּרָה וְשֵׁדִין וְרוּחִין וְלִילִין וְכָל פְּגָעִים וּמַרְעִין בִּישִׂין בְּכָל יַלְדֵי עַמְּךָ בֵּית יִשְׂרָאֵל. וּתְגַדְּלֵם לְתוֹרָתֶךָ, לִלְמֹד תּוֹרָה לִשְׁמָהּ. וְתַצִּילֵם מֵעַיִן הָרָע וּמִדֶּבֶר וּמִמַּגֵּפָה וּמִשָּׂטָן וּמִיֵּצֶר הָרָע. וּתְבַטֵּל מֵעָלֵינוּ וּמִכָּל עַמְּךָ בֵּית יִשְׂרָאֵל בְּכָל מָקוֹם שֶׁהֵם כָּל גְּזֵרוֹת קָשׁוֹת וְרָעוֹת. וְתַטֶּה לֵב הַמַּלְכוּת עָלֵינוּ לְטוֹבָה, וְתִגְזֹר עָלֵינוּ גְּזֵרוֹת טוֹבוֹת. וְתִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יָדֵינוּ. וְהָכֵן פַּרְנָסָתֵנוּ מִיָּדְךָ הָרְחָבָה וְהַמְּלֵאָה, וְלֹא יִצְטָרְכוּ עַמְּךָ בֵּית יִשְׂרָאֵל זֶה לָזֶה וְלֹא לְעַם אַחֵר. וְתֵן לְכָל אִישׁ וְאִישׁ דֵּי פַּרְנָסָתוֹ, וּלְכָל גְּוִיָּה וּגְוִיָּה דֵּי מַחְסוֹרָהּ. וּתְמַהֵר וְתָחִישׁ לְגָאֳלֵנוּ, וְתִבְנֶה בֵּית מִקְדָּשֵׁנוּ וְתִפְאַרְתֵּנוּ. וּבִזְכוּת שְׁלֹשׁ עֶשְׂרֵה מִדּוֹתֶיךָ שֶׁל רַחֲמִים הַכְּתוּבִים בְּתוֹרָתֶךָ, כְּמוֹ שֶׁנֶּאֱמַר: יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן, אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת׃ נֹצֵר חֶסֶד לָאֲלָפִים, נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה. שֶׁאֵינָן חוֹזְרוֹת רֵיקָם מִלְּפָנֶיךָ, עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ עַל דְּבַר כְּבוֹד שְׁמֶךָ, וְהַצִּילֵנוּ וְכַפֵּר עַל חַטֹּאתֵינוּ לְמַעַן שְׁמֶךָ. בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"פרק מב","en":"Psalm 42"},"headings":[{"he":"ספר שני","en":"Second Book","level":1}],"segments":[{"key":"vrEUPfIyBS","he":[[{"t":"לַמְנַצֵּחַ מַשְׂכִּיל לִבְנֵי־קֹרַח׃"}]]},{"key":"ixnsj_7Dx4","he":[[{"t":"כְּאַיָּל תַּעֲרֹג עַל־אֲפִיקֵי־מָיִם כֵּן נַפְשִׁי תַעֲרֹג אֵלֶיךָ אֱלֹהִים׃"}]]},{"key":"61rd2rw7a3","he":[[{"t":"צָמְאָה נַפְשִׁי לֵאלֹהִים לְאֵל חָי מָתַי אָבוֹא וְאֵרָאֶה פְּנֵי אֱלֹהִים׃"}]]},{"key":"3mTUMMl46i","he":[[{"t":"הָיְתָה־לִּי דִמְעָתִי לֶחֶם יוֹמָם וָלָיְלָה בֶּאֱמֹר אֵלַי כָּל־הַיּוֹם אַיֵּה אֱלֹהֶיךָ׃"}]]},{"key":"eT_K7WNSrY","he":[[{"t":"אֵלֶּה אֶזְכְּרָה וְאֶשְׁפְּכָה עָלַי נַפְשִׁי כִּי אֶעֱבֹר בַּסָּךְ אֶדַּדֵּם עַד־בֵּית אֱלֹהִים בְּקוֹל־רִנָּה וְתוֹדָה הָמוֹן חוֹגֵג׃"}]]},{"key":"lxXCz7whAA","he":[[{"t":"מַה־תִּשְׁתּוֹחֲחִי נַפְשִׁי וַתֶּהֱמִי עָלָי הוֹחִילִי לֵאלֹהִים כִּי־עוֹד אוֹדֶנּוּ יְשׁוּעוֹת פָּנָיו׃"}]]},{"key":"PPk0LSkOKe","he":[[{"t":"אֱלֹהַי עָלַי נַפְשִׁי תִשְׁתּוֹחָח עַל־כֵּן אֶזְכָּרְךָ מֵאֶרֶץ יַרְדֵּן וְחֶרְמוֹנִים מֵהַר מִצְעָר׃"}]]},{"key":"Y8e9fgd_Or","he":[[{"t":"תְּהוֹם־אֶל־תְּהוֹם קוֹרֵא לְקוֹל צִנּוֹרֶיךָ כָּל־מִשְׁבָּרֶיךָ וְגַלֶּיךָ עָלַי עָבָרוּ׃"}]]},{"key":"_CYLaV0dIx","he":[[{"t":"יוֹמָם יְצַוֶּה יְהֹוָה חַסְדּוֹ וּבַלַּיְלָה שִׁירוֹ עִמִּי תְּפִלָּה לְאֵל חַיָּי׃"}]]},{"key":"s1ek0QnjtD","he":[[{"t":"אוֹמְרָה לְאֵל סַלְעִי לָמָה שְׁכַחְתָּנִי לָמָּה־קֹדֵר אֵלֵךְ בְּלַחַץ אוֹיֵב׃"}]]},{"key":"jC9Xc76Eih","he":[[{"t":"בְּרֶצַח בְּעַצְמוֹתַי חֵרְפוּנִי צוֹרְרָי בְּאָמְרָם אֵלַי כָּל־הַיּוֹם אַיֵּה אֱלֹהֶיךָ׃"}]]},{"key":"owof8Z-qne","he":[[{"t":"מַה־תִּשְׁתּוֹחֲחִי נַפְשִׁי וּמַה־תֶּהֱמִי עָלָי הוֹחִילִי לֵאלֹהִים כִּי־עוֹד אוֹדֶנּוּ יְשׁוּעֹת פָּנַי וֵאלֹהָי׃"}]]}]},{"title":{"he":"פרק מג","en":"Psalm 43"},"segments":[{"key":"swab92qGPY","he":[[{"t":"שָׁפְטֵנִי אֱלֹהִים וְרִיבָה רִיבִי מִגּוֹי לֹא־חָסִיד מֵאִישׁ־מִרְמָה וְעַוְלָה תְפַלְּטֵנִי׃"}]]},{"key":"UQwhRPRQIq","he":[[{"t":"כִּי־אַתָּה אֱלֹהֵי מָעוּזִּי לָמָה זְנַחְתָּנִי לָמָּה־קֹדֵר אֶתְהַלֵּךְ בְּלַחַץ אוֹיֵב׃"}]]},{"key":"5DDu8Q32P6","he":[[{"t":"שְׁלַח־אוֹרְךָ וַאֲמִתְּךָ הֵמָּה יַנְחוּנִי יְבִיאוּנִי אֶל־הַר־קָדְשְׁךָ וְאֶל־מִשְׁכְּנוֹתֶיךָ׃"}]]},{"key":"RzihR8mnKE","he":[[{"t":"וְאָבוֹאָה אֶל־מִזְבַּח אֱלֹהִים אֶל־אֵל שִׂמְחַת גִּילִי וְאוֹדְךָ בְכִנּוֹר אֱלֹהִים אֱלֹהָי׃"}]]},{"key":"mD7X6rZEJq","he":[[{"t":"מַה־תִּשְׁתּוֹחֲחִי נַפְשִׁי וּמַה־תֶּהֱמִי עָלָי הוֹחִילִי לֵאלֹהִים כִּי־עוֹד אוֹדֶנּוּ יְשׁוּעֹת פָּנַי וֵאלֹהָי׃"}]]}]},{"title":{"he":"פרק מד","en":"Psalm 44"},"segments":[{"key":"i1hmNnJJdt","he":[[{"t":"לַמְנַצֵּחַ לִבְנֵי־קֹרַח מַשְׂכִּיל׃"}]]},{"key":"pwjcn5MNeS","he":[[{"t":"אֱלֹהִים בְּאָזְנֵינוּ שָׁמַעְנוּ אֲבוֹתֵינוּ סִפְּרוּ־לָנוּ פֹּעַל פָּעַלְתָּ בִימֵיהֶם בִּימֵי קֶדֶם׃"}]]},{"key":"28jXWfHYZB","he":[[{"t":"אַתָּה יָדְךָ גּוֹיִם הוֹרַשְׁתָּ וַתִּטָּעֵם תָּרַע לְאֻמִּים וַתְּשַׁלְּחֵם׃"}]]},{"key":"mHE_Tq8BiX","he":[[{"t":"כִּי לֹא בְחַרְבָּם יָרְשׁוּ אָרֶץ וּזְרוֹעָם לֹא־הוֹשִׁיעָה לָּמוֹ כִּי־יְמִינְךָ וּזְרוֹעֲךָ וְאוֹר פָּנֶיךָ כִּי רְצִיתָם׃"}]]},{"key":"Zx1rnHQO4b","he":[[{"t":"אַתָּה־הוּא מַלְכִּי אֱלֹהִים צַוֵּה יְשׁוּעוֹת יַעֲקֹב׃"}]]},{"key":"XQQ2vNDMUd","he":[[{"t":"בְּךָ צָרֵינוּ נְנַגֵּחַ בְּשִׁמְךָ נָבוּס קָמֵינוּ׃"}]]},{"key":"9IltzaZj0_","he":[[{"t":"כִּי לֹא בְקַשְׁתִּי אֶבְטָח וְחַרְבִּי לֹא תוֹשִׁיעֵנִי׃"}]]},{"key":"2uThp0yFgU","he":[[{"t":"כִּי הוֹשַׁעְתָּנוּ מִצָּרֵינוּ וּמְשַׂנְאֵינוּ הֱבִישׁוֹתָ׃"}]]},{"key":"8fHFAy1x_X","he":[[{"t":"בֵּאלֹהִים הִלַּלְנוּ כָל־הַיּוֹם וְשִׁמְךָ לְעוֹלָם נוֹדֶה סֶלָה׃"}]]},{"key":"ATOyfvyYpO","he":[[{"t":"אַף־זָנַחְתָּ וַתַּכְלִימֵנוּ וְלֹא־תֵצֵא בְּצִבְאוֹתֵינוּ׃"}]]},{"key":"8t-vRiUBNj","he":[[{"t":"תְּשִׁיבֵנוּ אָחוֹר מִנִּי־צָר וּמְשַׂנְאֵינוּ שָׁסוּ לָמוֹ׃"}]]},{"key":"ami_kBymio","he":[[{"t":"תִּתְּנֵנוּ כְּצֹאן מַאֲכָל וּבַגּוֹיִם זֵרִיתָנוּ׃"}]]},{"key":"Eg0ZzIo0DL","he":[[{"t":"תִּמְכֹּר־עַמְּךָ בְלֹא־הוֹן וְלֹא־רִבִּיתָ בִּמְחִירֵיהֶם׃"}]]},{"key":"5xByrFAk3a","he":[[{"t":"תְּשִׂימֵנוּ חֶרְפָּה לִשְׁכֵנֵינוּ לַעַג וָקֶלֶס לִסְבִיבוֹתֵינוּ׃"}]]},{"key":"YY11uVlIIh","he":[[{"t":"תְּשִׂימֵנוּ מָשָׁל בַּגּוֹיִם מְנוֹד־רֹאשׁ בַּל־אֻמִּים׃"}]]},{"key":"-0oRI337xR","he":[[{"t":"כ