ְדוֹר לְכָל־יָבוֹא גְּבוּרָתֶךָ׃"}]]},{"key":"8K8qbONESC","he":[[{"t":"וְצִדְקָתְךָ אֱלֹהִים עַד־מָרוֹם אֲשֶׁר־עָשִׂיתָ גְדֹלוֹת אֱלֹהִים מִי כָמוֹךָ׃"}]]},{"key":"l8t-0qbbCA","he":[[{"t":"אֲשֶׁר הִרְאִיתַנִי צָרוֹת רַבּוֹת וְרָעוֹת תָּשׁוּב תְּחַיֵּינִי וּמִתְּהֹמוֹת הָאָרֶץ תָּשׁוּב תַּעֲלֵנִי׃"}]]},{"key":"1Q6qKO-hwE","he":[[{"t":"תֶּרֶב גְּדֻלָּתִי וְתִסֹּב תְּנַחֲמֵנִי׃"}]]},{"key":"vk1x0AtRxH","he":[[{"t":"גַּם־אֲנִי אוֹדְךָ בִכְלִי־נֶבֶל אֲמִתְּךָ אֱלֹהָי אֲזַמְּרָה לְךָ בְכִנּוֹר קְדוֹשׁ יִשְׂרָאֵל׃"}]]},{"key":"fjeSXvOEUt","he":[[{"t":"תְּרַנֵּנָּה שְׂפָתַי כִּי אֲזַמְּרָה־לָּךְ וְנַפְשִׁי אֲשֶׁר פָּדִיתָ׃"}]]},{"key":"xfaE5N5LeT","he":[[{"t":"גַּם־לְשׁוֹנִי כָּל־הַיּוֹם תֶּהְגֶּה צִדְקָתֶךָ כִּי־בֹשׁוּ כִי־חָפְרוּ מְבַקְשֵׁי רָעָתִי׃"}]]}]},{"title":{"he":"פרק עב","en":"Psalm 72"},"segments":[{"key":"HB-0J0X6-h","he":[[{"t":"לִשְׁלֹמֹה אֱלֹהִים מִשְׁפָּטֶיךָ לְמֶלֶךְ תֵּן וְצִדְקָתְךָ לְבֶן־מֶלֶךְ׃"}]]},{"key":"s88OnRrVFq","he":[[{"t":"יָדִין עַמְּךָ בְצֶדֶק וַעֲנִיֶּיךָ בְמִשְׁפָּט׃"}]]},{"key":"3QDME0eNHx","he":[[{"t":"יִשְׂאוּ הָרִים שָׁלוֹם לָעָם וּגְבָעוֹת בִּצְדָקָה׃"}]]},{"key":"YbYYOAQxNZ","he":[[{"t":"יִשְׁפֹּט עֲנִיֵּי־עָם יוֹשִׁיעַ לִבְנֵי אֶבְיוֹן וִידַכֵּא עוֹשֵׁק׃"}]]},{"key":"09RE6OR0ll","he":[[{"t":"יִירָאוּךָ עִם־שָׁמֶשׁ וְלִפְנֵי יָרֵחַ דּוֹר דּוֹרִים׃"}]]},{"key":"hcTkbBDssG","he":[[{"t":"יֵרֵד כְּמָטָר עַל־גֵּז כִּרְבִיבִים זַרְזִיף אָרֶץ׃"}]]},{"key":"7n7iEOqUQt","he":[[{"t":"יִפְרַח־בְּיָמָיו צַדִּיק וְרֹב שָׁלוֹם עַד־בְּלִי יָרֵחַ׃"}]]},{"key":"74DIJuTMex","he":[[{"t":"וְיֵרְדְּ מִיָּם עַד־יָם וּמִנָּהָר עַד־אַפְסֵי־אָרֶץ׃"}]]},{"key":"OfH6jFbu5Q","he":[[{"t":"לְפָנָיו יִכְרְעוּ צִיִּים וְאֹיְבָיו עָפָר יְלַחֵכוּ׃"}]]},{"key":"R_7JqFAoXp","he":[[{"t":"מַלְכֵי תַרְשִׁישׁ וְאִיִּים מִנְחָה יָשִׁיבוּ מַלְכֵי שְׁבָא וּסְבָא אֶשְׁכָּר יַקְרִיבוּ׃"}]]},{"key":"37OrAC4EMe","he":[[{"t":"וְיִשְׁתַּחֲווּ־לוֹ כָל־מְלָכִים כָּל־גּוֹיִם יַעַבְדוּהוּ׃"}]]},{"key":"8aPqCjFxlx","he":[[{"t":"כִּי־יַצִּיל אֶבְיוֹן מְשַׁוֵּעַ וְעָנִי וְאֵין־עֹזֵר לוֹ׃"}]]},{"key":"QvRQvP5fDg","he":[[{"t":"יָחֹס עַל־דַּל וְאֶבְיוֹן וְנַפְשׁוֹת אֶבְיוֹנִים יוֹשִׁיעַ׃"}]]},{"key":"tszhyaYtQR","he":[[{"t":"מִתּוֹךְ וּמֵחָמָס יִגְאַל נַפְשָׁם וְיֵיקַר דָּמָם בְּעֵינָיו׃"}]]},{"key":"RrAQOsGcB1","he":[[{"t":"וִיחִי וְיִתֶּן־לוֹ מִזְּהַב שְׁבָא וְיִתְפַּלֵּל בַּעֲדוֹ תָמִיד כָּל־הַיּוֹם יְבָרֲכֶנְהוּ׃"}]]},{"key":"nUuU-4-0AM","he":[[{"t":"יְהִי פִסַּת־בַּר בָּאָרֶץ בְּרֹאשׁ הָרִים יִרְעַשׁ כַּלְּבָנוֹן פִּרְיוֹ וְיָצִיצוּ מֵעִיר כְּעֵשֶׂב הָאָרֶץ׃"}]]},{"key":"oqy__KWg6n","he":[[{"t":"יְהִי שְׁמוֹ לְעוֹלָם לִפְנֵי־שֶׁמֶשׁ יִנּוֹן שְׁמוֹ וְיִתְבָּרְכוּ בוֹ כָּל־גּוֹיִם יְאַשְּׁרוּהוּ׃"}]]},{"key":"ISJilLZ1v1","he":[[{"t":"בָּרוּךְ יְהֹוָה אֱלֹהִים אֱלֹהֵי יִשְׂרָאֵל עֹשֵׂה נִפְלָאוֹת לְבַדּוֹ׃"}]]},{"key":"wlv9KdqIDN","he":[[{"t":"וּבָרוּךְ שֵׁם כְּבוֹדוֹ לְעוֹלָם וְיִמָּלֵא כְבוֹדוֹ אֶת־כֹּל הָאָרֶץ אָמֵן וְאָמֵן׃"}]]},{"key":"UC1KmsIGJa","he":[[{"t":"כָּלּוּ תְפִלּוֹת דָּוִד בֶּן־יִשָׁי׃"}]]}]},{"title":{"he":"יהי רצון לאחר ספר שני","en":"After the Second Book"},"optional":{"he":"המסיים ספר שני אומר","en":"Said on finishing the Second Book"},"segments":[{"key":"pFsuKUU6hw.1","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, בִּזְכוּת סֵפֶר שֵׁנִי שֶׁבַּתְּהִלִּים שֶׁקָּרָאנוּ לְפָנֶיךָ, שֶׁהוּא כְּנֶגֶד סֵפֶר שְׁמוֹת בִּזְכוּת מִזְמוֹרָיו, וּבִזְכוּת פְּסוּקָיו, וּבִזְכוּת תֵּבוֹתָיו, וּבִזְכוּת שְׁמוֹתֶיךָ הַקְּדוֹשִׁים וְהַטְּהוֹרִים הַיּוֹצְאִים מִמֶּנּוּ, שֶׁתְּכַפֶּר לָנוּ עַל כָּל חַטֹּאתֵינוּ, וְתִסְלַח לָנוּ עַל כָּל עֲוֹנֹתֵינוּ, וְתִמְחָל לָנוּ עַל כָּל פְּשָׁעֵינוּ, שֶׁחָטָאנוּ וְשֶׁעָוִינוּ וְשֶׁפָּשַׁעְנוּ לְפָנֶיךָ. וְהַחֲזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ, וְהַדְרִיכֵנוּ לַעֲבֹדָתְךָ וְתִפְתַּח לִבֵּנוּ בְּתַלְמוּד תּוֹרָתֶךָ. וְתִשְׁלַח רְפוּאָה שְׁלֵמָה לְחוֹלֵי עַמֶּךָ (ולפב\"פ). וְתִקְרָא לִשְׁבוּיִם דְּרוֹר וְלַאֲסוּרִים פְּקַח קוֹחַ, וּלְכָל הוֹלְכֵי דְּרָכִים וְעוֹבְרֵי יַמִּים וּנְהָרוֹת מֵעַמְּךָ יִשְׂרָאֵל, תַּצִּילֵם מִכָּל צַעַר וְנֶזֶק, וְתַגִּיעֵם לִמְחוֹז חֶפְצָם לְחַיִּים וּלְשָׁלוֹם. וְתִפְקֹד לְכָל חֲשׂוּכֵי בָנִים בְּזֶרַע שֶׁל קַיָּמָא לַעֲבוֹדָתְךָ וּלְיִרְאָתֶךָ. וְעֻבָּרוֹת שֶׁל עַמְּךָ בֵּית יִשְׂרָאֵל תַּצִּילֵן שֶׁלֹּא תַּפֵּלְנָה וַלְדוֹתֵיהֶן. וְהַיּוֹשְׁבוֹת עַל הַמַּשְׁבֵּר, בְּרַחֲמֶיךָ הָרַבִּים תַּצִּילֵן מִכָּל רָע. וְאֶל הַמְּנִיקוֹת תַּשְׁפִּיעַ שֶׁלֹּא יֶחְסַר חָלָב מִדַּדֵּיהֶן. וְאַל יִמְשֹׁל אַסְכָּרָה וְשֵׁדִין וְרוּחִין וְלִילִין וְכָל פְּגָעִים וּמַרְעִין בִּישִׂין בְּכָל יַלְדֵי עַמְּךָ בֵּית יִשְׂרָאֵל. וּתְגַדְּלֵם לְתוֹרָתֶךָ, לִלְמֹד תּוֹרָה לִשְׁמָהּ. וְתַצִּילֵם מֵעַיִן הָרָע וּמִדֶּבֶר וּמִמַּגֵּפָה וּמִשָּׂטָן וּמִיֵּצֶר הָרָע. וּתְבַטֵּל מֵעָלֵינוּ וּמִכָּל עַמְּךָ בֵּית יִשְׂרָאֵל בְּכָל מָקוֹם שֶׁהֵם כָּל גְּזֵרוֹת קָשׁוֹת וְרָעוֹת. וְתַטֶּה לֵב הַמַּלְכוּת עָלֵינוּ לְטוֹבָה, וְתִגְזֹר עָלֵינוּ גְּזֵרוֹת טוֹבוֹת. וְתִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יָדֵינוּ. וְהָכֵן פַּרְנָסָתֵנוּ מִיָּדְךָ הָרְחָבָה וְהַמְּלֵאָה, וְלֹא יִצְטָרְכוּ עַמְּךָ בֵּית יִשְׂרָאֵל זֶה לָזֶה וְלֹא לְעַם אַחֵר. וְתֵן לְכָל אִישׁ וְאִישׁ דֵּי פַּרְנָסָתוֹ, וּלְכָל גְּוִיָּה וּגְוִיָּה דֵּי מַחְסוֹרָהּ. וּתְמַהֵר וְתָחִישׁ לְגָאֳלֵנוּ, וְתִבְנֶה בֵּית מִקְדָּשֵׁנוּ וְתִפְאַרְתֵּנוּ. וּבִזְכוּת שְׁלֹשׁ עֶשְׂרֵה מִדּוֹתֶיךָ שֶׁל רַחֲמִים הַכְּתוּבִים בְּתוֹרָתֶךָ, כְּמוֹ שֶׁנֶּאֱמַר: יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן, אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת׃ נֹצֵר חֶסֶד לָאֲלָפִים, נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה. שֶׁאֵינָן חוֹזְרוֹת רֵיקָם מִלְּפָנֶיךָ, עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ עַל דְּבַר כְּבוֹד שְׁמֶךָ, וְהַצִּילֵנוּ וְכַפֵּר עַל חַטֹּאתֵינוּ לְמַעַן שְׁמֶךָ. בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"פרק עג","en":"Psalm 73"},"headings":[{"he":"ספר שלישי","en":"Third Book","level":1},{"he":"ליום רביעי","en":"Wednesday","level":2}],"chapter":{"he":"ליום רביעי","en":"Wednesday"},"segments":[{"key":"xmpNyuwxwD","he":[[{"t":"מִזְמוֹר לְאָסָף אַךְ טוֹב לְיִשְׂרָאֵל אֱלֹהִים לְבָרֵי לֵבָב׃"}]]},{"key":"X8Yt2mH7Ol","he":[[{"t":"וַאֲנִי כִּמְעַט נָטָיוּ רַגְלָי כְּאַיִן שֻׁפְּכוּ אֲשֻׁרָי׃"}]]},{"key":"xwuZB53h_N","he":[[{"t":"כִּי־קִנֵּאתִי בַּהוֹלְלִים שְׁלוֹם רְשָׁעִים אֶרְאֶה׃"}]]},{"key":"klh75Sy6Iy","he":[[{"t":"כִּי אֵין חַרְצֻבּוֹת לְמוֹתָם וּבָרִיא אוּלָם׃"}]]},{"key":"8CUj_t2gq4","he":[[{"t":"בַּעֲמַל אֱנוֹשׁ אֵינֵמוֹ וְעִם־אָדָם לֹא יְנֻגָּעוּ׃"}]]},{"key":"0iyg5osJue","he":[[{"t":"לָכֵן עֲנָקַתְמוֹ גַאֲוָה יַעֲטָף־שִׁית חָמָס לָמוֹ׃"}]]},{"key":"x2EbD7ByZH","he":[[{"t":"יָצָא מֵחֵלֶב עֵינֵמוֹ עָבְרוּ מַשְׂכִּיּוֹת לֵבָב׃"}]]},{"key":"aBr6io4jb_","he":[[{"t":"יָמִיקוּ וִידַבְּרוּ בְרָע עֹשֶׁק מִמָּרוֹם יְדַבֵּרוּ׃"}]]},{"key":"fw3k6Cgr_h","he":[[{"t":"שַׁתּוּ בַשָּׁמַיִם פִּיהֶם וּלְשׁוֹנָם תִּהֲלַךְ בָּאָרֶץ׃"}]]},{"key":"0yUIAVFhuL","he":[[{"t":"לָכֵן יָשׁוּב עַמּוֹ הֲלֹם וּמֵי מָלֵא יִמָּצוּ לָמוֹ׃"}]]},{"key":"okEmGjBKOP","he":[[{"t":"וְאָמְרוּ אֵיכָה יָדַע־אֵל וְיֵשׁ דֵּעָה בְעֶלְיוֹן׃"}]]},{"key":"EF2hsRcOuh","he":[[{"t":"הִנֵּה־אֵלֶּה רְשָׁעִים וְשַׁלְוֵי עוֹלָם הִשְׂגּוּ־חָיִל׃"}]]},{"key":"kg7bfCSCCJ","he":[[{"t":"אַךְ־רִיק זִכִּיתִי לְבָבִי וָאֶרְחַץ בְּנִקָּיוֹן כַּפָּי׃"}]]},{"key":"cRaPFd34uF","he":[[{"t":"וָאֱהִי נָגוּעַ כָּל־הַיּוֹם וְתוֹכַחְתִּי לַבְּקָרִים׃"}]]},{"key":"WZsLPaHgo1","he":[[{"t":"אִם־אָמַרְתִּי אֲסַפְּרָה כְמוֹ הִנֵּה דוֹר בָּנֶיךָ בָגָדְתִּי׃"}]]},{"key":"2px4EDDtiZ","he":[[{"t":"וָאֲחַשְּׁבָה לָדַעַת זֹאת עָמָל הוּא בְעֵינָי׃"}]]},{"key":"3dACI-Ou1Z","he":[[{"t":"עַד־אָבוֹא אֶל־מִקְדְּשֵׁי־אֵל אָבִינָה לְאַחֲרִיתָם׃"}]]},{"key":"ATEobqkfaZ","he":[[{"t":"אַךְ בַּחֲלָקוֹת תָּשִׁית לָמוֹ הִפַּלְתָּם לְמַשּׁוּאוֹת׃"}]]},{"key":"g61JXu_cOl","he":[[{"t":"אֵיךְ הָיוּ לְשַׁמָּה כְרָגַע סָפוּ תַמּוּ מִן־בַּלָּהוֹת׃"}]]},{"key":"ZYAFeag7GQ","he":[[{"t":"כַּחֲלוֹם מֵהָקִיץ אֲדֹנָי בָּעִיר צַלְמָם תִּבְזֶה׃"}]]},{"key":"MnY6XtlIxP","he":[[{"t":"כִּי יִתְחַמֵּץ לְבָבִי וְכִלְיוֹתַי אֶשְׁתּוֹנָן׃"}]]},{"key":"e8dS9z5235","he":[[{"t":"וַאֲנִי־בַעַר וְלֹא אֵדָע בְּהֵמוֹת הָיִיתִי עִמָּךְ׃"}]]},{"key":"fmFnzJnvjg","he":[[{"t":"וַאֲנִי תָמִיד עִמָּךְ אָחַזְתָּ בְּיַד־יְמִינִי׃"}]]},{"key":"boX0fpe7p6","he":[[{"t":"בַּעֲצָתְךָ תַנְחֵנִי וְאַחַר כָּבוֹד תִּקָּחֵנִי׃"}]]},{"key":"O7QzfeZod2","he":[[{"t":"מִי־לִי בַשָּׁמָיִם וְעִמְּךָ לֹא־חָפַצְתִּי בָאָרֶץ׃"}]]},{"key":"bGXCpWjoOZ","he":[[{"t":"כָּלָה שְׁאֵרִי וּלְבָבִי צוּר־לְבָבִי וְחֶלְקִי אֱלֹהִים לְעוֹלָם׃"}]]},{"key":"SpYNAHXUbB","he":[[{"t":"כִּי־הִנֵּה רְחֵקֶיךָ יֹאבֵדוּ הִצְמַתָּה כָּל־זוֹנֶה מִמֶּךָּ׃"}]]},{"key":"iyLhiABwdL","he":[[{"t":"וַאֲנִי קִרֲבַת אֱלֹהִים לִי־טוֹב שַׁתִּי בַּאדֹנָי יְהֹוִה מַחְסִי לְסַפֵּר כָּל־מַלְאֲכוֹתֶיךָ׃"}]]}]},{"title":{"he":"פרק עד","en":"Psalm 74"},"segments":[{"key":"mUFBlPzZWD","he":[[{"t":"מַשְׂכִּיל לְאָסָף לָמָה אֱלֹהִים זָנַחְתָּ לָנֶצַח יֶעְשַׁן אַפְּךָ בְּצֹאן מַרְעִיתֶךָ׃"}]]},{"key":"C27C9rXHLG","he":[[{"t":"זְכֹר עֲדָתְךָ קָנִיתָ קֶּדֶם גָּאַלְתָּ שֵׁבֶט נַחֲלָתֶךָ הַר־צִיּוֹן זֶה שָׁכַנְתָּ בּוֹ׃"}]]},{"key":"bH0NfEk1NK","he":[[{"t":"הָרִימָה פְעָמֶיךָ לְמַשֻּׁאוֹת נֶצַח כָּל־הֵרַע אוֹיֵב בַּקֹּדֶשׁ׃"}]]},{"key":"_CvR1g7k8i","he":[[{"t":"שָׁאֲגוּ צֹרְרֶיךָ בְּקֶרֶב מוֹעֲדֶךָ שָׂמוּ אוֹתֹתָם אֹתוֹת׃"}]]},{"key":"17IBSCLpBn","he":[[{"t":"יִוָּדַע כְּמֵבִיא לְמָעְלָה בִּסֲבָךְ־עֵץ קַרְדֻּמּוֹת׃"}]]},{"key":"ikTemoJ-pK","he":[[{"t":"וְעַתָּה פִּתּוּחֶיהָ יָּחַד בְּכַשִּׁיל וְכֵילַפֹּת יַהֲלֹמוּן׃"}]]},{"key":"uii6YRwzeo","he":[[{"t":"שִׁלְחוּ בָאֵשׁ מִקְדָּשֶׁךָ לָאָרֶץ חִלְּלוּ מִשְׁכַּן־שְׁמֶךָ׃"}]]},{"key":"dxe_jz-YnX","he":[[{"t":"אָמְרוּ בְלִבָּם נִינָם יָחַד שָׂרְפוּ כָל־מוֹעֲדֵי־אֵל בָּאָרֶץ׃"}]]},{"key":"P-gozF6HQ_","he":[[{"t":"אוֹתֹתֵינוּ לֹא רָאִינוּ אֵין־עוֹד נָבִיא וְלֹא־אִתָּנוּ יֹדֵעַ עַד־מָה׃"}]]},{"key":"E4dqSlOzHc","he":[[{"t":"עַד־מָתַי אֱלֹהִים יְחָרֶף צָר יְנָאֵץ אוֹיֵב שִׁמְךָ לָנֶצַח׃"}]]},{"key":"aZED9VH0EU","he":[[{"t":"לָמָּה תָשִׁיב יָדְךָ וִימִינֶךָ מִקֶּרֶב חֵיקְךָ כַלֵּה׃"}]]},{"key":"IACMa9nrFl","he":[[{"t":"וֵאלֹהִים מַלְכִּי מִקֶּדֶם פֹּעֵל יְשׁוּעוֹת בְּקֶרֶב הָאָרֶץ׃"}]]},{"key":"ldSa5VAh3e","he":[[{"t":"אַתָּה פוֹרַרְתָּ בְעָזְּךָ יָם שִׁבַּרְתָּ רָאשֵׁי תַנִּינִים עַל־הַמָּיִם׃"}]]},{"key":"hCthClSh5d","he":[[{"t":"אַתָּה רִצַּצְתָּ רָאשֵׁי לִ