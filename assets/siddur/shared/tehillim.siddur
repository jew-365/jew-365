B4Xzi4DnMJ","he":[[{"t":"אַף־אָנִי בְּכוֹר אֶתְּנֵהוּ עֶלְיוֹן לְמַלְכֵי־אָרֶץ׃"}]]},{"key":"odgulOYpn1","he":[[{"t":"לְעוֹלָם אֶשְׁמָר־לוֹ חַסְדִּי וּבְרִיתִי נֶאֱמֶנֶת לוֹ׃"}]]},{"key":"nzVt05lmkt","he":[[{"t":"וְשַׂמְתִּי לָעַד זַרְעוֹ וְכִסְאוֹ כִּימֵי שָׁמָיִם׃"}]]},{"key":"WJCKRyrQLb","he":[[{"t":"אִם־יַעַזְבוּ בָנָיו תּוֹרָתִי וּבְמִשְׁפָּטַי לֹא יֵלֵכוּן׃"}]]},{"key":"YXr44Izqrt","he":[[{"t":"אִם־חֻקֹּתַי יְחַלֵּלוּ וּמִצְוֺתַי לֹא יִשְׁמֹרוּ׃"}]]},{"key":"oBDh9Oa-kp","he":[[{"t":"וּפָקַדְתִּי בְשֵׁבֶט פִּשְׁעָם וּבִנְגָעִים עֲוֺנָם׃"}]]},{"key":"8UdWMWkNGT","he":[[{"t":"וְחַסְדִּי לֹא־אָפִיר מֵעִמּוֹ וְלֹא־אֲשַׁקֵּר בֶּאֱמוּנָתִי׃"}]]},{"key":"osGDFsL-22","he":[[{"t":"לֹא־אֲחַלֵּל בְּרִיתִי וּמוֹצָא שְׂפָתַי לֹא אֲשַׁנֶּה׃"}]]},{"key":"FgfJGl4_7c","he":[[{"t":"אַחַת נִשְׁבַּעְתִּי בְקָדְשִׁי אִם־לְדָוִד אֲכַזֵּב׃"}]]},{"key":"tEb4lSbLma","he":[[{"t":"זַרְעוֹ לְעוֹלָם יִהְיֶה וְכִסְאוֹ כַשֶּׁמֶשׁ נֶגְדִּי׃"}]]},{"key":"H0KeIY2ii3","he":[[{"t":"כְּיָרֵחַ יִכּוֹן עוֹלָם וְעֵד בַּשַּׁחַק נֶאֱמָן סֶלָה׃"}]]},{"key":"h35o1dnMFF","he":[[{"t":"וְאַתָּה זָנַחְתָּ וַתִּמְאָס הִתְעַבַּרְתָּ עִם־מְשִׁיחֶךָ׃"}]]},{"key":"1J0Bjw3I-Q","he":[[{"t":"נֵאַרְתָּה בְּרִית עַבְדֶּךָ חִלַּלְתָּ לָאָרֶץ נִזְרוֹ׃"}]]},{"key":"V9eTkyodfo","he":[[{"t":"פָּרַצְתָּ כָל־גְּדֵרֹתָיו שַׂמְתָּ מִבְצָרָיו מְחִתָּה׃"}]]},{"key":"I2yrTpX3kH","he":[[{"t":"שַׁסֻּהוּ כָּל־עֹבְרֵי דָרֶךְ הָיָה חֶרְפָּה לִשְׁכֵנָיו׃"}]]},{"key":"EvBfwGHOJC","he":[[{"t":"הֲרִימוֹתָ יְמִין צָרָיו הִשְׂמַחְתָּ כָּל־אוֹיְבָיו׃"}]]},{"key":"kyV2awmtwt","he":[[{"t":"אַף־תָּשִׁיב צוּר חַרְבּוֹ וְלֹא הֲקֵימֹתוֹ בַּמִּלְחָמָה׃"}]]},{"key":"zxAED927eu","he":[[{"t":"הִשְׁבַּתָּ מִטְּהָרוֹ וְכִסְאוֹ לָאָרֶץ מִגַּרְתָּה׃"}]]},{"key":"460vvyffTZ","he":[[{"t":"הִקְצַרְתָּ יְמֵי עֲלוּמָיו הֶעֱטִיתָ עָלָיו בּוּשָׁה סֶלָה׃"}]]},{"key":"EZSB0yt_zd","he":[[{"t":"עַד־מָה יְהֹוָה תִּסָּתֵר לָנֶצַח תִּבְעַר כְּמוֹ־אֵשׁ חֲמָתֶךָ׃"}]]},{"key":"B1o_fH09Cc","he":[[{"t":"זְכָר־אֲנִי מֶה־חָלֶד עַל־מַה־שָּׁוְא בָּרָאתָ כָל־בְּנֵי־אָדָם׃"}]]},{"key":"G9IECkO6Zu","he":[[{"t":"מִי גֶבֶר יִחְיֶה וְלֹא יִרְאֶה־מָּוֶת יְמַלֵּט נַפְשׁוֹ מִיַּד־שְׁאוֹל סֶלָה׃"}]]},{"key":"23raIaJrv1","he":[[{"t":"אַיֵּה חֲסָדֶיךָ הָרִאשֹׁנִים אֲדֹנָי נִשְׁבַּעְתָּ לְדָוִד בֶּאֱמוּנָתֶךָ׃"}]]},{"key":"uC8kbpdxbF","he":[[{"t":"זְכֹר אֲדֹנָי חֶרְפַּת עֲבָדֶיךָ שְׂאֵתִי בְחֵיקִי כָּל־רַבִּים עַמִּים׃"}]]},{"key":"p3BjXyl1ta","he":[[{"t":"אֲשֶׁר חֵרְפוּ אוֹיְבֶיךָ יְהֹוָה אֲשֶׁר חֵרְפוּ עִקְּבוֹת מְשִׁיחֶךָ׃"}]]},{"key":"AJNx9uqFbh","he":[[{"t":"בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"יהי רצון לאחר ספר שלישי","en":"After the Third Book"},"optional":{"he":"המסיים ספר שלישי אומר","en":"Said on finishing the Third Book"},"segments":[{"key":"pFsuKUU6hw.2","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, בִּזְכוּת סֵפֶר שְׁלִישִׁי שֶׁבַּתְּהִלִּים שֶׁקָּרָאנוּ לְפָנֶיךָ, שֶׁהוּא כְּנֶגֶד סֵפֶר וַיִּקְרָא בִּזְכוּת מִזְמוֹרָיו, וּבִזְכוּת פְּסוּקָיו, וּבִזְכוּת תֵּבוֹתָיו, וּבִזְכוּת שְׁמוֹתֶיךָ הַקְּדוֹשִׁים וְהַטְּהוֹרִים הַיּוֹצְאִים מִמֶּנּוּ, שֶׁתְּכַפֶּר לָנוּ עַל כָּל חַטֹּאתֵינוּ, וְתִסְלַח לָנוּ עַל כָּל עֲוֹנֹתֵינוּ, וְתִמְחָל לָנוּ עַל כָּל פְּשָׁעֵינוּ, שֶׁחָטָאנוּ וְשֶׁעָוִינוּ וְשֶׁפָּשַׁעְנוּ לְפָנֶיךָ. וְהַחֲזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ, וְהַדְרִיכֵנוּ לַעֲבֹדָתְךָ וְתִפְתַּח לִבֵּנוּ בְּתַלְמוּד תּוֹרָתֶךָ. וְתִשְׁלַח רְפוּאָה שְׁלֵמָה לְחוֹלֵי עַמֶּךָ (ולפב\"פ). וְתִקְרָא לִשְׁבוּיִם דְּרוֹר וְלַאֲסוּרִים פְּקַח קוֹחַ, וּלְכָל הוֹלְכֵי דְּרָכִים וְעוֹבְרֵי יַמִּים וּנְהָרוֹת מֵעַמְּךָ יִשְׂרָאֵל, תַּצִּילֵם מִכָּל צַעַר וְנֶזֶק, וְתַגִּיעֵם לִמְחוֹז חֶפְצָם לְחַיִּים וּלְשָׁלוֹם. וְתִפְקֹד לְכָל חֲשׂוּכֵי בָנִים בְּזֶרַע שֶׁל קַיָּמָא לַעֲבוֹדָתְךָ וּלְיִרְאָתֶךָ. וְעֻבָּרוֹת שֶׁל עַמְּךָ בֵּית יִשְׂרָאֵל תַּצִּילֵן שֶׁלֹּא תַּפֵּלְנָה וַלְדוֹתֵיהֶן. וְהַיּוֹשְׁבוֹת עַל הַמַּשְׁבֵּר, בְּרַחֲמֶיךָ הָרַבִּים תַּצִּילֵן מִכָּל רָע. וְאֶל הַמְּנִיקוֹת תַּשְׁפִּיעַ שֶׁלֹּא יֶחְסַר חָלָב מִדַּדֵּיהֶן. וְאַל יִמְשֹׁל אַסְכָּרָה וְשֵׁדִין וְרוּחִין וְלִילִין וְכָל פְּגָעִים וּמַרְעִין בִּישִׂין בְּכָל יַלְדֵי עַמְּךָ בֵּית יִשְׂרָאֵל. וּתְגַדְּלֵם לְתוֹרָתֶךָ, לִלְמֹד תּוֹרָה לִשְׁמָהּ. וְתַצִּילֵם מֵעַיִן הָרָע וּמִדֶּבֶר וּמִמַּגֵּפָה וּמִשָּׂטָן וּמִיֵּצֶר הָרָע. וּתְבַטֵּל מֵעָלֵינוּ וּמִכָּל עַמְּךָ בֵּית יִשְׂרָאֵל בְּכָל מָקוֹם שֶׁהֵם כָּל גְּזֵרוֹת קָשׁוֹת וְרָעוֹת. וְתַטֶּה לֵב הַמַּלְכוּת עָלֵינוּ לְטוֹבָה, וְתִגְזֹר עָלֵינוּ גְּזֵרוֹת טוֹבוֹת. וְתִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יָדֵינוּ. וְהָכֵן פַּרְנָסָתֵנוּ מִיָּדְךָ הָרְחָבָה וְהַמְּלֵאָה, וְלֹא יִצְטָרְכוּ עַמְּךָ בֵּית יִשְׂרָאֵל זֶה לָזֶה וְלֹא לְעַם אַחֵר. וְתֵן לְכָל אִישׁ וְאִישׁ דֵּי פַּרְנָסָתוֹ, וּלְכָל גְּוִיָּה וּגְוִיָּה דֵּי מַחְסוֹרָהּ. וּתְמַהֵר וְתָחִישׁ לְגָאֳלֵנוּ, וְתִבְנֶה בֵּית מִקְדָּשֵׁנוּ וְתִפְאַרְתֵּנוּ. וּבִזְכוּת שְׁלֹשׁ עֶשְׂרֵה מִדּוֹתֶיךָ שֶׁל רַחֲמִים הַכְּתוּבִים בְּתוֹרָתֶךָ, כְּמוֹ שֶׁנֶּאֱמַר: יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן, אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת׃ נֹצֵר חֶסֶד לָאֲלָפִים, נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה. שֶׁאֵינָן חוֹזְרוֹת רֵיקָם מִלְּפָנֶיךָ, עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ עַל דְּבַר כְּבוֹד שְׁמֶךָ, וְהַצִּילֵנוּ וְכַפֵּר עַל חַטֹּאתֵינוּ לְמַעַן שְׁמֶךָ. בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"פרק צ","en":"Psalm 90"},"headings":[{"he":"ספר רביעי","en":"Fourth Book","level":1},{"he":"ליום חמישי","en":"Thursday","level":2}],"chapter":{"he":"ליום חמישי","en":"Thursday"},"segments":[{"key":"tDO9GNImjV","he":[[{"t":"תְּפִלָּה לְמֹשֶׁה אִישׁ־הָאֱלֹהִים אֲדֹנָי מָעוֹן אַתָּה הָיִיתָ לָּנוּ בְּדֹר וָדֹר׃"}]]},{"key":"eOxZJ4Y0rH","he":[[{"t":"בְּטֶרֶם הָרִים יֻלָּדוּ וַתְּחוֹלֵל אֶרֶץ וְתֵבֵל וּמֵעוֹלָם עַד־עוֹלָם אַתָּה אֵל׃"}]]},{"key":"jueDo4qY45","he":[[{"t":"תָּשֵׁב אֱנוֹשׁ עַד־דַּכָּא וַתֹּאמֶר שׁוּבוּ בְנֵי־אָדָם׃"}]]},{"key":"quV9Q6WIxX","he":[[{"t":"כִּי אֶלֶף שָׁנִים בְּעֵינֶיךָ כְּיוֹם אֶתְמוֹל כִּי יַעֲבֹר וְאַשְׁמוּרָה בַלָּיְלָה׃"}]]},{"key":"CFnXoU-W8n","he":[[{"t":"זְרַמְתָּם שֵׁנָה יִהְיוּ בַּבֹּקֶר כֶּחָצִיר יַחֲלֹף׃"}]]},{"key":"zsavUI1cUo","he":[[{"t":"בַּבֹּקֶר יָצִיץ וְחָלָף לָעֶרֶב יְמוֹלֵל וְיָבֵשׁ׃"}]]},{"key":"mxsGfDxgIW","he":[[{"t":"כִּי־כָלִינוּ בְאַפֶּךָ וּבַחֲמָתְךָ נִבְהָלְנוּ׃"}]]},{"key":"QAgsd_5MYc","he":[[{"t":"שַׁתָּה עֲוֺנֹתֵינוּ לְנֶגְדֶּךָ עֲלֻמֵנוּ לִמְאוֹר פָּנֶיךָ׃"}]]},{"key":"khbWCxKcFm","he":[[{"t":"כִּי כָל־יָמֵינוּ פָּנוּ בְעֶבְרָתֶךָ כִּלִּינוּ שָׁנֵינוּ כְמוֹ־הֶגֶה׃"}]]},{"key":"iKtLe6LkII","he":[[{"t":"יְמֵי־שְׁנוֹתֵינוּ בָהֶם שִׁבְעִים שָׁנָה וְאִם בִּגְבוּרֹת שְׁמוֹנִים שָׁנָה וְרָהְבָּם עָמָל וָאָוֶן כִּי־גָז חִישׁ וַנָּעֻפָה׃"}]]},{"key":"XWaUMVmj6G","he":[[{"t":"מִי־יוֹדֵעַ עֹז אַפֶּךָ וּכְיִרְאָתְךָ עֶבְרָתֶךָ׃"}]]},{"key":"C-1GxOKJUK","he":[[{"t":"לִמְנוֹת יָמֵינוּ כֵּן הוֹדַע וְנָבִא לְבַב חָכְמָה׃"}]]},{"key":"DDJNHy-rLJ","he":[[{"t":"שׁוּבָה יְהֹוָה עַד־מָתָי וְהִנָּחֵם עַל־עֲבָדֶיךָ׃"}]]},{"key":"dHFZRqKQDt","he":[[{"t":"שַׂבְּעֵנוּ בַבֹּקֶר חַסְדֶּךָ וּנְרַנְּנָה וְנִשְׂמְחָה בְּכָל־יָמֵינוּ׃"}]]},{"key":"t5mvQ90OB7","he":[[{"t":"שַׂמְּחֵנוּ כִּימוֹת עִנִּיתָנוּ שְׁנוֹת רָאִינוּ רָעָה׃"}]]},{"key":"R6ru5WZqdJ","he":[[{"t":"יֵרָאֶה אֶל־עֲבָדֶיךָ פָעֳלֶךָ וַהֲדָרְךָ עַל־בְּנֵיהֶם׃"}]]},{"key":"7wpTU8Qm70","he":[[{"t":"וִיהִי נֹעַם אֲדֹנָי אֱלֹהֵינוּ עָלֵינוּ וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנָה עָלֵינוּ וּמַעֲשֵׂה יָדֵינוּ כּוֹנְנֵהוּ׃"}]]}]},{"title":{"he":"פרק צא","en":"Psalm 91"},"segments":[{"key":"DoFZehbsQw","he":[[{"t":"יֹשֵׁב בְּסֵתֶר עֶלְיוֹן בְּצֵל שַׁדַּי יִתְלוֹנָן׃"}]]},{"key":"r3huuycdvd","he":[[{"t":"אֹמַר לַיהֹוָה מַחְסִי וּמְצוּדָתִי אֱלֹהַי אֶבְטַח־בּוֹ׃"}]]},{"key":"4ml73Lnct7","he":[[{"t":"כִּי הוּא יַצִּילְךָ מִפַּח יָקוּשׁ מִדֶּבֶר הַוּוֹת׃"}]]},{"key":"R5UeJaccW2","he":[[{"t":"בְּאֶבְרָתוֹ יָסֶךְ לָךְ וְתַחַת־כְּנָפָיו תֶּחְסֶה צִנָּה וְסֹחֵרָה אֲמִתּוֹ׃"}]]},{"key":"-lfSm0vxOz","he":[[{"t":"לֹא־תִירָא מִפַּחַד לָיְלָה מֵחֵץ יָעוּף יוֹמָם׃"}]]},{"key":"by-y77sU9m","he":[[{"t":"מִדֶּבֶר בָּאֹפֶל יַהֲלֹךְ מִקֶּטֶב יָשׁוּד צָהֳרָיִם׃"}]]},{"key":"psc5d_Uesq","he":[[{"t":"יִפֹּל מִצִּדְּךָ אֶלֶף וּרְבָבָה מִימִינֶךָ אֵלֶיךָ לֹא יִגָּשׁ׃"}]]},{"key":"8Cp46btEXC","he":[[{"t":"רַק בְּעֵינֶיךָ תַבִּיט וְשִׁלֻּמַת רְשָׁעִים תִּרְאֶה׃"}]]},{"key":"DC5l23t0gz","he":[[{"t":"כִּי־אַתָּה יְהֹוָה מַחְסִי עֶלְיוֹן שַׂמְתָּ מְעוֹנֶךָ׃"}]]},{"key":"mz7OKy7aou","he":[[{"t":"לֹא־תְאֻנֶּה אֵלֶיךָ רָעָה וְנֶגַע לֹא־יִקְרַב בְּאָהֳלֶךָ׃"}]]},{"key":"KmGrirJzvJ","he":[[{"t":"כִּי מַלְאָכָיו יְצַוֶּה־לָּךְ לִשְׁמָרְךָ בְּכָל־דְּרָכֶיךָ׃"}]]},{"key":"dKJmFYxY-Y","he":[[{"t":"עַל־כַּפַּיִם יִשָּׂאוּנְךָ פֶּן־תִּגֹּף בָּאֶבֶן רַגְלֶךָ׃"}]]},{"key":"-f5Md-ooTN","he":[[{"t":"עַל־שַׁחַל וָפֶתֶן תִּדְרֹךְ תִּרְמֹס כְּפִיר וְתַנִּין׃"}]]},{"key":"blLsbMpXYu","he":[[{"t":"כִּי בִי חָשַׁק וַאֲפַלְּטֵהוּ אֲשַׂגְּבֵהוּ כִּי־יָדַע שְׁמִי׃"}]]},{"key":"HMscVxuQIL","he":[[{"t":"יִקְרָאֵנִי וְאֶעֱנֵהוּ עִמּוֹ־אָנֹכִי בְצָרָה אֲחַלְּצֵהוּ וַאֲכַבְּדֵהוּ׃"}]]},{"key":"Okd2vdnQ9w","he":[[{"t":"אֹרֶךְ יָמִים אַשְׂבִּיעֵהוּ וְאַרְאֵהוּ בִּישׁוּעָתִי׃"}]]}]},{"title":{"he":"פרק צב","en":"Psalm 92"},"segments":[{"key":"oBLzlfxlnN","he":[[{"t":"מִזְמוֹר שִׁיר לְיוֹם הַשַּׁבָּת׃"}]]},{"key":"oFy71xuOHc","he":[[{"t":"טוֹב לְהֹדוֹת לַיהֹוָה וּלְזַמֵּר לְשִׁמְךָ עֶלְיוֹן׃"}]]},{"key":"lY1uQsQTeq","he":[[{"t":"לְהַגִּיד בַּבֹּקֶר חַסְדֶּךָ וֶאֱמוּנָתְךָ בַּלֵּילוֹת׃"}]]},{"key":"9KlM1ZBZod","he":[[{"t":"עֲלֵי־עָשׂוֹר וַעֲלֵי־נָבֶל עֲלֵי הִגָּיוֹן בְּכִנּוֹר׃"}]]},{"key":"kVG4BR8Qe5","he":[[{"t":"כִּי שִׂמַּחְתַּנִי יְהֹוָה בְּפָעֳלֶךָ בְּמַעֲשֵׂי יָדֶיךָ אֲרַנֵּן׃"}]]},{"key":"f5kpGoTnYb","he":[[{"t":"מַה־גָּדְלוּ מַעֲשֶׂיךָ יְהֹוָה מְאֹד עָמְקוּ מַחְשְׁבֹתֶיךָ׃"}]]},{"key":"Tsg9WxyDD9","he":[[{"t":"אִישׁ־בַּעַר לֹא יֵדָע וּכְסִיל לֹא־יָבִין אֶת־זֹאת׃"}]]},{"key":"SPbc0zFAwi","he":[[{"t":"בִּפְרֹחַ רְשָׁעִים כְּמוֹ עֵשֶׂב וַיָּצִיצוּ כָּל־פֹּעֲלֵי אָוֶן לְהִשָּׁמְדָם עֲדֵי־עַד׃"}]]},{"key":"cErGfXvNWn","he":[[{"t":"וְאַתָּה מָרוֹם לְעֹלָם יְהֹוָה׃"}]]},{"key":"16obq8omz8","he":[[{"t":"כִּי הִנֵּה אֹיְבֶיךָ יְהֹוָה כִּי־הִנֵּה אֹיְבֶיךָ יֹאבֵדוּ יִתְפָּרְדוּ כָּל־פֹּעֲלֵי אָוֶן׃"}]]},{"key":"qt5Tu1-t_k","he":[[{"t":"וַתָּרֶם כִּרְאֵים קַרְנִי בַּלֹּתִי בְּשֶׁמֶן רַעֲ