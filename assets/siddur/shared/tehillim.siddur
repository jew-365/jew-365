ים בַּיְתָה מוֹצִיא אֲסִירִים בַּכּוֹשָׁרוֹת אַךְ סוֹרֲרִים שָׁכְנוּ צְחִיחָה׃"}]]},{"key":"BS_48o1rZw","he":[[{"t":"אֱלֹהִים בְּצֵאתְךָ לִפְנֵי עַמֶּךָ בְּצַעְדְּךָ בִישִׁימוֹן סֶלָה׃"}]]},{"key":"hNZEKdl28e","he":[[{"t":"אֶרֶץ רָעָשָׁה אַף־שָׁמַיִם נָטְפוּ מִפְּנֵי אֱלֹהִים זֶה סִינַי מִפְּנֵי אֱלֹהִים אֱלֹהֵי יִשְׂרָאֵל׃"}]]},{"key":"e097wzX62k","he":[[{"t":"גֶּשֶׁם נְדָבוֹת תָּנִיף אֱלֹהִים נַחֲלָתְךָ וְנִלְאָה אַתָּה כוֹנַנְתָּהּ׃"}]]},{"key":"KAWUiGmqxJ","he":[[{"t":"חַיָּתְךָ יָשְׁבוּ־בָהּ תָּכִין בְּטוֹבָתְךָ לֶעָנִי אֱלֹהִים׃"}]]},{"key":"wvbS45bEgd","he":[[{"t":"אֲדֹנָי יִתֶּן־אֹמֶר הַמְבַשְּׂרוֹת צָבָא רָב׃"}]]},{"key":"IEGFSRtCf1","he":[[{"t":"מַלְכֵי צְבָאוֹת יִדֹּדוּן יִדֹּדוּן וּנְוַת בַּיִת תְּחַלֵּק שָׁלָל׃"}]]},{"key":"XU7qXGH_5t","he":[[{"t":"אִם־תִּשְׁכְּבוּן בֵּין שְׁפַתָּיִם כַּנְפֵי יוֹנָה נֶחְפָּה בַכֶּסֶף וְאֶבְרוֹתֶיהָ בִּירַקְרַק חָרוּץ׃"}]]},{"key":"dxaO6zEHJO","he":[[{"t":"בְּפָרֵשׂ שַׁדַּי מְלָכִים בָּהּ תַּשְׁלֵג בְּצַלְמוֹן׃"}]]},{"key":"Kyhg38GmnC","he":[[{"t":"הַר־אֱלֹהִים הַר־בָּשָׁן הַר גַּבְנֻנִּים הַר־בָּשָׁן׃"}]]},{"key":"Ig8DP_VpTB","he":[[{"t":"לָמָּה תְּרַצְּדוּן הָרִים גַּבְנֻנִּים הָהָר חָמַד אֱלֹהִים לְשִׁבְתּוֹ אַף־יְהֹוָה יִשְׁכֹּן לָנֶצַח׃"}]]},{"key":"jrt3shb8hX","he":[[{"t":"רֶכֶב אֱלֹהִים רִבֹּתַיִם אַלְפֵי שִׁנְאָן אֲדֹנָי בָם סִינַי בַּקֹּדֶשׁ׃"}]]},{"key":"U3FpDccG3h","he":[[{"t":"עָלִיתָ לַמָּרוֹם שָׁבִיתָ שֶּׁבִי לָקַחְתָּ מַתָּנוֹת בָּאָדָם וְאַף סוֹרְרִים לִשְׁכֹּן יָהּ אֱלֹהִים׃"}]]},{"key":"RZwNuD2lyf","he":[[{"t":"בָּרוּךְ אֲדֹנָי יוֹם יוֹם יַעֲמָס־לָנוּ הָאֵל יְשׁוּעָתֵנוּ סֶלָה׃"}]]},{"key":"FkLumdGs-M","he":[[{"t":"הָאֵל לָנוּ אֵל לְמוֹשָׁעוֹת וְלֵיהוִה אֲדֹנָי לַמָּוֶת תּוֹצָאוֹת׃"}]]},{"key":"gTbwps55mx","he":[[{"t":"אַךְ־אֱלֹהִים יִמְחַץ רֹאשׁ אֹיְבָיו קָדְקֹד שֵׂעָר מִתְהַלֵּךְ בַּאֲשָׁמָיו׃"}]]},{"key":"Bwq1IvoU2-","he":[[{"t":"אָמַר אֲדֹנָי מִבָּשָׁן אָשִׁיב אָשִׁיב מִמְּצֻלוֹת יָם׃"}]]},{"key":"LgrGm6JUUG","he":[[{"t":"לְמַעַן תִּמְחַץ רַגְלְךָ בְּדָם לְשׁוֹן כְּלָבֶיךָ מֵאֹיְבִים מִנֵּהוּ׃"}]]},