ְאוּ לְמֹשֶׁה בַּמַּחֲנֶה לְאַהֲרֹן קְדוֹשׁ יְהֹוָה׃"}]]},{"key":"y4HHYgY0k6","he":[[{"t":"תִּפְתַּח־אֶרֶץ וַתִּבְלַע דָּתָן וַתְּכַס עַל־עֲדַת אֲבִירָם׃"}]]},{"key":"-b4Mm8XGjM","he":[[{"t":"וַתִּבְעַר־אֵשׁ בַּעֲדָתָם לֶהָבָה תְּלַהֵט רְשָׁעִים׃"}]]},{"key":"6xfHArbFoJ","he":[[{"t":"יַעֲשׂוּ־עֵגֶל בְּחֹרֵב וַיִּשְׁתַּחֲווּ לְמַסֵּכָה׃"}]]},{"key":"l5NqnnsWG_","he":[[{"t":"וַיָּמִירוּ אֶת־כְּבוֹדָם בְּתַבְנִית שׁוֹר אֹכֵל עֵשֶׂב׃"}]]},{"key":"ALe6BYhda3","he":[[{"t":"שָׁכְחוּ אֵל מוֹשִׁיעָם עֹשֶׂה גְדֹלוֹת בְּמִצְרָיִם׃"}]]},{"key":"rE9F-Zqyxi","he":[[{"t":"נִפְלָאוֹת בְּאֶרֶץ חָם נוֹרָאוֹת עַל־יַם־סוּף׃"}]]},{"key":"ueJTabPiXR","he":[[{"t":"וַיֹּאמֶר לְהַשְׁמִידָם לוּלֵי מֹשֶׁה בְחִירוֹ עָמַד בַּפֶּרֶץ לְפָנָיו לְהָשִׁיב חֲמָתוֹ מֵהַשְׁחִית׃"}]]},{"key":"wdz3w5v5N2","he":[[{"t":"וַיִּמְאֲסוּ בְּאֶרֶץ חֶמְדָּה לֹא־הֶאֱמִינוּ לִדְבָרוֹ׃"}]]},{"key":"zU_qEPEDqe","he":[[{"t":"וַיֵּרָגְנוּ בְאָהֳלֵיהֶם לֹא שָׁמְעוּ בְּקוֹל יְהֹוָה׃"}]]},{"key":"tvOS1PR0G1","he":[[{"t":"וַיִּשָּׂא יָדוֹ לָהֶם לְהַפִּיל אוֹתָם בַּמִּדְבָּר׃"}]]},{"key":"hfl6JwPu7u","he":[[{"t":"וּלְהַפִּיל זַרְעָם בַּגּוֹיִם וּלְזָרוֹתָם בָּאֲרָצוֹת׃"}]]},{"key":"h2sQ602piT","he":[[{"t":"וַיִּצָּמְדוּ לְבַעַל פְּעוֹר וַיֹּאכְלוּ זִבְחֵי מֵתִים׃"}]]},{"key":"QCRcrzElpB","he":[[{"t":"וַיַּכְעִיסוּ בְּמַעַלְלֵיהֶם וַתִּפְרָץ־בָּם מַגֵּפָה׃"}]]},{"key":"5icKsmlgOE","he":[[{"t":"וַיַּעֲמֹד פִּינְחָס וַיְפַלֵּל וַתֵּעָצַר הַמַּגֵּפָה׃"}]]},{"key":"qgP1Q63hLn","he":[[{"t":"וַתֵּחָשֶׁב לוֹ לִצְדָקָה לְדֹר וָדֹר עַד־עוֹלָם׃"}]]},{"key":"MArWhmGP3Y","he":[[{"t":"וַיַּקְצִיפוּ עַל־מֵי מְרִיבָה וַיֵּרַע לְמֹשֶׁה בַּעֲבוּרָם׃"}]]},{"key":"duUQTnags9","he":[[{"t":"כִּי־הִמְרוּ אֶת־רוּחוֹ וַיְבַטֵּא בִּשְׂפָתָיו׃"}]]},{"key":"OYULmvG_aD","he":[[{"t":"לֹא־הִשְׁמִידוּ אֶת־הָעַמִּים אֲשֶׁר אָמַר יְהֹוָה לָהֶם׃"}]]},{"key":"ebwLetnQfP","he":[[{"t":"וַיִּתְעָרְבוּ בַגּוֹיִם וַיִּלְמְדוּ מַעֲשֵׂיהֶם׃"}]]},{"key":"yWfMjb7UZW","he":[[{"t":"וַיַּעַבְדוּ אֶת־עֲצַבֵּיהֶם וַיִּהְיוּ לָהֶם לְמוֹקֵשׁ׃"}]]},{"key":"KxvOzFpd5z","he":[[{"t":"וַיִּזְבְּחוּ אֶת־בְּנֵיהֶם וְאֶת־בְּנוֹתֵיהֶם לַשֵּׁדִים׃"}]]},{"key":"db0lTVmIPI","he":[[{"t":"וַיִּשְׁפְּכוּ דָם נָקִי דַּם־בְּנֵיהֶם וּבְנוֹתֵיהֶם אֲשֶׁר זִבְּחוּ לַעֲצַבֵּי כְנָעַן וַתֶּחֱנַף הָאָרֶץ בַּדָּמִים׃"}]]},{"key":"EaBDLRyYwX","he":[[{"t":"וַיִּטְמְאוּ בְמַעֲשֵׂיהֶם וַיִּזְנוּ בְּמַעַלְלֵיהֶם׃"}]]},{"key":"QmS9hCpczh","he":[[{"t":"וַיִּחַר־אַף יְהֹוָה בְּעַמּוֹ וַיְתָעֵב אֶת־נַחֲלָתוֹ׃"}]]},{"key":"loxu4IKDPV","he":[[{"t":"וַיִּתְּנֵם בְּיַד־גּוֹיִם וַיִּמְשְׁלוּ בָהֶם שֹׂנְאֵיהֶם׃"}]]},{"key":"Be6nPmuDs3","he":[[{"t":"וַיִּלְחָצוּם אוֹיְבֵיהֶם וַיִּכָּנְעוּ תַּחַת יָדָם׃"}]]},{"key":"ycLCqpCRjw","he":[[{"t":"פְּעָמִים רַבּוֹת יַצִּילֵם וְהֵמָּה יַמְרוּ בַעֲצָתָם וַיָּמֹכּוּ בַּעֲוֺנָם׃"}]]},{"key":"6i6_M0J_UL","he":[[{"t":"וַיַּרְא בַּצַּר לָהֶם בְּשָׁמְעוֹ אֶת־רִנָּתָם׃"}]]},{"key":"yvb4CIR077","he":[[{"t":"וַיִּזְכֹּר לָהֶם בְּרִיתוֹ וַיִּנָּחֵם כְּרֹב חֲסָדָיו׃"}]]},{"key":"vMydicZGKK","he":[[{"t":"וַיִּתֵּן אוֹתָם לְרַחֲמִים לִפְנֵי כָּל־שׁוֹבֵיהֶם׃"}]]},{"key":"45MIikcAZv","he":[[{"t":"הוֹשִׁיעֵנוּ יְהֹוָה אֱלֹהֵינוּ וְקַבְּצֵנוּ מִן־הַגּוֹיִם לְהֹדוֹת לְשֵׁם קָדְשֶׁךָ לְהִשְׁתַּבֵּחַ בִּתְהִלָּתֶךָ׃"}]]},{"key":"vzNtUX-csC","he":[[{"t":"בָּרוּךְ־יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל מִן־הָעוֹלָם וְעַד הָעוֹלָם וְאָמַר כָּל־הָעָם אָמֵן הַלְלוּ־יָהּ׃"}]]}]},{"title":{"he":"יהי רצון לאחר ספר רביעי","en":"After the Fourth Book"},"optional":{"he":"המסיים ספר רביעי אומר","en":"Said on finishing the Fourth Book"},"segments":[{"key":"pFsuKUU6hw.3","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ וֵאלֹהֵי אֲבוֹתֵינוּ, בִּזְכוּת סֵפֶר רְבִיעִי שֶׁבַּתְּהִלִּים שֶׁקָּרָאנוּ לְפָנֶיךָ, שֶׁהוּא כְּנֶגֶד סֵפֶר בַּמִּדְבָּר בִּזְכוּת מִזְמוֹרָיו, וּבִזְכוּת פְּסוּקָיו, וּבִזְכוּת תֵּבוֹתָיו, וּבִזְכוּת שְׁמוֹתֶיךָ הַקְּדוֹשִׁים וְהַטְּהוֹרִים הַיּוֹצְאִים מִמֶּנּוּ, שֶׁתְּכַפֶּר לָנוּ עַל כָּל חַטֹּאתֵינוּ, וְתִסְלַח לָנוּ עַל כָּל עֲוֹנֹתֵינוּ, וְתִמְחָל לָנוּ עַל כָּל פְּשָׁעֵינוּ, שֶׁחָטָאנוּ וְשֶׁעָוִינוּ וְשֶׁפָּשַׁעְנוּ לְפָנֶיךָ. וְהַחֲזִירֵנוּ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ, וְהַדְרִיכֵנוּ לַעֲבֹדָתְךָ וְתִפְתַּח לִבֵּנוּ בְּתַלְמוּד תּוֹרָתֶךָ. וְתִשְׁלַח רְפוּאָה שְׁלֵמָה לְחוֹלֵי עַמֶּךָ (ולפב\"פ). וְתִקְרָא לִשְׁבוּיִם דְּרוֹר וְלַאֲסוּרִים פְּקַח קוֹחַ, וּלְכָל הוֹלְכֵי דְּרָכִים וְעוֹבְרֵי יַמִּים וּנְהָרוֹת מֵעַמְּךָ יִשְׂרָאֵל, תַּצִּילֵם מִכָּל צַעַר וְנֶזֶק, וְתַגִּיעֵם לִמְחוֹז חֶפְצָם לְחַיִּים וּלְשָׁלוֹם. וְתִפְקֹד לְכָל חֲשׂוּכֵי בָנִים בְּזֶרַע שֶׁל קַיָּמָא לַעֲבוֹדָתְךָ וּלְיִרְאָתֶךָ. וְעֻבָּרוֹת שֶׁל עַמְּךָ בֵּית יִשְׂרָאֵל תַּצִּילֵן שֶׁלֹּא תַּפֵּלְנָה וַלְדוֹתֵיהֶן. וְהַיּוֹשְׁבוֹת עַל הַמַּשְׁבֵּר, בְּרַחֲמֶיךָ הָרַבִּים תַּצִּילֵן מִכָּל רָע. וְאֶל הַמְּנִיקוֹת תַּשְׁפִּיעַ שֶׁלֹּא יֶחְסַר חָלָב מִדַּדֵּיהֶן. וְאַל יִמְשֹׁל אַסְכָּרָה וְשֵׁדִין וְרוּחִין וְלִילִין וְכָל פְּגָעִים וּמַרְעִין בִּישִׂין בְּכָל יַלְדֵי עַמְּךָ בֵּית יִשְׂרָאֵל. וּתְגַדְּלֵם לְתוֹרָתֶךָ, לִלְמֹד תּוֹרָה לִשְׁמָהּ. וְתַצִּילֵם מֵעַיִן הָרָע וּמִדֶּבֶר וּמִמַּגֵּפָה וּמִשָּׂטָן וּמִיֵּצֶר הָרָע. וּתְבַטֵּל מֵעָלֵינוּ וּמִכָּל עַמְּךָ בֵּית יִשְׂרָאֵל בְּכָל מָקוֹם שֶׁהֵם כָּל גְּזֵרוֹת קָשׁוֹת וְרָעוֹת. וְתַטֶּה לֵב הַמַּלְכוּת עָלֵינוּ לְטוֹבָה, וְתִגְזֹר עָלֵינוּ גְּזֵרוֹת טוֹבוֹת. וְתִשְׁלַח בְּרָכָה וְהַצְלָחָה בְּכָל מַעֲשֵׂה יָדֵינוּ. וְהָכֵן פַּרְנָסָתֵנוּ מִיָּדְךָ הָרְחָבָה וְהַמְּלֵאָה, וְלֹא יִצְטָרְכוּ עַמְּךָ בֵּית יִשְׂרָאֵל זֶה לָזֶה וְלֹא לְעַם אַחֵר. וְתֵן לְכָל אִישׁ וְאִישׁ דֵּי פַּרְנָסָתוֹ, וּלְכָל גְּוִיָּה וּגְוִיָּה דֵּי מַחְסוֹרָהּ. וּתְמַהֵר וְתָחִישׁ לְגָאֳלֵנוּ, וְתִבְנֶה בֵּית מִקְדָּשֵׁנוּ וְתִפְאַרְתֵּנוּ. וּבִזְכוּת שְׁלֹשׁ עֶשְׂרֵה מִדּוֹתֶיךָ שֶׁל רַחֲמִים הַכְּתוּבִים בְּתוֹרָתֶךָ, כְּמוֹ שֶׁנֶּאֱמַר: יְהֹוָה יְהֹוָה אֵל רַחוּם וְחַנּוּן, אֶרֶךְ אַפַּיִם וְרַב חֶסֶד וֶאֱמֶת׃ נֹצֵר חֶסֶד לָאֲלָפִים, נֹשֵׂא עָוֹן וָפֶשַׁע וְחַטָּאָה וְנַקֵּה. שֶׁאֵינָן חוֹזְרוֹת רֵיקָם מִלְּפָנֶיךָ, עָזְרֵנוּ אֱלֹהֵי יִשְׁעֵנוּ עַל דְּבַר כְּבוֹד שְׁמֶךָ, וְהַצִּילֵנוּ וְכַפֵּר עַל חַטֹּאתֵינוּ לְמַעַן שְׁמֶךָ. בָּרוּךְ יְהֹוָה לְעוֹלָם אָמֵן וְאָמֵן׃"}]]}]},{"title":{"he":"פרק קז","en":"Psalm 107"},"headings":[{"he":"ספר חמישי","en":"Fifth Book","level":1},{"he":"ליום שישי","en":"Friday","level":2}],"chapter":{"he":"ליום שישי","en":"Friday"},"segments":[{"key":"lA3fm6nMY3","he":[[{"t":"הֹדוּ לַיהֹוָה כִּי־טוֹב כִּי לְעוֹלָם חַסְדּוֹ׃"}]]},{"key":"wSmY-RD0wD","he":[[{"t":"יֹאמְרוּ גְּאוּלֵי יְהֹוָה אֲשֶׁר גְּאָלָם מִיַּד־צָר׃"}]]},{"key":"0G5jiPTM1C","he":[[{"t":"וּמֵאֲרָצוֹת קִבְּצָם מִמִּזְרָח וּמִמַּעֲרָב מִצָּפוֹן וּמִיָּם׃"}]]},{"key":"S83a0ibiSe","he":[[{"t":"תָּעוּ בַמִּדְבָּר בִּישִׁימוֹן דָּרֶךְ עִיר מוֹשָׁב לֹא מָצָאוּ׃"}]]},{"key":"vD8h3GiYte","he":[[{"t":"רְעֵבִים גַּם־צְמֵאִים נַפְשָׁם בָּהֶם תִּתְעַטָּף׃"}]]},{"key":"DbIKiEfw8c","he":[[{"t":"וַיִּצְעֲקוּ אֶל־יְהֹוָה בַּצַּר לָהֶם מִמְּצוּקוֹתֵיהֶם יַצִּילֵם׃"}]]},{"key":"YP-1sQVhL0","he":[[{"t":"וַיַּדְרִיכֵם בְּדֶרֶךְ יְשָׁרָה לָלֶכֶת אֶל־עִיר מוֹשָׁב׃"}]]},{"key":"nmkTa5pspu","he":[[{"t":"יוֹדוּ לַיהֹוָה חַסְדּוֹ וְנִפְלְאוֹתָיו לִבְנֵי אָדָם׃"}]]},{"key":"LJG4UvlDfc","he":[[{"t":"כִּי־הִשְׂבִּיעַ נֶפֶשׁ שֹׁקֵקָה וְנֶפֶשׁ רְעֵבָה מִלֵּא־טוֹב׃"}]]},{"key":"0jFDGrmiAv","he":[[{"t":"יֹשְׁבֵי חֹשֶׁךְ וְצַלְמָוֶת אֲסִירֵי עֳנִי וּבַרְזֶל׃"}]]},{"key":"GSMbcpBArs","he":[[{"t":"כִּי־הִמְרוּ אִמְרֵי־אֵל וַעֲצַת עֶלְיוֹן נָאָצוּ׃"}]]},{"key":"6DOIdBiimL","he":[[{"t":"וַיַּכְנַע בֶּעָמָל לִבָּם כָּשְׁלוּ וְאֵין עֹזֵר׃"}]]},{"key":"GAVnyy316j","he":[[{"t":"וַיִּזְעֲקוּ אֶל־יְהֹוָה בַּצַּר לָהֶם מִמְּצֻקוֹתֵיהֶם יוֹשִׁיעֵם׃"}]]},{"key":"G1qLUTju2C","he":[[{"t":"יוֹצִיאֵם מֵחֹשֶׁךְ וְצַלְמָוֶת וּמוֹסְרוֹתֵיהֶם יְנַתֵּק׃"}]]},{"key":"kLYerF8d61","he":[[{"t":"יוֹדוּ לַיהֹוָה חַסְדּוֹ וְנִפְלְאוֹתָיו לִבְנֵי אָדָם׃"}]]},{"key":"QM-FME8NBJ","he":[[{"t":"כִּי־שִׁבַּר דַּלְתוֹת נְחֹשֶׁת וּבְרִיחֵי בַרְזֶל גִּדֵּעַ׃"}]]},{"key":"GvLJEDAEyN","he":[[{"t":"אֱוִלִים מִדֶּרֶךְ פִּשְׁעָם וּמֵעֲוֺנֹתֵיהֶם יִתְעַנּוּ׃"}]]},{"key":"ydDOldeFIe","he":[[{"t":"כָּל־אֹכֶל תְּתַעֵב נַפְשָׁם וַיַּגִּיעוּ עַד־שַׁעֲרֵי מָוֶת׃"}]]},{"key":"sYxX4XylvO","he":[[{"t":"וַיִּזְעֲקוּ אֶל־יְהֹוָה בַּצַּר לָהֶם מִמְּצֻקוֹתֵיהֶם יוֹ