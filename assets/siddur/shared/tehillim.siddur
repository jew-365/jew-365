"לָכֵן שָׁמַע יְהֹוָה וַיִּתְעַבָּר וְאֵשׁ נִשְּׂקָה בְיַעֲקֹב וְגַם־אַף עָלָה בְיִשְׂרָאֵל׃"}]]},{"key":"kguqyh-C_Q","he":[[{"t":"כִּי לֹא הֶאֱמִינוּ בֵּאלֹהִים וְלֹא בָטְחוּ בִּישׁוּעָתוֹ׃"}]]},{"key":"XD0hVw3Pby","he":[[{"t":"וַיְצַו שְׁחָקִים מִמָּעַל וְדַלְתֵי שָׁמַיִם פָּתָח׃"}]]},{"key":"mdi3Pkjboj","he":[[{"t":"וַיַּמְטֵר עֲלֵיהֶם מָן לֶאֱכֹל וּדְגַן־שָׁמַיִם נָתַן לָמוֹ׃"}]]},{"key":"T87Um4l49z","he":[[{"t":"לֶחֶם אַבִּירִים אָכַל אִישׁ צֵידָה שָׁלַח לָהֶם לָשֹׂבַע׃"}]]},{"key":"eDNE4_LAqh","he":[[{"t":"יַסַּע קָדִים בַּשָּׁמָיִם וַיְנַהֵג בְּעֻזּוֹ תֵימָן׃"}]]},{"key":"cVF7lRPkgd","he":[[{"t":"וַיַּמְטֵר עֲלֵיהֶם כֶּעָפָר שְׁאֵר וּכְחוֹל יַמִּים עוֹף כָּנָף׃"}]]},{"key":"I5VbgUzu1t","he":[[{"t":"וַיַּפֵּל בְּקֶרֶב מַחֲנֵהוּ סָבִיב לְמִשְׁכְּנֹתָיו׃"}]]},{"key":"Kb7rfV-8Qi","he":[[{"t":"וַיֹּאכְלוּ וַיִּשְׂבְּעוּ מְאֹד וְתַאֲוָתָם יָבִא לָהֶם׃"}]]},{"key":"Zg6EYcd7jz","he":[[{"t":"לֹא־זָרוּ מִתַּאֲוָתָם עוֹד אָכְלָם בְּפִיהֶם׃"}]]},{"key":"QXRFBp4qfx","he":[[{"t":"וְאַף אֱלֹהִים עָלָה בָהֶם וַיַּהֲרֹג בְּמִשְׁמַנֵּיהֶם וּבַחוּרֵי יִשְׂרָאֵל הִכְרִיעַ׃"}]]},{"key":"30fFcwp9kc","he":[[{"t":"בְּכָל־זֹאת חָטְאוּ־עוֹד וְלֹא־הֶאֱמִינוּ בְּנִפְלְאוֹתָיו׃"}]]},{"key":"IfV6kthy_0","he":[[{"t":"וַיְכַל־בַּהֶבֶל יְמֵיהֶם וּשְׁנוֹתָם בַּבֶּהָלָה׃"}]]},{"key":"87PJZ0rjzl","he":[[{"t":"אִם־הֲרָגָם וּדְרָשׁוּהוּ וְשָׁבוּ וְשִׁחֲרוּ־אֵל׃"}]]},{"key":"XKW0L25bjT","he":[[{"t":"וַיִּזְכְּרוּ כִּי־אֱלֹהִים צוּרָם וְאֵל עֶלְיוֹן גֹּאֲלָם׃"}]]},{"key":"OWBZyJMC1d","he":[[{"t":"וַיְפַתּוּהוּ בְּפִיהֶם וּבִלְשׁוֹנָם יְכַזְּבוּ־לוֹ׃"}]]},{"key":"KjX-wx90YH","he":[[{"t":"וְלִבָּם לֹא־נָכוֹן עִמּוֹ וְלֹא נֶאֶמְנוּ בִּבְרִיתוֹ׃"}]]},{"key":"bVRieEBQPR","he":[[{"t":"וְהוּא רַחוּם יְכַפֵּר עָוֺן וְלֹא־יַשְׁחִית וְהִרְבָּה לְהָשִׁיב אַפּוֹ וְלֹא־יָעִיר כָּל־חֲמָתוֹ׃"}]]},{"key":"lb-bYJ7MOM","he":[[{"t":"וַיִּזְכֹּר כִּי־בָשָׂר הֵמָּה רוּחַ הוֹלֵךְ וְלֹא יָשׁוּב׃"}]]},{"key":"TG8nenDRmN","he":[[{"t":"כַּמָּה יַמְרוּהוּ בַמִּדְבָּר יַעֲצִיבוּהוּ בִּישִׁימוֹן׃"}]]},{"key":"wWMDV4qV3l","he":[[{"t":"וַיָּשׁוּבוּ וַיְנַסּוּ אֵל וּקְדוֹשׁ יִשְׂרָאֵל הִתְווּ׃"}]]},{"key":"jZ3p-LBHB8","he":[[{"t":"לֹא־זָכְרוּ אֶת־יָדוֹ יוֹם אֲשֶׁר־פָּדָם מִנִּי־צָר׃"}]]},{"key":"lNAjOZCiFQ","he":[[{"t":"אֲשֶׁר־שָׂם בְּמִצְרַיִם אֹתוֹתָיו וּמוֹפְתָיו בִּשְׂדֵה־צֹעַן׃"}]]},{"key":"6olasMhLQc","he":[[{"t":"וַיַּהֲפֹךְ לְדָם יְאֹרֵיהֶם וְנֹזְלֵיהֶם בַּל־יִשְׁתָּיוּן׃"}]]},{"key":"nTf_wHPu-v","he":[[{"t":"יְשַׁלַּח בָּהֶם עָרֹב וַיֹּאכְלֵם וּצְפַרְדֵּעַ וַתַּשְׁחִיתֵם׃"}]]},{"key":"DGLWjywE9h","he":[[{"t":"וַיִּתֵּן לֶחָסִיל יְבוּלָם וִיגִיעָם לָאַרְבֶּה׃"}]]},{"key":"nJb8aofy6z","he":[[{"t":"יַהֲרֹג בַּבָּרָד גַּפְנָם וְשִׁקְמוֹתָם בַּחֲנָמַל׃"}]]},{"key":"uMUxE3qH92","he":[[{"t":"וַיַּסְגֵּר לַבָּרָד בְּעִירָם וּמִקְנֵיהֶם לָרְשָׁפִים׃"}]]},{"key":"U3PXvCV81o","he":[[{"t":"יְשַׁלַּח־בָּם חֲרוֹן אַפּוֹ עֶבְרָה וָזַעַם וְצָרָה מִשְׁלַחַת מַלְאֲכֵי רָעִים׃"}]]},{"key":"MJBHH-3N3u","he":[[{"t":"יְפַלֵּס נָתִיב לְאַפּוֹ לֹא־חָשַׂךְ מִמָּוֶת נַפְשָׁם וְחַיָּתָם לַדֶּבֶר הִסְגִּיר׃"}]]},{"key":"3T9ggCdByG","he":[[{"t":"וַיַּךְ כָּל־בְּכוֹר בְּמִצְרָיִם רֵאשִׁית אוֹנִים בְּאָהֳלֵי־חָם׃"}]]},{"key":"qVq1iAJcHG","he":[[{"t":"וַיַּסַּע כַּצֹּאן עַמּוֹ וַיְנַהֲגֵם כַּעֵדֶר בַּמִּדְבָּר׃"}]]},{"key":"qaGpx2zUKS","he":[[{"t":"וַיַּנְחֵם לָבֶטַח וְלֹא פָחָדוּ וְאֶת־אוֹיְבֵיהֶם כִּסָּה הַיָּם׃"}]]},{"key":"DBcoY9Cam1","he":[[{"t":"וַיְבִיאֵם אֶל־גְּבוּל קָדְשׁוֹ הַר־זֶה קָנְתָה יְמִינוֹ׃"}]]},{"key":"G10YgEH3a-","he":[[{"t":"וַיְגָרֶשׁ מִפְּנֵיהֶם גּוֹיִם וַיַּפִּילֵם בְּחֶבֶל נַחֲלָה וַיַּשְׁכֵּן בְּאָהֳלֵיהֶם שִׁבְטֵי יִשְׂרָאֵל׃"}]]},{"key":"j8L4dfNRIQ","he":[[{"t":"וַיְנַסּוּ וַיַּמְרוּ אֶת־אֱלֹהִים עֶלְיוֹן וְעֵדוֹתָיו לֹא שָׁמָרוּ׃"}]]},{"key":"UZ8OzwSJQi","he":[[{"t":"וַיִּסֹּגוּ וַיִּבְגְּדוּ כַּאֲבוֹתָם נֶהְפְּכוּ כְּקֶשֶׁת רְמִיָּה׃"}]]},{"key":"xQMD6_Czlr","he":[[{"t":"וַיַּכְעִיסוּהוּ בְּבָמוֹתָם וּבִפְסִילֵיהֶם יַקְנִיאוּהוּ׃"}]]},{"key":"sbC9RHrFfE","he":[[{"t":"שָׁמַע אֱלֹהִים וַיִּתְעַבָּר וַיִּמְאַס מְאֹד בְּיִשְׂרָאֵל׃"}]]},{"key":"KpJVPGMBnP","he":[[{"t":"וַיִּטֹּשׁ מִשְׁכַ