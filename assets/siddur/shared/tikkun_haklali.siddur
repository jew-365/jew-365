:"שִׁירוּ־לוֹ זַמְּרוּ־לוֹ שִׂיחוּ בְּכָל־נִפְלְאוֹתָיו׃"}]]},{"key":"kOL6PXi6MM","he":[[{"t":"הִתְהַלְלוּ בְּשֵׁם קָדְשׁוֹ יִשְׂמַח לֵב מְבַקְשֵׁי יְהֹוָה׃"}]]},{"key":"gDl_4YVyLk","he":[[{"t":"דִּרְשׁוּ יְהֹוָה וְעֻזּוֹ בַּקְּשׁוּ פָנָיו תָּמִיד׃"}]]},{"key":"XBpkdsECG8","he":[[{"t":"זִכְרוּ נִפְלְאוֹתָיו אֲשֶׁר־עָשָׂה מֹפְתָיו וּמִשְׁפְּטֵי־פִיו׃"}]]},{"key":"BcWkv6vzvP","he":[[{"t":"זֶרַע אַבְרָהָם עַבְדּוֹ בְּנֵי יַעֲקֹב בְּחִירָיו׃"}]]},{"key":"kcjZIlz4GN","he":[[{"t":"הוּא יְהֹוָה אֱלֹהֵינוּ בְּכָל־הָאָרֶץ מִשְׁפָּטָיו׃"}]]},{"key":"A9p8UDvQcO","he":[[{"t":"זָכַר לְעוֹלָם בְּרִיתוֹ דָּבָר צִוָּה לְאֶלֶף דּוֹר׃"}]]},{"key":"McvOA74xGA","he":[[{"t":"אֲשֶׁר כָּרַת אֶת־אַבְרָהָם וּשְׁבוּעָתוֹ לְיִשְׂחָק׃"}]]},{"key":"2z0VVlMGMJ","he":[[{"t":"וַיַּעֲמִידֶהָ לְיַעֲקֹב לְחֹק לְיִשְׂרָאֵל בְּרִית עוֹלָם׃"}]]},{"key":"_t-Dv010nn","he":[[{"t":"לֵאמֹר לְךָ אֶתֵּן אֶת־אֶרֶץ־כְּנָעַן חֶבֶל נַחֲלַתְכֶם׃"}]]},{"key":"kd_MpW3ov-","he":[[{"t":"בִּהְיוֹתָם מְתֵי מִסְפָּר כִּמְעַט וְגָרִים בָּהּ׃"}]]},{"key":"gni1a_2ROj","he":[[{"t":"וַיִּתְהַלְּכוּ מִגּוֹי אֶל־גּוֹי מִמַּמְלָכָה אֶל־עַם אַחֵר׃"}]]},{"key":"9dEGEfp6Wx","he":[[{"t":"לֹא־הִנִּיחַ אָדָם לְעָשְׁקָם וַיּוֹכַח עֲלֵיהֶם מְלָכִים׃"}]]},{"key":"7BzxLEwobZ","he":[[{"t":"אַל־תִּגְּעוּ בִמְשִׁיחָי וְלִנְבִיאַי אַל־תָּרֵעוּ׃"}]]},{"key":"HonEyFfLnm","he":[[{"t":"וַיִּקְרָא רָעָב עַל־הָאָרֶץ כָּל־מַטֵּה־לֶחֶם שָׁבָר׃"}]]},{"key":"kaHlgOpvNJ","he":[[{"t":"שָׁלַח לִפְנֵיהֶם אִישׁ לְעֶבֶד נִמְכַּר יוֹסֵף׃"}]]},{"key":"fOaCowvsxV","he":[[{"t":"עִנּוּ בַכֶּבֶל רַגְלוֹ בַּרְזֶל בָּאָה נַפְשׁוֹ׃"}]]},{"key":"OIDhNmL8Kk","he":[[{"t":"עַד־עֵת בֹּא־דְבָרוֹ אִמְרַת יְהֹוָה צְרָפָתְהוּ׃"}]]},{"key":"hv_HwKF6cp","he":[[{"t":"שָׁלַח מֶלֶךְ וַיַּתִּירֵהוּ מֹשֵׁל עַמִּים וַיְפַתְּחֵהוּ׃"}]]},{"key":"7Ey3h6aOn2","he":[[{"t":"שָׂמוֹ אָדוֹן לְבֵיתוֹ וּמֹשֵׁל בְּכָל־קִנְיָנוֹ׃"}]]},{"key":"fxVd81O38O","he":[[{"t":"לֶאְסֹר שָׂרָיו בְּנַפְשׁוֹ וּזְקֵנָיו יְחַכֵּם׃"}]]},{"key":"VJBkAXaTuG","he":[[{"t":"וַיָּבֹא יִשְׂרָאֵל מִצְרָיִם וְיַעֲקֹב גָּר בְּאֶרֶץ־חָם׃"}]]},{"key":"EZB631QXSc","he":[[{"t":"וַיֶּפֶר אֶת־עַמּוֹ מְאֹד וַיַּעֲצִמֵהוּ מִצָּרָיו׃"}]]},{"key":"YOKA1-bDQJ","he":[[{"t":"הָפַךְ לִבָּם לִשְׂנֹא עַמּוֹ לְהִתְנַכֵּל בַּעֲבָדָיו׃"}]]},{"key":"A9pq2-NQfb","he":[[{"t":"שָׁלַח מֹשֶׁה עַבְדּוֹ אַהֲרֹן אֲשֶׁר בָּחַר־בּוֹ׃"}]]},{"key":"6RrCKms66W","he":[[{"t":"שָׂמוּ־בָם דִּבְרֵי אֹתוֹתָיו וּמֹפְתִים בְּאֶרֶץ חָם׃"}]]},{"key":"_s_iRB7dDl","he":[[{"t":"שָׁלַח חֹשֶׁךְ וַיַּחְשִׁךְ וְלֹא־מָרוּ אֶת־דְּבָרוֹ׃"}]]},{"key":"ND2gI_Jj2y","he":[[{"t":"הָפַךְ אֶת־מֵימֵיהֶם לְדָם וַיָּמֶת אֶת־דְּגָתָם׃"}]]},{"key":"KxbxYooRY-","he":[[{"t":"שָׁרַץ אַרְצָם צְפַרְדְּעִים בְּחַדְרֵי מַלְכֵיהֶם׃"}]]},{"key":"pzwaZVSfWb","he":[[{"t":"אָמַר וַיָּבֹא עָרֹב כִּנִּים בְּכָל־גְּבוּלָם׃"}]]},{"key":"FRbhRFGVEf","he":[[{"t":"נָתַן גִּשְׁמֵיהֶם בָּרָד אֵשׁ לֶהָבוֹת בְּאַרְצָם׃"}]]},{"key":"Tv00C8hD_S","he":[[{"t":"וַיַּךְ גַּפְנָם וּתְאֵנָתָם וַיְשַׁבֵּר עֵץ גְּבוּלָם׃"}]]},{"key":"3oYn1ZKgMR","he":[[{"t":"אָמַר וַיָּבֹא אַרְבֶּה וְיֶלֶק וְאֵין מִסְפָּר׃"}]]},{"key":"iDU5JCW9np","he":[[{"t":"וַיֹּאכַל כָּל־עֵשֶׂב בְּאַרְצָם וַיֹּאכַל פְּרִי אַדְמָתָם׃"}]]},{"key":"Hh2S2lcQpQ","he":[[{"t":"וַיַּךְ כָּל־בְּכוֹר בְּאַרְצָם רֵאשִׁית לְכָל־אוֹנָם׃"}]]},{"key":"sMmdL9Ujvl","he":[[{"t":"וַיּוֹצִיאֵם בְּכֶסֶף וְזָהָב וְאֵין בִּשְׁבָטָיו כּוֹשֵׁל׃"}]]},{"key":"texjP_lavR","he":[[{"t":"שָׂמַח מִצְרַיִם בְּצֵאתָם כִּי־נָפַל פַּחְדָּם עֲלֵיהֶם׃"}]]},{"key":"anvr9uX6hc","he":[[{"t":"פָּרַשׂ עָנָן לְמָסָךְ וְאֵשׁ לְהָאִיר לָיְלָה׃"}]]},{"key":"IRfpvBU_b8","he":[[{"t":"שָׁאַל וַיָּבֵא שְׂלָו וְלֶחֶם שָׁמַיִם יַשְׂבִּיעֵם׃"}]]},{"key":"GhUapnrNNT","he":[[{"t":"פָּתַח צוּר וַיָּזוּבוּ מָיִם הָלְכוּ בַּצִּיּוֹת נָהָר׃"}]]},{"key":"_6owNnUtV6","he":[[{"t":"כִּי־זָכַר אֶת־דְּבַר קָדְשׁוֹ אֶת־אַבְרָהָם עַבְדּוֹ׃"}]]},{"key":"cxqgBF7AaR","he":[[{"t":"וַיּוֹצִא עַמּוֹ בְשָׂשׂוֹן בְּרִנָּה אֶת־בְּחִירָיו׃"}]]},{"key":"RFGRv93HRt","he":[[{"t":"וַיִּתֵּן לָהֶם אַרְצוֹת גּוֹיִם וַעֲמַל לְאֻמִּים יִירָשׁוּ׃"}]]},{"key":"teXqkQBB3A","he":[[{"t":"בַּעֲבוּר יִשְׁמְרוּ חֻקָּיו וְתוֹרֹתָיו יִנְצֹרוּ הַלְלוּ־יָהּ׃"}]]}]},{"title":{"he":"מזמור קלז","en":"Psalm 137"},"segments":[{"key":"YhXBqfCLTA","he":[[{"t":"עַל נַהֲרוֹת בָּבֶל שָׁם יָשַׁבְנוּ גַּם־בָּכִינוּ בְּזָכְרֵנוּ אֶת־צִיּוֹן׃"}]]},{"key":"RTqtYbEyTq","he":[[{"t":"עַל־עֲרָבִים בְּתוֹכָהּ תָּלִינוּ כִּנֹּרוֹתֵינוּ׃"}]]},{"key":"SUuzATAz_T","he":[[{"t":"כִּי שָׁם שְׁאֵלוּנוּ שׁוֹבֵינוּ דִּבְרֵי־שִׁיר וְתוֹלָלֵינוּ שִׂמְחָה שִׁירוּ לָנוּ מִשִּׁיר צִיּוֹן׃"}]]},{"key":"_c7e7w9mS5","he":[[{"t":"אֵיךְ נָשִׁיר אֶת־שִׁיר־יְהֹוָה עַל אַדְמַת נֵכָר׃"}]]},{"key":"qJ2zKzl1NV","he":[[{"t":"אִם־אֶשְׁכָּחֵךְ יְרוּשָׁלִָם תִּשְׁכַּח יְמִינִי׃"}]]},{"key":"iWUuaeMZx3","he":[[{"t":"תִּדְבַּק־לְשׁוֹנִי לְחִכִּי אִם־לֹא אֶזְכְּרֵכִי אִם־לֹא אַעֲלֶה אֶת־יְרוּשָׁלִַם עַל רֹאשׁ שִׂמְחָתִי׃"}]]},{"key":"VW1xcrOwyO","he":[[{"t":"זְכֹר יְהֹוָה לִבְנֵי אֱדוֹם אֵת יוֹם יְרוּשָׁלִָם הָאֹמְרִים עָרוּ עָרוּ עַד הַיְסוֹד בָּהּ׃"}]]},{"key":"eQTx47y9qq","he":[[{"t":"בַּת־בָּבֶל הַשְּׁדוּדָה אַשְׁרֵי שֶׁיְשַׁלֶּם־לָךְ אֶת־גְּמוּלֵךְ שֶׁגָּמַלְתְּ לָנוּ׃"}]]},{"key":"QZ6ZZTC00f","he":[[{"t":"אַשְׁרֵי שֶׁיֹּאחֵז וְנִפֵּץ אֶת־עֹלָלַיִךְ אֶל־הַסָּלַע׃"}]]}]},{"title":{"he":"מזמור קנ","en":"Psalm 150"},"segments":[{"key":"HTf_D7evks","he":[[{"t":"הַלְלוּ יָהּ הַלְלוּ־אֵל בְּקָדְשׁוֹ הַלְלוּהוּ בִּרְקִיעַ עֻזּוֹ׃"}]]},{"key":"5oMxA3_pxM","he":[[{"t":"הַלְלוּהוּ בִגְבוּרֹתָיו הַלְלוּהוּ כְּרֹב גֻּדְלוֹ׃"}]]},{"key":"1lpo2wdSY5","he":[[{"t":"הַלְלוּהוּ בְּתֵקַע שׁוֹפָר הַלְלוּהוּ בְּנֵבֶל וְכִנּוֹר׃"}]]},{"key":"2MDlvbQ7dH","he":[[{"t":"הַלְלוּהוּ בְתֹף וּמָחוֹל הַלְלוּהוּ בְּמִנִּים וְעוּגָב׃"}]]},{"key":"I-O44yFEx4","he":[[{"t":"הַלְלוּהוּ בְצִלְצְלֵי־שָׁמַע הַלְלוּהוּ בְּצִלְצְלֵי תְרוּעָה׃"}]]},{"key":"LBd3qfF61s","he":[[{"t":"כֹּל הַנְּשָׁמָה תְּהַלֵּל יָהּ הַלְלוּ־יָהּ׃"}]]}]},{"title":{"he":"תפילה אחרי התיקון","en":"Prayer After the Tikkun"},"segments":[{"key":"zy1utPyrlU","he":[[{"t":"מִי יִתֵּן מִצִּיּוֹן יְשׁוּעַת יִשְׂרָאֵל בְּשׁוּב יְהֹוָה שְׁבוּת עַמּוֹ יָגֵל יַעֲקֹב יִשְׂמַח יִשְׂרָאֵל׃"}]]},{"key":"yojuRi8jF2","he":[[{"t":"וּתְשׁוּעַת צַדִּיקִים מֵיְהֹוָה מָעוּזָּם בְּעֵת צָרָה׃"}]]},{"key":"C44bRK3N8b","he":[[{"t":"וַיַּעְזְרֵם יְהֹוָה וַיְפַלְּטֵם יְפַלְּטֵם מֵרְשָׁעִים וְיוֹשִׁיעֵם כִּי־חָסוּ בוֹ׃"}]]},{"key":"6OfSl6L2it","he":[[{"t":"רבונו של עולם, עלת העלות וסבת כל הסבות אנת לעלא. לעלא מן כלא. ולית לעלא מנך. דלית מחשבה תפיסא בך כלל, ולך דומיה תהלה. ומרומם על כל ברכה ותהלה."}]]},{"key":"65OayINkU9","he":[[{"t":"אותך אדרש, אותך אבקש, שתחתר חתירה דרך כבושה מאתך, דרך כל העולמות, עד ההשתלשלות שלי, במקום שאני עומד, כפי אשר נגלה לך, יודע תעלומות. ובדרך ונתיב הזה תאיר עלי אורך, להחזירני בתשובה שלמה לפניך באמת כפי רצונך באמת, כפי רצון מבחר הברואים, לבלי לחשב במחשבתי שום מחשבת חוץ ושום מחשבה ובלבול, שהוא נגד רצונך, רק לדבק במחשבות זכות צחות וקדושות בעבודתך באמת בהשגתך ובתורתך."}]]},{"key":"GiQSC9cTxB","he":[[{"t":"הט לבי אל עדותיך, ותן לי לב טהור לעבדך באמת. וממצולות ים תוציאני לאור גדול חיש קל מהרה. תשועת יהוה כהרף עין, \"לאור באור החיים\" כל ימי היותי על פני האדמה; ואזכה לחדש נעורי, הימים שעברו בחשך, להחזירם אל הקדושה, ותהיה יציאתי מן העולם כביאתי, בלא חטא. ואזכה לחזות בנעם יהוה ולבקר בהיכלו, כולו אומר כבוד. אמן נצח סלה ועד:"}]]}]}],"credits":[{"title":"Tikkun HaKlali — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=1390004"},{"title":"Prayer Before Saying Psalms — Hebrew Wikisource","license":"CC-BY-SA","url":"https://he.wikisource.org/w/index.php?oldid=1386519"},{"title":"Psalms — Tanach with Nikkud","license":"Public Domain","url":"https://www.sefaria.org/Psalms"}]}