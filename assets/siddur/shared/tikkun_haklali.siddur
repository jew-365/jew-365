{"id":"tikkun_haklali","sections":[{"title":{"he":"תפילה לפני התיקון","en":"Prayer Before the Tikkun"},"segments":[{"key":"gcOa7dwKPr","he":[[{"t":"יְהִי רָצוֹן מִלְּפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ ואֱלֹהֵי אֲבוֹתֵינוּ הַבּוֹחֵר בְּדָוִד עַבְדוֹ וּבְזַרְעוֹ אַחֲרָיו וְהַבּוֹחֵר בְּשִׁירוֹת וְתִשְׁבָּחוֹת, שֶׁתֵּפֶן בְּרַחֲמִים אֶל קְרִיאַת מִזְמוֹרֵי תְּהִלִּים שֶׁאֶקְרָא כְּאִלּוּ אֲמָרָם דָּוִד הַמֶּלֶךְ עָלָיו הַשָּׁלוֹם בְּעַצְמוֹ זְכוּתוֹ יָגֵן עָלֵינוּ. וְיַעֲמָד לָנוּ זְכוּת פְּסוּקֵי תְּהִלִּים וּזְכוּת תֵּבוֹתֵיהֶם וְאוֹתִיוֹתֵיהֶם וּנְקֻדּוֹתֵיהֶם וְטַעֲמֵיהֶם וְהַשֵּׁמוֹת הַיּוֹצְאִים מֵהֶם מֵרָאשֵׁי תֵּבוֹת וּמִסּוֹפֵי תֵּבוֹת, לְכַפֵּר פְּשָּׁעֵינוּ וַעֲוֹנוֹתֵינוּ וְחַטֹּאתֵינוּ, וּלְזַמֵּר עָרִיצִים וּלְהַכְרִית כָּל הַחוֹחִים וְהַקּוֹצִים הַסּוֹבְבִים אֶת הַשּׁוֹשַׁנָּה הָעֶלְיוֹנָה, וּלְחַבֵּר אֵשֶׁת נְעוּרִים עִם דּוֹדָהּ בְּאַהֲבָה וְאַחֲוָה וְרֵעוּת, וּמִשָּׁם יִמָּשֵׁךְ לָנוּ שֶׁפַע לְנֶפֶשׁ רוּחַ וּנְשָׁמָה לְטַהֲרֵנוּ מֵעֲוֹנוֹתֵינוּ וְלִסְלֹחַ חַטֹּאתֵינוּ וּלְכַפֵּר פְּשָּׁעֵינוּ, כְּמוֹ שֶׁסָלַחְתָּ לְדָוִד שֶׁאָמַר מִזְמוֹרִים אֵלּוּ לְפָנֶיךָ, כְּמוֹ שֶׁנֶּאֱמַר גַּם יְהֹוָה הֶעֱבִיר חַטָּאתְךָ לֹא תָּמוּת. וְאַל תִּקָּחֵנוּ מֵהָעוֹלָם הַזֶּה קֹדֶם זְמַנֵּנוּ עַד מְלֹאת שְנוֹתֵינוּ בָּהֶם שִׁבְעִים שָׁנָה בְּאֹפֶן שֶׁנּוּכַל לְתַקֵּן אֵת אָשֵׁר שִׁחַתְנוּ. וּזְכוּת דָּוִד הַמֶּלֶךְ עָלָיו הַשָּׁלוֹם יָגֵן עָלֵינוּ וּבַּעֲדֵנוּ שְׁתַּאֲרִיךְ אַפְּךָ עַד שׁוּבֵנוּ אֵלֶיךָ בִּתְשׁוּבָה שְׁלֵמָה לְפָנֶיךָ. וּמֵאוֹצַר מַתְּנַת חִנָּם חֲנָנוֹ, כְּדִּכְתִיב וְחַנּוֹתִי אֶת אֲשֶׁר אָחֹן וְרִחַמְתִּי אֶת אָשֵׁר אֲרַחֵם. וּכְשֵׁם שֶׁאָנוּ אוֹמְרִים לְפָנֶיךָ שִׁירָה בָּעוֹלָם הַזֶּה כָּךְ נִזְכֶּה לוֹמַר לְפָנֶיךָ יְהֹוָה אֱלֹהֵינוּ שִׁיר וּשְׁבָחָה לָעוֹלָם הַבָּא. וְעַל יְדֵי אֲמִירַת תְּהִלִּים תִּתְעוֹרֵר חֲבַצֶּלֶת הַשָּׁרוֹן וְלָשִׁיר בְּקוֹל נָעִים בְּגִילַת וְרַנֵּן, כְּבוֹד הַלְּבָנוֹן נִתָּן לָהּ, הוֹד וְהָדָר בְּבֵית אֱלֹהֵינוּ בִּמְהֵרָה בְּיָמֵינוּ אָמֵן סֶלָה:"}]],"when":{"none":["shabbat","yomTov"]}},{"key":"gSlBd1Z2KK","he":[[{"t":"לְכוּ נְרַנְּנָה לַיהֹוָה נָרִיעָה לְצוּר יִשְׁעֵנוּ׃"}]]},{"key":"vkOLRmBFMZ","he":[[{"t":"נְקַדְּמָה פָנָיו בְּתוֹדָה בִּזְמִרוֹת נָרִיעַ לוֹ׃"}]]},{"key":"CP7_aAsx9M","he":[[{"t":"כִּי אֵל גָּדוֹל יְהֹוָה וּמֶלֶךְ גָּדוֹל עַל־כָּל־אֱלֹהִים׃"}]]},{"key":"3nGXtpRsPC","he":[[{"t":"קודם שיתחיל באמירת תהלים יאמר זה:","s":"n"}]]},{"key":"353Tj_Jn-Y","he":[[{"t":"הֲרֵינִי "},{"t":"מְזַמֵּן","voice":["male","unset"]},{"t":"מְזַמֶּנֶת","voice":["female"]},{"t":" אֶת פִּי לְהוֹדוֹת וּלְהַלֵּל וּלְשַׁבֵּחַ אֶת בּוֹרְאִי לְשֵׁם יִחוּד קֻדְשָׁא בְּרִיךְ הוּא וּשְׁכִינְתֵּה בִּדְחִילוּ וּרְחִימוּ עַל יְדֵי הַהוּא טָמִיר וְנֶעְלָם בְּשֵׁם כָּל יִשְׂרָאֵל:"}]]},{"key":"P3yvCJlINk","he":[[{"t":"טוב לומר זאת לפני אמירת העשרה מזמורים","s":"n"}]]},{"key":"YwbtD_wN76","he":[[{"t":"הֲרֵינִי "},{"t":"מְקַשֵׁר","voice":["male","unset"]},{"t":"מְקַשֶּׁרֶת","voice":["female"]},{"t":" עַצְמִי בַּאֲמִירַת הָעֲשָׂרָה מִזְמוֹרִים אֵלּוּ לְכָל הַצַּדִּיקִים הָאֲמִתִּיִּים שֶׁבְּדוֹרֵנוּ. וּלְכָל הַצַּדִּיקִים הָאֲמִתִּים שׁוֹכְנֵי עָפָר. קְדוֹשִׁים אָשֵׁר בָּאָרֶץ הֵמָּה. וּבִפְרָט לְרַבֵּנוּ הַקָּדוֹשׁ צַדִּיק יְסוֹד עוֹלָם נַחַל נוֹבֵעַ מְקוֹר חָכְמָה רַבֵּנוּ נַחְמָן בֶּן פֵיגֶא שגילה תיקון זה. זְכוּתָם יָגֵן עָלֵינוּ וְעַל כָּל יִשְׂרָאֵל אָמֵן"}]]},{"key":"oBsr4PBu22","he":[[{"t":"ועל דעתם ועל כוונתם "},{"t":"אני אומר","voice":["male","unset"]},{"t":"אני אומרת","voice":["female"]},{"t":" כל אלו העשרה מזמורי תהלים, ובזכותם וכוחם אזכה לעורר ולגלות כל העשרה מיני נגינה שנאמר בהם ספר תהלים שהם: אשרי, ברכה, משכיל, שיר, ניצוח, ניגון, תפילה, הודיה, מזמור, הללויה. שהם שיר פשוט כפול משולש מרובע שהם כלולים בשמך המיוחד הגדול ונורא. ובזכות וכח השני שמות הקדושים האלו במלואם שהם (יכוון בשמות א\"ל אלהי\"ם) (כזה): אלף למד, אלף למד הי יוד מם, שהם עולים במספר תפ\"ה כמספר תהלים, בכח אלו השמות תזכני לתיקון הברית שהוא תיקון הכללי אמן"}]]}]},{"title":{"he":"מזמור טז","en":"Psalm 16"},"segments":[{"key":"6DOTtNwp5J","he":[[{"t":"מִכְתָּם לְדָוִד שָׁמְרֵנִי אֵל כִּי־חָסִיתִי בָךְ׃"}]]},{"key":"0U0njrxRuT","he":[[{"t":"אָמַרְתְּ לַיהֹוָה אֲדֹנָי אָתָּה טוֹבָתִי בַּל־עָלֶיךָ׃"}]]},{"key":"54ZpiCZTL-","he":[[{"t":"לִקְדוֹשִׁים אֲשֶׁר־בָּאָרֶץ הֵמָּה וְאַדִּירֵי כָּל־חֶפְצִי־בָם׃"}]]},{"key":"meDKKtyr3I","he":[[{"t":"יִרְבּוּ עַצְּבוֹתָם אַחֵר מָהָרוּ בַּל־אַסִּיךְ נִסְכֵּיהֶם מִדָּם וּבַל־אֶשָּׂא אֶת־שְׁמוֹתָם עַל־שְׂפָתָי׃"}]]},{"key":"ty4TyWJ-_6","he":[[{"t":"יְהֹוָה מְנָת־חֶלְקִי וְכוֹסִי אַתָּה תּוֹמִיךְ גּוֹרָלִי׃"}]]},{"key":"K49F_yVjQs","he":[[{"t":"חֲבָלִים נָפְלוּ־לִי בַּנְּעִמִים אַף־נַחֲלָת שָׁפְרָה עָלָי׃"}]]},{"key":"niCCm7o0Y2","he":[[{"t":"אֲבָרֵךְ אֶת־יְהֹוָה אֲשֶׁר יְעָצָנִי אַף־לֵילוֹת יִסְּרוּנִי כִלְיוֹתָי׃"}]]},{"key":"1pgJrUwW8g","he":[[{"t":"שִׁוִּיתִי יְהֹוָה לְנֶגְדִּי תָמִיד כִּי מִימִינִי בַּל־אֶמּוֹט׃"}]]},{"key":"597R4toqKf","he":[[{"t":"לָכֵן שָׂמַח לִבִּי וַיָּגֶל כְּבוֹדִי אַף־בְּשָׂרִי יִשְׁכֹּן לָבֶטַח׃"}]]},{"key":"YlijYkNr3N","he":[[{"t":"כִּי לֹא־תַעֲזֹב נַפְשִׁי לִשְׁאוֹל לֹא־תִתֵּן חֲסִידְךָ לִרְאוֹת שָׁחַת׃"}]]},{"key":"aQDPV7Hi30","he":[[{"t":"תּוֹדִיעֵנִי אֹרַח חַיִּים שֹׂבַע שְׂמָחוֹת אֶת־פָּנֶיךָ נְעִמוֹת בִּימִינְךָ נֶצַח׃"}]]}]},{"title":{"he":"מזמור לב","en":"Psalm 32"},"segments":[{"key":"Ef4ksCOYE7","he":[[{"t":"לְדָוִד מַשְׂכִּיל אַשְׁרֵי נְשׂוּי־פֶּשַׁע כְּסוּי חֲטָאָה׃"}]]},{"key":"N7yyiZOUCC","he":[[{"t":"אַשְׁרֵי אָדָם לֹא יַחְשֹׁב יְהֹוָה לוֹ עָוֺן וְאֵין בְּרוּחוֹ רְמִיָּה׃"}]]},{"key":"qYijVgqzXV","he":[[{"t":"כִּי־הֶחֱרַשְׁתִּי בָּלוּ עֲצָמָי בְּשַׁאֲגָתִי כָּל־הַיּוֹם׃"}]]},{"key":"t_r1_UL92z","he":[[{"t":"כִּי יוֹמָם וָלַיְלָה תִּכְבַּד עָלַי יָדֶךָ נֶהְפַּךְ לְשַׁדִּי בְּחַרְבֹנֵי קַיִץ סֶלָה׃"}]]},{"key":"B4a_90V-Q5","he":[[{"t":"חַטָּאתִי אוֹדִיעֲךָ וַעֲוֺנִי לֹא־כִסִּיתִי אָמַרְתִּי אוֹדֶה עֲלֵי פְשָׁעַי לַיהֹוָה וְאַתָּה נָשָׂאתָ עֲוֺן חַטָּאתִי סֶלָה׃"}]]},{"key":"4fZsyuTnbc","he":[[{"t":"עַל־זֹאת יִתְפַּלֵּל כָּל־חָסִיד אֵלֶיךָ לְעֵת מְצֹא רַק לְשֵׁטֶף מַיִם רַבִּים אֵלָיו לֹא יַגִּיעוּ׃"}]]},{"key":"0rnp5TW_1b","he":[[{"t":"אַתָּה סֵתֶר לִי מִצַּר תִּצְּרֵנִי רָנֵּי פַלֵּט תְּסוֹבְבֵנִי סֶלָה׃"}]]},{"key":"CHpZgctWMN","he":[[{"t":"אַשְׂכִּילְךָ וְאוֹרְךָ בְּדֶרֶךְ־זוּ תֵלֵךְ אִיעֲצָה עָלֶיךָ עֵינִי׃"}]]},{"key":"KArFs376eJ","he":[[{"t":"אַל־תִּהְיוּ כְּסוּס כְּפֶרֶד אֵין הָבִין בְּמֶתֶג־וָרֶסֶן עֶדְיוֹ לִבְלוֹם בַּל קְרֹב אֵלֶיךָ׃"}]]},{"key":"SyI_tKTrLc","he":[[{"t":"רַבִּים מַכְאוֹבִים לָרָשָׁע וְהַבּוֹטֵחַ בַּיהֹוָה חֶסֶד יְסוֹבְבֶנּוּ׃"}]]},{"key":"5WjHLVoBDi","he":[[{"t":"שִׂמְחוּ בַיהֹוָה וְגִילוּ צַדִּיקִים וְהַרְנִינוּ כָּל־יִשְׁרֵי־לֵב׃"}]]}]},{"title":{"he":"מזמור מא","en":"Psalm 41"},"segments":[{"key":"4owuBkFyVp","he":[[{"t":"לַמְנַצֵּחַ מִזְמוֹר לְדָוִד׃"}]]},{"key":"4L0S0RBpbM","he":[[{"t":"אַשְׁרֵי מַשְׂכִּיל אֶל־דָּל בְּיוֹם רָעָה יְמַלְּטֵהוּ יְהֹוָה׃"}]]},{"key":"G0j_qnlRP-","he":[[{"t":"יְהֹוָה יִשְׁמְרֵהוּ וִיחַיֵּהוּ וְאֻשַּׁר בָּאָרֶץ וְאַל־תִּתְּנֵהוּ בְּנֶפֶשׁ אֹיְבָיו׃"}]]},{"key":"0_yqUkbffV","he":[[{"t":"יְהֹוָה יִסְעָדֶנּוּ עַל־עֶרֶשׂ דְּוָי כָּל־מִשְׁכָּבוֹ הָפַכְתָּ בְחָלְיוֹ׃"}]]},{"key":"uIqQmR9MlN","he":[[{"t":"אֲנִי־אָמַרְתִּי יְהֹוָה חָנֵּנִי רְפָאָה נַפְשִׁי כִּי־חָטָאתִי לָךְ׃"}]]},{"key":"U8INYILCt1","he":[[{"t":"אוֹיְבַי יֹאמְרוּ רַע לִי מָתַי יָמוּת וְאָבַד שְׁמוֹ׃"}]]},{"key":"XijumAZVhZ","he":[[{"t":"וְאִם־בָּא לִרְאוֹת שָׁוְא יְדַבֵּר לִבּוֹ יִקְבָּץ־אָוֶן לוֹ יֵצֵא לַחוּץ יְדַבֵּר׃"}]]},{"key":"IFJkULtQAp","he":[[{"t":"יַחַד עָלַי יִתְלַחֲשׁוּ כָּל־שֹׂנְאָי עָלַי יַחְשְׁבוּ רָעָה לִי׃"}]]},{"key":"-f6lBF7M1v","he":[[{"t":"דְּבַר־בְּלִיַּעַל יָצוּק בּוֹ וַאֲשֶׁר שָׁכַב לֹא־יוֹסִיף לָקוּם׃"}]]},{"key":"2-djB_VOQZ","he":[[{"t":"גַּם־אִישׁ שְׁלוֹמִי אֲשֶׁר־בָּטַחְתִּי בוֹ אוֹכֵל לַחְמִי הִגְדִּיל עָלַי עָקֵב׃"}]]},{"key":"4KJkmA1IBG","he":[[{"t":"וְאַתָּה יְהֹוָה חָנֵּנִי וַהֲקִימֵנִי וַאֲשַׁלְּמָה לָהֶם׃"}]]},{"key":"aJ7i6a2Sxl","he":[[{"t":"בְּזֹאת יָדַעְתִּי כִּי־חָפַצְתָּ בִּי כִּי לֹא־יָרִיעַ אֹיְבִי עָלָי׃"}]]},{"key":"2n6fHXSkVi","he":[[{"t":"וַאֲנִי בְּתֻמִּי תָּמַכְתָּ בִּי וַתַּצִּיבֵנִי לְפָנֶיךָ לְעוֹלָם׃"}]]},{"key":"YjoN9MF8Vc","he":[[{"t":"בָּרוּךְ יְהֹוָה אֱלֹהֵי יִשְׂרָאֵל מֵהָעוֹלָם וְעַד הָעוֹלָם אָמֵן וְאָמֵן׃"}]]}]