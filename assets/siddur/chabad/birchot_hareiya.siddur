{"nusach":"chabad","id":"birchot_hareiya","sections":[{"title":{"he":"ברק ורעם","en":"Lightning and Thunder"},"segments":[{"key":"9HhBA1ibv1","he":[[{"t":"על הברקים מברך:","s":"n"}]]},{"key":"cz-dxD5Gye","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, עוֹשֵׂה מַעֲשֵׂה בְרֵאשִׁית:"}]]},{"key":"momKjTsbwd","he":[[{"t":"על הרעמים מברך:","s":"n"}]]},{"key":"-q4IxUMit6","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, שֶׁכֹּחוֹ וּגְבוּרָתוֹ מָלֵא עוֹלָם:"}]]}]},{"title":{"he":"הקשת","en":"A Rainbow"},"segments":[{"key":"q39PtD_Q0s","he":[[{"t":"הרואה קשת:","s":"n"}]]},{"key":"pAFVMblCT-","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, זוֹכֵר הַבְּרִית וְנֶאֱמָן בִּבְרִיתוֹ וְקַיָּם בְּמַאֲמָרוֹ:"}]]}]},{"title":{"he":"ברכת האילנות","en":"Trees in Blossom"},"segments":[{"key":"t1UtzQea5y","he":[[{"t":"היוצא בימי ניסן וראה אילנות שמוציאין פרח צריך לברך:","s":"n"}]]},{"key":"8qiLiKRoKj","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֹהֵינוּ מֶלֶךְ הָעוֹלָם, שֶׁלֹּא חִסַּר בְּעוֹלָמוֹ כְּלוּם וּבָרָא בוֹ בְּרִיוֹת טוֹבוֹת וְאִילָנוֹת טוֹבוֹת לֵיהָנוֹת בָּהֶם בְּנֵי אָדָם:"}]]}]},{"title":{"he":"ברכות שבח והודאה","en":"Further Blessings of Praise"},"segments":[{"key":"DpIc3_0Dgc","he":[[{"t":"על שמועות שהם טובות לו ולאחרים מברך:","s":"n"}]]},{"key":"VMP03wb1B9","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, הַטוֹב וְהַמֵּטִיב:"}]]},{"key":"eULkmfDlQR","he":[[{"t":"על שמועות רעות מברך:","s":"n"}]]},{"key":"rHxVIsvyQG","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, דַּיַּן הָאֱמֶת:"}]]}]}],"credits":[{"title":"Weekday Siddur Chabad — Wikisource","license":"CC-BY-SA","url":"https://www.sefaria.org/Weekday_Siddur_Chabad"}]}