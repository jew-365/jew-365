{"nusach":"chabad","id":"birchot_hanehenin","sections":[{"title":{"he":"נטילת ידיים לסעודה","en":"Washing Hands Before Bread"},"segments":[{"key":"ES5nIt6NhC","he":[[{"t":"כשנוטל ידיו:","s":"n"}]]},{"key":"GfuirBimaJ","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֹהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, אֲשֶׁר קִדְּשָֽׁנוּ בְּמִצְוֹתָיו, וְצִוָּנוּ עַל נְטִילַת יָדָֽיִם:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Who sanctified us with His commandments and commanded us concerning the washing of hands."}]},{"title":{"he":"המוציא","en":"Over Bread"},"segments":[{"key":"Q1aTNQGrim","he":[[{"t":"על הפת:","s":"n"}]]},{"key":"_QbHYFIQxQ","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, הַמּוֹצִֽיא לֶֽחֶם מִן־הָאָֽרֶץ:"}]]}]},{"title":{"he":"בורא מיני מזונות","en":"Over Grain Foods"},"segments":[{"key":"YHT4pFM4ZZ","he":[[{"t":"כל שהוא ממין דגן ולא עשאו פת:","s":"n"}]]},{"key":"SWOuFmBaVF","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, בּוֹרֵא מִינֵֽי מְזוֹנֽוֹת:"}]]}]},{"title":{"he":"בורא פרי הגפן","en":"Over Wine"},"segments":[{"key":"1cDBFsMTaT","he":[[{"t":"על היין:","s":"n"}]]},{"key":"JT_81kCb4g","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, בּוֹרֵא פְּרִי הַגָּֽפֶן:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Creator of the fruit of the vine."}]},{"title":{"he":"בורא פרי העץ","en":"Over Tree Fruit"},"segments":[{"key":"fupxSDSVNK","he":[[{"t":"לכל פירות האילן:","s":"n"}]]},{"key":"DcxaabdZwX","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, בּוֹרֵא פְּרִי הָעֵץ:"}]]}]},{"title":{"he":"בורא פרי האדמה","en":"Over Produce of the Ground"},"segments":[{"key":"5cqBx3E-Xq","he":[[{"t":"לכל מיני פירות הארץ:","s":"n"}]]},{"key":"pcIh7PiEmK","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, בּוֹרֵא פְּרִי הָאֲדָמָה:"}]]}]},{"title":{"he":"שהכל נהיה בדברו","en":"Over Other Foods and Drinks"},"segments":[{"key":"0XKgWGC-OT","he":[[{"t":"לשאר כל אוכלין ומשקין חוץ מן היין והפת:","s":"n"}]]},{"key":"BkpFFOi_FP","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, שֶׁהַכֹּל נִהְיָה בִּדְבָרוֹ:"}]]}]},{"title":{"he":"ברכות הריח","en":"Over Fragrances"},"segments":[{"key":"S99NJKf4q1","he":[[{"t":"על ריח בשמים מברך:","s":"n"}]]},{"key":"ph_RBCWvxb","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, בּוֹרֵא מִינֵי בְשָׂמִים:"}]]}]},{"title":{"he":"שהחיינו","en":"Shehecheyanu"},"segments":[{"key":"HC6pPJyqCi","he":[[{"t":"הלובש מלבוש חדש וכן האוכל פרי חדש הגדל בזמן קבוע בשנה ומתחדש משנה לשנה מברך:","s":"n"}]]},{"key":"DiepMVGBhW","he":[[{"t":"בָּרוּךְ","s":"b"},{"t":" אַתָּה יְיָ אֱלֺהֵֽינוּ מֶֽלֶךְ הָעוֹלָם, שֶׁהֶחֱיָֽנוּ וְקִיְּמָֽנוּ וְהִגִּיעָֽנוּ לַזְּמַן הַזֶּה:"}]],"en":"Blessed are You, Adonoy our God, King of the Universe, Who has kept us alive and sustained us and brought us to this time."}]}],"credits":[{"title":"Weekday Siddur Chabad — Wikisource","license":"CC-BY-SA","url":"https://www.sefaria.org/Weekday_Siddur_Chabad"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"},{"title":"Siddur Sefard — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Sefard"}]}