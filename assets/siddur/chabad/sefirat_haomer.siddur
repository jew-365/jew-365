וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁנֵי יָמִים לָעֹֽמֶר:"}],[{"t":"קבל גבורה שבמלכות אֱלֹהִים נ","s":"n"}]],"en":"Today is 44 days, which is 6 weeks and 2 days of the Omer","when":{"omerDay":44}},{"key":"nVYvQnKguu","he":[[{"t":"א סיון","s":"n"}],[{"t":"הַיּוֹם חֲמִשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וּשְׁלשָׁה יָמִים לָעֹֽמֶר:"}],[{"t":"ושמע תפארת שבמלכות וייראוֹ ח","s":"n"}]],"en":"Today is 45 days, which is 6 weeks and 3 days of the Omer","when":{"omerDay":45}},{"key":"QFkLNiGKUW","he":[[{"t":"ב סיון","s":"n"}],[{"t":"הַיּוֹם שִׁשָּׁה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְאַרְבָּעָה יָמִים לָעֹֽמֶר:"}],[{"t":"צעקתנו נצח שבמלכות אוֹתו ם","s":"n"}]],"en":"Today is 46 days, which is 6 weeks and 4 days of the Omer","when":{"omerDay":46}},{"key":"3Twm2dSJgq","he":[[{"t":"ג סיון","s":"n"}],[{"t":"הַיּוֹם שִׁבְעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וַחֲמִשָּׁה יָמִים לָעֹֽמֶר:"}],[{"t":"יודע הוד שבמלכות כל ס","s":"n"}]],"en":"Today is 47 days, which is 6 weeks and 5 days of the Omer","when":{"omerDay":47}},{"key":"jFa2buB7zb","he":[[{"t":"ד סיון","s":"n"}],[{"t":"הַיּוֹם שְׁמוֹנָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁשָּׁה שָׁבוּעוֹת וְשִׁשָּׁה יָמִים לָעֹֽמֶר:"}],[{"t":"תעלומות יסוד שבמלכות אפסי ל","s":"n"}]],"en":"Today is 48 days, which is 6 weeks and 6 days of the Omer","when":{"omerDay":48}},{"key":"PAatWbrfkJ","he":[[{"t":"ה סיון","s":"n"}],[{"t":"הַיּוֹם תִּשְׁעָה וְאַרְבָּעִים יוֹם שֶׁהֵם שִׁבְעָה שָׁבוּעוֹת לָעֹֽמֶר:"}],[{"t":"שק״ו צי״ת מַלְכוּת שבמלכות ארץ ה","s":"n"}]],"en":"Today is 49 days, which is 7 weeks of the Omer","when":{"omerDay":49}},{"key":"lf0yt1MyCc","he":[[{"t":"הָרַחֲמָן הוּא יַחֲזִיר לָנוּ עֲבוֹדַת בֵּית הַמִּקְדָּשׁ לִמְקוֹמָה, בִּמְהֵרָה בְּיָמֵֽינוּ. אָמֵן סֶֽלָה:"}]],"en":"The Merciful One, may He return for us the service of the Beis Hamikdash in its place speedily in our days, Amein, Selah."},{"key":"Q65nvL5bNK","he":[[{"t":"לַמְנַצֵּֽחַ","s":"b"},{"t":" בִּנְגִינוֹת מִזְמוֹר שִׁיר: אֱלֹהִים יְחָנֵּֽנוּ וִיבָרְכֵֽנוּ יָאֵר פָּנָיו אִתָּֽנוּ סֶֽלָה: לָדַֽעַת בָּאָֽרֶץ דַּרְכֶּֽךָ בְּכָל־גּוֹיִם יְשׁוּעָתֶֽךָ: יוֹדֽוּךָ עַמִּים אֱלֹהִים יוֹדֽוּךָ עַמִּים כֻּלָּם: יִשְׂמְחוּ וִירַנְּנוּ לְאֻמִּים כִּי־תִשְׁפּוֹט עַמִּים מִישׁוֹר וּלְאֻמִּים בָּאָֽרֶץ תַּנְחֵם סֶֽלָה: יוֹדֽוּךָ עַמִּים אֱלֹהִים יוֹדֽוּךָ עַמִּים כֻּלָּם: אֶֽרֶץ נָתְנָה יְבוּלָהּ יְבָרְכֵֽנוּ אֱלֹהִים אֱלֹהֵֽינוּ: יְבָרְכֵֽנוּ אֱלֹהִים וְיִירְאוּ אוֹתוֹ כָּל־אַפְסֵי־אָֽרֶץ:"}]],"en":"To Him, Who grants victory: a psalm with instrumental music, a song. [May] God favor us and bless us, [may He] cause His countenance to shine among us forever; [so] that Your way become known on earth, [and] Your deliverance among all nations. Peoples will thank You, God, all the peoples will thank You. Nations will rejoice and sing when You judge the peoples justly, and lead the nations upon the earth forever. Peoples will thank You, God, all the peoples will thank You. The earth will have yielded its produce; God, our God, will have blessed us. God will bless us, and they will fear Him— all [men even from] the ends of the earth."},{"key":"_o5hy3CGxB","he":[[{"t":"אָֽנָּא","s":"b"},{"t":", בְּכֹֽחַ גְּדֻלַּת יְמִינְךָ, תַּתִּיר צְרוּרָה. "},{"t":"אב״ג ית״ץ","s":"n"}],[{"t":"קַבֵּל רִנַּת עַמְּךָ, שַׂגְּבֵֽנוּ, טַהֲרֵֽנוּ נוֹרָא. "},{"t":"קר״ע שט״ן","s":"n"}],[{"t":"נָא גִבּוֹר, דּוֹרְשֵׁי יִחוּדְךָ כְּבָבַת שָׁמְרֵם. "},{"t":"נג״ד יכ״ש","s":"n"}],[{"t":"בָּרְכֵם טַהֲרֵם, רַחֲמֵי צִדְקָתְךָ תָּמִיד גָּמְלֵם. "},{"t":"בט״ר צת״ג","s":"n"}],[{"t":"חֲסִין קָדוֹשׁ, בְּרוֹב טוּבְךָ נַהֵל עֲדָתֶֽךָ. "},{"t":"חק״ב טנ״ע","s":"n"}],[{"t":"יָחִיד גֵּאֶה לְעַמְּךָ פְּנֵה, זוֹכְרֵי קְדֻשָּׁתֶֽךָ. "},{"t":"יג״ל פז״ק","s":"n"}],[{"t":"שַׁוְעָתֵֽנוּ קַבֵּל וּשְׁמַע צַעֲקָתֵֽנוּ, יוֹדֵֽעַ תַּעֲלוּמוֹת. "},{"t":"שק״ו צי״ת","s":"n"}],[{"t":"בָּרוּךְ שֵׁם כְּבוֹד מַלְכוּתוֹ לְעוֹלָם וָעֶד:"}]]},{"key":"t0jx0FzDFt","he":[[{"t":"רִבּוֹנוֹ","s":"b"},{"t":" שֶׁל עוֹלָם, אַתָּה צִוִּיתָֽנוּ עַל־יְדֵי משֶׁה עַבְדֶּֽךָ לִסְפֹּר סְפִירַת הָֽעֹמֶר כְּדֵי לְטַהֲרֵֽנוּ מִקְּלִפּוֹתֵֽינוּ וּמִטֻּמְאוֹתֵֽינוּ, כְּמוֹ שֶׁכָּתַֽבְתָּ בְּתוֹרָתֶֽךָ: וּסְפַרְתֶּם לָכֶם מִמָּחֳרַת הַשַּׁבָּת מִיּוֹם הֲבִיאֲכֶם אֶת־עֹֽמֶר הַתְּנוּפָה שֶֽׁבַע שַׁבָּתוֹת תְּמִימוֹת תִּהְיֶֽינָה: עַד מִמָּחֳרַת הַשַּׁבָּת הַשְּׁבִיעִית תִּסְפְּרוּ חֲמִשִּׁים יוֹם, כְּדֵי שֶׁיִּטָּהֲרוּ נַפְשׁוֹת עַמְּךָ יִשְׂרָאֵל מִזֻּהֲמָתָם, וּבְכֵן יְהִי רָצוֹן מִלְּפָנֶֽיךָ יְיָ אֱלֹהֵֽינוּ וֵאלֹהֵי אֲבוֹתֵֽינוּ, שֶׁבִּזְכוּת סְפִירַת הָעֹֽמֶר שֶׁסָּפַֽרְתִּי הַיּוֹם, יְתֻקַּן מַה־שֶּׁפָּגַֽמְתִּי בִּסְפִירָה ("},{"t":"השייכת לאותו הלילה","s":"n"},{"t":") וְאֶטָּהֵר וְאֶתְקַדֵּשׁ בִּקְדֻשָּׁה שֶׁל מַֽעְלָה, וְעַל־יְדֵי זֶה יֻשְׁפַּע שֶֽׁפַע רַב בְּכָל־הָעוֹלָמוֹת וּלְתַקֵּן אֶת־נַפְשׁוֹתֵֽינוּ וְרוּחוֹתֵֽינוּ וְנִשְׁמוֹתֵֽינוּ מִכָּל־סִיג וּפְגַם, וּלְטַהֲרֵֽנוּ וּלְקַדְּשֵֽׁנוּ בִּקְדֻשָּׁתְךָ הָעֶלְיוֹנָה. אָמֵן סֶֽלָה:"}]],"en":"Master of the universe, You commanded us through the hands of Your servant, Moses, to count the Omer in order to purify us from our evil and defilement. As You have written in Your Torah: And you shall count for yourselves, from the day after the day of rest, from the day you bring the omer as the wave-offering, seven complete weeks, shall there be; until the day following the seventh week shall you count fifty days, in order to cleanse the souls of Your people Israel from their impurities. Therefore, may it be Your will, Adonoy, our God, and God of our fathers, that in the merit of the Omer which I counted today, may any defect I have caused be rectified. May I be purified and sanctified with sublime holiness, and thereby may abundant bounty be bestowed upon all the worlds. May it rectify our being, our spirit and our souls from every baseness and defect, and may it purify us and sanctify us with Your sublime holiness. Amen, Selah."}]}],"credits":[{"title":"Weekday Siddur Chabad — Wikisource","license":"CC-BY-SA","url":"https://www.sefaria.org/Weekday_Siddur_Chabad"},{"title":"Siddur Ashkenaz — The Metsudah Siddur, Avrohom Davis (1981)","license":"CC-BY","url":"https://www.sefaria.org/Siddur_Ashkenaz"}]}