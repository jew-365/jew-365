+  private fun styledText(content: INotificationContent): CharSequence? {
+    val text = content.text ?: return null
+    val span = content.body?.optJSONObject("bodySpan") ?: return text
+    return try {
+      val start = span.getInt("start")
+      val end = span.getInt("end")
+      if (start < 0 || end > text.length || start >= end) return text
+      val styled = SpannableString(text)
+      styled.setSpan(
+        ForegroundColorSpan(Color.parseColor(span.getString("color"))),
+        start,
+        end,
+        Spanned.SPAN_EXCLUSIVE_EXCLUSIVE
+      )
+      styled
+    } catch (e: Exception) {
