{
  "expo": {
    "name": "Jew 365",
    "slug": "jew-365",
    "version": "1.0.21",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "jew365",
    "userInterfaceStyle": "automatic",
    "locales": {
      "he": "./locales/he.json",
      "en": "./locales/en.json"
    },
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jew365.app",
      "infoPlist": {
        "CFBundleDisplayName": "יהודי 365",
        "NSLocationWhenInUseUsageDescription": "יהודי 365 משתמש במיקום כדי לחשב את זמני ההלכה, כמו הזריחה והדלקת הנרות, במקום שבו אתם נמצאים, וכדי לכוון את מצפן התפילה לירושלים. אפשר גם לבחור מקום ידנית, בלי מיקום.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "יהודי 365 משתמש במיקום רק כשהאפליקציה פתוחה, כדי לחשב את זמני ההלכה ולכוון את מצפן התפילה. אפשר גם לבחור מקום ידנית, בלי מיקום.",
        "UIBackgroundModes": ["processing"],
        "CFBundleAllowMixedLocalizations": true,
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#FFFFFF"
      },
      "package": "com.jew365.app",
      "allowBackup": true,
      "permissions": [
        "ACCESS_COARSE_LOCATION",
        "ACCESS_FINE_LOCATION",
        "RECEIVE_BOOT_COMPLETED",
        "SCHEDULE_EXACT_ALARM",
        "POST_NOTIFICATIONS",
        "USE_EXACT_ALARM",
        "WAKE_LOCK",
        "REQUEST_IGNORE_BATTERY_OPTIMIZATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#F6F1E8",
          "dark": {
            "image": "./assets/splash-dark.png",
            "backgroundColor": "#0E1626"
          }
        }
      ],
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "יהודי 365 משתמש במיקום רק כשהאפליקציה פתוחה, כדי לחשב את זמני ההלכה ולכוון את מצפן התפילה. אפשר גם לבחור מקום ידנית, בלי מיקום.",
          "locationAlwaysPermission": "יהודי 365 משתמש במיקום רק כשהאפליקציה פתוחה, כדי לחשב את זמני ההלכה ולכוון את מצפן התפילה. אפשר גם לבחור מקום ידנית, בלי מיקום."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#002767",
          "sounds": [
            "./assets/sounds/jew365_bells.wav",
            "./assets/sounds/jew365_call.wav",
            "./assets/sounds/jew365_harp.wav",
            "./assets/sounds/jew365_drop.wav",
            "./assets/sounds/jew365_chime.wav",
            "./assets/sounds/jew365_glass.wav",
            "./assets/sounds/jew365_kalimba.wav",
            "./assets/sounds/jew365_dew.wav",
            "./assets/sounds/jew365_music_box.wav",
            "./assets/sounds/jew365_flute.wav",
            "./assets/sounds/jew365_bowl.wav",
            "./assets/sounds/jew365_piano.wav"
          ]
        }
      ],
      "./scripts/withMitzvahNotificationAction",
      "./scripts/withExactAlarmPermissions",
      "expo-task-manager",
      "expo-background-task",
      "expo-asset",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./scripts/withAndroidBackupRules",
      "./scripts/withAndroidLegacyHebrewLocale",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "יהודי 365 משתמש ב-Face ID רק כדי לנעול את מסכי המעקב של טהרת המשפחה."
        }
      ],
      [
        "@sentry/react-native/expo",
        {
          "organization": "<sentry-org>",
          "project": "<sentry-project>",
          "url": "https://sentry.io/"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "root": "./src/app"
      },
      "eas": {
        "projectId": "681ad224-93cc-4094-81cd-f70c48087485"
      }
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "owner": "jew-365-org",
    "updates": {
      "url": "https://u.expo.dev/681ad224-93cc-4094-81cd-f70c48087485"
    }
  }
}
